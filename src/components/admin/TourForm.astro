---
interface Props {
  tour?: {
    id?: number;
    title?: string;
    slug?: string;
    thumbnail?: string;
    tagline?: string;
    whatsapp_message?: string;
    content?: string;
    price?: string;
    price_unit?: string;
    duration?: string;
    badge?: string;
    location?: string;
    is_active?: boolean;
    rating?: number;
    reviews_count?: number;
    highlights?: any;
    itinerary?: any;
    included?: any;
    excluded?: any;
    gallery?: any;
    price_note?: string;
    important_info?: string;
    pickup_location?: string;
    booking_perks?: any;
    bookingPerks?: any;
  };
  submitLabel: string;
  slugRequired?: boolean;
}

const { tour = {}, submitLabel, slugRequired = false } = Astro.props;

function toLines(val: any): string {
  if (Array.isArray(val)) return val.join('\n');
  if (typeof val === 'string') {
    try {
      const parsed = JSON.parse(val);
      if (Array.isArray(parsed)) return parsed.join('\n');
    } catch {}
    return val;
  }
  return '';
}

function itineraryToLines(val: any): string {
  let arr: any[] = [];
  if (Array.isArray(val)) arr = val;
  else if (typeof val === 'string') {
    try {
      const p = JSON.parse(val);
      if (Array.isArray(p)) arr = p;
    } catch {}
  }
  if (arr.length > 0) {
    return arr.map(i => `${i.time || ''} | ${i.title || ''} | ${i.desc || ''}`).join('\n');
  }
  return '';
}

const highlightsText = toLines(tour.highlights);
const includedText = toLines(tour.included);
const excludedText = toLines(tour.excluded);
const galleryText = toLines(tour.gallery);
const itineraryText = itineraryToLines(tour.itinerary);
const bookingPerksText = toLines(tour.booking_perks || tour.bookingPerks) || '100% Private Tour (Tanpa Campur Tamu Lain)\nJadwal & Waktu Singgah Bebas Diatur\nBisa Bayar DP Ringan / Bayar di Tempat\nDriver Ramah & Siap Bantu Ambilkan Foto';

const input =
  'w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-sm focus:outline-none focus:ring-4 focus:ring-primary-500/10 focus:border-primary-500 transition shadow-sm placeholder:text-slate-400';
const label = 'block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5';
---

<form method="POST" class="grid lg:grid-cols-3 gap-8">
  <!-- Left Column: Primary Data (2 Cols) -->
  <div class="lg:col-span-2 space-y-6">
    <!-- Auto-Translate Tool Banner -->
    <div class="admin-translate-banner bg-gradient-to-r from-primary-50 via-emerald-50 to-amber-50 dark:from-navy-900 dark:via-navy-900 dark:to-navy-950 border border-primary-200/80 dark:border-primary-500/30 rounded-3xl p-5 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition-colors">
      <div class="flex items-start gap-3.5">
        <div class="w-10 h-10 rounded-2xl bg-primary-600 dark:bg-primary-500 text-white flex items-center justify-center text-lg shadow-sm shrink-0">
          🌐
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h4 class="text-sm font-bold text-slate-900 dark:text-white">Biasa Input Paket dalam Bahasa Inggris?</h4>
            <span class="text-[10px] bg-primary-600 dark:bg-primary-500 text-white font-bold px-2 py-0.5 rounded-full uppercase tracking-wider">Fitur Praktis</span>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-300 mt-1 leading-relaxed max-w-xl">
            Ketik semua judul, deskripsi, dan rute dalam Bahasa Inggris seperti biasa. Klik tombol di samping untuk <strong class="text-slate-900 dark:text-teal-300 font-bold">otomatis menerjemahkannya ke Bahasa Indonesia yang rapi</strong> agar paket tampil sempurna di mode ID & ENG!
          </p>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 shrink-0">
        <button
          type="button"
          id="btn-auto-translate"
          class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-700 dark:bg-primary-500 dark:hover:bg-primary-600 text-white font-bold text-xs shadow-md transition-all active:scale-95 cursor-pointer"
        >
          <span id="translate-icon">✨</span>
          <span id="translate-btn-text">Terjemahkan ke Bahasa Indonesia</span>
        </button>
        <button
          type="button"
          id="btn-undo-translate"
          class="hidden inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-slate-200 hover:bg-slate-300 text-slate-700 dark:bg-navy-800 dark:hover:bg-navy-700 dark:text-slate-200 dark:border dark:border-navy-700 font-bold text-xs transition cursor-pointer"
          title="Kembalikan teks bahasa Inggris asli"
        >
          <span>↺</span>
          <span>Batal</span>
        </button>
      </div>
    </div>

    <!-- Status Sukses Translate -->
    <div id="translate-success-box" class="hidden px-4 py-3 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 dark:bg-emerald-950/60 dark:border-emerald-800/80 dark:text-emerald-200 text-xs font-semibold flex items-center justify-between">
      <span>🎉 Teks paket berhasil diterjemahkan ke Bahasa Indonesia! Anda masih bisa mengeditnya sebelum klik tombol Simpan di bawah.</span>
      <button type="button" id="close-success-box" class="text-emerald-600 hover:text-emerald-900 dark:text-emerald-400 dark:hover:text-emerald-200 font-bold ml-2 text-sm">&times;</button>
    </div>

    <!-- Main Info Section -->
    <section class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-7 shadow-sm space-y-5">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <h3 class="font-bold text-slate-900 flex items-center gap-2 text-base">
          <span class="w-7 h-7 rounded-lg bg-primary-50 text-primary-600 flex items-center justify-center text-sm font-bold">1</span>
          <span>Informasi Utama Paket</span>
        </h3>
        <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-600">Katalog Wisata</span>
      </div>

      <div>
        <label for="title" class={label}>Nama Paket Wisata <span class="text-rose-500">*</span></label>
        <input id="title" name="title" type="text" required value={tour.title ?? ''} placeholder="Contoh: Sunrise Punthuk Setumbu & Candi Borobudur" class={input} />
      </div>

      <div>
        <label for="slug" class={label}>
          Slug URL Website {slugRequired && <span class="text-rose-500">*</span>}
        </label>
        <div class="flex rounded-xl border border-slate-300 overflow-hidden focus-within:ring-4 focus-within:ring-primary-500/10 focus-within:border-primary-500 transition shadow-sm bg-white">
          <span class="px-3.5 flex items-center bg-slate-50 text-slate-400 text-xs font-mono border-r border-slate-300">/tour-package/</span>
          <input id="slug" name="slug" type="text" required={slugRequired} value={tour.slug ?? ''} placeholder="otomatis-dari-nama-paket" class="flex-1 px-3 py-2.5 text-sm outline-none bg-transparent" />
        </div>
        <p class="text-[11px] text-slate-400 mt-1">Gunakan huruf kecil dan tanda hubung (-). Dikosongkan akan otomatis dibuat.</p>
      </div>

      <div>
        <label for="tagline" class={label}>Tagline / Ringkasan Menarik</label>
        <input id="tagline" name="tagline" type="text" value={tour.tagline ?? ''} placeholder="Satu kalimat singkat yang memikat wisatawan (tampil di bawah judul)" class={input} />
      </div>

      <!-- Pricing & Duration Grid -->
      <div class="grid sm:grid-cols-2 gap-4 pt-3 border-t border-slate-100">
        <div>
          <label for="price" class={label}>Harga Mulai Dari</label>
          <input id="price" name="price" type="text" value={tour.price ?? 'Rp 450.000'} placeholder="Rp 450.000" class={input} />
        </div>
        <div>
          <label for="price_unit" class={label}>Satuan Harga</label>
          <input id="price_unit" name="price_unit" type="text" value={tour.price_unit ?? '/ mobil'} placeholder="/ mobil atau / pax" class={input} />
        </div>
      </div>

      <div>
        <label for="price_note" class={label}>Catatan Harga & Kapasitas</label>
        <input id="price_note" name="price_note" type="text" value={tour.price_note ?? 'Harga per mobil (kapasitas 1-6 orang). Termasuk mobil ber-AC, driver ramah, & BBM.'} placeholder="Harga per mobil (kapasitas 1-6 orang). Termasuk mobil ber-AC, driver ramah, & BBM." class={input} />
        <p class="text-[11px] text-slate-400 mt-1">Keterangan yang tampil di bawah nominal harga pada kartu pemesanan (sticky card).</p>
      </div>

      <div>
        <label for="booking_perks" class={label}>Poin Keunggulan Pemesanan (Poin Centang Hijau ✓, 1 per baris)</label>
        <textarea id="booking_perks" name="booking_perks" rows="4" class={input} placeholder={'100% Private Tour (Tanpa Campur Tamu Lain)\nJadwal & Waktu Singgah Bebas Diatur\nBisa Bayar DP Ringan / Bayar di Tempat\nDriver Ramah & Siap Bantu Ambilkan Foto'}>{bookingPerksText}</textarea>
        <p class="text-[11px] text-slate-400 mt-1">Poin-poin garansi/keunggulan yang tampil dengan centang hijau pada kartu pemesanan samping.</p>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label for="badge" class={label}>Badge / Tag Populer</label>
          <input id="badge" name="badge" type="text" value={tour.badge ?? 'Paling Populer ⭐'} placeholder="Paling Populer ⭐" class={input} />
        </div>
        <div>
          <label for="location" class={label}>Destinasi / Wilayah</label>
          <input id="location" name="location" type="text" value={tour.location ?? 'Yogyakarta'} placeholder="Yogyakarta & Magelang" class={input} />
        </div>
      </div>

      <!-- Rating Bintang & Jumlah Ulasan Tamu (Opsional) -->
      <div class="grid sm:grid-cols-2 gap-4 p-4 rounded-2xl bg-amber-50/50 border border-amber-200/60 dark:bg-amber-950/20 dark:border-amber-900/40">
        <div>
          <label for="rating" class={label}>
            <span>⭐ Rating Bintang (Opsional)</span>
          </label>
          <input
            id="rating"
            name="rating"
            type="number"
            step="0.1"
            min="1"
            max="5"
            value={tour.rating ?? ''}
            placeholder="Contoh: 4.9"
            class={input}
          />
          <p class="text-[11px] text-slate-400 mt-1">Skala 1.0 - 5.0. Kosongkan jika belum ingin menampilkan rating bintang.</p>
        </div>
        <div>
          <label for="reviews_count" class={label}>
            <span>💬 Jumlah Ulasan Tamu (Opsional)</span>
          </label>
          <input
            id="reviews_count"
            name="reviews_count"
            type="number"
            step="1"
            min="0"
            value={tour.reviews_count ?? ''}
            placeholder="Contoh: 85"
            class={input}
          />
          <p class="text-[11px] text-slate-400 mt-1">Total ulasan tamu (misal: 85). Kosongkan jika belum ada ulasan.</p>
        </div>
      </div>

      <!-- Box Kartu Aktivitas Wisata (Tentang Aktivitas Wisata Ini) -->
      <div class="p-5 rounded-2xl bg-sky-50/60 border border-sky-100 dark:bg-navy-950 dark:border-white/10 space-y-4">
        <div class="flex items-center justify-between pb-2 border-b border-sky-200/60 dark:border-white/10">
          <div class="flex items-center gap-2">
            <span class="text-base">ℹ️</span>
            <div>
              <h4 class="font-bold text-xs uppercase tracking-wider text-slate-800 dark:text-slate-100">Bagian "Tentang Aktivitas Wisata Ini"</h4>
              <p class="text-[11px] text-slate-400">4 kartu ringkasan aktivitas yang tampil di bawah galeri foto halaman detail.</p>
            </div>
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-4 pt-1">
          <!-- Kartu 1: Durasi -->
          <div>
            <label for="duration" class={label}>⏱️ Durasi Tour</label>
            <input id="duration" name="duration" type="text" value={tour.duration ?? '10-12 Jam'} placeholder="Contoh: 8 Jam atau 10-12 Jam" class={input} />
            <p class="text-[11px] text-slate-400 mt-1">Estimasi durasi waktu tour.</p>
          </div>

          <!-- Kartu 2: Penjemputan -->
          <div>
            <label for="pickup_location" class={label}>🏨 Area Penjemputan Termasuk</label>
            <input id="pickup_location" name="pickup_location" type="text" value={tour.pickup_location ?? 'Hotel, Stasiun Tugu/Lempuyangan, Bandara'} placeholder="Hotel, Stasiun Tugu/Lempuyangan, Bandara" class={input} />
            <p class="text-[11px] text-slate-400 mt-1">Titik penjemputan gratis dalam paket.</p>
          </div>

          <!-- Kartu 3: Grup Privat -->
          <div>
            <label for="group_type" class={label}>🚗 Keterangan Grup Wisata</label>
            <input id="group_type" name="group_type" type="text" value={tour.group_type ?? 'Hanya Anda & Rombongan'} placeholder="Hanya Anda & Rombongan" class={input} />
            <input id="group_type_note" name="group_type_note" type="text" value={tour.group_type_note ?? 'Tidak digabung dengan tamu lain'} placeholder="Catatan: Tidak digabung dengan tamu lain" class={`${input} mt-1.5 text-xs text-slate-500`} />
            <p class="text-[11px] text-slate-400 mt-1">Judul & catatan bawah kartu grup wisata.</p>
          </div>

          <!-- Kartu 4: Driver & Pemandu -->
          <div>
            <label for="driver_service" class={label}>💬 Driver & Pemandu</label>
            <input id="driver_service" name="driver_service" type="text" value={tour.driver_service ?? 'Bahasa Indonesia / English'} placeholder="Bahasa Indonesia / English" class={input} />
            <input id="driver_service_note" name="driver_service_note" type="text" value={tour.driver_service_note ?? 'Ramah, sopan, & siap ambilkan foto terbaik'} placeholder="Catatan: Ramah, sopan, & siap ambilkan foto terbaik" class={`${input} mt-1.5 text-xs text-slate-500`} />
            <p class="text-[11px] text-slate-400 mt-1">Bahasa driver & keterangan pelayanan.</p>
          </div>
        </div>
      </div>

      <div>
        <label for="whatsapp_message" class={label}>Template Pesan WhatsApp Pelanggan</label>
        <input id="whatsapp_message" name="whatsapp_message" type="text" value={tour.whatsapp_message ?? ''} placeholder="Halo Beyond Jogja Tours, saya tertarik pesan Paket Wisata ini..." class={input} />
        <p class="text-[11px] text-slate-400 mt-1">Pesan otomatis yang langsung terisi ketika wisatawan klik tombol booking.</p>
      </div>
    </section>

    <!-- Highlights Section -->
    <section class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-7 shadow-sm space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <h3 class="font-bold text-slate-900 flex items-center gap-2 text-base">
          <span class="w-7 h-7 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center text-sm font-bold">2</span>
          <span>Highlights / Daya Tarik Wisata</span>
        </h3>
        <span class="text-xs text-slate-400 font-medium">1 Poin per baris</span>
      </div>
      <div>
        <textarea id="highlights" name="highlights" rows="4" placeholder={'Menyaksikan kemegahan Candi Borobudur warisan dunia UNESCO\nSpot foto instagramable dengan lanskap perbukitan Menoreh yang magis\nPerjalanan santai dan privat bersama driver ramah & berpengalaman'} class={input}>{highlightsText}</textarea>
        <p class="text-[11px] text-slate-400 mt-1.5">Poin-poin ini akan tampil rapi dengan icon centang emas ala GetYourGuide.</p>
      </div>
    </section>

    <!-- Itinerary Section -->
    <section class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-7 shadow-sm space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <h3 class="font-bold text-slate-900 flex items-center gap-2 text-base">
          <span class="w-7 h-7 rounded-lg bg-sky-50 text-sky-600 flex items-center justify-center text-sm font-bold">3</span>
          <span>Rencana Perjalanan (Itinerary Timeline)</span>
        </h3>
        <span class="text-xs font-mono text-slate-500 bg-slate-100 px-2 py-0.5 rounded-md">Jam | Rute | Detail</span>
      </div>
      <div>
        <textarea id="itinerary" name="itinerary" rows="6" placeholder={'07:30 - 08:30 | Penjemputan di Hotel | Driver menjemput tepat waktu di lobi hotel Yogyakarta\n08:30 - 11:30 | Eksplorasi Candi Borobudur | Mengagumi relief candi megah dan suasana tenang pagi\n12:00 - 13:30 | Kuliner Khas Menoreh | Makan siang santai dengan hidangan tradisional nikmat\n14:00 - 16:30 | Gereja Ayam & Bukit Rhema | Menikmati pemandangan 360 derajat pegunungan\n16:30 - 18:00 | Kembali ke Hotel | Diantar kembali dengan selamat dan nyaman'} class={`${input} font-mono text-xs leading-relaxed`}>{itineraryText}</textarea>
        <p class="text-[11px] text-slate-400 mt-1.5">Pisahkan tiap langkah dengan tanda pipa ( | ). Di halaman detail akan dirender menjadi timeline interaktif yang estetik.</p>
      </div>
    </section>

    <!-- Inclusions & Exclusions -->
    <section class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-7 shadow-sm space-y-5">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <h3 class="font-bold text-slate-900 flex items-center gap-2 text-base">
          <span class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center text-sm font-bold">4</span>
          <span>Fasilitas Termasuk & Tidak Termasuk</span>
        </h3>
      </div>

      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <label for="included" class="block text-xs font-bold uppercase tracking-wider text-emerald-700 mb-1.5 flex items-center gap-1.5">
            <span>✓</span> Termasuk dalam Paket (1 per baris)
          </label>
          <textarea id="included" name="included" rows="5" placeholder={'Mobil Nyaman Ber-AC Prima\nDriver Ramah & Sopan\nBBM selama perjalanan tour\nAntar-Jemput Hotel (Area Jogja)\nAir Mineral Dingin\nBiaya Parkir Seluruh Objek'} class={input}>{includedText}</textarea>
        </div>
        <div>
          <label for="excluded" class="block text-xs font-bold uppercase tracking-wider text-rose-700 mb-1.5 flex items-center gap-1.5">
            <span>✗</span> Tidak Termasuk (1 per baris)
          </label>
          <textarea id="excluded" name="excluded" rows="5" placeholder={'Tiket masuk objek wisata (bisa all-in via WA)\nMakan siang & pengeluaran pribadi\nTips untuk driver (sukarela)'} class={input}>{excludedText}</textarea>
        </div>
      </div>
    </section>

    <!-- Full Description Markdown -->
    <section class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-7 shadow-sm space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <h3 class="font-bold text-slate-900 flex items-center gap-2 text-base">
          <span class="w-7 h-7 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center text-sm font-bold">5</span>
          <span>Deskripsi Lengkap / Cerita Destinasi</span>
        </h3>
        <span class="text-xs text-slate-400">Format Markdown didukung</span>
      </div>
      <div>
        <textarea id="content" name="content" rows="6" placeholder="Tuliskan cerita menarik tentang destinasi ini, keunikan rute, suasana perjalanan, dll..." class={`${input} font-mono text-xs leading-relaxed`}>{tour.content ?? ''}</textarea>
      </div>
    </section>

    <!-- Section 6: Important Info / Preparation -->
    <section class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-7 shadow-sm space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <h3 class="font-bold text-slate-900 flex items-center gap-2 text-base">
          <span class="w-7 h-7 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center text-sm font-bold">6</span>
          <span>Informasi Penting & Tips Persiapan</span>
        </h3>
        <span class="text-xs text-slate-400 font-medium">Yang perlu dibawa tamu</span>
      </div>
      <div>
        <label for="important_info" class={label}>Yang Perlu Dibawa / Catatan Persiapan</label>
        <textarea id="important_info" name="important_info" rows="3" class={input} placeholder="Pakaian yang nyaman dan menyerap keringat, kacamata hitam, topi/payung, kamera atau smartphone terisi penuh, serta uang tunai secukupnya untuk keperluan pribadi di lokasi wisata.">{tour.important_info ?? 'Pakaian yang nyaman dan menyerap keringat, kacamata hitam, topi/payung, kamera atau smartphone terisi penuh, serta uang tunai secukupnya untuk keperluan pribadi di lokasi wisata.'}</textarea>
        <p class="text-[11px] text-slate-400 mt-1">Panduan praktis perlengkapan yang perlu disiapkan wisatawan saat trip.</p>
      </div>
    </section>
  </div>

  <!-- Right Column: Media Preview & Action Box (1 Col) -->
  <div class="space-y-6">
    <section class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-7 shadow-sm space-y-5 lg:sticky lg:top-24">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <h3 class="font-bold text-slate-900 text-sm">Media & Status Paket</h3>
        <span class="text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full bg-primary-50 text-primary-700">Publikasi</span>
      </div>

      <!-- Status Paket: Aktif vs Nonaktif -->
      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-2.5">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">Status Tampil Paket</span>
          <span id="status-badge" class:list={[
            'text-[11px] font-bold px-2.5 py-0.5 rounded-full border',
            tour.is_active !== false ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-amber-50 text-amber-700 border-amber-200'
          ]}>
            {tour.is_active !== false ? '🟢 Aktif (Live)' : '⚪ Nonaktif (Diperbarui)'}
          </span>
        </div>

        <div class="grid grid-cols-2 gap-2 pt-1">
          <label class="flex items-center justify-center gap-1.5 p-2 rounded-xl border cursor-pointer transition text-xs font-semibold bg-white hover:bg-slate-50 border-slate-200 has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-50/60 has-[:checked]:text-emerald-800">
            <input type="radio" name="is_active" value="true" checked={tour.is_active !== false} class="sr-only status-radio" />
            <span>Aktif (Tampil)</span>
          </label>
          <label class="flex items-center justify-center gap-1.5 p-2 rounded-xl border cursor-pointer transition text-xs font-semibold bg-white hover:bg-slate-50 border-slate-200 has-[:checked]:border-amber-500 has-[:checked]:bg-amber-50/60 has-[:checked]:text-amber-800">
            <input type="radio" name="is_active" value="false" checked={tour.is_active === false} class="sr-only status-radio" />
            <span>Nonaktif (Tutup)</span>
          </label>
        </div>
        <p class="text-[11px] text-slate-400 leading-relaxed">
          Pilih <strong>Nonaktif</strong> jika paket sedang Anda perbarui. Pengunjung tidak akan dapat memesan atau melihat paket ini di katalog.
        </p>
      </div>

      <!-- Live Thumbnail Preview Card -->
      <div class="aspect-[4/3] rounded-2xl bg-slate-100 border border-slate-200 overflow-hidden flex items-center justify-center relative shadow-inner group">
        <img
          id="preview"
          src={tour.thumbnail ?? ''}
          alt="Preview foto utama"
          class:list={['w-full h-full object-cover transition duration-300 group-hover:scale-105', !tour.thumbnail && 'hidden']}
        />
        <div id="preview-empty" class:list={['flex flex-col items-center gap-2 text-slate-400 p-4 text-center', tour.thumbnail && 'hidden']}>
          <svg class="w-10 h-10 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span class="text-xs font-medium">Upload foto atau masukkan link gambar</span>
        </div>
      </div>

      <!-- Upload Foto Utama & Link Input -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <label for="thumbnail" class={label}>Foto Utama Paket <span class="text-rose-500">*</span></label>
          <button
            type="button"
            id="clear_thumb_btn"
            class:list={['text-xs text-rose-500 hover:text-rose-700 font-medium cursor-pointer', !tour.thumbnail && 'hidden']}
          >
            Hapus Foto
          </button>
        </div>

        <!-- Tombol Upload File Komputer / HP -->
        <input type="file" id="thumb_file_input" accept="image/*" class="hidden" />
        <button
          type="button"
          id="thumb_upload_btn"
          class="w-full py-2.5 px-3 rounded-xl border-2 border-dashed border-primary-300 dark:border-primary-500/40 bg-primary-50/60 dark:bg-primary-500/10 hover:bg-primary-100/70 text-primary-700 dark:text-primary-300 text-xs font-semibold flex items-center justify-center gap-2 transition cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
          </svg>
          <span id="thumb_btn_text">📁 Upload Foto dari Komputer / HP</span>
        </button>

        <div>
          <input
            id="thumbnail"
            name="thumbnail"
            type="text"
            required
            value={tour.thumbnail ?? ''}
            placeholder="Atau tempel link gambar (https://...)"
            class={input}
          />
          <p class="text-[11px] text-slate-400 mt-1">Bisa langsung upload file foto atau tempel URL link gambar.</p>
        </div>
      </div>

      <!-- Upload Galeri Foto Tambahan -->
      <div class="pt-4 border-t border-slate-100 space-y-3">
        <label for="gallery" class={label}>Galeri Foto Tambahan (Mosaic)</label>

        <input type="file" id="gallery_file_input" accept="image/*" multiple class="hidden" />
        <button
          type="button"
          id="gallery_upload_btn"
          class="w-full py-2.5 px-3 rounded-xl border-2 border-dashed border-slate-300 hover:border-slate-400 bg-slate-50 hover:bg-slate-100 text-slate-700 text-xs font-semibold flex items-center justify-center gap-2 transition cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          <span id="gallery_btn_text">📁 Upload Foto ke Galeri (Bisa Pilih Banyak)</span>
        </button>

        <textarea
          id="gallery"
          name="gallery"
          rows="4"
          placeholder={'https://images.unsplash.com/...\nhttps://images.unsplash.com/...'}
          class={`${input} font-mono text-xs`}
        >{galleryText}</textarea>
        <p class="text-[11px] text-slate-400 mt-1">1 foto per baris. Hasil upload otomatis ditambahkan ke kolom ini.</p>
      </div>

      <!-- Action Buttons -->
      <div class="flex gap-3 pt-4 border-t border-slate-100">
        <a href="/admin/tours" class="flex-1 text-center px-4 py-2.5 rounded-xl border border-slate-200 text-sm font-semibold text-slate-600 hover:bg-slate-50 transition shadow-sm">
          Batal
        </a>
        <button
          type="submit"
          class="flex-1 px-4 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold transition shadow-md shadow-primary-600/20 cursor-pointer text-center"
        >
          {submitLabel}
        </button>
      </div>
    </section>
  </div>
</form>

<script is:inline>
  (function() {
    // 1. Status Toggle Visual Indicator
    const statusRadios = document.querySelectorAll('.status-radio');
    const statusBadge = document.getElementById('status-badge');
    statusRadios.forEach(radio => {
      radio.addEventListener('change', () => {
        if (radio.checked) {
          if (radio.value === 'true') {
            statusBadge.textContent = '🟢 Aktif (Live)';
            statusBadge.className = 'text-[11px] font-bold px-2.5 py-0.5 rounded-full border bg-emerald-50 text-emerald-700 border-emerald-200';
          } else {
            statusBadge.textContent = '⚪ Nonaktif (Diperbarui)';
            statusBadge.className = 'text-[11px] font-bold px-2.5 py-0.5 rounded-full border bg-amber-50 text-amber-700 border-amber-200';
          }
        }
      });
    });

    // 2. Helper Canvas Image Compressor
    function compressImage(file, maxDim, quality) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            let w = img.width;
            let h = img.height;
            if (w > h) {
              if (w > maxDim) {
                h = Math.round((h * maxDim) / w);
                w = maxDim;
              }
            } else {
              if (h > maxDim) {
                w = Math.round((w * maxDim) / h);
                h = maxDim;
              }
            }
            const canvas = document.createElement('canvas');
            canvas.width = w;
            canvas.height = h;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, w, h);
            resolve(canvas.toDataURL('image/jpeg', quality));
          };
          img.onerror = reject;
          img.src = e.target.result;
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    // 3. Thumbnail Live Preview & Upload
    const urlInput = document.getElementById('thumbnail');
    const previewImg = document.getElementById('preview');
    const emptyBox = document.getElementById('preview-empty');
    const thumbUploadBtn = document.getElementById('thumb_upload_btn');
    const thumbFileInput = document.getElementById('thumb_file_input');
    const thumbBtnText = document.getElementById('thumb_btn_text');
    const clearThumbBtn = document.getElementById('clear_thumb_btn');

    function updatePreview(val) {
      const v = (val !== undefined ? val : (urlInput ? urlInput.value : '')).trim();
      if (!v) {
        if (previewImg) previewImg.classList.add('hidden');
        if (emptyBox) emptyBox.classList.remove('hidden');
        if (clearThumbBtn) clearThumbBtn.classList.add('hidden');
        return;
      }
      if (previewImg) previewImg.src = v;
      if (clearThumbBtn) clearThumbBtn.classList.remove('hidden');
    }

    if (previewImg) {
      previewImg.addEventListener('load', () => {
        previewImg.classList.remove('hidden');
        if (emptyBox) emptyBox.classList.add('hidden');
      });
      previewImg.addEventListener('error', () => {
        previewImg.classList.add('hidden');
        if (emptyBox) {
          emptyBox.classList.remove('hidden');
          emptyBox.innerHTML = '<span class="text-xs text-rose-500 font-medium">⚠️ Foto tidak dapat dimuat</span>';
        }
      });
    }

    urlInput?.addEventListener('input', () => updatePreview());

    thumbUploadBtn?.addEventListener('click', () => {
      thumbFileInput?.click();
    });

    thumbFileInput?.addEventListener('change', async (e) => {
      const file = e.target.files?.[0];
      if (!file) return;
      if (!file.type.startsWith('image/')) {
        alert('Silakan pilih file gambar (JPG, PNG, atau WebP).');
        return;
      }
      if (thumbBtnText) thumbBtnText.textContent = '⏳ Mengompres & Memproses...';
      try {
        const compressedDataUrl = await compressImage(file, 1200, 0.85);
        if (urlInput) urlInput.value = compressedDataUrl;
        updatePreview(compressedDataUrl);
      } catch (err) {
        alert('Gagal memproses gambar: ' + err.message);
      } finally {
        if (thumbBtnText) thumbBtnText.textContent = '📁 Ganti Foto dari Komputer / HP';
        thumbFileInput.value = '';
      }
    });

    clearThumbBtn?.addEventListener('click', () => {
      if (urlInput) urlInput.value = '';
      updatePreview('');
    });

    // 4. Gallery Upload Multiple Images
    const galleryUploadBtn = document.getElementById('gallery_upload_btn');
    const galleryFileInput = document.getElementById('gallery_file_input');
    const galleryTextarea = document.getElementById('gallery');
    const galleryBtnText = document.getElementById('gallery_btn_text');

    galleryUploadBtn?.addEventListener('click', () => {
      galleryFileInput?.click();
    });

    galleryFileInput?.addEventListener('change', async (e) => {
      const files = Array.from(e.target.files || []).filter(f => f.type.startsWith('image/'));
      if (files.length === 0) return;

      if (galleryBtnText) galleryBtnText.textContent = `⏳ Memproses ${files.length} foto...`;
      try {
        const results = await Promise.all(files.map(f => compressImage(f, 1200, 0.82)));
        const currentLines = (galleryTextarea?.value || '').split('\n').map(s => s.trim()).filter(Boolean);
        const combined = [...currentLines, ...results];
        if (galleryTextarea) {
          galleryTextarea.value = combined.join('\n');
        }
      } catch (err) {
        alert('Gagal memproses foto galeri: ' + err.message);
      } finally {
        if (galleryBtnText) galleryBtnText.textContent = '📁 Upload Foto ke Galeri (Bisa Pilih Banyak)';
        galleryFileInput.value = '';
      }
    });

    // 5. Auto-Translate Tool (EN -> ID)
    const btnAutoTranslate = document.getElementById('btn-auto-translate');
    const btnUndoTranslate = document.getElementById('btn-undo-translate');
    const translateBtnText = document.getElementById('translate-btn-text');
    const translateIcon = document.getElementById('translate-icon');
    const successBox = document.getElementById('translate-success-box');
    const closeSuccessBox = document.getElementById('close-success-box');

    let backupTexts = null;

    closeSuccessBox?.addEventListener('click', () => {
      successBox?.classList.add('hidden');
    });

    const fieldIds = [
      'title', 'tagline', 'content', 'price_note',
      'booking_perks', 'highlights', 'itinerary',
      'included', 'excluded', 'important_info',
      'pickup_location', 'driver_service_note', 'group_type_note'
    ];

    btnAutoTranslate?.addEventListener('click', async () => {
      const inputs = fieldIds.map(id => document.getElementById(id)).filter(Boolean);
      const textsToTranslate = inputs.map(el => el.value);

      // Pastikan ada teks yang diisi
      if (textsToTranslate.every(t => !t || !t.trim())) {
        alert('Silakan isi judul atau deskripsi paket dalam Bahasa Inggris terlebih dahulu.');
        return;
      }

      // Simpan backup untuk fitur undo
      backupTexts = inputs.map(el => el.value);

      // Tampilkan status loading
      if (translateBtnText) translateBtnText.textContent = 'Sedang Menerjemahkan...';
      if (translateIcon) translateIcon.textContent = '⏳';
      btnAutoTranslate.disabled = true;

      try {
        const res = await fetch('/api/admin/translate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ texts: textsToTranslate, targetLang: 'id' }),
        });

        const data = await res.json();
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'Gagal menerjemahkan');
        }

        // Terapkan hasil terjemahan ke form inputs
        inputs.forEach((el, idx) => {
          if (data.translatedTexts[idx]) {
            el.value = data.translatedTexts[idx];
          }
        });

        // Tampilkan box sukses dan tombol undo
        successBox?.classList.remove('hidden');
        btnUndoTranslate?.classList.remove('hidden');
      } catch (err) {
        alert('Gagal menerjemahkan: ' + err.message);
      } finally {
        if (translateBtnText) translateBtnText.textContent = 'Terjemahkan Ulang';
        if (translateIcon) translateIcon.textContent = '✨';
        btnAutoTranslate.disabled = false;
      }
    });

    btnUndoTranslate?.addEventListener('click', () => {
      if (!backupTexts) return;
      const inputs = fieldIds.map(id => document.getElementById(id)).filter(Boolean);
      inputs.forEach((el, idx) => {
        if (backupTexts[idx] !== undefined) {
          el.value = backupTexts[idx];
        }
      });
      btnUndoTranslate.classList.add('hidden');
      successBox?.classList.add('hidden');
      if (translateBtnText) translateBtnText.textContent = 'Terjemahkan ke Bahasa Indonesia';
    });
  })();
</script>

