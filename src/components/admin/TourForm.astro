  :global(html.dark) .admin-translate-banner {
    background-image: linear-gradient(to right, #0f172a, #1e293b, #0f172a) !important;
    border-color: rgba(20, 184, 166, 0.3) !important;
  }
  :global(html.dark) .admin-translate-banner h4 {
    color: #ffffff !important;
  }
  :global(html.dark) .admin-translate-banner p {
    color: #cbd5e1 !important;
  }
  :global(html.dark) .admin-translate-banner strong {
    color: #5eead4 !important;
  }
  :global(html.dark) #translate-success-box {
    background-color: rgba(6, 78, 59, 0.4) !important;
    border-color: rgba(16, 185, 129, 0.3) !important;
    color: #a7f3d0 !important;
  }
</style>
