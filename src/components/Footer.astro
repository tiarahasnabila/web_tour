---
import { getSiteSettings, formatWhatsAppUrl } from '../lib/settings';

const settings = await getSiteSettings();
const currentYear = new Date().getFullYear();

const navLinks = [
  { name: 'Home',         href: '/' },
  { name: 'Tentang Kami', href: '/tentang-kami' },
  { name: 'Armada',       href: '/layanan' },
  { name: 'Tour Package', href: '/tour-package' },
  { name: 'Galeri',       href: '/galeri' },
  { name: 'Kontak',       href: '/kontak' },
];

const services = [
  { name: 'Rental Mobil Harian', href: '/layanan' },
  { name: 'Rental + Driver',     href: '/layanan' },
  { name: 'Paket Wisata Jogja',  href: '/tour-package' },
  { name: 'Custom Tour',         href: '/tour-package' },
];

const waFooterUrl = formatWhatsAppUrl(settings.whatsapp_number, 'Halo Beyond Jogja Tours! Saya ingin tanya-tanya informasi paket wisata dan rental mobil.');
---

<footer class="bg-navy-950 text-slate-400 border-t border-white/5 relative">
  <!-- Main Footer Body (4 Columns) -->
  <div class="container mx-auto px-4 pt-16 pb-12">
    <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10 lg:gap-10">

      <!-- Brand Column -->
      <div class="col-span-2 lg:col-span-1">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2.5 mb-5 group">
          <img src="/logo.png" alt="Beyond Jogja Tours" class="w-10 h-10 object-contain rounded-full shadow ring-2 ring-white/10 shrink-0" />
          <div class="leading-tight">
            <span class="block text-[15px] font-semibold text-white tracking-tight">{settings.site_title}</span>
            <span class="block text-[9px] font-medium text-primary-400 uppercase tracking-[0.15em] -mt-0.5">Tours & Rental</span>
          </div>
        </a>
        <p class="text-sm text-slate-500 leading-relaxed mb-6">
          Penyedia jasa rental mobil dan paket wisata terpercaya di Yogyakarta. Aman, nyaman, harga bersahabat.
        </p>

        <!-- Social Media & Contact Icons -->
        <div>
          <p class="text-xs text-slate-600 font-medium uppercase tracking-widest mb-3">Sosial Media & Chat :</p>
          <div class="flex items-center gap-2.5">
            <!-- Instagram -->
            <a href={settings.instagram_url} target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram"
              class="w-9 h-9 rounded-xl bg-white/5 hover:bg-primary-600 border border-white/8 hover:border-primary-600 flex items-center justify-center text-slate-400 hover:text-white transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
              </svg>
            </a>

            <!-- WhatsApp Icon Button (Sejajar dengan Instagram) -->
            <a href={waFooterUrl} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" title="Chat via WhatsApp"
              class="w-9 h-9 rounded-xl bg-white/5 hover:bg-emerald-600 border border-white/8 hover:border-emerald-600 flex items-center justify-center text-slate-400 hover:text-white transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.086 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Navigasi -->
      <div class="col-span-1">
        <h4 class="text-white font-semibold text-xs uppercase tracking-widest mb-5 pb-3 border-b border-white/8">Navigasi</h4>
        <ul class="space-y-3">
          {navLinks.map(link => (
            <li>
              <a href={link.href} class="text-slate-500 hover:text-primary-400 text-sm transition-colors flex items-center gap-2 group">
                <span class="w-1 h-1 rounded-full bg-slate-700 group-hover:bg-primary-500 transition-colors shrink-0"></span>
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Layanan -->
      <div class="col-span-1">
        <h4 class="text-white font-semibold text-xs uppercase tracking-widest mb-5 pb-3 border-b border-white/8">Layanan</h4>
        <ul class="space-y-3">
          {services.map(s => (
            <li>
              <a href={s.href} class="text-slate-500 hover:text-primary-400 text-sm transition-colors flex items-center gap-2 group">
                <span class="w-1 h-1 rounded-full bg-slate-700 group-hover:bg-primary-500 transition-colors shrink-0"></span>
                {s.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Kontak -->
      <div class="col-span-2 lg:col-span-1">
        <h4 class="text-white font-semibold text-xs uppercase tracking-widest mb-5 pb-3 border-b border-white/8">Kontak Kami</h4>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <span class="text-primary-400 text-base shrink-0 mt-0.5">📍</span>
            <span class="text-sm leading-relaxed text-slate-500">{settings.office_address}</span>
          </li>
          <li>
            <a href={`tel:${settings.phone_number.replace(/\s+/g,'')}`} class="flex items-center gap-3 hover:text-white transition-colors group">
              <span class="text-primary-400 text-base shrink-0">📞</span>
              <span class="text-sm text-slate-500 group-hover:text-primary-300 transition-colors">{settings.phone_number}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${settings.email_address}`} class="flex items-center gap-3 hover:text-white transition-colors group">
              <span class="text-primary-400 text-base shrink-0">✉️</span>
              <span class="text-sm text-slate-500 group-hover:text-primary-300 transition-colors">{settings.email_address}</span>
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Official Partner Strip (Di dalam Footer, rapi & tidak nabrak) -->
    <div class="mt-12 pt-8 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-5">
      <div class="flex items-center gap-3.5 text-center sm:text-left">
        <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 text-primary-400 flex items-center justify-center text-xl shrink-0">
          🌍
        </div>
        <div>
          <span class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-widest text-primary-400 mb-0.5">
            <span class="w-1.5 h-1.5 rounded-full bg-primary-400 animate-pulse"></span>
            Official Partner
          </span>
          <h4 class="text-sm sm:text-base font-bold text-white">
            Beyond Jogja Tours is Officially Listed on GetYourGuide
          </h4>
          <p class="text-xs text-slate-400 mt-0.5">
            Terverifikasi melayani wisatawan mancanegara & domestik dengan standar pelayanan bintang 5.
          </p>
        </div>
      </div>

      <div class="shrink-0">
        <a 
          href="https://www.getyourguide.com/-s813749" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:scale-105 transition-transform duration-200 inline-block shadow-sm rounded-xl overflow-hidden"
        >
          <img 
            src="https://gyg.me/DFO5LFuz" 
            width="140" 
            height="auto" 
            class="rounded-xl border border-white/10 shadow-sm" 
            alt="GetYourGuide | Beyond Jogja Journeys" 
          />
        </a>
      </div>
    </div>
  </div>

  <!-- Divider & Copyright -->
  <div class="border-t border-white/5">
    <div class="container mx-auto px-4 py-6 flex flex-col justify-center items-center gap-1.5 text-xs text-slate-600 text-center">
      <p>&copy; {currentYear} <span class="text-slate-500 font-medium">{settings.site_title}</span>. All rights reserved.</p>
    </div>
  </div>
</footer>
