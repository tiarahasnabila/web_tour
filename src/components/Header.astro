---
import { getWhatsAppUrl, PHONE_NUMBER } from '../lib/constants';

const navLinks = [
  { name: 'Home',         href: '/' },
  { name: 'Tentang Kami', href: '/tentang-kami' },
  { name: 'Armada',       href: '/layanan' },
  { name: 'Tour Package', href: '/tour-package' },
  { name: 'Kontak',       href: '/kontak' },
];

const currentPath = Astro.url.pathname;
const isLinkActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
};
---

<!-- Ticker Bar -->
<div class="fixed top-0 left-0 right-0 z-[60] w-full bg-primary-600 text-white py-2 overflow-hidden shadow-sm">
  <div class="animate-marquee whitespace-nowrap text-[10px] md:text-xs font-bold tracking-[0.2em] uppercase flex w-max items-center">
    <!-- First half -->
    <div class="flex items-center">
      <span class="mx-4">Sewa Mobil</span> &bull; <span class="mx-4">Paket Wisata</span> &bull; <span class="mx-4">Lepas Kunci</span> &bull; <span class="mx-4">Driver Berpengalaman</span> &bull; 
      <span class="mx-4">Sewa Mobil</span> &bull; <span class="mx-4">Paket Wisata</span> &bull; <span class="mx-4">Lepas Kunci</span> &bull; <span class="mx-4">Driver Berpengalaman</span> &bull; 
    </div>
    <!-- Second half (duplicate for smooth loop) -->
    <div class="flex items-center">
      <span class="mx-4">Sewa Mobil</span> &bull; <span class="mx-4">Paket Wisata</span> &bull; <span class="mx-4">Lepas Kunci</span> &bull; <span class="mx-4">Driver Berpengalaman</span> &bull; 
      <span class="mx-4">Sewa Mobil</span> &bull; <span class="mx-4">Paket Wisata</span> &bull; <span class="mx-4">Lepas Kunci</span> &bull; <span class="mx-4">Driver Berpengalaman</span> &bull; 
    </div>
  </div>
</div>

<header class="fixed top-12 left-0 right-0 z-50 w-full px-4 pointer-events-none transition-all duration-300" id="main-header">
  <div id="navbar" class="container mx-auto max-w-6xl bg-white/75 dark:bg-navy-900/80 backdrop-blur-2xl border border-slate-200/60 dark:border-white/8 shadow-[0_4px_24px_rgba(0,0,0,0.06)] rounded-full pointer-events-auto transition-all duration-500">
    <nav class="px-5 py-2.5">
      <div class="flex justify-between items-center">

        <!-- Logo -->
        <a href="/" class="flex items-center gap-2.5 group">
          <img src="/logo.png" alt="Beyond Jogja Tours" class="w-10 h-10 object-contain rounded-full shadow-sm ring-2 ring-slate-200 dark:ring-white/10" />
          <div class="leading-tight">
            <span class="block text-[15px] font-semibold text-slate-900 dark:text-white tracking-tight">Beyond Jogja</span>
            <span class="block text-[9px] font-medium text-primary-600 uppercase tracking-[0.15em] -mt-0.5">Tours & Rental</span>
          </div>
        </a>

        <!-- Desktop Nav -->
        <div class="hidden lg:flex items-center gap-8">
          <ul class="flex gap-6">
            {navLinks.map(link => {
              const active = isLinkActive(link.href);
              return (
                <li>
                  <a 
                    href={link.href} 
                    data-astro-prefetch="load" 
                    class={`font-medium text-[13px] tracking-wide transition-colors duration-200 relative group py-1 ${
                      active 
                        ? 'text-primary-600 dark:text-primary-400 font-semibold' 
                        : 'text-slate-500 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white'
                    }`}
                  >
                    {link.name}
                    <span class={`absolute -bottom-1 left-0 h-[2px] bg-primary-500 rounded-full transition-all duration-300 ${
                      active ? 'w-full' : 'w-0 group-hover:w-full'
                    }`}></span>
                  </a>
                </li>
              );
            })}
          </ul>

          <!-- Open Hours Badge -->
          <div class="group flex items-center text-xs font-medium text-emerald-700 bg-emerald-50/80 border border-emerald-200/60 p-2 rounded-full backdrop-blur-sm cursor-default transition-all duration-300 ease-in-out hover:px-3">
            <span class="relative flex h-2 w-2 shrink-0">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span class="max-w-0 overflow-hidden whitespace-nowrap opacity-0 group-hover:max-w-[150px] group-hover:opacity-100 group-hover:ml-2 transition-all duration-300 ease-in-out">
              Buka 07:00–22:00
            </span>
          </div>

          <div class="flex items-center gap-3 border-r border-slate-200 dark:border-white/10 pr-4">
            <!-- Desktop Theme Toggle -->
            <button class="theme-toggle p-2 text-slate-400 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-white/10 rounded-full focus:outline-none transition-colors" aria-label="Toggle Dark Mode">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 icon-sun hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 icon-moon block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
              </svg>
            </button>
            <a
              href={getWhatsAppUrl("Halo, saya ingin bertanya tentang layanan Beyond Jogja Tours")}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-primary-600 text-white px-5 py-2 rounded-full font-semibold text-sm hover:bg-primary-700 hover:shadow-lg hover:shadow-primary-500/20 hover:-translate-y-0.5 transition-all duration-300"
            >
              Booking Sekarang
            </a>
          </div>
        </div>

        <div class="flex items-center gap-2 lg:hidden">
          <!-- Mobile Theme Toggle -->
          <button class="theme-toggle p-2 text-slate-500 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/10 rounded-lg focus:outline-none transition-colors" aria-label="Toggle Dark Mode">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 icon-sun hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 icon-moon block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
          
          <!-- Mobile menu button -->
          <button id="mobile-menu-btn" class="text-slate-700 dark:text-white p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-white/10 focus:outline-none">
            <svg id="icon-open"  xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Nav -->
      <div id="mobile-menu" class="hidden lg:hidden mt-4 pb-4 border-t border-slate-100 dark:border-white/8 pt-4">
        <ul class="flex flex-col gap-2">
          {navLinks.map(link => {
            const active = isLinkActive(link.href);
            return (
              <li>
                <a 
                  href={link.href} 
                  data-astro-prefetch="load" 
                  class={`flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm transition-all active:scale-[0.98] ${
                    active 
                      ? 'bg-primary-500/10 dark:bg-primary-500/20 text-primary-600 dark:text-primary-400 font-bold border border-primary-500/20 shadow-xs' 
                      : 'text-slate-600 dark:text-slate-300 hover:text-primary-600 dark:hover:text-primary-400 hover:bg-slate-100 dark:hover:bg-white/5 font-medium'
                  }`}
                >
                  <span>{link.name}</span>
                  {active && (
                    <span class="w-1.5 h-1.5 rounded-full bg-primary-500 dark:bg-primary-400"></span>
                  )}
                </a>
              </li>
            );
          })}
          <li class="mt-3">
            <a
              href={getWhatsAppUrl("Halo, saya ingin bertanya tentang layanan Beyond Jogja Tours")}
              target="_blank"
              rel="noopener noreferrer"
              class="block text-center bg-primary-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-primary-700 transition-colors shadow-sm"
            >
              Booking Sekarang
            </a>
          </li>
        </ul>
      </div>
    </nav>
  </div>
</header>

<script>
  let isScrollListenerAdded = false;

  const initHeader = () => {
    const navbar    = document.getElementById('navbar');
    const btn       = document.getElementById('mobile-menu-btn');
    const menu      = document.getElementById('mobile-menu');
    const iconOpen  = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');

    if (btn && menu) {
      btn.onclick = (e) => {
        e.stopPropagation();
        const isHidden = menu.classList.contains('hidden');
        menu.classList.toggle('hidden', !isHidden);
        iconOpen?.classList.toggle('hidden', isHidden);
        iconClose?.classList.toggle('hidden', !isHidden);
        navbar?.classList.toggle('rounded-full', !isHidden);
        navbar?.classList.toggle('rounded-2xl', isHidden);
      };

      // Close menu immediately when clicking any navigation link
      menu.querySelectorAll('a').forEach((link) => {
        link.onclick = () => {
          menu.classList.add('hidden');
          iconOpen?.classList.remove('hidden');
          iconClose?.classList.add('hidden');
          navbar?.classList.add('rounded-full');
          navbar?.classList.remove('rounded-2xl');
        };
      });
    }

    // Close menu when clicking outside
    document.onclick = (e) => {
      const currentNavbar = document.getElementById('navbar');
      const currentMenu   = document.getElementById('mobile-menu');
      if (currentNavbar && currentMenu && !currentNavbar.contains(e.target as Node) && !currentMenu.classList.contains('hidden')) {
        currentMenu.classList.add('hidden');
        document.getElementById('icon-open')?.classList.remove('hidden');
        document.getElementById('icon-close')?.classList.add('hidden');
        currentNavbar.classList.add('rounded-full');
        currentNavbar.classList.remove('rounded-2xl');
      }
    };

    const handleThemeToggle = () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
    };

    document.querySelectorAll('.theme-toggle').forEach((btn) => {
      (btn as HTMLButtonElement).onclick = handleThemeToggle;
    });

    if (!isScrollListenerAdded) {
      window.addEventListener('scroll', () => {
        const currentNavbar = document.getElementById('navbar');
        if (window.scrollY > 20) {
          currentNavbar?.classList.remove('bg-white/75', 'dark:bg-navy-900/80', 'shadow-[0_4px_24px_rgba(0,0,0,0.06)]', 'border-slate-200/60');
          currentNavbar?.classList.add('bg-white/92', 'dark:bg-navy-900/95', 'shadow-[0_4px_24px_rgba(0,0,0,0.10)]', 'border-slate-200/80', 'backdrop-blur-3xl');
        } else {
          currentNavbar?.classList.add('bg-white/75', 'dark:bg-navy-900/80', 'shadow-[0_4px_24px_rgba(0,0,0,0.06)]', 'border-slate-200/60');
          currentNavbar?.classList.remove('bg-white/92', 'dark:bg-navy-900/95', 'shadow-[0_4px_24px_rgba(0,0,0,0.10)]', 'border-slate-200/80', 'backdrop-blur-3xl');
        }
      }, { passive: true });
      isScrollListenerAdded = true;
    }
  };

  // Run on initial load and subsequent Astro page loads
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader);
  } else {
    initHeader();
  }
  document.addEventListener('astro:page-load', initHeader);
</script>
