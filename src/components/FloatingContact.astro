---
import { getWhatsAppUrl, PHONE_NUMBER } from '../lib/constants';

const funnyMessages = [
  "Psst... mau liburan? 👀",
  "Yuk gas ke Jogja! 🚗💨",
  "Driver kita asik banget lho! 😎",
  "Udah tau mau ke mana belum? 🗺️",
  "Jangan bengong, chat aja! 😄",
  "Mobil udah siap, kamu kapan? 🔑",
  "Cuss Borobudur bareng kita! 🏛️",
  "Healing time! 🌿✨",
  "Mau sewa Hiace buat rombongan? 🚐",
  "Pusing mikirin itinerary? Sini dibantu 📝",
  "Banyak promo menanti lho! 🎉",
  "Cuaca Jogja lagi enak nih buat jalan ☀️",
  "Tanya-tanya gratis kok, gass! 💬"
];
---

<div class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-3">

  <!-- Fun speech bubble -->
  <div id="speech-bubble" class="relative max-w-[180px] opacity-0 translate-y-2 pointer-events-none transition-all duration-500">
    <div class="bg-white dark:bg-navy-900 text-navy-900 dark:text-white text-xs font-bold px-4 py-2.5 rounded-2xl rounded-br-none shadow-xl border border-gray-100 dark:border-white/10 leading-snug" id="bubble-text">
      Psst... mau liburan? 👀
    </div>
    <!-- Tail -->
    <div class="absolute -bottom-2 right-3 w-0 h-0 border-l-[8px] border-l-transparent border-r-[0px] border-t-[8px] border-t-white dark:border-t-navy-900 filter drop-shadow-sm"></div>
  </div>


  <!-- WhatsApp button — bouncy + glowing -->
  <div class="relative group" id="wa-wrapper">
    <!-- Glow ring -->
    <div class="absolute inset-0 rounded-full bg-green-400 opacity-30 animate-ping"></div>
    <!-- Button -->
    <a
      href={getWhatsAppUrl("Halo Beyond Jogja Tours! 👋")}
      target="_blank"
      rel="noopener noreferrer"
      id="wa-btn"
      class="relative z-10 w-14 h-14 rounded-full bg-gradient-to-br from-green-500 to-green-400 text-white flex items-center justify-center shadow-[0_8px_25px_-5px_rgba(34,197,94,0.6)] hover:scale-110 hover:-translate-y-1 transition-all duration-300 animate-bounce-slow"
      aria-label="Chat WhatsApp"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.086 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
      </svg>
    </a>
  </div>
</div>

<style>
  @keyframes bounceSlow {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-6px); }
  }
  .animate-bounce-slow {
    animation: bounceSlow 2.4s ease-in-out infinite;
  }
</style>

<script define:vars={{ funnyMessages }}>
  function initFloatingWA() {
    const bubble    = document.getElementById('speech-bubble');
    const bubbleTxt = document.getElementById('bubble-text');
    const waWrapper = document.getElementById('wa-wrapper');

    if (!bubble || !bubbleTxt || !waWrapper) return;

    let msgIndex = 0;
    let hideTimer = null;
    let cycleTimer = null;

    function showBubble(text) {
      if (bubbleTxt) bubbleTxt.textContent = text;
      bubble?.classList.remove('opacity-0', 'translate-y-2');
      bubble?.classList.add('opacity-100', 'translate-y-0');
    }

    function hideBubble() {
      bubble?.classList.add('opacity-0', 'translate-y-2');
      bubble?.classList.remove('opacity-100', 'translate-y-0');
    }

    function cycleBubble() {
      msgIndex = (msgIndex + 1) % funnyMessages.length;
      showBubble(funnyMessages[msgIndex]);
      clearTimeout(hideTimer);
      hideTimer = setTimeout(hideBubble, 3500);
    }

    // Clear existing timers on page reload to avoid duplicates
    if (window.waCycleTimer) clearInterval(window.waCycleTimer);
    if (window.waHideTimer) clearTimeout(window.waHideTimer);

    // Show after 1.5s on load
    setTimeout(() => {
      showBubble(funnyMessages[0]);
      window.waHideTimer = setTimeout(hideBubble, 3500);
      // Then cycle every 7s
      window.waCycleTimer = setInterval(cycleBubble, 7000);
    }, 1500);

    // Show on hover
    waWrapper.addEventListener('mouseenter', () => {
      clearTimeout(window.waHideTimer);
      showBubble(funnyMessages[msgIndex]);
    });
    waWrapper.addEventListener('mouseleave', () => {
      window.waHideTimer = setTimeout(hideBubble, 2000);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFloatingWA);
  } else {
    initFloatingWA();
  }
</script>
