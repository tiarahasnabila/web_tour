---
// LanguageSwitcher.astro - Switcher Bahasa Indonesia & English
interface Props {
  isMobile?: boolean;
}
const { isMobile = false } = Astro.props;
---

<div class={`lang-switcher-container relative inline-block text-left ${isMobile ? 'text-xs' : 'text-xs'}`}>
  <!-- Trigger Button -->
  <button
    type="button"
    class="lang-switcher-btn flex items-center gap-1.5 px-2.5 py-1.5 rounded-full border border-slate-200/80 dark:border-white/10 bg-slate-100/80 dark:bg-white/5 hover:bg-slate-200/70 dark:hover:bg-white/10 text-slate-700 dark:text-slate-200 font-semibold transition-all cursor-pointer shadow-xs focus:outline-none"
    aria-label="Pilih Bahasa / Select Language"
    title="Pilih Bahasa / Select Language"
  >
    <span class="lang-flag text-sm">🇮🇩</span>
    <span class="lang-code font-bold uppercase tracking-wider text-[11px]">ID</span>
    <svg class="w-3 h-3 text-slate-400 transition-transform duration-200 lang-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div class="lang-dropdown hidden absolute right-0 mt-2 w-44 rounded-2xl bg-white dark:bg-navy-900 border border-slate-200 dark:border-white/10 shadow-xl py-1.5 z-[100] backdrop-blur-xl animate-in fade-in zoom-in-95 duration-150">
    <div class="px-3 py-1.5 border-b border-slate-100 dark:border-white/5 text-[10px] font-bold uppercase tracking-wider text-slate-400">
      Pilih Bahasa / Language
    </div>

    <!-- Option: Indonesia -->
    <button
      type="button"
      data-lang="id"
      class="lang-option w-full flex items-center justify-between px-3.5 py-2 text-left text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-primary-50 dark:hover:bg-primary-500/10 hover:text-primary-600 dark:hover:text-primary-400 transition-colors cursor-pointer"
    >
      <span class="flex items-center gap-2">
        <span class="text-base">🇮🇩</span>
        <span>Bahasa Indonesia</span>
      </span>
      <span class="check-icon-id text-primary-600 dark:text-primary-400 font-bold hidden">✓</span>
    </button>

    <!-- Option: English -->
    <button
      type="button"
      data-lang="en"
      class="lang-option w-full flex items-center justify-between px-3.5 py-2 text-left text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-primary-50 dark:hover:bg-primary-500/10 hover:text-primary-600 dark:hover:text-primary-400 transition-colors cursor-pointer"
    >
      <span class="flex items-center gap-2">
        <span class="text-base">🇬🇧</span>
        <span>English</span>
      </span>
      <span class="check-icon-en text-primary-600 dark:text-primary-400 font-bold hidden">✓</span>
    </button>
  </div>
</div>

<script>
  function setupLanguageSwitcher() {
    // 1. Get current language from cookie or localStorage (default: 'id')
    function getCurrentLang() {
      const match = document.cookie.match(/googtrans=\/id\/([a-z]{2})/i);
      if (match && match[1]) {
        return match[1].toLowerCase();
      }
      return localStorage.getItem('beyondjogja_lang') || 'id';
    }

    function updateUI(lang: string) {
      document.querySelectorAll('.lang-switcher-container').forEach((container) => {
        const flagEl = container.querySelector('.lang-flag');
        const codeEl = container.querySelector('.lang-code');
        const checkId = container.querySelector('.check-icon-id');
        const checkEn = container.querySelector('.check-icon-en');

        if (lang === 'en') {
          if (flagEl) flagEl.textContent = '🇬🇧';
          if (codeEl) codeEl.textContent = 'EN';
          checkId?.classList.add('hidden');
          checkEn?.classList.remove('hidden');
        } else {
          if (flagEl) flagEl.textContent = '🇮🇩';
          if (codeEl) codeEl.textContent = 'ID';
          checkId?.classList.remove('hidden');
          checkEn?.classList.add('hidden');
        }
      });
    }

    function changeLanguage(lang: string) {
      const current = getCurrentLang();
      if (current === lang) return;

      localStorage.setItem('beyondjogja_lang', lang);

      // Set cookie googtrans
      const domain = window.location.hostname;
      const targetVal = lang === 'en' ? '/id/en' : '/id/id';

      // Set for root path and root domain
      document.cookie = `googtrans=${targetVal}; path=/;`;
      document.cookie = `googtrans=${targetVal}; path=/; domain=${domain};`;

      // Try triggering change on Google Translate combo if available
      const select = document.querySelector<HTMLSelectElement>('.goog-te-combo');
      if (select) {
        select.value = lang;
        select.dispatchEvent(new Event('change'));
      }

      updateUI(lang);

      // Reload to ensure full and clean translation across all elements
      setTimeout(() => {
        window.location.reload();
      }, 150);
    }

    // Toggle dropdown
    document.querySelectorAll('.lang-switcher-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const container = btn.closest('.lang-switcher-container');
        const dropdown = container?.querySelector('.lang-dropdown');
        const chevron = container?.querySelector('.lang-chevron');

        const isHidden = dropdown?.classList.contains('hidden');

        // Close all other dropdowns
        document.querySelectorAll('.lang-dropdown').forEach((d) => d.classList.add('hidden'));
        document.querySelectorAll('.lang-chevron').forEach((c) => c.classList.remove('rotate-180'));

        if (isHidden) {
          dropdown?.classList.remove('hidden');
          chevron?.classList.add('rotate-180');
        }
      });
    });

    // Handle option click
    document.querySelectorAll('.lang-option').forEach((opt) => {
      opt.addEventListener('click', (e) => {
        e.stopPropagation();
        const lang = opt.getAttribute('data-lang');
        if (lang) {
          changeLanguage(lang);
        }
        document.querySelectorAll('.lang-dropdown').forEach((d) => d.classList.add('hidden'));
        document.querySelectorAll('.lang-chevron').forEach((c) => c.classList.remove('rotate-180'));
      });
    });

    // Close on click outside
    document.addEventListener('click', () => {
      document.querySelectorAll('.lang-dropdown').forEach((d) => d.classList.add('hidden'));
      document.querySelectorAll('.lang-chevron').forEach((c) => c.classList.remove('rotate-180'));
    });

    // Init UI
    const currentLang = getCurrentLang();
    updateUI(currentLang);
  }

  // Setup on initial load & Astro ViewTransitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupLanguageSwitcher);
  } else {
    setupLanguageSwitcher();
  }
  document.addEventListener('astro:page-load', setupLanguageSwitcher);
</script>
