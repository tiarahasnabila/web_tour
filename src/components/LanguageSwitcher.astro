---
// LanguageSwitcher.astro - 1-Click Segmented Toggle (ID / EN)
interface Props {
  isMobile?: boolean;
}
const { isMobile = false } = Astro.props;
---

<div class={`lang-pill-container inline-flex items-center rounded-full bg-slate-100 dark:bg-white/10 p-0.5 border border-slate-200/80 dark:border-white/10 shadow-xs ${isMobile ? 'scale-90 origin-right' : ''}`}>
  <!-- Tombol ID -->
  <button
    type="button"
    data-lang="id"
    class="lang-pill-btn lang-btn-id flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold transition-all duration-200 cursor-pointer focus:outline-none"
    title="Bahasa Indonesia"
    aria-label="Bahasa Indonesia"
  >
    <span>🇮🇩</span>
    <span>ID</span>
  </button>

  <!-- Tombol EN -->
  <button
    type="button"
    data-lang="en"
    class="lang-pill-btn lang-btn-en flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold transition-all duration-200 cursor-pointer focus:outline-none text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white"
    title="English"
    aria-label="English"
  >
    <span>🇬🇧</span>
    <span>EN</span>
  </button>
</div>

<script>
  function initLanguagePill() {
    function getStoredLang(): 'id' | 'en' {
      const cookieMatch = document.cookie.match(/googtrans=\/id\/([a-z]{2})/i);
      if (cookieMatch && cookieMatch[1]) {
        return cookieMatch[1].toLowerCase() === 'en' ? 'en' : 'id';
      }
      return (localStorage.getItem('beyondjogja_lang') as 'id' | 'en') || 'id';
    }

    function updatePillStyles(lang: 'id' | 'en') {
      document.querySelectorAll('.lang-pill-container').forEach((container) => {
        const btnId = container.querySelector<HTMLButtonElement>('.lang-btn-id');
        const btnEn = container.querySelector<HTMLButtonElement>('.lang-btn-en');

        const activeClasses = ['bg-white', 'dark:bg-navy-800', 'text-primary-600', 'dark:text-primary-400', 'shadow-xs'];
        const inactiveClasses = ['text-slate-500', 'dark:text-slate-400', 'hover:text-slate-900', 'dark:hover:text-white'];

        if (lang === 'en') {
          btnEn?.classList.add(...activeClasses);
          btnEn?.classList.remove(...inactiveClasses);

          btnId?.classList.remove(...activeClasses);
          btnId?.classList.add(...inactiveClasses);
        } else {
          btnId?.classList.add(...activeClasses);
          btnId?.classList.remove(...inactiveClasses);

          btnEn?.classList.remove(...activeClasses);
          btnEn?.classList.add(...inactiveClasses);
        }
      });
    }

    function applyGoogleTranslate(targetLang: 'id' | 'en') {
      const host = window.location.hostname;
      const parts = host.split('.');
      const rootDomain = parts.length > 2 ? '.' + parts.slice(-2).join('.') : host;

      if (targetLang === 'en') {
        localStorage.setItem('beyondjogja_lang', 'en');
        document.cookie = `googtrans=/id/en; path=/;`;
        document.cookie = `googtrans=/id/en; path=/; domain=${host};`;
        if (rootDomain !== host) {
          document.cookie = `googtrans=/id/en; path=/; domain=${rootDomain};`;
        }
      } else {
        localStorage.setItem('beyondjogja_lang', 'id');
        const past = 'Thu, 01 Jan 1970 00:00:00 UTC';
        document.cookie = `googtrans=; expires=${past}; path=/;`;
        document.cookie = `googtrans=; expires=${past}; path=/; domain=${host};`;
        document.cookie = `googtrans=; expires=${past}; path=/; domain=${rootDomain};`;
        document.cookie = `googtrans=/id/id; path=/;`;
      }

      // Cari elemen combo Google Translate
      let attempts = 0;
      const interval = setInterval(() => {
        attempts++;
        const select = document.querySelector<HTMLSelectElement>('.goog-te-combo');
        if (select) {
          clearInterval(interval);
          select.value = targetLang === 'en' ? 'en' : 'id';
          select.dispatchEvent(new Event('change'));

          // Jika pindah kembali ke 'id', reload agar teks asli kembali 100% sempurna
          if (targetLang === 'id') {
            setTimeout(() => {
              window.location.reload();
            }, 100);
          }
        } else if (attempts > 8) {
          clearInterval(interval);
          // Jika combo belum siap di DOM, reload saat itu juga agar cookie membaca bahasa baru
          window.location.reload();
        }
      }, 50);
    }

    // Attach click listeners ke tombol pill
    document.querySelectorAll('.lang-pill-btn').forEach((btn) => {
      btn.onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        const target = btn.getAttribute('data-lang') as 'id' | 'en';
        const current = getStoredLang();
        if (target !== current) {
          updatePillStyles(target);
          applyGoogleTranslate(target);
        }
      };
    });

    // Inisialisasi tampilan awal
    const currentLang = getStoredLang();
    updatePillStyles(currentLang);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLanguagePill);
  } else {
    initLanguagePill();
  }
  document.addEventListener('astro:page-load', initLanguagePill);
</script>
