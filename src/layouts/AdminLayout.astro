---
import { verifySessionToken } from '../lib/auth';
import { sql } from '../lib/db';

interface Props {
  title: string;
  active?: 'dashboard' | 'tours' | 'cars' | 'inquiries' | 'testimonials' | 'users' | 'settings' | 'profile';
}

const { title, active = 'dashboard' } = Astro.props;

// Proteksi utama ada di middleware & tiap halaman; ini hanya untuk menampilkan nama user
const user = verifySessionToken(Astro.cookies.get('admin_session')?.value);
const username = user?.username ?? 'admin';

let displayName = username;
let avatarUrl = '';
let newInquiriesCount = 0;

try {
  const [adminRows, inqRows] = await Promise.all([
    sql`SELECT display_name, avatar_url FROM admins WHERE username = ${username} LIMIT 1;`,
    sql`SELECT count(*) as count FROM inquiries WHERE status = 'baru';`,
  ]);
  if (adminRows[0]?.display_name) displayName = adminRows[0].display_name;
  if (adminRows[0]?.avatar_url) avatarUrl = adminRows[0].avatar_url;
  newInquiriesCount = Number(inqRows[0]?.count || 0);
} catch {
  // fallback
}
const initials = displayName.split(/\s+/).map((w: string) => w[0]).join('').slice(0, 2).toUpperCase();

const nav = [
  { key: 'dashboard', label: 'Dashboard', href: '/admin', icon: 'M4 5a1 1 0 011-1h5a1 1 0 011 1v5a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm9 0a1 1 0 011-1h5a1 1 0 011 1v3a1 1 0 01-1 1h-5a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h5a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zm9-3a1 1 0 011-1h5a1 1 0 011 1v7a1 1 0 01-1 1h-5a1 1 0 01-1-1v-7z' },
  { key: 'tours', label: 'Paket Wisata', href: '/admin/tours', icon: 'M3 7l9-4 9 4-9 4-9-4zm0 5l9 4 9-4M3 17l9 4 9-4' },
  { key: 'cars', label: 'Armada Mobil', href: '/admin/cars', icon: 'M5 17h-.5A1.5 1.5 0 013 15.5V12l2-5h14l2 5v3.5a1.5 1.5 0 01-1.5 1.5H19M7 17a2 2 0 104 0 2 2 0 00-4 0zm6 0a2 2 0 104 0 2 2 0 00-4 0' },
  { key: 'inquiries', label: 'Pesan Leads', href: '/admin/inquiries', icon: 'M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z', badge: newInquiriesCount },
  { key: 'testimonials', label: 'Testimoni', href: '/admin/testimonials', icon: 'M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z' },
  { key: 'users', label: 'Kelola Admin', href: '/admin/users', icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z' },
  { key: 'settings', label: 'Pengaturan Web', href: '/admin/settings', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z' },
];
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title} — Admin Beyond Jogja Tours</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  
  <!-- Inisialisasi status sidebar & tema sebelum render agar tidak "berkedip" -->
  <script is:inline>
    if (localStorage.getItem('admin-sidebar') === 'collapsed') {
      document.documentElement.dataset.sidebar = 'collapsed';
    }
    const savedTheme = localStorage.getItem('admin-theme');
    if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
  <style is:global>
    #sidebar, #content { transition: width .2s ease, padding-left .2s ease, transform .2s ease; }
    @media (min-width: 1024px) {
      html[data-sidebar='collapsed'] #sidebar { width: 5rem; }
      html[data-sidebar='collapsed'] #content { padding-left: 5rem; }
      html[data-sidebar='collapsed'] .sb-label { display: none; }
      html[data-sidebar='collapsed'] .sb-item { justify-content: center; padding-left: 0; padding-right: 0; }
      html[data-sidebar='collapsed'] .sb-brand { justify-content: center; padding-left: 0; padding-right: 0; }
      html[data-sidebar='collapsed'] .sb-collapse-icon { transform: rotate(180deg); }
    }

    /* Penyesuaian Global Mode Gelap (Dark Mode) Panel Admin */
    html.dark {
      color-scheme: dark;
    }
    html.dark body {
      background-color: #020617;
      color: #f1f5f9;
    }
    html.dark header {
      background-color: rgba(15, 23, 42, 0.88) !important;
      border-color: #1e293b !important;
    }
    html.dark header h2 {
      color: #ffffff !important;
    }
    html.dark header button#menu-btn {
      color: #cbd5e1 !important;
    }
    html.dark header button#menu-btn:hover {
      background-color: #1e293b !important;
    }
    html.dark .bg-white {
      background-color: #0f172a !important;
      border-color: #1e293b !important;
      color: #f1f5f9;
    }
    html.dark .bg-slate-50 {
      background-color: #020617 !important;
    }
    html.dark .bg-slate-50\/80,
    html.dark .bg-slate-50\/60 {
      background-color: #0b1120 !important;
    }
    html.dark .bg-slate-100 {
      background-color: #1e293b !important;
      color: #cbd5e1 !important;
    }
    html.dark .border-slate-200,
    html.dark .border-slate-200\/80,
    html.dark .border-slate-100,
    html.dark .divide-slate-100 > :not([hidden]) ~ :not([hidden]),
    html.dark .divide-slate-200 > :not([hidden]) ~ :not([hidden]) {
      border-color: #1e293b !important;
    }
    html.dark .border-slate-300 {
      border-color: #334155 !important;
    }
    html.dark .text-slate-900 {
      color: #ffffff !important;
    }
    html.dark .text-slate-800 {
      color: #f8fafc !important;
    }
    html.dark .text-slate-700 {
      color: #e2e8f0 !important;
    }
    html.dark .text-slate-600 {
      color: #cbd5e1 !important;
    }
    html.dark .text-slate-500 {
      color: #94a3b8 !important;
    }
    html.dark .text-slate-400 {
      color: #64748b !important;
    }
    html.dark input:not([type="checkbox"]):not([type="radio"]):not([type="submit"]):not([type="button"]):not([type="file"]),
    html.dark textarea,
    html.dark select {
      background-color: #1e293b !important;
      border-color: #334155 !important;
      color: #f8fafc !important;
    }
    html.dark input::placeholder,
    html.dark textarea::placeholder {
      color: #64748b !important;
    }
    html.dark .hover\:bg-slate-50:hover,
    html.dark .hover\:bg-slate-50\/60:hover,
    html.dark .hover\:bg-slate-100:hover {
      background-color: #1e293b !important;
    }
    html.dark table thead tr {
      background-color: #1e293b !important;
      border-color: #334155 !important;
    }
    html.dark table thead th {
      color: #94a3b8 !important;
    }
    html.dark #delete-modal-card {
      background-color: #0f172a !important;
      border-color: #1e293b !important;
    }
    html.dark #delete-modal-cancel {
      border-color: #334155 !important;
      color: #e2e8f0 !important;
    }
    html.dark #delete-modal-cancel:hover {
      background-color: #1e293b !important;
    }
    html.dark footer {
      color: #64748b !important;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased">
  <!-- Overlay mobile -->
  <div id="overlay" class="fixed inset-0 bg-black/50 z-40 hidden lg:hidden"></div>

  <!-- Sidebar -->
  <aside id="sidebar" class="fixed inset-y-0 left-0 w-64 bg-navy-950 text-slate-300 z-50 flex flex-col -translate-x-full lg:translate-x-0 overflow-hidden">
    <div class="sb-brand h-18 py-3.5 px-4 sm:px-5 flex items-center gap-3.5 border-b border-white/[0.08] shrink-0 bg-white/[0.02]">
      <div class="relative shrink-0 flex items-center justify-center">
        <img
          src="/logo.png"
          alt="Beyond Jogja Tours"
          class="w-10 h-10 rounded-full object-contain shadow-md ring-2 ring-white/15"
        />
        <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 bg-emerald-400 border-2 border-navy-950 rounded-full shadow-sm" title="Online"></span>
      </div>
      <div class="sb-label min-w-0 flex-1 leading-none">
        <h1 class="text-white font-bold text-[15px] tracking-tight truncate leading-snug">Beyond Jogja</h1>
        <div class="flex items-center gap-1.5 mt-1">
          <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-semibold tracking-wider uppercase bg-white/10 text-slate-300 border border-white/10">
            Admin Panel
          </span>
        </div>
      </div>
      <!-- Tutup (mobile) -->
      <button
        id="close-btn"
        class="sb-label lg:hidden p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-white/10 transition cursor-pointer"
        aria-label="Tutup menu"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav class="flex-1 px-3 py-6 space-y-1 overflow-y-auto">
      <p class="sb-label px-3 mb-2 text-[10px] font-semibold uppercase tracking-widest text-slate-500">Menu</p>
      {nav.map((item) => (
        <a
          href={item.href}
          title={item.label}
          class:list={[
            'sb-item flex items-center justify-between gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition whitespace-nowrap',
            active === item.key
              ? 'bg-primary-600/15 text-primary-300 ring-1 ring-primary-500/20'
              : 'hover:bg-white/5 hover:text-white',
          ]}
        >
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
            </svg>
            <span class="sb-label">{item.label}</span>
          </div>
          {item.badge !== undefined && item.badge > 0 && (
            <span class="sb-label px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500 text-white">
              {item.badge}
            </span>
          )}
        </a>
      ))}
      <a href="/" target="_blank" title="Lihat Website" class="sb-item flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium hover:bg-white/5 hover:text-white transition whitespace-nowrap">
        <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
        <span class="sb-label">Lihat Website</span>
      </a>
    </nav>

    <div class="p-3 border-t border-white/5 space-y-2 shrink-0">
      <a
        href="/admin/profil"
        title="Edit profil"
        class:list={[
          'sb-item group flex items-center gap-3 px-2 py-2 rounded-xl transition',
          active === 'profile' ? 'bg-primary-600/15 ring-1 ring-primary-500/20' : 'hover:bg-white/5',
        ]}
      >
        <div class="w-9 h-9 rounded-full overflow-hidden bg-primary-500/20 text-primary-300 flex items-center justify-center font-bold text-sm shrink-0">
          {avatarUrl ? (
            <img src={avatarUrl} alt={displayName} class="w-full h-full object-cover" />
          ) : (
            <span>{initials}</span>
          )}
        </div>
        <div class="sb-label min-w-0 flex-1">
          <p class="text-sm font-medium text-white truncate">{displayName}</p>
          <p class="text-xs text-slate-500 truncate">@{username}</p>
        </div>
        <svg class="sb-label w-4 h-4 text-slate-500 group-hover:text-primary-300 transition shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.232-6.232a2.5 2.5 0 113.536 3.536L12.536 16.5H9V13z" />
        </svg>
      </a>
      <a href="/admin/logout" title="Keluar" class="sb-item flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium bg-white/5 hover:bg-red-500/20 hover:text-red-300 transition whitespace-nowrap">
        <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
        <span class="sb-label">Keluar</span>
      </a>
      <!-- Ciutkan (desktop) -->
      <button id="collapse-btn" title="Ciutkan / buka sidebar" class="sb-item hidden lg:flex w-full items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-slate-400 hover:bg-white/5 hover:text-white transition whitespace-nowrap">
        <svg class="sb-collapse-icon w-5 h-5 shrink-0 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
        </svg>
        <span class="sb-label">Ciutkan</span>
      </button>
    </div>
  </aside>

  <!-- Konten -->
  <div id="content" class="lg:pl-64 min-h-screen flex flex-col">
    <header class="h-16 bg-white/80 backdrop-blur border-b border-slate-200 sticky top-0 z-30 px-4 sm:px-8 flex items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <button id="menu-btn" class="p-2 -ml-2 rounded-lg hover:bg-slate-100 text-slate-600" aria-label="Buka/tutup sidebar" title="Buka/tutup sidebar">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
        <h2 class="font-semibold text-slate-900">{title}</h2>
      </div>

      <div class="flex items-center gap-2.5 sm:gap-3">
        <!-- Tombol Pengalih Mode Terang / Gelap -->
        <button
          id="admin-theme-toggle"
          type="button"
          class="flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-amber-300 transition cursor-pointer border border-slate-200 dark:border-slate-700 shadow-sm"
          title="Beralih Mode Gelap / Terang"
          aria-label="Beralih mode tema"
        >
          <!-- Sun Icon (Aktif saat Dark Mode) -->
          <svg id="theme-icon-sun" class="w-4 h-4 text-amber-400 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <!-- Moon Icon (Aktif saat Light Mode) -->
          <svg id="theme-icon-moon" class="w-4 h-4 text-slate-600 dark:text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <span id="theme-toggle-text" class="hidden sm:inline">Mode Gelap</span>
        </button>

        <a href="/admin/profil" class="flex items-center gap-2.5 p-1 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 transition group" title="Profil Admin">
          <div class="w-8 h-8 rounded-full overflow-hidden bg-primary-50 dark:bg-primary-900/50 border border-slate-200 dark:border-slate-700 text-primary-600 dark:text-primary-300 flex items-center justify-center font-bold text-xs shrink-0">
            {avatarUrl ? (
              <img src={avatarUrl} alt={displayName} class="w-full h-full object-cover" />
            ) : (
              <span>{initials}</span>
            )}
          </div>
          <span class="text-xs font-semibold text-slate-700 dark:text-slate-200 hidden sm:inline-block pr-1 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition">{displayName}</span>
        </a>
      </div>
    </header>

    <main class="flex-1 px-4 sm:px-8 py-8 max-w-7xl w-full mx-auto">
      <slot />
    </main>

    <footer class="px-8 py-4 text-xs text-slate-400 text-center">
      &copy; {new Date().getFullYear()} Beyond Jogja Tours
    </footer>
  </div>

  <!-- Reusable Delete Confirmation Modal Dialog -->
  <div id="delete-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
    <!-- Backdrop Blur -->
    <div id="delete-modal-backdrop" class="fixed inset-0 bg-navy-950/60 backdrop-blur-sm transition-opacity opacity-0"></div>

    <!-- Modal Card with Pop-in -->
    <div id="delete-modal-card" class="relative bg-white rounded-3xl max-w-sm sm:max-w-md w-full p-6 sm:p-8 shadow-2xl border border-slate-100 transform scale-95 opacity-0 transition-all duration-200 z-10 text-center">
      <!-- Animated Warning Trash Icon Bubble -->
      <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-rose-50 border border-rose-100 flex items-center justify-center text-rose-500 shadow-inner">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      </div>

      <h3 id="delete-modal-title" class="text-xl font-bold text-slate-900 mb-2">
        Hapus Data Ini?
      </h3>
      <p id="delete-modal-desc" class="text-sm text-slate-500 leading-relaxed mb-6">
        Tindakan ini permanen dan tidak dapat dibatalkan. Apakah Anda yakin ingin menghapus data ini?
      </p>

      <!-- Action Buttons -->
      <div class="flex items-center gap-3">
        <button
          type="button"
          id="delete-modal-cancel"
          class="flex-1 py-3 px-4 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 font-semibold text-sm transition shadow-sm cursor-pointer"
        >
          Batal
        </button>
        <button
          type="button"
          id="delete-modal-confirm"
          class="flex-1 py-3 px-4 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-semibold text-sm transition shadow-md hover:shadow-lg cursor-pointer flex items-center justify-center gap-2"
        >
          <span>Ya, Hapus</span>
        </button>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const root = document.documentElement;
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('overlay');
      const desktop = window.matchMedia('(min-width: 1024px)');

      function toggleMobile(open) {
        const show = open ?? sidebar.classList.contains('-translate-x-full');
        sidebar.classList.toggle('-translate-x-full', !show);
        overlay.classList.toggle('hidden', !show);
      }

      function toggleCollapse() {
        const collapsed = root.dataset.sidebar === 'collapsed';
        if (collapsed) delete root.dataset.sidebar;
        else root.dataset.sidebar = 'collapsed';
        localStorage.setItem('admin-sidebar', collapsed ? 'expanded' : 'collapsed');
      }

      document.getElementById('menu-btn').addEventListener('click', () => {
        desktop.matches ? toggleCollapse() : toggleMobile();
      });
      document.getElementById('collapse-btn').addEventListener('click', toggleCollapse);
      document.getElementById('close-btn').addEventListener('click', () => toggleMobile(false));
      overlay.addEventListener('click', () => toggleMobile(false));
      document.addEventListener('keydown', (e) => { 
        if (e.key === 'Escape') {
          toggleMobile(false);
          closeDeleteModal();
        }
      });

      // Global Delete Confirmation Modal Handler
      let currentFormToSubmit = null;

      window.confirmDelete = function(formOrEvent, title, message) {
        let form = formOrEvent;
        if (formOrEvent && formOrEvent.target) form = formOrEvent.target;
        if (formOrEvent && formOrEvent.tagName !== 'FORM') form = formOrEvent.closest('form');
        
        currentFormToSubmit = form;
        
        const modal = document.getElementById('delete-modal');
        const backdrop = document.getElementById('delete-modal-backdrop');
        const card = document.getElementById('delete-modal-card');
        const titleEl = document.getElementById('delete-modal-title');
        const descEl = document.getElementById('delete-modal-desc');

        if (title) titleEl.textContent = title;
        if (message) descEl.textContent = message;

        modal.classList.remove('hidden');
        requestAnimationFrame(() => {
          backdrop.classList.remove('opacity-0');
          backdrop.classList.add('opacity-100');
          card.classList.remove('scale-95', 'opacity-0');
          card.classList.add('scale-100', 'opacity-100');
        });
        return false;
      };

      function closeDeleteModal() {
        const modal = document.getElementById('delete-modal');
        const backdrop = document.getElementById('delete-modal-backdrop');
        const card = document.getElementById('delete-modal-card');
        if (!modal || modal.classList.contains('hidden')) return;

        backdrop.classList.remove('opacity-100');
        backdrop.classList.add('opacity-0');
        card.classList.remove('scale-100', 'opacity-100');
        card.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
          modal.classList.add('hidden');
          currentFormToSubmit = null;
        }, 200);
      }

      document.getElementById('delete-modal-cancel')?.addEventListener('click', closeDeleteModal);
      document.getElementById('delete-modal-backdrop')?.addEventListener('click', closeDeleteModal);

      document.getElementById('delete-modal-confirm')?.addEventListener('click', () => {
        if (currentFormToSubmit) {
          const form = currentFormToSubmit;
          currentFormToSubmit = null;
          form.submit();
        }
      });

      // Kontrol Pengalih Mode Gelap & Mode Terang
      const themeToggleBtn = document.getElementById('admin-theme-toggle');
      const sunIcon = document.getElementById('theme-icon-sun');
      const moonIcon = document.getElementById('theme-icon-moon');
      const toggleText = document.getElementById('theme-toggle-text');

      function syncThemeUI(isDark) {
        if (isDark) {
          sunIcon?.classList.remove('hidden');
          moonIcon?.classList.add('hidden');
          if (toggleText) toggleText.textContent = '';
          themeToggleBtn?.setAttribute('title', 'Beralih ke Mode Terang');
        } else {
          sunIcon?.classList.add('hidden');
          moonIcon?.classList.remove('hidden');
          if (toggleText) toggleText.textContent = '';
          themeToggleBtn?.setAttribute('title', 'Beralih ke Mode Gelap');
        }
      }

      // Sinkronkan ikon saat halaman dimuat
      syncThemeUI(root.classList.contains('dark'));

      themeToggleBtn?.addEventListener('click', () => {
        const isDark = root.classList.toggle('dark');
        localStorage.setItem('admin-theme', isDark ? 'dark' : 'light');
        syncThemeUI(isDark);
      });
    })();
  </script>
</body>
</html>
