---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getWhatsAppUrl } from '../../lib/constants';

export async function getStaticPaths() {
  const tours = await getCollection('tours');
  return tours.map(tour => ({
    params: { slug: tour.slug },
    props: { tour },
  }));
}

const { tour } = Astro.props;
const { Content } = await tour.render();
---

<BaseLayout title={tour.data.title} description={tour.data.tagline}>
  <!-- Hero Detail -->
  <section class="relative bg-gray-900 text-white pt-40 pb-24 md:pt-48 md:pb-32 flex items-center">
    <div class="absolute inset-0 z-0">
      <img 
        src={tour.data.thumbnail} 
        alt={tour.data.title} 
        class="w-full h-full object-cover opacity-40"
      />
    </div>
    <div class="container mx-auto px-4 relative z-10 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">{tour.data.title}</h1>
      <p class="text-xl max-w-2xl mx-auto">{tour.data.tagline}</p>
    </div>
  </section>

  <!-- Content Detail -->
  <section class="py-16 bg-white min-h-screen">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="bg-white rounded-xl shadow-lg border border-gray-100 p-8 md:p-12 -mt-24 relative z-20">
        <div class="prose prose-lg max-w-none text-gray-700">
          <Content />
        </div>
        
        <div class="mt-12 pt-8 border-t border-gray-100 text-center flex flex-col items-center">
          <h3 class="text-2xl font-bold text-gray-900 mb-6">Tertarik dengan Paket Tour Ini?</h3>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a 
              href={getWhatsAppUrl(tour.data.whatsappMessage)}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block bg-primary-600 text-white px-8 py-3.5 rounded-lg font-bold text-base hover:bg-primary-700 transition-colors shadow-md"
            >
              Contact Us Now via WhatsApp
            </a>
            {(tour.slug.toLowerCase().includes('borobudur') || tour.slug.toLowerCase().includes('prambanan')) && (
              <a
                href="https://www.getyourguide.com/yogyakarta-l349/borobudur-sunrise-prambanan-sunset-its-hidden-temples-t1505636/"
                target="_blank"
                rel="noopener noreferrer"
                class="transition-transform duration-200 hover:scale-[1.03] inline-block shadow-sm rounded-lg overflow-hidden"
              >
                <div style="position: relative; width: fit-content">
                  <img src="https://gyg.me/pQw3KK9K" width="170px" height="auto" style="border: 1px solid #c6c8d0" class="rounded-lg" alt="GetYourGuide | Borobudur Sunrise, Prambanan Sunset & Its Hidden Temples"/>
                  <p style="position: absolute; font-size: 0.52rem; font-weight: 500; color: #000000; font-family: Arial, sans-serif; z-index: 10; margin: 0 auto; right: 0.2rem; top: 0.2rem; width: 60%; line-height: 1.1;">
                    Borobudur Sunrise, Prambanan Sunset & Its Hidden Temples
                  </p>
                </div>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
