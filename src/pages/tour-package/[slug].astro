---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTourBySlug } from '../../lib/tours';
import { getSiteSettings, formatWhatsAppUrl } from '../../lib/settings';
import { verifySessionToken } from '../../lib/auth';

const { slug } = Astro.params;
const tour = await getTourBySlug(slug || '');
const settings = await getSiteSettings();

if (!tour) {
  return Astro.redirect('/404');
}

const isAdmin = !!verifySessionToken(Astro.cookies.get('admin_session')?.value);
const isUnderMaintenance = !tour.data.isActive;

let waBookingUrl = '';
let waCustomUrl = '';
let images: string[] = [];
let mainImage = '';
let subImage1 = '';
let subImage2 = '';
let tourSchema: any = null;

if (tour) {
  const waBookingMessage = tour.data.whatsappMessage || `Halo Beyond Jogja Tours! Saya ingin tanya dan booking paket wisata: ${tour.data.title}`;
  waBookingUrl = formatWhatsAppUrl(settings.whatsapp_number, waBookingMessage);
  waCustomUrl = formatWhatsAppUrl(settings.whatsapp_number, `Halo Beyond Jogja Tours! Saya tertarik dengan ${tour.data.title}, tapi ingin konsultasi custom rute/destinasinya.`);

  images = tour.data.gallery && tour.data.gallery.length > 0 ? tour.data.gallery : [tour.data.thumbnail];
  mainImage = images[0];
  subImage1 = images[1] || images[0];
  subImage2 = images[2] || images[0];

  tourSchema = {
    "@context": "https://schema.org",
    "@type": "TouristTrip",
    "name": tour.data.title,
    "description": tour.data.tagline || `Paket wisata private ${tour.data.title} di Yogyakarta.`,
    "touristType": "Private Tour",
    "offers": {
      "@type": "Offer",
      "price": (tour.data.price || '450000').replace(/\D/g, ''),
      "priceCurrency": "IDR",
      "availability": isUnderMaintenance ? "https://schema.org/Discontinued" : "https://schema.org/InStock"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": tour.data.rating || 4.9,
      "reviewCount": tour.data.reviewsCount || 85
    }
  };
}
---

{isUnderMaintenance && !isAdmin && (
  <BaseLayout 
    title={`${tour.data.title} (Sedang Diperbarui) - Beyond Jogja Tours`} 
    description="Paket wisata ini sementara waktu sedang dalam penyesuaian oleh tim kami."
  >
    <div class="min-h-[75vh] flex items-center justify-center py-28 px-4">
      <div class="max-w-md w-full text-center bg-white dark:bg-navy-900 rounded-3xl p-8 sm:p-10 border border-slate-200/80 dark:border-white/10 shadow-xl space-y-5">
        <div class="w-16 h-16 mx-auto rounded-2xl bg-amber-50 dark:bg-amber-500/10 text-amber-500 flex items-center justify-center text-3xl shadow-inner">
          🛠️
        </div>
        <div>
          <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 px-3 py-1 rounded-full">
            Sedang Dalam Pembaruan
          </span>
          <h1 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mt-3">{tour.data.title}</h1>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2.5 leading-relaxed">
            Paket wisata ini sementara waktu sedang dalam penyesuaian rute atau pembaruan harga oleh tim kami dan <strong>sementara waktu tidak dapat dipesan</strong>.
          </p>
        </div>

        <div class="pt-4 space-y-2.5">
          <a
            href="/tour-package"
            class="block w-full py-3 px-4 rounded-xl bg-primary-600 hover:bg-primary-700 text-white font-bold text-sm transition shadow-md shadow-primary-600/20"
          >
            Lihat Paket Wisata Lainnya &rarr;
          </a>
          <a
            href={formatWhatsAppUrl(settings.whatsapp_number, `Halo Beyond Jogja! Saya ingin tanya informasi tentang paket ${tour.data.title} yang sedang diperbarui.`)}
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full py-2.5 px-4 rounded-xl border border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-300 font-semibold text-xs hover:bg-slate-50 dark:hover:bg-navy-800 transition"
          >
            Tanya Customer Service via WhatsApp
          </a>
        </div>
      </div>
    </div>
  </BaseLayout>
)}

{(!isUnderMaintenance || isAdmin) && (
  <BaseLayout 
    title={`${tour.data.title} - Beyond Jogja Tours`} 
    description={tour.data.tagline || `Paket wisata private ${tour.data.title} di Yogyakarta. Lengkap mobil, driver ramah, BBM, dan jadwal fleksibel.`}
    image={tour.data.thumbnail}
    type="article"
    schema={tourSchema}
  >
    {isUnderMaintenance && isAdmin && (
      <div class="bg-amber-500 text-slate-900 px-4 py-2.5 text-center text-xs font-bold shadow-md sticky top-12 z-40 flex items-center justify-center gap-2">
        <span>⚠️ Mode Pratinjau Admin: Paket ini berstatus <u>NONAKTIF</u> (Sedang Diperbarui). Pengunjung umum melihat halaman pembaruan.</span>
        <a href={`/admin/tours/edit/${tour.id}`} class="underline ml-2 bg-black/10 hover:bg-black/20 px-2 py-0.5 rounded">Edit di Admin &rarr;</a>
      </div>
    )}

    <!-- Breadcrumb & Top Bar -->
    <section class="bg-navy-950 text-white pt-28 pb-8 md:pt-36 md:pb-10 border-b border-white/10">
      <div class="container mx-auto px-4 max-w-7xl">
        
        <!-- Back Button -->
        <div class="mb-5">
          <button
            type="button"
            onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/tour-package'; }"
            class="inline-flex items-center gap-2 text-xs font-semibold text-slate-200 hover:text-white bg-white/10 hover:bg-white/20 border border-white/15 px-3 py-1.5 rounded-xl transition shadow-sm cursor-pointer group"
            title="Kembali"
          >
            <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            <span>Kembali</span>
          </button>
        </div>

        <div class="flex flex-wrap items-center gap-3 mb-3">
          {tour.data.badge && (
            <span class="bg-primary-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-sm">
              {tour.data.badge}
            </span>
          )}
          <span class="bg-white/10 text-slate-200 text-xs font-medium px-3 py-1 rounded-full flex items-center gap-1.5">
            📍 {tour.data.location}
          </span>
          <span class="bg-white/10 text-slate-200 text-xs font-medium px-3 py-1 rounded-full flex items-center gap-1.5">
            🚗 100% Private Tour
          </span>
        </div>

        <h1 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
          {tour.data.title}
        </h1>

        <div class="flex flex-wrap items-center gap-4 text-xs sm:text-sm text-slate-300">
          {tour.data.rating && tour.data.reviewsCount ? (
            <div class="flex items-center gap-1.5 bg-amber-400/10 border border-amber-400/20 px-2.5 py-1 rounded-lg">
              <span class="text-amber-400 font-bold">★ {tour.data.rating}</span>
              <span class="text-slate-400">({tour.data.reviewsCount} ulasan tamu)</span>
            </div>
          ) : null}
          <div class="flex items-center gap-1.5">
            <span>⏱️ Durasi:</span>
            <strong class="text-white">{tour.data.duration}</strong>
          </div>
          <div class="flex items-center gap-1.5">
            <span>🏨 Penjemputan:</span>
            <strong class="text-white">Hotel / Stasiun</strong>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Tour Details Content -->
    <section class="py-8 md:py-12 bg-slate-50 dark:bg-navy-950 transition-colors duration-300">
      <div class="container mx-auto px-4 max-w-7xl">
        
        <!-- GYG Photo Gallery Mosaic -->
        <div class="mb-10 rounded-2xl md:rounded-3xl overflow-hidden shadow-sm border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-navy-900">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-2 p-2">
            <!-- Main Big Image -->
            <div class="md:col-span-2 h-72 sm:h-96 md:h-[440px] rounded-xl overflow-hidden relative group">
              <img 
                src={mainImage} 
                alt={tour.data.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                onerror="this.src='https://placehold.co/800x600?text=Foto+Wisata'"
              />
              <div class="absolute bottom-3 left-3 bg-black/60 backdrop-blur-sm text-white text-xs px-3 py-1.5 rounded-lg flex items-center gap-1.5">
                <span>📷 Destinasi Utama</span>
              </div>
            </div>

            <!-- Stacked Side Images -->
            <div class="hidden md:flex flex-col gap-2 h-[440px]">
              <div class="h-1/2 rounded-xl overflow-hidden relative group">
                <img 
                  src={subImage1} 
                  alt={`${tour.data.title} galeri 1`} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  onerror="this.src='https://placehold.co/600x400?text=Foto+2'"
                />
              </div>
              <div class="h-1/2 rounded-xl overflow-hidden relative group">
                <img 
                  src={subImage2} 
                  alt={`${tour.data.title} galeri 2`} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  onerror="this.src='https://placehold.co/600x400?text=Foto+3'"
                />
                <div class="absolute inset-0 bg-black/20 flex items-center justify-center pointer-events-none">
                  <span class="bg-black/75 backdrop-blur-sm text-white text-xs font-semibold px-3 py-1.5 rounded-lg">
                    Lihat {images.length} Foto
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 2-Column Content Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
          
          <!-- LEFT COLUMN: Tour Information (65%) -->
          <div class="lg:col-span-2 space-y-10">
            
            <!-- Activity Overview Grid (About this activity) -->
            <div class="bg-white dark:bg-navy-900 rounded-2xl p-6 sm:p-8 border border-slate-200/80 dark:border-white/10 shadow-sm">
              <h2 class="text-lg font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2">
                <span class="text-primary-600">ℹ️</span> Tentang Aktivitas Wisata Ini
              </h2>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div class="flex items-start gap-3.5">
                  <div class="w-10 h-10 rounded-xl bg-primary-50 dark:bg-primary-500/10 text-primary-600 dark:text-primary-400 flex items-center justify-center shrink-0 text-lg">
                    ⏱️
                  </div>
                  <div>
                    <h4 class="text-xs uppercase tracking-wider font-semibold text-slate-400">Durasi Tour</h4>
                    <p class="text-sm font-bold text-slate-800 dark:text-slate-100 mt-0.5">{tour.data.duration}</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Waktu fleksibel mengikuti kenyamanan Anda</p>
                  </div>
                </div>

                <div class="flex items-start gap-3.5">
                  <div class="w-10 h-10 rounded-xl bg-primary-50 dark:bg-primary-500/10 text-primary-600 dark:text-primary-400 flex items-center justify-center shrink-0 text-lg">
                    🚗
                  </div>
                  <div>
                    <h4 class="text-xs uppercase tracking-wider font-semibold text-slate-400">Grup Wisata (100% Private)</h4>
                    <p class="text-sm font-bold text-slate-800 dark:text-slate-100 mt-0.5">{tour.data.groupType || 'Hanya Anda & Rombongan'}</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">{tour.data.groupTypeNote || 'Tidak digabung dengan tamu lain'}</p>
                  </div>
                </div>

                <div class="flex items-start gap-3.5">
                  <div class="w-10 h-10 rounded-xl bg-primary-50 dark:bg-primary-500/10 text-primary-600 dark:text-primary-400 flex items-center justify-center shrink-0 text-lg">
                    🏨
                  </div>
                  <div>
                    <h4 class="text-xs uppercase tracking-wider font-semibold text-slate-400">Layanan Antar-Jemput</h4>
                    <p class="text-sm font-bold text-slate-800 dark:text-slate-100 mt-0.5">Sudah Termasuk</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">{tour.data.pickupLocation || 'Hotel, Stasiun Tugu/Lempuyangan, Bandara'}</p>
                  </div>
                </div>

                <div class="flex items-start gap-3.5">
                  <div class="w-10 h-10 rounded-xl bg-primary-50 dark:bg-primary-500/10 text-primary-600 dark:text-primary-400 flex items-center justify-center shrink-0 text-lg">
                    💬
                  </div>
                  <div>
                    <h4 class="text-xs uppercase tracking-wider font-semibold text-slate-400">Driver & Pemandu</h4>
                    <p class="text-sm font-bold text-slate-800 dark:text-slate-100 mt-0.5">{tour.data.driverService || 'Bahasa Indonesia / English'}</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">{tour.data.driverServiceNote || 'Ramah, sopan, & siap ambilkan foto terbaik'}</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Highlights Section -->
            {tour.data.highlights && tour.data.highlights.length > 0 && (
              <div class="bg-white dark:bg-navy-900 rounded-2xl p-6 sm:p-8 border border-slate-200/80 dark:border-white/10 shadow-sm">
                <h2 class="text-lg font-bold text-slate-900 dark:text-white mb-5 flex items-center gap-2">
                  <span class="text-amber-500">✨</span> Daya Tarik & Keunggulan Paket Ini
                </h2>
                <ul class="space-y-3">
                  {tour.data.highlights.map((hl) => (
                    <li class="flex items-start gap-3 text-sm text-slate-700 dark:text-slate-200">
                      <span class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 mt-0.5 text-xs font-bold">
                        ✓
                      </span>
                      <span class="leading-relaxed">{hl}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Detailed Description -->
            <div class="bg-white dark:bg-navy-900 rounded-2xl p-6 sm:p-8 border border-slate-200/80 dark:border-white/10 shadow-sm">
              <h2 class="text-lg font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
                <span class="text-primary-600">📖</span> Deskripsi Lengkap Paket
              </h2>
              <div class="prose dark:prose-invert prose-slate max-w-none text-sm leading-relaxed" set:html={tour.htmlContent} />
            </div>

            <!-- Timeline Itinerary (GetYourGuide Timeline Style) -->
            {tour.data.itinerary && tour.data.itinerary.length > 0 && (
              <div class="bg-white dark:bg-navy-900 rounded-2xl p-6 sm:p-8 border border-slate-200/80 dark:border-white/10 shadow-sm">
                <div class="flex items-center justify-between mb-6">
                  <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <span class="text-primary-600">🗺️</span> Rencana Perjalanan (Itinerary)
                  </h2>
                  <span class="text-xs font-medium text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-navy-800 px-2.5 py-1 rounded-md">
                    Jadwal Fleksibel
                  </span>
                </div>

                <!-- Timeline List -->
                <div class="relative pl-6 sm:pl-8 border-l-2 border-primary-200 dark:border-primary-500/30 space-y-8 ml-3">
                  {tour.data.itinerary.map((step, idx) => (
                    <div class="relative group">
                      <!-- Dot Marker -->
                      <div class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-4 h-4 rounded-full border-2 border-primary-500 bg-white dark:bg-navy-900 group-hover:scale-125 transition-transform duration-200 shadow-sm"></div>

                      <div class="space-y-1">
                        <span class="inline-block text-xs font-bold text-primary-600 dark:text-primary-400 bg-primary-50 dark:bg-primary-500/10 px-2.5 py-0.5 rounded-full">
                          {step.time}
                        </span>
                        <h4 class="text-base font-bold text-slate-900 dark:text-white mt-1">
                          {step.title}
                        </h4>
                        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                          {step.desc}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>

                <div class="mt-8 p-4 rounded-xl bg-amber-50 dark:bg-amber-500/10 border border-amber-200/60 dark:border-amber-500/20 text-xs text-amber-900 dark:text-amber-200 flex items-start gap-2.5">
                  <span class="text-base shrink-0">💡</span>
                  <p>
                    <strong>Catatan:</strong> Susunan rute di atas bersifat fleksibel. Jika Anda ingin menambah destinasi, mampir mencicipi kuliner khas, atau berbelanja oleh-oleh, silakan komunikasikan dengan driver kami saat perjalanan.
                  </p>
                </div>
              </div>
            )}

            <!-- Inclusions & Exclusions Checklist -->
            <div class="bg-white dark:bg-navy-900 rounded-2xl p-6 sm:p-8 border border-slate-200/80 dark:border-white/10 shadow-sm">
              <h2 class="text-lg font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2">
                <span class="text-primary-600">📋</span> Fasilitas Paket
              </h2>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
                <!-- Included -->
                <div class="space-y-3">
                  <h4 class="text-sm font-bold text-emerald-700 dark:text-emerald-400 flex items-center gap-2 uppercase tracking-wider text-xs">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Termasuk dalam Paket:
                  </h4>
                  <ul class="space-y-2.5">
                    {tour.data.included.map((inc) => (
                      <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-700 dark:text-slate-200">
                        <span class="text-emerald-600 dark:text-emerald-400 font-bold shrink-0">✓</span>
                        <span>{inc}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Excluded -->
                <div class="space-y-3">
                  <h4 class="text-sm font-bold text-rose-700 dark:text-rose-400 flex items-center gap-2 uppercase tracking-wider text-xs">
                    <span class="w-2 h-2 rounded-full bg-rose-500"></span> Tidak Termasuk:
                  </h4>
                  <ul class="space-y-2.5">
                    {tour.data.excluded.map((exc) => (
                      <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-500 dark:text-slate-400">
                        <span class="text-rose-500 font-bold shrink-0">✕</span>
                        <span>{exc}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>

            <!-- Important Information & Tips -->
            <div class="bg-white dark:bg-navy-900 rounded-2xl p-6 sm:p-8 border border-slate-200/80 dark:border-white/10 shadow-sm">
              <h2 class="text-lg font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
                <span class="text-primary-600">🎒</span> Informasi Penting & Persiapan
              </h2>
              <div class="space-y-4 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                <div>
                  <strong class="text-slate-800 dark:text-slate-100 block mb-1">Yang Perlu Dibawa & Tips Persiapan:</strong>
                  <p class="whitespace-pre-line">{tour.data.importantInfo || 'Pakaian yang nyaman dan menyerap keringat, kacamata hitam, topi/payung, kamera atau smartphone terisi penuh, serta uang tunai secukupnya untuk keperluan pribadi di lokasi wisata.'}</p>
                </div>
                <div>
                  <strong class="text-slate-800 dark:text-slate-100 block mb-1">Konfirmasi Penjemputan:</strong>
                  <p>Driver kami akan menghubungi Anda via WhatsApp H-1 sebelum keberangkatan untuk konfirmasi lokasi penjemputan dan nomor plat armada yang bertugas.</p>
                </div>
              </div>
            </div>


          </div>

          <!-- RIGHT COLUMN: Sticky Booking & Inquiry Card (35%) -->
          <div class="lg:col-span-1">
            <div class="sticky top-28 space-y-6">
              
              <!-- Sticky Box Card -->
              <div class="bg-white dark:bg-navy-900 rounded-2xl p-6 sm:p-7 border border-slate-200/90 dark:border-white/10 shadow-lg dark:shadow-2xl">
                <!-- Price Header -->
                <div class="border-b border-slate-100 dark:border-white/10 pb-5 mb-5">
                  <span class="text-xs uppercase tracking-wider text-slate-400 font-semibold block">Harga Paket Mulai Dari</span>
                  <div class="flex items-baseline gap-2 mt-1">
                    <span class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
                      {tour.data.price}
                    </span>
                    <span class="text-sm text-slate-500 dark:text-slate-400 font-normal">
                      {tour.data.priceUnit}
                    </span>
                  </div>
                  <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                    {tour.data.priceNote || 'Harga per mobil (kapasitas 1-6 orang). Termasuk mobil ber-AC, driver ramah, & BBM.'}
                  </p>
                </div>

                <!-- Reassurance Points -->
                <div class="space-y-2.5 mb-6 text-xs text-slate-600 dark:text-slate-300">
                  {(tour.data.bookingPerks || [
                    '100% Private Tour (Tanpa Campur Tamu Lain)',
                    'Jadwal & Waktu Singgah Bebas Diatur',
                    'Bisa Bayar DP Ringan / Bayar di Tempat',
                    'Driver Ramah & Siap Bantu Ambilkan Foto'
                  ]).map((perk: string) => (
                    <div class="flex items-center gap-2">
                      <span class="text-emerald-500 font-bold">✓</span>
                      <span>{perk}</span>
                    </div>
                  ))}
                </div>

                <!-- Big Primary WhatsApp Booking CTA -->
                <div class="space-y-3">
                  <a
                    href={waBookingUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full bg-primary-600 hover:bg-primary-700 text-white font-bold py-3.5 px-4 rounded-xl text-center transition duration-200 shadow-md hover:shadow-lg flex items-center justify-center gap-2.5 text-sm"
                  >
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
                    </svg>
                    <span>Pesan Sekarang via WhatsApp</span>
                  </a>

                  <a
                    href={waCustomUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full bg-slate-100 hover:bg-slate-200 dark:bg-navy-800 dark:hover:bg-navy-700 text-slate-700 dark:text-slate-200 font-semibold py-2.5 px-4 rounded-xl text-center transition text-xs flex items-center justify-center gap-2"
                  >
                    <span>💬 Konsultasi / Ubah Rute Ini</span>
                  </a>
                </div>

                <!-- Fast Info Box -->
                <div class="mt-6 pt-5 border-t border-slate-100 dark:border-white/10 text-center">
                  <p class="text-xs text-slate-500 dark:text-slate-400">
                    Respon Cepat • CS Online Siap Melayani 24/7
                  </p>
                </div>
              </div>

              <!-- Helpful Custom Tour Box -->
              <div class="bg-gradient-to-br from-primary-900/10 to-primary-600/10 rounded-2xl p-5 border border-primary-500/20 text-center">
                <span class="text-2xl mb-1 block">💡</span>
                <h4 class="font-bold text-slate-900 dark:text-white text-sm mb-1">Ingin Destinasi Lain?</h4>
                <p class="text-xs text-slate-600 dark:text-slate-300 mb-3">
                  Kami bisa buatkan rute khusus sesuai keinginan dan durasi liburan Anda di Jogja.
                </p>
                <a
                  href={formatWhatsAppUrl(settings.whatsapp_number, 'Halo Beyond Jogja! Saya ingin konsultasi rute wisata kustom untuk keluarga.')}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-bold text-primary-600 dark:text-primary-400 hover:underline"
                >
                  Chat Konsultasi Kustom &rarr;
                </a>
              </div>

            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- Mobile Sticky Bottom Floating Bar -->
    <div class="fixed bottom-0 left-0 right-0 z-40 bg-white/95 dark:bg-navy-900/95 backdrop-blur-md border-t border-slate-200 dark:border-white/10 p-3.5 sm:hidden shadow-2xl flex items-center justify-between gap-3">
      <div>
        <span class="text-[10px] uppercase tracking-wider text-slate-400 block font-medium">Mulai dari</span>
        <div class="flex items-baseline gap-1">
          <span class="text-lg font-black text-slate-900 dark:text-white">
            {tour.data.price}
          </span>
          <span class="text-[11px] text-slate-400">
            {tour.data.priceUnit}
          </span>
        </div>
      </div>

      <a
        href={waBookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-primary-600 hover:bg-primary-700 text-white font-bold py-2.5 px-5 rounded-xl text-xs transition shadow flex items-center gap-1.5 shrink-0"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
