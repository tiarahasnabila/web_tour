---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTours } from '../../lib/tours';
import { getSiteSettings, formatWhatsAppUrl } from '../../lib/settings';

const tours = (await getAllTours()).filter((t) => t.data.isActive);
const settings = await getSiteSettings();
---

<BaseLayout 
  title="Katalog Paket Wisata Jogja Terbaik - Beyond Jogja Tours" 
  description="Pilihan paket tour dan wisata Jogja murah, private, dan fleksibel. Eksplor Candi Borobudur, Prambanan, Lava Tour Merapi, hingga pantai Jogja."
  image="https://images.unsplash.com/photo-1596402184320-417e7178b2cd?auto=format&fit=crop&w=1200&q=80"
>
  <!-- Hero Section ala GetYourGuide -->
  <section class="bg-navy-950 text-white pt-32 pb-16 md:pt-44 md:pb-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:60px_60px] z-0"></div>
    <div class="absolute top-1/4 -right-20 w-96 h-96 rounded-full bg-primary-500/10 blur-3xl z-0"></div>
    <div class="absolute bottom-0 left-10 w-72 h-72 rounded-full bg-primary-400/5 blur-3xl z-0"></div>

    <div class="container mx-auto px-4 relative z-10 text-center max-w-4xl" data-aos="fade-up">
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight mb-5 leading-tight">
        Eksplorasi Keindahan Jogja <br class="hidden sm:inline" />
        <span class="text-primary-400">Tanpa Ribet & Fleksibel</span>
      </h1>

      <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto font-light leading-relaxed">
        Pilih paket wisata private terbaik untuk keluarga, pasangan, atau rombongan. Sudah termasuk mobil, driver ramah, dan BBM.
      </p>

      <!-- Trust Badges Bar -->
      <div class="mt-8 pt-8 border-t border-white/10 flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-xs text-slate-300">
        <div class="flex items-center gap-2">
          <span class="text-primary-400 text-base">🚗</span>
          <span>100% Private Tour</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-primary-400 text-base">🏨</span>
          <span>Antar-Jemput Hotel & Stasiun</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-primary-400 text-base">⭐</span>
          <span>Rating 4.9 dari 300+ Tamu</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-primary-400 text-base">💬</span>
          <span>Booking & Negosiasi via WA</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Tour Catalog Section -->
  <section class="py-16 md:py-24 bg-slate-50 dark:bg-navy-950 transition-colors duration-300 min-h-screen">
    <div class="container mx-auto px-4 max-w-7xl">
      <!-- Section Header with count -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 pb-6 border-b border-slate-200/80 dark:border-white/10">
        <div>
          <p class="text-xs uppercase tracking-widest font-semibold text-primary-600 dark:text-primary-400 mb-1">Pilihan Terbaik</p>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">Daftar Paket Wisata Pilihan</h2>
        </div>
        <div class="text-sm text-slate-500 dark:text-slate-400">
          Menampilkan <strong class="text-slate-900 dark:text-white">{tours.length} paket</strong> wisata siap jalan
        </div>
      </div>

      <!-- Tours Grid ala GetYourGuide Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {tours.map((tour, index) => {
          const detailUrl = `/tour-package/${tour.slug}`;
          const waMessage = tour.data.whatsappMessage || `Halo Beyond Jogja Tours! Saya tertarik dengan ${tour.data.title}`;
          const waUrl = formatWhatsAppUrl(settings.whatsapp_number, waMessage);

          return (
            <article
              data-aos="fade-up"
              data-aos-delay={index * 80}
              class="group bg-white dark:bg-navy-900 rounded-2xl overflow-hidden border border-slate-200/90 dark:border-white/10 hover:border-primary-400 dark:hover:border-primary-500/40 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col"
            >
              <!-- Card Image & Badges -->
              <a href={detailUrl} class="block h-56 sm:h-60 overflow-hidden relative shrink-0 bg-slate-100">
                <img
                  src={tour.data.thumbnail}
                  alt={tour.data.title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                  onerror="this.src='https://placehold.co/600x400?text=Paket+Wisata'"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>

                <!-- Floating Top Badges -->
                <div class="absolute top-3.5 left-3.5 right-3.5 flex items-center justify-between pointer-events-none">
                  {tour.data.badge && (
                    <span class="bg-primary-600/95 backdrop-blur-sm text-white text-[11px] font-bold px-3 py-1 rounded-full shadow-md uppercase tracking-wider">
                      {tour.data.badge}
                    </span>
                  )}
                  <span class="bg-black/60 backdrop-blur-sm text-white text-[11px] font-medium px-2.5 py-1 rounded-full flex items-center gap-1 shadow-sm ml-auto">
                    📍 {tour.data.location}
                  </span>
                </div>

                <!-- Floating Bottom Title Tag in Image for readability -->
                <div class="absolute bottom-3.5 left-4 right-4">
                  <span class="text-xs text-primary-300 font-semibold uppercase tracking-wider">Beyond Jogja</span>
                  <h3 class="text-white text-lg font-bold leading-snug line-clamp-1 group-hover:text-primary-200 transition-colors">
                    {tour.data.title}
                  </h3>
                </div>
              </a>

              <!-- Card Body -->
              <div class="p-6 flex flex-col flex-grow justify-between gap-5">
                <div>
                  <!-- Meta Row (Duration & Location) -->
                  <div class="flex items-center justify-between text-xs mb-3 pb-3 border-b border-slate-100 dark:border-white/5 text-slate-500 dark:text-slate-400 font-medium">
                    <div class="flex items-center gap-1.5">
                      <span>⏱️</span>
                      <span>Durasi: {tour.data.duration}</span>
                    </div>

                    {tour.data.rating && tour.data.reviewsCount ? (
                      <div class="flex items-center gap-1 text-amber-500 font-bold">
                        <span>★</span>
                        <span>{tour.data.rating}</span>
                        <span class="text-slate-400 font-normal">({tour.data.reviewsCount})</span>
                      </div>
                    ) : (
                      tour.data.location && (
                        <div class="flex items-center gap-1 text-slate-500 dark:text-slate-400">
                          <span>📍</span>
                          <span>{tour.data.location}</span>
                        </div>
                      )
                    )}
                  </div>

                  <!-- Tagline / Summary -->
                  <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed line-clamp-2 mb-4">
                    {tour.data.tagline || 'Eksplorasi destinasi ikonik Yogyakarta dengan kendaraan private ber-AC dan driver ramah.'}
                  </p>

                  <!-- Value propositions bullet chips -->
                  <div class="flex flex-wrap gap-1.5 mb-2">
                    <span class="bg-slate-100 dark:bg-navy-800 text-slate-600 dark:text-slate-300 text-[11px] font-medium px-2 py-0.5 rounded-md">
                      ✓ Mobil + Driver + BBM
                    </span>
                    <span class="bg-slate-100 dark:bg-navy-800 text-slate-600 dark:text-slate-300 text-[11px] font-medium px-2 py-0.5 rounded-md">
                      ✓ Bebas Custom Waktu
                    </span>
                  </div>
                </div>

                <!-- Price Block & Action Buttons (GetYourGuide style) -->
                <div class="pt-4 border-t border-slate-100 dark:border-white/10 mt-auto">
                  <div class="flex items-baseline justify-between mb-3.5">
                    <div>
                      <span class="text-[11px] uppercase tracking-wider text-slate-400 block font-medium">Mulai dari</span>
                      <div class="flex items-baseline gap-1">
                        <span class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">
                          {tour.data.price}
                        </span>
                        <span class="text-xs text-slate-400 font-normal">
                          {tour.data.priceUnit}
                        </span>
                      </div>
                    </div>

                    <a
                      href={detailUrl}
                      class="text-xs font-semibold text-primary-600 dark:text-primary-400 hover:underline flex items-center gap-1"
                    >
                      Lihat Itinerary &rarr;
                    </a>
                  </div>

                  <!-- Action Buttons -->
                  <div class="grid grid-cols-2 gap-2.5">
                    <a
                      href={detailUrl}
                      class="text-center py-2.5 px-3 rounded-xl border border-slate-300 dark:border-white/20 hover:border-primary-500 text-slate-700 dark:text-slate-200 font-semibold text-xs transition hover:bg-slate-50 dark:hover:bg-navy-800 flex items-center justify-center gap-1.5"
                    >
                      Rincian Paket
                    </a>

                    <a
                      href={waUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-center py-2.5 px-3 rounded-xl bg-primary-600 hover:bg-primary-700 text-white font-semibold text-xs transition shadow-sm hover:shadow flex items-center justify-center gap-1.5"
                    >
                      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
                      </svg>
                      Tanya via WA
                    </a>
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Bottom FAQ / CTA Helper -->
      <div class="mt-20 bg-white dark:bg-navy-900 rounded-3xl p-8 sm:p-12 border border-slate-200/80 dark:border-white/10 shadow-sm text-center max-w-3xl mx-auto" data-aos="fade-up">
        <span class="text-3xl mb-3 block">💡</span>
        <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-3">Mau Rute atau Destinasi Wisata Sendiri?</h3>
        <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-6">
          Punya daftar destinasi impian di Jogja yang tidak ada di paket atas? Tenang, kamu bisa <strong>Custom Tour</strong> sesuka hatimu. Chat admin kami sekarang, tentukan destinasi, kami buatkan rute dan estimasi terbaik!
        </p>
        <a
          href={formatWhatsAppUrl(settings.whatsapp_number, 'Halo Beyond Jogja! Saya ingin konsultasi Custom Tour sesuai rute pilihan saya sendiri.')}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-primary-600 hover:bg-primary-700 text-white font-semibold px-7 py-3.5 rounded-xl transition shadow-md hover:-translate-y-0.5 text-sm"
        >
          Konsultasi Custom Tour Gratis via WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
