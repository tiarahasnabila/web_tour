---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getWhatsAppUrl } from '../../lib/constants';

const tours = await getCollection('tours');

// Render markdown content for each tour upfront
const toursWithContent = await Promise.all(
  tours.map(async (tour) => {
    const { Content } = await tour.render();
    return { tour, Content };
  })
);
---

<BaseLayout title="Pilihan Paket Wisata Jogja" description="Daftar paket wisata Jogja murah dari Beyond Jogja Tours.">
  <div class="bg-navy-900 text-white pt-32 pb-20 md:pt-40 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-navy-900 via-navy-800/50 to-navy-900 z-0"></div>
    <div class="container mx-auto px-4 text-center relative z-10" data-aos="fade-up">
      <p class="text-primary-400 font-bold text-sm uppercase tracking-widest mb-3">Jalan-jalan Seru</p>
      <h1 class="text-4xl md:text-6xl font-black mb-4">Katalog <span class="text-primary-400">Paket Wisata</span></h1>
      <p class="text-gray-400 text-lg max-w-xl mx-auto font-light">Temukan paket wisata Jogja dan sekitarnya yang sesuai budget-mu.</p>
    </div>
  </div>

  <section class="py-20 bg-gray-50 dark:bg-navy-950 transition-colors duration-300 min-h-screen">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {toursWithContent.map(({ tour, Content }, index) => (
          <div
            data-aos="fade-up"
            data-aos-delay={index * 80}
            class="tilt-card bg-white dark:bg-navy-900 rounded-2xl overflow-hidden shadow-sm border border-gray-100 dark:border-white/10 hover:shadow-lg transition-all duration-300 flex flex-col"
          >
            <!-- Gambar -->
            <div class="h-52 overflow-hidden relative shrink-0">
              <img
                src={tour.data.thumbnail}
                alt={tour.data.title}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
              <h3 class="absolute bottom-4 left-5 right-5 text-white text-xl font-black">{tour.data.title}</h3>
            </div>

            <!-- Body Kartu -->
            <div class="p-6 flex flex-col flex-grow">
              <p class="text-gray-500 dark:text-gray-400 text-sm mb-5 leading-relaxed transition-colors">{tour.data.tagline}</p>

              <!-- Expandable Detail -->
              <div
                id={`detail-${tour.slug}`}
                class="detail-content hidden mb-5 overflow-hidden"
              >
                <div class="border-t border-gray-100 dark:border-white/10 pt-5 transition-colors">
                  <div class="prose prose-sm max-w-none text-gray-600 dark:text-gray-300 prose-headings:text-navy-900 dark:prose-headings:text-white prose-ul:list-disc prose-li:text-gray-600 dark:prose-li:text-gray-300 transition-colors">
                    <Content />
                  </div>
                </div>
              </div>

              {(tour.slug.toLowerCase().includes('borobudur') || tour.slug.toLowerCase().includes('prambanan')) && (
                <div class="mb-4 pt-3 border-t border-gray-100 dark:border-white/10">
                  <p class="text-[10px] font-semibold text-primary-600 dark:text-primary-400 uppercase tracking-wider mb-2">Pesan via GetYourGuide:</p>
                  <a
                    href="https://www.getyourguide.com/yogyakarta-l349/borobudur-sunrise-prambanan-sunset-its-hidden-temples-t1505636/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="transition-transform duration-200 hover:scale-[1.02] inline-block shadow-sm rounded-lg overflow-hidden"
                  >
                    <div style="position: relative; width: fit-content">
                      <img src="https://gyg.me/pQw3KK9K" width="160px" height="auto" style="border: 1px solid #c6c8d0" class="rounded-lg" alt="GetYourGuide | Borobudur Sunrise, Prambanan Sunset & Its Hidden Temples"/>
                      <p style="position: absolute; font-size: 0.5rem; font-weight: 500; color: #000000; font-family: Arial, sans-serif; z-index: 10; margin: 0 auto; right: 0.2rem; top: 0.2rem; width: 60%; line-height: 1.1;">
                        Borobudur Sunrise, Prambanan Sunset & Its Hidden Temples
                      </p>
                    </div>
                  </a>
                </div>
              )}

              <!-- Tombol Aksi -->
              <div class="flex gap-3 mt-auto">
                <button
                  type="button"
                  data-target={`detail-${tour.slug}`}
                  class="detail-btn flex-1 flex items-center justify-center gap-2 border border-primary-500 text-primary-600 dark:text-primary-400 py-2.5 rounded-lg font-bold text-sm hover:bg-primary-50 dark:hover:bg-primary-500/10 transition-colors"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 arrow-icon transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                  </svg>
                  <span class="btn-label">Lihat Detail</span>
                </button>
                <a
                  href={getWhatsAppUrl(tour.data.whatsappMessage)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 text-center bg-primary-500 text-white py-2.5 rounded-lg font-bold text-sm hover:bg-primary-600 transition-colors"
                >
                  Contact Us Now
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Accordion toggle for each tour card: only one card can be open at a time
  document.addEventListener('astro:page-load', () => {
    const allButtons = document.querySelectorAll<HTMLButtonElement>('.detail-btn');
    const allPanels = document.querySelectorAll<HTMLElement>('.detail-content');

    allButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.dataset.target!;
        const panel = document.getElementById(targetId);
        const arrow = btn.querySelector<SVGElement>('.arrow-icon');
        const label = btn.querySelector<HTMLSpanElement>('.btn-label');

        if (!panel) return;

        const isOpen = !panel.classList.contains('hidden');

        allPanels.forEach((item) => {
          const itemBtn = document.querySelector<HTMLButtonElement>(`[data-target="${item.id}"]`);
          const itemArrow = itemBtn?.querySelector<SVGElement>('.arrow-icon');
          const itemLabel = itemBtn?.querySelector<HTMLSpanElement>('.btn-label');

          item.classList.add('hidden');
          itemBtn?.classList.remove('bg-primary-50', 'dark:bg-primary-500/10');
          itemArrow?.classList.remove('rotate-180');
          if (itemLabel) itemLabel.textContent = 'Lihat Detail';
        });

        if (isOpen) {
          // clicked card was already open -> leave all closed
          return;
        }

        panel.classList.remove('hidden');
        arrow?.classList.add('rotate-180');
        if (label) label.textContent = 'Tutup Detail';
        btn.classList.add('bg-primary-50', 'dark:bg-primary-500/10');
      });
    });
  });
</script>
