---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getWhatsAppUrl } from '../lib/constants';

const cars = await getCollection('cars');
const tours = await getCollection('tours');

const featuredCars = cars.slice(0, 3);

// Render markdown content for each featured tour
const allTours = await Promise.all(
  tours.slice(0, 3).map(async (tour) => {
    const { Content } = await tour.render();
    return { tour, Content };
  })
);
---

<BaseLayout title="Beyond Jogja Tours - Rental Mobil & Paket Wisata Terbaik di Jogja">
  <!-- ===== HERO SECTION ===== -->
  <section class="relative bg-navy-900 overflow-hidden pt-36 md:pt-44 pb-10 min-h-[600px] flex items-center lg:items-end">
    <!-- BG pattern -->
    <div class="absolute inset-0 z-0">
      <div class="absolute top-0 right-0 w-1/2 h-full bg-navy-800/30"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 rounded-full bg-primary-500/5 blur-3xl"></div>
    </div>

    <div class="container mx-auto px-4 relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-8 items-end">
      <!-- Left: Copy -->
      <div class="pb-14 md:pb-20" data-aos="fade-right">
        <h1 class="text-4xl md:text-6xl font-black text-white leading-tight mb-6">
          Perjalanan Seru <br/>
          <span class="text-primary-400">Anti Ribet</span> di Jogja
        </h1>
        <p class="text-gray-400 text-lg mb-10 max-w-md leading-relaxed">
          Sewa mobil harian atau langsung paket wisata keliling Jogja — semua bisa diatur sesuai budget dan jadwalmu.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="#tours" class="bg-primary-500 hover:bg-primary-600 text-white font-bold px-8 py-4 rounded-xl transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-primary-500/30">
            Lihat Paket Wisata
          </a>
          <a href="#cars" class="bg-white/10 hover:bg-white/20 border border-white/20 text-white font-bold px-8 py-4 rounded-xl transition-all">
            Sewa Mobil
          </a>
        </div>

        <!-- Stats -->
        <div class="flex gap-8 mt-12 pt-8 border-t border-white/10">
          <div>
            <p class="text-3xl font-black text-white">500+</p>
            <p class="text-gray-400 text-sm">Pelanggan Puas</p>
          </div>
          <div>
            <p class="text-3xl font-black text-white">10+</p>
            <p class="text-gray-400 text-sm">Armada Tersedia</p>
          </div>
          <div>
            <p class="text-3xl font-black text-white">5★</p>
            <p class="text-gray-400 text-sm">Rating Google</p>
          </div>
        </div>
      </div>

      <!-- Right: Car image -->
      <div class="relative flex items-end justify-center" data-aos="fade-left" data-aos-delay="200">
        <img
          src="https://images.unsplash.com/photo-1549317661-bd32c8ce0db2?auto=format&fit=crop&q=80&w=900"
          alt="Armada Beyond Jogja Tours"
          class="w-full max-w-xl object-contain drop-shadow-2xl"
        />
        <!-- floating badge -->
        <div class="absolute top-8 right-4 bg-white rounded-2xl p-4 shadow-2xl" data-aos="zoom-in" data-aos-delay="500">
          <p class="text-xs text-gray-500 font-medium">Mulai dari</p>
          <p class="text-2xl font-black text-primary-500">Rp 350K</p>
          <p class="text-xs text-gray-400">/ hari</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== HOW IT WORKS ===== -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-14" data-aos="fade-up">
        <h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-3">Cara Memesan Sangat Mudah</h2>
        <p class="text-gray-500 max-w-xl mx-auto">Cukup 3 langkah dan kamu siap jalan-jalan!</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
        <!-- connector line -->
        <div class="hidden md:block absolute top-10 left-1/4 right-1/4 h-0.5 bg-gradient-to-r from-primary-200 to-primary-400 z-0"></div>
        {[
          { step: '01', icon: '💬', title: 'Hubungi Kami', desc: 'Chat via WhatsApp, ceritain mau ke mana dan berapa lama.' },
          { step: '02', icon: '🚗', title: 'Pilih Layanan', desc: 'Pilih armada atau paket tour yang paling cocok buatmu.' },
          { step: '03', icon: '🎉', title: 'Nikmati Perjalanan', desc: 'Kami siapkan semuanya. Kamu tinggal berangkat!' },
        ].map((item, i) => (
          <div data-aos="fade-up" data-aos-delay={i * 150} class="relative z-10 flex flex-col items-center text-center">
            <div class="w-20 h-20 rounded-2xl bg-white shadow-lg flex items-center justify-center text-4xl mb-6 border border-gray-100">
              {item.icon}
            </div>
            <span class="text-5xl font-black text-gray-100 absolute top-0 left-1/2 -translate-x-1/2 -z-10 leading-none">{item.step}</span>
            <h3 class="text-xl font-bold text-gray-900 mb-2">{item.title}</h3>
            <p class="text-gray-500 max-w-xs">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== ARMADA MOBIL ===== -->
  <section id="cars" class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12" data-aos="fade-up">
        <div>
          <p class="text-primary-500 font-bold text-sm uppercase tracking-widest mb-2">Armada Terbaik Kami</p>
          <h2 class="text-3xl md:text-4xl font-black text-gray-900">Pilih Mobil Sesuai Kebutuhanmu</h2>
        </div>
        <a href="/layanan" class="hidden md:flex items-center gap-2 text-gray-600 hover:text-primary-500 font-semibold transition-colors mt-4 md:mt-0">
          Lihat Semua Armada
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {featuredCars.map((car, index) => (
          <div data-aos="fade-up" data-aos-delay={index * 100} class="bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 group overflow-hidden">
            <div class="bg-gray-50 p-6 flex items-center justify-center h-52 overflow-hidden">
              <img src={car.data.thumbnail} alt={car.data.title} class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="p-6">
              <div class="flex justify-between items-start mb-3">
                <h3 class="text-xl font-bold text-gray-900">{car.data.title}</h3>
                <span class="bg-green-50 text-green-600 text-xs font-bold px-2 py-1 rounded-full border border-green-100">Tersedia</span>
              </div>
              <p class="text-2xl font-black text-primary-500 mb-4">{car.data.priceLabel} <span class="text-sm font-medium text-gray-400">/ hari</span></p>
              <div class="flex flex-wrap gap-2 mb-6">
                {car.data.features.map(f => (
                  <span class="bg-gray-100 text-gray-600 text-xs font-semibold px-3 py-1.5 rounded-lg">{f}</span>
                ))}
              </div>
              <a
                href={getWhatsAppUrl(car.data.whatsappMessage)}
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full text-center bg-primary-500 text-white py-3 rounded-xl font-bold hover:bg-primary-600 transition-colors"
              >
                Booking Sekarang
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== PAKET WISATA ===== -->
  <section id="tours" class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-14" data-aos="fade-up">
        <p class="text-primary-500 font-bold text-sm uppercase tracking-widest mb-2">Jalan-jalan Seru</p>
        <h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-3">Paket Wisata Pilihan</h2>
        <p class="text-gray-500 max-w-xl mx-auto">Dari Candi Borobudur sampai pantai selatan Jogja — pilih paket yang paling sesuai sama selera kamu.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {allTours.map(({ tour, Content }, index) => (
          <div data-aos="fade-up" data-aos-delay={index * 100} class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-xl transition-all duration-300 group flex flex-col">
            <div class="h-52 overflow-hidden relative shrink-0">
              <img src={tour.data.thumbnail} alt={tour.data.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
              <h3 class="absolute bottom-4 left-5 right-5 text-white text-xl font-black">{tour.data.title}</h3>
            </div>
            <div class="p-6 flex flex-col flex-grow">
              <p class="text-gray-500 text-sm mb-5 line-clamp-2 leading-relaxed">{tour.data.tagline}</p>

              <!-- Expandable Detail -->
              <div id={`home-detail-${tour.slug}`} class="home-detail-content hidden mb-5">
                <div class="border-t border-gray-100 pt-4">
                  <div class="prose prose-sm max-w-none text-gray-600 prose-headings:text-navy-900 prose-headings:font-bold">
                    <Content />
                  </div>
                </div>
              </div>

              <div class="flex gap-3 mt-auto">
                <button
                  type="button"
                  data-target={`home-detail-${tour.slug}`}
                  class="home-detail-btn flex-1 flex items-center justify-center gap-1.5 border border-primary-500 text-primary-600 py-2.5 rounded-lg font-bold text-sm hover:bg-primary-50 transition-colors"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 arrow-icon transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                  </svg>
                  <span class="btn-label">Detail</span>
                </button>
                <a
                  href={getWhatsAppUrl(tour.data.whatsappMessage)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 text-center bg-primary-500 text-white py-2.5 rounded-lg font-bold text-sm hover:bg-primary-600 transition-colors"
                >
                  Contact Us Now
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-12">
        <a href="/tour-package" class="inline-flex items-center gap-2 border-2 border-primary-500 text-primary-600 font-bold px-8 py-3.5 rounded-xl hover:bg-primary-500 hover:text-white transition-all">
          Lihat Semua Paket Wisata →
        </a>
      </div>
    </div>
  </section>

  <!-- ===== KEUNGGULAN ===== -->
  <section class="py-20 bg-navy-900">
    <div class="container mx-auto px-4">
      <div class="text-center mb-14" data-aos="fade-up">
        <p class="text-primary-400 font-bold text-sm uppercase tracking-widest mb-2">Mengapa Kami?</p>
        <h2 class="text-3xl md:text-4xl font-black text-white mb-3">Layanan Terbaik untuk Kamu</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { icon: '💰', title: 'Harga Transparan', desc: 'Gak ada biaya tambahan yang tidak disepakati di awal.' },
          { icon: '✨', title: 'Mobil Bersih & Wangi', desc: 'Setiap unit kami cuci dan semprot parfum sebelum dipakai.' },
          { icon: '🤝', title: 'Responsif 24/7', desc: 'Tim kami siap balesin chat kamu kapanpun.' },
          { icon: '😎', title: 'Driver Lokal Asik', desc: 'Hafal jalan tikus Jogja, ramah, dan siap jadi tour guide dadakan.' },
        ].map((item, i) => (
          <div data-aos="fade-up" data-aos-delay={i * 100} class="bg-white/5 border border-white/10 rounded-2xl p-7 hover:bg-white/10 transition-all duration-300 group">
            <div class="w-14 h-14 bg-primary-500/20 rounded-xl flex items-center justify-center text-3xl mb-5 group-hover:bg-primary-500/30 transition-colors">
              {item.icon}
            </div>
            <h3 class="text-white font-bold text-lg mb-2">{item.title}</h3>
            <p class="text-gray-400 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== PETA ===== -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center" data-aos="fade-up">
        <div>
          <p class="text-primary-500 font-bold text-sm uppercase tracking-widest mb-3">Lokasi Kami</p>
          <h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-5">Mampir ke Basecamp Kami</h2>
          <p class="text-gray-500 mb-8 leading-relaxed">Kapan-kapan kalau lagi mampir Jogja, mampir aja dulu ke basecamp kita buat diskusi rencana tripmu sambil ngopi.</p>
          <div class="space-y-4">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center shrink-0 text-primary-500 text-lg">📍</div>
              <div>
                <p class="font-bold text-gray-900">Alamat</p>
                <p class="text-gray-500 text-sm">Jl. Malioboro No. 1, Yogyakarta</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center shrink-0 text-primary-500 text-lg">⏰</div>
              <div>
                <p class="font-bold text-gray-900">Jam Operasional</p>
                <p class="text-gray-500 text-sm">Setiap Hari: 07:00 – 22:00 WIB</p>
              </div>
            </div>
          </div>
        </div>
        <div class="rounded-2xl overflow-hidden shadow-xl h-80 border border-gray-100">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3952.923184659795!2d110.36395911477747!3d-7.79410319438318!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e7a574249a5b481%3A0xc3eeb1168449c256!2sJalan%20Malioboro%2C%20Sosromenduran%2C%20Gedong%20Tengen%2C%20Kota%20Yogyakarta%2C%20Daerah%20Istimewa%20Yogyakarta!5e0!3m2!1sen!2sid!4v1689578135017!5m2!1sen!2sid"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.home-detail-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.dataset.target!;
      const panel    = document.getElementById(targetId);
      const arrow    = btn.querySelector<SVGElement>('.arrow-icon');
      const label    = btn.querySelector<HTMLSpanElement>('.btn-label');
      if (!panel) return;
      const isOpen = !panel.classList.contains('hidden');
      panel.classList.toggle('hidden', isOpen);
      arrow?.classList.toggle('rotate-180', !isOpen);
      if (label) label.textContent = isOpen ? 'Detail' : 'Tutup';
      btn.classList.toggle('bg-primary-50', !isOpen);
    });
  });
</script>
