---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllTours } from '../lib/tours';
import { getAllCars } from '../lib/cars';
import { getAllTestimonials } from '../lib/testimonials';
import { getFeaturedGallery } from '../lib/gallery';
import { getWhatsAppUrl, OFFICE_ADDRESS } from '../lib/constants';

const cars = await getAllCars();
const tours = (await getAllTours()).filter((t) => t.data.isActive);
const testimonials = await getAllTestimonials();
const gallerySlides = await getFeaturedGallery();

const featuredCars = ['all-new-avanza', 'innova-reborn', 'hiace', 'fortuner']
  .map((slug) => cars.find((car) => car.slug.toLowerCase() === slug))
  .filter((car) => car !== undefined);

const featuredTours = tours.slice(0, 3);
---

<BaseLayout title="Beyond Jogja Tours - Rental Mobil & Paket Wisata di Jogja">
  <!-- ===== HERO SECTION ===== -->
  <section class="relative bg-navy-950 overflow-hidden pt-36 md:pt-44 pb-16 min-h-[620px] flex items-center lg:items-end">
    <!-- BG: subtle grid pattern -->
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:60px_60px]"></div>
      <div class="absolute top-0 right-0 w-1/2 h-full bg-navy-900/20"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 rounded-full bg-primary-500/5 blur-3xl"></div>
      <div class="absolute top-1/4 right-1/4 w-64 h-64 rounded-full bg-primary-400/3 blur-3xl"></div>
    </div>

    <div class="container mx-auto px-4 relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-8 items-end">
      <!-- Left: Copy -->
      <div class="pb-14 md:pb-20" data-aos="fade-right">
        <!-- Label -->
        <div class="inline-flex items-center gap-2 bg-primary-500/10 border border-primary-500/20 rounded-full px-3 py-1.5 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-primary-400"></span>
          <span class="text-primary-300 text-xs font-medium tracking-wider">Jogja Tour & Rental</span>
        </div>

        <h1 class="text-4xl md:text-[56px] font-bold text-white leading-[1.1] mb-5 tracking-display">
          Perjalanan Seru <br/>
          <span class="text-primary-400">Anti Ribet</span> di Jogja
        </h1>
        <p class="text-slate-400 text-base md:text-lg mb-10 max-w-md leading-relaxed font-light">
          Sewa mobil harian atau langsung paket wisata keliling Jogja — semua bisa diatur sesuai budget dan jadwalmu.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/tour-package" class="bg-primary-600 hover:bg-primary-700 text-white font-semibold px-7 py-3.5 rounded-xl transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-primary-500/20 text-sm">
            Lihat Paket Wisata
          </a>
          <a href="/layanan" class="bg-white/6 hover:bg-white/10 border border-white/15 text-white font-medium px-7 py-3.5 rounded-xl transition-all text-sm">
            Sewa Mobil
          </a>
        </div>

        <!-- Stats -->
        <div class="flex gap-8 mt-12 pt-8 border-t border-white/8">
          <div>
            <p class="text-2xl font-bold text-white"><span class="counter-number" data-target="500">0</span>+</p>
            <p class="text-slate-500 text-xs mt-0.5">Pelanggan Puas</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-white"><span class="counter-number" data-target="10">0</span>+</p>
            <p class="text-slate-500 text-xs mt-0.5">Armada Tersedia</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-white"><span class="counter-number" data-target="5">0</span>★</p>
            <p class="text-slate-500 text-xs mt-0.5">Rating Google</p>
          </div>
        </div>

        <!-- Official Partner in Hero (Approved Supplier - Code 2) -->
        <div class="mt-8 pt-6 border-t border-white/8 flex flex-col sm:flex-row sm:items-center gap-3">
          <a
            href="https://www.getyourguide.com/-s813749"
            target="_blank"
            rel="noopener noreferrer"
            class="transition-transform duration-200 hover:scale-105 inline-block shrink-0"
          >
            <img src="https://gyg.me/kUtga42u" width="160" height="auto" class="rounded-lg border border-white/10 shadow-sm" alt="GetYourGuide Approved Supplier | Beyond Jogja Journeys" />
          </a>
          <span class="text-xs text-slate-400 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            Official Approved Supplier di GetYourGuide
          </span>
        </div>
      </div>

      <!-- Right: Car image -->
      <div class="relative flex items-center justify-center lg:justify-end" data-aos="fade-left" data-aos-delay="200">
        <div class="relative w-full max-w-[760px] h-[300px] md:h-[360px] lg:h-[420px]">
          <div class="absolute inset-x-2 md:inset-x-6 bottom-0 h-[72%] rounded-[38%_62%_40%_60%/62%_38%_62%_38%] bg-[linear-gradient(135deg,#a9deff_0%,#89d4ff_35%,#69c7f7_100%)] shadow-[0_30px_80px_rgba(34,211,238,0.15)]"></div>
          <div class="absolute inset-x-4 md:inset-x-10 bottom-4 h-[62%] rounded-[36%_64%_35%_65%/60%_40%_60%_40%] bg-white/10 blur-sm"></div>
          <img
            src="/rentalmobil.jpg"
            alt="Armada Beyond Jogja Tours"
            class="absolute inset-x-0 bottom-0 mx-auto w-[94%] max-w-[700px] object-contain drop-shadow-[0_30px_45px_rgba(15,23,42,0.25)]"
          />
        </div>

        <!-- floating badge -->
        <div class="absolute top-6 right-2 md:right-6 bg-white/90 backdrop-blur-sm rounded-2xl p-4 shadow-[0_20px_50px_rgba(15,23,42,0.12)] border border-slate-100" data-aos="zoom-in" data-aos-delay="500">
          <p class="text-xs text-slate-400 font-medium">Mulai dari</p>
          <p class="text-xl md:text-2xl font-bold text-primary-600 leading-tight">Rp 350K</p>
          <p class="text-xs text-slate-400">/ hari</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== HOW IT WORKS ===== -->
  <section class="py-24 md:py-32 bg-white dark:bg-navy-950 transition-colors duration-300">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16" data-aos="fade-up">
        <p class="text-primary-600 dark:text-primary-400 font-medium text-xs uppercase tracking-[0.15em] mb-3">Proses Booking</p>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-3 tracking-display transition-colors">Cara Memesan Sangat Mudah</h2>
        <p class="text-slate-500 dark:text-slate-400 max-w-xl mx-auto text-sm leading-relaxed transition-colors">Cukup 3 langkah dan kamu siap jalan-jalan!</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 relative">
        <!-- connector line -->
        <div class="hidden md:block absolute top-9 left-1/4 right-1/4 h-px bg-gradient-to-r from-primary-200/50 to-primary-300/50 z-0"></div>
        {[
          { step: '01', icon: '💬', title: 'Hubungi Kami', desc: 'Chat via WhatsApp, ceritain mau ke mana dan berapa lama.' },
          { step: '02', icon: '🚗', title: 'Pilih Layanan', desc: 'Pilih armada atau paket tour yang paling cocok buatmu.' },
          { step: '03', icon: '🎉', title: 'Nikmati Perjalanan', desc: 'Kami siapkan semuanya. Kamu tinggal berangkat!' },
        ].map((item, i) => (
          <div data-aos="fade-up" data-aos-delay={i * 150} class="relative z-10 flex flex-col items-center text-center">
            <div class="w-18 h-18 rounded-2xl bg-white dark:bg-navy-900 shadow-sm flex items-center justify-center text-3xl mb-6 border border-slate-100 dark:border-white/8 transition-colors">
              {item.icon}
            </div>
            <span class="text-[80px] font-bold text-slate-100/60 dark:text-navy-800 absolute top-[-10px] left-1/2 -translate-x-1/2 -z-10 leading-none select-none transition-colors">{item.step}</span>
            <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-2 transition-colors">{item.title}</h3>
            <p class="text-slate-500 dark:text-slate-400 max-w-xs text-sm leading-relaxed transition-colors">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== PAKET WISATA ===== -->
  <section id="tours" class="py-24 md:py-32 bg-slate-50 dark:bg-navy-950 transition-colors duration-300">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16" data-aos="fade-up">
        <p class="text-primary-600 dark:text-primary-400 font-medium text-xs uppercase tracking-[0.15em] mb-3">Jalan-jalan Seru</p>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-3 tracking-display transition-colors">Paket Wisata Pilihan</h2>
        <p class="text-slate-500 dark:text-slate-400 max-w-xl mx-auto text-sm leading-relaxed transition-colors">Dari Candi Borobudur sampai pantai selatan Jogja — pilih paket yang paling sesuai sama selera kamu.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredTours.map((tour, index) => (
          <div data-aos="fade-up" data-aos-delay={index * 100} class="tilt-card bg-white dark:bg-navy-900 rounded-2xl overflow-hidden border border-slate-100 dark:border-white/8 hover:border-primary-200 dark:hover:border-primary-500/20 shadow-sm hover:shadow-lg transition-all duration-300 group flex flex-col">
            <a href={`/tour-package/${tour.slug}`} class="h-52 overflow-hidden relative shrink-0 block">
              <img src={tour.data.thumbnail} alt={tour.data.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
              <h3 class="absolute bottom-4 left-5 right-5 text-white text-base font-semibold group-hover:text-primary-300 transition-colors">{tour.data.title}</h3>
            </a>
            <div class="p-6 flex flex-col flex-grow">
              <p class="text-slate-500 dark:text-slate-400 text-sm mb-5 line-clamp-2 leading-relaxed transition-colors">{tour.data.tagline}</p>

              {(tour.slug.toLowerCase().includes('borobudur') || tour.slug.toLowerCase().includes('prambanan')) && (
                <div class="mb-4 pt-3 border-t border-slate-100 dark:border-white/8">
                  <p class="text-[10px] font-semibold text-primary-600 dark:text-primary-400 uppercase tracking-wider mb-2">Pesan via GetYourGuide:</p>
                  <a
                    href="https://www.getyourguide.com/yogyakarta-l349/borobudur-sunrise-prambanan-sunset-its-hidden-temples-t1505636/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="transition-transform duration-200 hover:scale-[1.02] inline-block shadow-sm rounded-lg overflow-hidden"
                  >
                    <div style="position: relative; width: fit-content">
                      <img src="https://gyg.me/pQw3KK9K" width="160px" height="auto" style="border: 1px solid #c6c8d0" class="rounded-lg" alt="GetYourGuide | Borobudur Sunrise, Prambanan Sunset & Its Hidden Temples"/>
                      <p style="position: absolute; font-size: 0.5rem; font-weight: 500; color: #000000; font-family: Arial, sans-serif; z-index: 10; margin: 0 auto; right: 0.2rem; top: 0.2rem; width: 60%; line-height: 1.1;">
                        Borobudur Sunrise, Prambanan Sunset & Its Hidden Temples
                      </p>
                    </div>
                  </a>
                </div>
              )}

              <div class="flex gap-3 mt-auto">
                <a
                  href={`/tour-package/${tour.slug}`}
                  class="flex-1 flex items-center justify-center gap-1.5 border border-primary-300 dark:border-primary-500/40 text-primary-600 dark:text-primary-400 py-2.5 rounded-lg font-medium text-xs hover:bg-primary-50 dark:hover:bg-primary-500/10 transition-colors"
                >
                  <span>Detail</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                  </svg>
                </a>
                <a
                  href={getWhatsAppUrl(tour.data.whatsappMessage)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 text-center bg-primary-600 text-white py-2.5 rounded-lg font-medium text-xs hover:bg-primary-700 transition-colors"
                >
                  Contact Us Now
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-14">
        <a href="/tour-package" class="inline-flex items-center gap-2 border border-slate-200 dark:border-white/10 text-slate-600 dark:text-slate-300 font-medium text-sm px-8 py-3.5 rounded-xl hover:border-primary-400 hover:text-primary-600 dark:hover:border-primary-500 dark:hover:text-primary-400 transition-all">
          Lihat Semua Paket Wisata
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== ARMADA MOBIL ===== -->
  <section id="cars" class="py-24 md:py-32 bg-white dark:bg-navy-900/40 transition-colors duration-300">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row justify-between items-end mb-14 gap-4" data-aos="fade-up">
        <div>
          <p class="text-primary-600 dark:text-primary-400 font-medium text-xs uppercase tracking-[0.15em] mb-2">Armada Terbaik Kami</p>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white tracking-display transition-colors">Pilih Mobil Sesuai Kebutuhanmu</h2>
        </div>
        <a href="/layanan" class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary-600 dark:text-primary-400 hover:gap-2.5 transition-all">
          Lihat Semua Armada &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {featuredCars.map((car, index) => (
          <div data-aos="fade-up" data-aos-delay={index * 100} class="tilt-card bg-slate-50/80 dark:bg-navy-900 rounded-2xl border border-slate-100 dark:border-white/8 hover:border-primary-200 dark:hover:border-primary-500/20 shadow-sm hover:shadow-lg transition-all duration-300 group overflow-hidden">
            <div class="bg-white dark:bg-navy-800/50 p-6 flex items-center justify-center h-52 overflow-hidden transition-colors">
              <img src={car.data.thumbnail} alt={car.data.title} class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="p-6">
              <div class="flex justify-between items-start mb-3">
                <h3 class="text-base font-semibold text-slate-900 dark:text-white transition-colors">{car.data.title}</h3>
                <span class="bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-medium px-2.5 py-1 rounded-full border border-emerald-100 dark:border-emerald-500/20 transition-colors">Tersedia</span>
              </div>
              <div class="flex flex-wrap gap-1.5 mb-6 mt-4">
                {car.data.features.map(f => (
                  <span class="bg-slate-100 dark:bg-navy-800 text-slate-500 dark:text-slate-300 text-xs font-medium px-2.5 py-1 rounded-lg transition-colors">{f}</span>
                ))}
              </div>
              <a
                href={getWhatsAppUrl(car.data.whatsappMessage)}
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full text-center bg-primary-600 text-white py-2.5 rounded-xl text-sm font-semibold hover:bg-primary-700 transition-colors"
              >
                Booking Sekarang
              </a>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-slate-200 dark:border-white/10 pt-6">
        <p class="max-w-3xl text-sm text-slate-600 dark:text-slate-300 leading-relaxed text-center sm:text-left">
          Ingin menggunakan kendaraan lain yang mungkin lebih nyaman? Kamu bisa request atau tanyakan terlebih dahulu melalui chat WhatsApp sebelum melakukan booking.
        </p>
        <a
          href={getWhatsAppUrl("Halo, saya ingin menanyakan kendaraan lain sebelum booking")}
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 inline-flex items-center justify-center bg-primary-600 text-white px-5 py-3 rounded-xl text-sm font-semibold hover:bg-primary-700 transition-colors"
        >
          Tanya via WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- ===== DOKUMENTASI / GALERI SLIDER ===== -->
  {gallerySlides.length > 0 && (
    <section id="gallery-slider" class="py-24 md:py-32 bg-slate-50 dark:bg-navy-950 transition-colors duration-300 overflow-hidden">
      <div class="container mx-auto px-4">
        <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-4" data-aos="fade-up">
          <div>
            <p class="text-primary-600 dark:text-primary-400 font-medium text-xs uppercase tracking-[0.15em] mb-2">Dokumentasi Momen Seru</p>
            <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white tracking-display transition-colors">Liburan Seru Bareng Kami</h2>
            <p class="text-slate-500 dark:text-slate-400 text-sm mt-1 max-w-xl leading-relaxed">
              Intip keseruan wisatawan domestik & mancanegara yang menjelajahi keindahan Yogyakarta bersama Beyond Jogja.
            </p>
          </div>
          
          <div class="flex items-center gap-3">
            <!-- Prev/Next Navigation Buttons -->
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="slider-prev"
                aria-label="Foto Sebelumnya"
                class="w-10 h-10 rounded-xl bg-white dark:bg-navy-900 border border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-300 hover:text-primary-600 dark:hover:text-primary-400 hover:border-primary-400 flex items-center justify-center transition shadow-xs cursor-pointer"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
              </button>
              <button
                type="button"
                id="slider-next"
                aria-label="Foto Berikutnya"
                class="w-10 h-10 rounded-xl bg-white dark:bg-navy-900 border border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-300 hover:text-primary-600 dark:hover:text-primary-400 hover:border-primary-400 flex items-center justify-center transition shadow-xs cursor-pointer"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </button>
            </div>

            <a href="/galeri" class="inline-flex items-center gap-1.5 text-xs font-bold px-4 py-2.5 rounded-xl bg-primary-50 dark:bg-primary-950/60 text-primary-700 dark:text-primary-300 border border-primary-200/60 dark:border-primary-800/60 hover:bg-primary-100 transition shadow-xs ml-2">
              <span>Lihat Semua Galeri</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Carousel Viewport & Track -->
        <div id="slider-viewport" class="relative overflow-hidden cursor-grab active:cursor-grabbing select-none rounded-3xl" data-aos="fade-up">
          <div id="slider-track" class="flex transition-transform duration-500 ease-out gap-5">
            {gallerySlides.map((slide) => (
              <a
                href="/galeri"
                class="slider-item shrink-0 w-[82%] sm:w-[46%] lg:w-[31.5%] aspect-[4/3] rounded-2xl overflow-hidden relative group bg-slate-200 dark:bg-navy-900 border border-slate-100 dark:border-white/10 shadow-sm block"
              >
                <img
                  src={slide.image_url}
                  alt={slide.title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 pointer-events-none"
                  onerror="this.src='https://placehold.co/800x600?text=Dokumentasi+Jogja'"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-navy-950/85 via-navy-950/20 to-transparent flex flex-col justify-between p-4 sm:p-5 pointer-events-none">
                  <div class="flex justify-between items-start">
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-black/60 backdrop-blur-sm text-white shadow-xs">
                      {slide.category || 'Wisata'}
                    </span>
                  </div>
                  <div>
                    <h3 class="text-white font-bold text-sm sm:text-base leading-snug drop-shadow-sm group-hover:text-primary-200 transition-colors line-clamp-2">
                      {slide.title}
                    </h3>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Dot Indicators -->
        <div id="slider-dots" class="flex items-center justify-center gap-2 mt-8"></div>
      </div>
    </section>
  )}

  <!-- ===== KEUNGGULAN ===== -->
  <section class="py-24 md:py-32 bg-navy-950">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16" data-aos="fade-up">
        <p class="text-primary-400 font-medium text-xs uppercase tracking-[0.15em] mb-3">Mengapa Kami?</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-3 tracking-display">Layanan Terbaik untuk Kamu</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          { icon: '💰', title: 'Harga Transparan', desc: 'Gak ada biaya tambahan yang tidak disepakati di awal.' },
          { icon: '✨', title: 'Mobil Bersih & Wangi', desc: 'Setiap unit kami cuci dan semprot parfum sebelum dipakai.' },
          { icon: '🤝', title: 'Responsif 24/7', desc: 'Tim kami siap balesin chat kamu kapanpun.' },
          { icon: '😎', title: 'Driver Lokal Asik', desc: 'Hafal jalan tikus Jogja, ramah, dan siap jadi tour guide dadakan.' },
        ].map((item, i) => (
          <div data-aos="fade-up" data-aos-delay={i * 100} class="bg-white/4 border border-white/8 rounded-2xl p-7 hover:bg-white/7 hover:border-white/12 transition-all duration-300 group">
            <div class="w-12 h-12 bg-primary-500/15 rounded-xl flex items-center justify-center text-2xl mb-5 group-hover:bg-primary-500/25 transition-colors">
              {item.icon}
            </div>
            <h3 class="text-white font-semibold text-sm mb-2">{item.title}</h3>
            <p class="text-slate-500 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== TESTIMONI PELANGGAN ===== -->
  {testimonials.length > 0 && (
    <section class="py-24 md:py-32 bg-slate-50 dark:bg-navy-900/50 transition-colors duration-300">
      <div class="container mx-auto px-4">
        <div class="text-center mb-16" data-aos="fade-up">
          <p class="text-primary-600 dark:text-primary-400 font-medium text-xs uppercase tracking-[0.15em] mb-3">Kata Mereka</p>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-3 tracking-display transition-colors">Cerita Seru Pelanggan Kami</h2>
          <p class="text-slate-500 dark:text-slate-400 max-w-xl mx-auto text-sm leading-relaxed transition-colors">Pengalaman nyata dari wisatawan yang sudah mempercayakan liburannya di Jogja bersama kami.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {testimonials.map((t, idx) => (
            <div data-aos="fade-up" data-aos-delay={idx * 100} class="bg-white dark:bg-navy-900 rounded-2xl p-7 border border-slate-100 dark:border-white/8 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <div class="flex items-center gap-3">
                    <img
                      src={t.avatar}
                      alt={t.name}
                      class="w-11 h-11 rounded-full object-cover border border-slate-200 dark:border-white/10"
                      onerror="this.src='https://placehold.co/100x100?text=User'"
                    />
                    <div>
                      <h3 class="font-semibold text-slate-900 dark:text-white text-sm">{t.name}</h3>
                      <p class="text-xs text-slate-400">{t.origin}</p>
                    </div>
                  </div>
                  <div class="flex text-amber-400 text-xs">
                    {'★'.repeat(t.rating)}
                  </div>
                </div>

                {t.trip_package && (
                  <div class="mb-3">
                    <span class="inline-block bg-primary-50 dark:bg-primary-500/10 text-primary-600 dark:text-primary-400 text-[11px] font-medium px-2 py-0.5 rounded-md">
                      {t.trip_package}
                    </span>
                  </div>
                )}

                <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed italic">
                  "{t.comment}"
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===== PETA ===== -->
  <section class="py-24 md:py-32 bg-white dark:bg-navy-950 transition-colors duration-300">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-14 items-center" data-aos="fade-up">
        <div>
          <p class="text-primary-600 dark:text-primary-400 font-medium text-xs uppercase tracking-[0.15em] mb-3">Lokasi Kami</p>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-4 tracking-display transition-colors">Mampir ke Basecamp Kami</h2>
          <p class="text-slate-500 dark:text-slate-400 mb-8 leading-relaxed text-sm transition-colors">Kapan-kapan kalau lagi mampir Jogja, mampir aja dulu ke basecamp kita buat diskusi rencana tripmu sambil ngopi.</p>
          <div class="space-y-4">
            <div class="flex items-start gap-4">
              <div class="w-9 h-9 bg-primary-50 dark:bg-primary-500/15 rounded-lg flex items-center justify-center shrink-0 text-base transition-colors">📍</div>
              <div>
                <p class="font-semibold text-slate-900 dark:text-white text-sm transition-colors">Alamat Kantor</p>
                <p class="text-slate-500 dark:text-slate-400 text-sm transition-colors">{OFFICE_ADDRESS}</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-9 h-9 bg-primary-50 dark:bg-primary-500/15 rounded-lg flex items-center justify-center shrink-0 text-base transition-colors">⏰</div>
              <div>
                <p class="font-semibold text-slate-900 dark:text-white text-sm transition-colors">Jam Operasional</p>
                <p class="text-slate-500 dark:text-slate-400 text-sm transition-colors">Setiap Hari: 07:00 – 22:00 WIB</p>
              </div>
            </div>
          </div>
        </div>
        <div class="rounded-2xl overflow-hidden shadow-lg h-80 border border-slate-100 dark:border-white/8 transition-colors">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3952.522876455459!2d110.40907557476658!3d-7.840212692181067!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e7a56da295ed6f5%3A0x5b308149005a2390!2sSAMARA%20REGENCY!5e0!3m2!1sen!2sid!4v1790485562673!5m2!1sen!2sid" width="1024" height="768" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initHomePage() {
    // 1. Number Counter Animation
    const counters = document.querySelectorAll('.counter-number');
    const observerOptions = { threshold: 0.1 };
    
    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const target = +entry.target.getAttribute('data-target')!;
          const duration = 2000; // 2 seconds
          const frameRate = 1000 / 60; // 60fps
          const totalFrames = Math.round(duration / frameRate);
          const increment = target / totalFrames;
          
          let current = 0;
          const updateCounter = () => {
            current += increment;
            if (current < target) {
              entry.target.textContent = Math.ceil(current).toString();
              requestAnimationFrame(updateCounter);
            } else {
              entry.target.textContent = target.toString();
            }
          };
          updateCounter();
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);
    
    counters.forEach(counter => observer.observe(counter));

    // 2. Gallery Carousel Auto-Slide & Touch Swipe
    const track = document.getElementById('slider-track');
    const viewport = document.getElementById('slider-viewport');
    const prevBtn = document.getElementById('slider-prev');
    const nextBtn = document.getElementById('slider-next');
    const dotsContainer = document.getElementById('slider-dots');

    if (track && viewport) {
      const items = track.querySelectorAll<HTMLElement>('.slider-item');
      if (items.length > 0) {
        let currentIndex = 0;
        let autoPlayTimer: any = null;
        let startX = 0;
        let isDragging = false;

        const getItemsPerView = () => {
          if (window.innerWidth >= 1024) return 3;
          if (window.innerWidth >= 640) return 2;
          return 1;
        };

        const maxIndex = () => Math.max(0, items.length - getItemsPerView());

        function renderDots() {
          if (!dotsContainer) return;
          dotsContainer.innerHTML = '';
          const count = maxIndex() + 1;
          if (count <= 1) return;
          for (let i = 0; i < count; i++) {
            const dot = document.createElement('button');
            dot.className = `h-2.5 rounded-full transition-all duration-300 cursor-pointer ${
              i === currentIndex ? 'w-7 bg-primary-600' : 'w-2.5 bg-slate-300 dark:bg-white/20'
            }`;
            dot.setAttribute('aria-label', `Pindah ke slide ${i + 1}`);
            dot.addEventListener('click', () => {
              goToSlide(i);
              resetAutoPlay();
            });
            dotsContainer.appendChild(dot);
          }
        }

        function updateDots() {
          if (!dotsContainer) return;
          const dots = dotsContainer.children;
          for (let i = 0; i < dots.length; i++) {
            (dots[i] as HTMLElement).className = `h-2.5 rounded-full transition-all duration-300 cursor-pointer ${
              i === currentIndex ? 'w-7 bg-primary-600' : 'w-2.5 bg-slate-300 dark:bg-white/20'
            }`;
          }
        }

        function goToSlide(index: number) {
          const limit = maxIndex();
          if (index < 0) index = limit;
          if (index > limit) index = 0;
          currentIndex = index;

          const firstItem = items[0];
          const gap = 20;
          const itemWidth = firstItem.offsetWidth + gap;
          track.style.transform = `translateX(-${currentIndex * itemWidth}px)`;
          updateDots();
        }

        function nextSlide() {
          goToSlide(currentIndex + 1);
        }

        function prevSlide() {
          goToSlide(currentIndex - 1);
        }

        function startAutoPlay() {
          stopAutoPlay();
          autoPlayTimer = setInterval(nextSlide, 3500);
        }

        function stopAutoPlay() {
          if (autoPlayTimer) clearInterval(autoPlayTimer);
        }

        function resetAutoPlay() {
          stopAutoPlay();
          startAutoPlay();
        }

        prevBtn?.addEventListener('click', () => {
          prevSlide();
          resetAutoPlay();
        });

        nextBtn?.addEventListener('click', () => {
          nextSlide();
          resetAutoPlay();
        });

        viewport.addEventListener('mouseenter', stopAutoPlay);
        viewport.addEventListener('mouseleave', startAutoPlay);

        // Touch Swipe
        viewport.addEventListener('touchstart', (e) => {
          stopAutoPlay();
          startX = e.touches[0].clientX;
          isDragging = true;
        }, { passive: true });

        viewport.addEventListener('touchend', (e) => {
          if (!isDragging) return;
          isDragging = false;
          const endX = e.changedTouches[0].clientX;
          const diff = startX - endX;
          if (Math.abs(diff) > 40) {
            if (diff > 0) nextSlide();
            else prevSlide();
          }
          startAutoPlay();
        });

        window.addEventListener('resize', () => {
          renderDots();
          goToSlide(currentIndex);
        });

        renderDots();
        startAutoPlay();
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHomePage);
  } else {
    initHomePage();
  }
</script>
