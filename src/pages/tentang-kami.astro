---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getWhatsAppUrl } from '../lib/constants';
---

<BaseLayout 
  title="Tentang Kami - Beyond Jogja Tours" 
  description="Profil resmi Beyond Jogja Tours, penyedia jasa rental mobil terpercaya dan paket wisata private di Yogyakarta sejak tahun 2019."
  image="/kraton.jpg"
>
  <div class="bg-navy-950 text-white pt-32 pb-20 md:pt-44 relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.015)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.015)_1px,transparent_1px)] bg-[size:60px_60px] z-0"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 rounded-full bg-primary-500/5 blur-3xl z-0"></div>
    <div class="container mx-auto px-4 text-center relative z-10" data-aos="fade-up">
      <div class="inline-flex items-center gap-2 bg-primary-500/10 border border-primary-500/20 rounded-full px-3 py-1.5 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-primary-400"></span>
        <span class="text-primary-300 text-xs font-medium tracking-wider">Siapa Kami?</span>
      </div>
      <h1 class="text-4xl md:text-[54px] font-bold tracking-display mb-4">Mengenal Lebih Dekat</h1>
      <p class="text-slate-400 text-base max-w-xl mx-auto font-light leading-relaxed">Mitra perjalanan wisata dan transportasi terpercaya di Yogyakarta.</p>
    </div>
  </div>

  <section class="py-24 md:py-32 bg-white dark:bg-navy-950 transition-colors duration-300">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <div class="relative" data-aos="fade-right">
          <div class="absolute -inset-3 bg-primary-50 dark:bg-primary-500/10 rounded-2xl rotate-2 opacity-70 transition-colors"></div>
          <img
            src="https://images.unsplash.com/photo-1596402184320-417e7178b2cd?auto=format&fit=crop&q=80&w=800"
            alt="Beyond Jogja Tours Team"
            class="relative rounded-2xl shadow-lg w-full object-cover"
          />
        </div>
        <div data-aos="fade-left">
          <p class="text-primary-600 dark:text-primary-400 font-medium text-xs uppercase tracking-[0.15em] mb-3">Tentang Kami</p>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-6 leading-tight tracking-display transition-colors">Mewujudkan Liburan Impianmu di Jogja</h2>
          <div class="text-slate-600 dark:text-slate-300 leading-relaxed space-y-4 mb-8 text-sm transition-colors">
            <p>
              <strong class="text-slate-900 dark:text-white font-semibold transition-colors">Beyond Jogja Tours</strong> hadir karena kecintaan kami terhadap keindahan kota Yogyakarta dan keinginan untuk berbagi pengalaman tersebut dengan semua orang.
            </p>
            <p>
              Mulai dari sewa kendaraan harian hingga paket wisata lengkap dengan pemandu lokal — semua kami rancang agar perjalananmu terasa mudah, aman, dan tak terlupakan.
            </p>
            <p>
              Armada kami selalu terawat dan dirawat secara berkala. Driver kami bukan sekadar pengemudi — mereka adalah teman jalan yang siap bikin liburanmu makin asik!
            </p>
          </div>
          <a
            href={getWhatsAppUrl("Halo, saya ingin bertanya tentang layanan Beyond Jogja Tours")}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-primary-600 text-white px-7 py-3.5 rounded-xl font-semibold text-sm hover:bg-primary-700 hover:shadow-lg hover:shadow-primary-500/20 hover:-translate-y-0.5 transition-all"
          >
            Hubungi Kami Sekarang
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 md:py-32 bg-slate-50 dark:bg-navy-900 border-t border-slate-100 dark:border-white/5 transition-colors duration-300">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="text-center mb-16" data-aos="fade-up">
        <p class="text-primary-600 dark:text-primary-400 font-medium text-xs uppercase tracking-[0.15em] mb-2">Keunggulan Kami</p>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white tracking-display transition-colors">Mengapa Pilih Beyond Jogja Tours?</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {[
          { icon: '🌟', title: 'Pelayanan Tulus', desc: 'Kami melayani seperti melayani keluarga sendiri — dengan hati dan penuh perhatian.' },
          { icon: '🚗', title: 'Armada Prima', desc: 'Semua unit kami cuci, parfum, dan cek teknis sebelum dipakai pelanggan.' },
          { icon: '💰', title: 'Harga Jujur', desc: 'Tidak ada biaya tersembunyi. Deal di awal, bayar sesuai kesepakatan.' },
        ].map((item, i) => (
          <div data-aos="fade-up" data-aos-delay={i * 100} class="bg-white dark:bg-navy-800 p-8 rounded-2xl border border-slate-100 dark:border-white/8 text-center hover:shadow-md hover:-translate-y-1 transition-all duration-300">
            <div class="w-14 h-14 mx-auto bg-primary-50 dark:bg-primary-500/15 rounded-2xl flex items-center justify-center text-2xl mb-5 transition-colors">{item.icon}</div>
            <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-3 transition-colors">{item.title}</h3>
            <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed transition-colors">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
