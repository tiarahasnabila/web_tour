---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getWhatsAppUrl } from '../lib/constants';
---

<BaseLayout title="Tentang Kami" description="Profil perusahaan Beyond Jogja Tours">
  <div class="bg-navy-900 text-white pt-32 pb-20 md:pt-40 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-navy-900 via-navy-800/50 to-navy-900 z-0"></div>
    <div class="container mx-auto px-4 text-center relative z-10" data-aos="fade-up">
      <p class="text-primary-400 font-bold text-sm uppercase tracking-widest mb-3">Siapa Kami?</p>
      <h1 class="text-4xl md:text-6xl font-black mb-4">Mengenal Lebih Dekat</h1>
      <p class="text-gray-400 text-lg max-w-xl mx-auto font-light">Mitra perjalanan wisata dan transportasi terpercaya di Yogyakarta.</p>
    </div>
  </div>

  <section class="py-20 bg-white dark:bg-navy-950 transition-colors duration-300">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <div class="relative" data-aos="fade-right">
          <div class="absolute -inset-3 bg-primary-100 dark:bg-primary-500/20 rounded-2xl rotate-3 opacity-60 transition-colors"></div>
          <img
            src="https://images.unsplash.com/photo-1596402184320-417e7178b2cd?auto=format&fit=crop&q=80&w=800"
            alt="Beyond Jogja Tours Team"
            class="relative rounded-2xl shadow-xl w-full object-cover"
          />
        </div>
        <div data-aos="fade-left">
          <p class="text-primary-500 font-bold text-sm uppercase tracking-widest mb-3">Tentang Kami</p>
          <h2 class="text-3xl md:text-4xl font-black text-gray-900 dark:text-white mb-6 leading-tight transition-colors">Mewujudkan Liburan Impianmu di Jogja</h2>
          <div class="text-gray-600 dark:text-gray-300 leading-relaxed space-y-4 mb-8 transition-colors">
            <p>
              <strong class="text-gray-900 dark:text-white transition-colors">Beyond Jogja Tours</strong> hadir karena kecintaan kami terhadap keindahan kota Yogyakarta dan keinginan untuk berbagi pengalaman tersebut dengan semua orang.
            </p>
            <p>
              Mulai dari sewa kendaraan harian hingga paket wisata lengkap dengan pemandu lokal — semua kami rancang agar perjalananmu terasa mudah, aman, dan tak terlupakan.
            </p>
            <p>
              Armada kami selalu terawat dan dirawat secara berkala. Driver kami bukan sekadar pengemudi — mereka adalah teman jalan yang siap bikin liburanmu makin asik!
            </p>
          </div>
          <a
            href={getWhatsAppUrl("Halo, saya ingin bertanya tentang layanan Beyond Jogja Tours")}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-primary-500 text-white px-8 py-4 rounded-xl font-bold hover:bg-primary-600 hover:shadow-lg hover:shadow-primary-500/30 hover:-translate-y-0.5 transition-all"
          >
            Hubungi Kami Sekarang
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-gray-50 dark:bg-navy-900 border-t border-gray-100 dark:border-white/5 transition-colors duration-300">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="text-center mb-14" data-aos="fade-up">
        <p class="text-primary-500 font-bold text-sm uppercase tracking-widest mb-2">Keunggulan Kami</p>
        <h2 class="text-3xl md:text-4xl font-black text-gray-900 dark:text-white transition-colors">Mengapa Pilih Beyond Jogja Tours?</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          { icon: '🌟', title: 'Pelayanan Tulus', desc: 'Kami melayani seperti melayani keluarga sendiri — dengan hati dan penuh perhatian.' },
          { icon: '🚗', title: 'Armada Prima', desc: 'Semua unit kami cuci, parfum, dan cek teknis sebelum dipakai pelanggan.' },
          { icon: '💰', title: 'Harga Jujur', desc: 'Tidak ada biaya tersembunyi. Deal di awal, bayar sesuai kesepakatan.' },
        ].map((item, i) => (
          <div data-aos="fade-up" data-aos-delay={i * 100} class="bg-white dark:bg-navy-800 p-8 rounded-2xl shadow-sm border border-gray-100 dark:border-white/10 text-center hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <div class="w-16 h-16 mx-auto bg-primary-50 dark:bg-primary-500/20 rounded-2xl flex items-center justify-center text-3xl mb-5 transition-colors">{item.icon}</div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3 transition-colors">{item.title}</h3>
            <p class="text-gray-500 dark:text-gray-400 leading-relaxed transition-colors">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
