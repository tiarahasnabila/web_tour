---
import BaseLayout from '../layouts/BaseLayout.astro';

const galleryImages = [
  { src: "https://images.unsplash.com/photo-1584852922119-94f71a93eeb1?auto=format&fit=crop&q=80&w=800", alt: "Tour Jogja 1" },
  { src: "https://images.unsplash.com/photo-1596402184320-417e7178b2cd?auto=format&fit=crop&q=80&w=800", alt: "Tour Jogja 2" },
  { src: "https://images.unsplash.com/photo-1549317661-bd32c8ce0db2?auto=format&fit=crop&q=80&w=800", alt: "Rental Mobil Jogja" },
  { src: "https://images.unsplash.com/photo-1533587851505-d119e13fa0d7?auto=format&fit=crop&q=80&w=800", alt: "Wisata Budaya" },
  { src: "https://images.unsplash.com/photo-1627885437812-32a24bc98a58?auto=format&fit=crop&q=80&w=800", alt: "Pantai Selatan" },
  { src: "https://images.unsplash.com/photo-1583095111166-3d6074a385f8?auto=format&fit=crop&q=80&w=800", alt: "Candi Prambanan" },
];
---

<BaseLayout 
  title="Galeri Dokumentasi Wisata - Beyond Jogja Tours" 
  description="Kumpulan dokumentasi foto perjalanan dan keseruan para tamu wisatawan bersama Beyond Jogja Tours di destinasi terbaik Yogyakarta."
  image="https://images.unsplash.com/photo-1584852922119-94f71a93eeb1?auto=format&fit=crop&q=80&w=800"
>
  <div class="bg-navy-950 text-white pt-32 pb-16 md:pt-44 relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.015)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.015)_1px,transparent_1px)] bg-[size:60px_60px] z-0"></div>
    <div class="container mx-auto px-4 text-center relative z-10" data-aos="fade-up">
      <div class="inline-flex items-center gap-2 bg-primary-500/10 border border-primary-500/20 rounded-full px-3 py-1.5 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-primary-400"></span>
        <span class="text-primary-300 text-xs font-medium tracking-wider">Momen Seru</span>
      </div>
      <h1 class="text-4xl md:text-[54px] font-bold tracking-display mb-4">Galeri Dokumentasi</h1>
      <p class="text-slate-400 text-base max-w-xl mx-auto font-light leading-relaxed">Kumpulan momen perjalanan liburan tak terlupakan pelanggan Beyond Jogja Tours.</p>
    </div>
  </div>

  <section class="py-24 bg-slate-50 dark:bg-navy-950 transition-colors duration-300 min-h-screen">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {galleryImages.map((img, i) => (
          <div data-aos="fade-up" data-aos-delay={i * 80} class="aspect-square overflow-hidden rounded-2xl bg-slate-200 dark:bg-navy-800 group relative shadow-sm border border-slate-100 dark:border-white/5 transition-colors">
            <img
              src={img.src}
              alt={img.alt}
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-navy-950/50 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
              <span class="text-white font-medium text-sm px-5 py-2 border border-white/40 rounded-full backdrop-blur-sm bg-white/8">
                Lihat Foto
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
