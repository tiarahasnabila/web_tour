---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllGallery } from '../lib/gallery';
import { getWhatsAppUrl } from '../lib/constants';

const galleryItems = await getAllGallery();
const categories = ['Semua', ...Array.from(new Set(galleryItems.map((i) => i.category || 'Wisata')))];
---

<BaseLayout 
  title="Galeri Dokumentasi Wisata - Beyond Jogja Tours" 
  description="Kumpulan dokumentasi foto perjalanan dan keseruan para tamu wisatawan bersama Beyond Jogja Tours di destinasi terbaik Yogyakarta."
  image="https://images.unsplash.com/photo-1584852922119-94f71a93eeb1?auto=format&fit=crop&q=80&w=800"
>
  <!-- Hero Section -->
  <div class="bg-navy-950 text-white pt-32 pb-16 md:pt-44 relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.015)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.015)_1px,transparent_1px)] bg-[size:60px_60px] z-0"></div>
    <div class="container mx-auto px-4 text-center relative z-10" data-aos="fade-up">
      <div class="inline-flex items-center gap-2 bg-primary-500/10 border border-primary-500/20 rounded-full px-3 py-1.5 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-primary-400"></span>
        <span class="text-primary-300 text-xs font-medium tracking-wider">Momen Seru</span>
      </div>
      <h1 class="text-4xl md:text-[54px] font-bold tracking-display mb-4">Galeri Dokumentasi</h1>
      <p class="text-slate-400 text-base max-w-xl mx-auto font-light leading-relaxed">
        Kumpulan momen perjalanan liburan tak terlupakan wisatawan domestik dan mancanegara bersama Beyond Jogja Tours.
      </p>
    </div>
  </div>

  <!-- Gallery Section -->
  <section class="py-16 md:py-24 bg-slate-50 dark:bg-navy-950 transition-colors duration-300 min-h-[600px]">
    <div class="container mx-auto px-4">
      <!-- Filter Category Buttons -->
      {categories.length > 2 && (
        <div class="flex flex-wrap items-center justify-center gap-2 mb-12" data-aos="fade-up">
          {categories.map((cat, idx) => (
            <button
              type="button"
              class={`filter-btn px-4 py-2 rounded-full text-xs font-semibold transition cursor-pointer ${
                idx === 0
                  ? 'bg-primary-600 text-white shadow-sm'
                  : 'bg-white dark:bg-navy-900 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-white/10 hover:border-primary-400'
              }`}
              data-category={cat}
            >
              {cat}
            </button>
          ))}
        </div>
      )}

      <!-- Photo Grid -->
      <div id="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {galleryItems.map((img, i) => (
          <div
            data-aos="fade-up"
            data-aos-delay={i * 60}
            data-category={img.category || 'Wisata'}
            class="gallery-item aspect-[4/3] overflow-hidden rounded-2xl bg-slate-200 dark:bg-navy-900 group relative shadow-sm border border-slate-100 dark:border-white/5 transition-all duration-300 hover:shadow-xl cursor-pointer"
            data-full={img.image_url}
            data-title={img.title}
            data-category-label={img.category || 'Wisata'}
          >
            <img
              src={img.image_url}
              alt={img.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
              onerror="this.src='https://placehold.co/800x600?text=Dokumentasi+Jogja'"
            />
            
            <!-- Category Tag -->
            <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-[11px] font-bold bg-black/60 backdrop-blur-sm text-white shadow-xs z-10">
              {img.category || 'Wisata'}
            </span>

            <!-- Bottom Gradient with Title -->
            <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 via-navy-950/20 to-transparent opacity-90 group-hover:opacity-100 transition-opacity flex flex-col justify-end p-5">
              <h3 class="text-white font-bold text-base leading-snug drop-shadow-sm group-hover:text-primary-200 transition-colors">
                {img.title}
              </h3>
              <span class="text-primary-300 text-xs mt-1.5 flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-all duration-300 translate-y-2 group-hover:translate-y-0">
                <span>Klik untuk perbesar</span>
                <span>&rarr;</span>
              </span>
            </div>
          </div>
        ))}
      </div>

      <!-- Empty State if no photos -->
      {galleryItems.length === 0 && (
        <div class="py-20 text-center">
          <p class="text-slate-400 text-sm">Dokumentasi foto akan segera diperbarui.</p>
        </div>
      )}

      <!-- Bottom CTA Banner -->
      <div class="mt-20 p-8 sm:p-12 rounded-3xl bg-gradient-to-r from-navy-900 via-navy-950 to-primary-950 border border-white/10 text-center text-white relative overflow-hidden" data-aos="fade-up">
        <div class="relative z-10 max-w-2xl mx-auto space-y-4">
          <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-primary-500/20 text-primary-300 border border-primary-500/30">
            Liburan Bersama Kami
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">
            Ingin Mengabadikan Momen Seru di Jogja?
          </h2>
          <p class="text-sm text-slate-300 leading-relaxed font-light">
            Sewa mobil nyaman dengan driver ramah yang siap mengantar ke spot foto terbaik, candi megah, hingga pantai tersembunyi.
          </p>
          <div class="pt-3">
            <a
              href={getWhatsAppUrl("Halo Beyond Jogja Tours! Saya melihat dokumentasi liburan dan ingin konsultasi trip wisata.")}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-bold text-sm shadow-lg hover:shadow-primary-500/30 transition-all hover:-translate-y-0.5"
            >
              <span>Konsultasi Liburan via WhatsApp</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Fullscreen Lightbox Modal -->
  <div id="lightbox-modal" class="fixed inset-0 z-50 hidden bg-black/95 backdrop-blur-md flex flex-col justify-between p-4 sm:p-6 transition-opacity duration-300">
    <!-- Top Bar -->
    <div class="flex items-center justify-between text-white z-10">
      <div>
        <span id="lb-category" class="px-2.5 py-1 rounded-full text-xs font-bold bg-primary-600 text-white"></span>
        <h3 id="lb-title" class="text-sm sm:text-base font-bold mt-1 text-slate-100"></h3>
      </div>
      <button type="button" id="lb-close" class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center text-lg font-bold transition cursor-pointer">
        ✕
      </button>
    </div>

    <!-- Center Photo with Prev/Next buttons -->
    <div class="relative flex-1 flex items-center justify-center my-4 overflow-hidden">
      <button type="button" id="lb-prev" class="absolute left-2 sm:left-4 z-20 w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center text-xl transition cursor-pointer">
        &#10094;
      </button>

      <img id="lb-img" src="" alt="" class="max-h-[78vh] max-w-[92vw] object-contain rounded-xl shadow-2xl transition-transform duration-300 select-none" />

      <button type="button" id="lb-next" class="absolute right-2 sm:right-4 z-20 w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center text-xl transition cursor-pointer">
        &#10095;
      </button>
    </div>

    <!-- Bottom Caption -->
    <div class="text-center text-xs text-slate-400 pb-2">
      Gunakan tombol panah atau tombol keyboard <kbd class="px-1.5 py-0.5 bg-white/10 rounded">←</kbd> <kbd class="px-1.5 py-0.5 bg-white/10 rounded">→</kbd> untuk melihat foto lainnya. Tekan <kbd class="px-1.5 py-0.5 bg-white/10 rounded">ESC</kbd> untuk menutup.
    </div>
  </div>
</BaseLayout>

<script>
  function initGallery() {
    // 1. Filter Category
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const items = document.querySelectorAll<HTMLElement>('.gallery-item');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.category;
        filterBtns.forEach((b) => {
          b.classList.remove('bg-primary-600', 'text-white', 'shadow-sm');
          b.classList.add('bg-white', 'dark:bg-navy-900', 'text-slate-600', 'dark:text-slate-300');
        });
        btn.classList.add('bg-primary-600', 'text-white', 'shadow-sm');
        btn.classList.remove('bg-white', 'dark:bg-navy-900', 'text-slate-600', 'dark:text-slate-300');

        items.forEach((item) => {
          if (cat === 'Semua' || item.dataset.category === cat) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });

    // 2. Lightbox Modal
    const modal = document.getElementById('lightbox-modal');
    const lbImg = document.getElementById('lb-img') as HTMLImageElement;
    const lbTitle = document.getElementById('lb-title');
    const lbCategory = document.getElementById('lb-category');
    const lbClose = document.getElementById('lb-close');
    const lbPrev = document.getElementById('lb-prev');
    const lbNext = document.getElementById('lb-next');

    let currentIndex = 0;
    const visibleItems = () => Array.from(items).filter((it) => it.style.display !== 'none');

    function showPhoto(idx: number) {
      const vItems = visibleItems();
      if (idx < 0) idx = vItems.length - 1;
      if (idx >= vItems.length) idx = 0;
      currentIndex = idx;

      const target = vItems[currentIndex];
      if (!target) return;
      const fullUrl = target.dataset.full || '';
      const title = target.dataset.title || '';
      const catLabel = target.dataset.categoryLabel || '';

      if (lbImg) lbImg.src = fullUrl;
      if (lbTitle) lbTitle.textContent = title;
      if (lbCategory) lbCategory.textContent = catLabel;
    }

    items.forEach((item) => {
      item.addEventListener('click', () => {
        const vItems = visibleItems();
        const idx = vItems.indexOf(item);
        if (idx !== -1) {
          showPhoto(idx);
          modal?.classList.remove('hidden');
        }
      });
    });

    function closeLightbox() {
      modal?.classList.add('hidden');
    }

    lbClose?.addEventListener('click', closeLightbox);
    lbPrev?.addEventListener('click', () => showPhoto(currentIndex - 1));
    lbNext?.addEventListener('click', () => showPhoto(currentIndex + 1));

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeLightbox();
    });

    window.addEventListener('keydown', (e) => {
      if (!modal || modal.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') showPhoto(currentIndex - 1);
      if (e.key === 'ArrowRight') showPhoto(currentIndex + 1);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGallery);
  } else {
    initGallery();
  }
</script>
