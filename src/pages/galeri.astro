---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllGallery } from '../lib/gallery';
import { getWhatsAppUrl } from '../lib/constants';

const galleryItems = await getAllGallery();

// Hitung jumlah foto per kategori
const categoryCounts: Record<string, number> = { Semua: galleryItems.length };
galleryItems.forEach((i) => {
  const c = i.category || 'Wisata';
  categoryCounts[c] = (categoryCounts[c] || 0) + 1;
});

const uniqueCategories = Object.keys(categoryCounts).filter((c) => c !== 'Semua');
const categories = ['Semua', ...uniqueCategories];

const getCategoryEmoji = (cat: string) => {
  const c = cat.toLowerCase();
  if (c === 'semua') return '🌟';
  if (c.includes('candi') || c.includes('temple')) return '⛩️';
  if (c.includes('petualang') || c.includes('adventure') || c.includes('jeep')) return '🚙';
  if (c.includes('pantai') || c.includes('beach') || c.includes('laut')) return '🏖️';
  if (c.includes('budaya') || c.includes('culture') || c.includes('kraton') || c.includes('malioboro')) return '🏛️';
  if (c.includes('armada') || c.includes('mobil') || c.includes('car') || c.includes('driver')) return '🚐';
  if (c.includes('alam') || c.includes('nature') || c.includes('gunung')) return '🌄';
  if (c.includes('kuliner') || c.includes('food')) return '🍲';
  return '📸';
};
---

<BaseLayout 
  title="Galeri Dokumentasi Wisata & Trip Jogja - Beyond Jogja Tours" 
  description="Kumpulan dokumentasi foto perjalanan dan keseruan para tamu wisatawan bersama Beyond Jogja Tours di Candi Borobudur, Prambanan, Jeep Merapi, dan pantai eksotis Yogyakarta."
  image="https://images.unsplash.com/photo-1584852922119-94f71a93eeb1?auto=format&fit=crop&q=80&w=800"
>
  <!-- HERO HEADER SECTION -->
  <section class="bg-navy-950 text-white pt-32 pb-16 md:pt-44 md:pb-20 relative overflow-hidden">
    <!-- Starry & Glow Grid Background -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:50px_50px] z-0"></div>
    <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-primary-500/15 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full bg-teal-500/15 blur-3xl pointer-events-none"></div>

    <div class="container mx-auto px-4 text-center relative z-10" data-aos="fade-up">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md border border-white/15 rounded-full px-4 py-1.5 mb-6 text-primary-300 text-xs font-semibold tracking-wide">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Dokumentasi Nyata Wisatawan</span>
        <span class="text-white/30">•</span>
        <span class="text-white font-normal">{galleryItems.length}+ Momen Abadi</span>
      </div>

      <!-- Main Title -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[56px] font-extrabold tracking-tight text-white mb-4 leading-tight">
        Galeri Momen Liburan di Jogja
      </h1>

      <!-- Subtitle -->
      <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto font-light leading-relaxed">
        Kumpulan cerita dan senyuman wisatawan domestik maupun mancanegara yang menjelajahi megahnya candi, serunya petualangan alam, dan indahnya panorama Yogyakarta bersama kami.
      </p>

      <!-- Quick Search Bar -->
      <div class="max-w-md mx-auto mt-8 relative" data-aos="fade-up" data-aos-delay="100">
        <div class="relative flex items-center">
          <svg class="w-4 h-4 text-slate-400 absolute left-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            id="gallery-search-input"
            placeholder="Cari spot foto (misal: Borobudur, Prambanan, Jeep, Pantai)..."
            class="w-full pl-11 pr-10 py-3 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 text-white placeholder:text-slate-400 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-primary-400 focus:bg-white/15 transition shadow-lg"
          />
          <button
            type="button"
            id="btn-clear-search"
            class="hidden absolute right-3 w-6 h-6 rounded-full bg-white/10 hover:bg-white/20 text-slate-300 items-center justify-center text-xs transition cursor-pointer"
            title="Hapus pencarian"
          >
            ✕
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- MAIN GALLERY CONTENT SECTION -->
  <section class="py-12 md:py-20 bg-slate-50 dark:bg-navy-950 transition-colors duration-300 min-h-[700px]">
    <div class="container mx-auto px-4 max-w-7xl">

      <!-- TOOLBAR: FILTER KATEGORI & OPSI TAMPILAN UKURAN (BESAR / KECIL) -->
      <div class="mb-10 space-y-4">
        <div class="bg-white dark:bg-navy-900 rounded-3xl p-3 sm:p-4 shadow-sm border border-slate-200/80 dark:border-white/10 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          
          <!-- TAB KATEGORI WISATA -->
          <div class="flex flex-wrap items-center gap-2 overflow-x-auto pb-1 md:pb-0" id="category-tab-container">
            {categories.map((cat, idx) => (
              <button
                type="button"
                data-category={cat}
                class={`filter-cat-btn px-4 py-2 rounded-2xl text-xs font-bold transition-all duration-200 flex items-center gap-1.5 cursor-pointer whitespace-nowrap shadow-2xs ${
                  idx === 0
                    ? 'active bg-primary-600 text-white shadow-md shadow-primary-600/20'
                    : 'bg-slate-100 dark:bg-navy-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200/80 dark:hover:bg-navy-700'
                }`}
              >
                <span>{getCategoryEmoji(cat)}</span>
                <span>{cat}</span>
                <span class={`ml-1 px-1.5 py-0.2 rounded-full text-[10px] font-mono ${
                  idx === 0 ? 'bg-white/25 text-white' : 'bg-white dark:bg-navy-900 text-slate-500 dark:text-slate-400'
                }`}>
                  {categoryCounts[cat] || 0}
                </span>
              </button>
            ))}
          </div>

          <!-- KANAN: OPSI UKURAN GRID (BESAR VS KECIL) + COUNTER -->
          <div class="flex items-center justify-between md:justify-end gap-3 pt-2 md:pt-0 border-t md:border-t-0 border-slate-100 dark:border-white/10 shrink-0">
            <!-- Counter Teks -->
            <div class="text-xs text-slate-500 dark:text-slate-400 font-medium">
              <span id="visible-count-text">{galleryItems.length}</span> dari {galleryItems.length} foto
            </div>

            <!-- Grid View Mode Switcher -->
            <div class="inline-flex items-center p-1 rounded-2xl bg-slate-100 dark:bg-navy-800 border border-slate-200/70 dark:border-white/10">
              <button
                type="button"
                id="view-btn-comfortable"
                class="view-toggle-btn active px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 cursor-pointer bg-white dark:bg-navy-900 text-primary-600 dark:text-primary-400 shadow-xs"
                title="Tampilan Gambar Besar (3 Kolom)"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                </svg>
                <span>Besar</span>
              </button>

              <button
                type="button"
                id="view-btn-compact"
                class="view-toggle-btn px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 cursor-pointer text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white"
                title="Tampilan Gambar Kecil / Kompak (4-5 Kolom)"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                </svg>
                <span>Kecil (Kompak)</span>
              </button>
            </div>
          </div>

        </div>
      </div>

      <!-- PHOTO GRID CONTAINER (Default: Comfortable / Besar 3 Kolom) -->
      <div
        id="gallery-grid"
        class="view-comfortable grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 transition-all duration-300"
      >
        {galleryItems.map((img, i) => (
          <div
            data-category={img.category || 'Wisata'}
            data-title={img.title}
            data-full={img.image_url}
            data-index={i}
            class="gallery-item group relative overflow-hidden rounded-3xl bg-slate-200 dark:bg-navy-900 shadow-xs hover:shadow-2xl border border-slate-200/80 dark:border-white/10 transition-all duration-300 cursor-pointer hover:-translate-y-1"
          >
            <!-- Image Frame -->
            <div class="img-frame w-full h-full aspect-[4/3] overflow-hidden bg-slate-900 relative">
              <img
                src={img.image_url}
                alt={img.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-700 ease-out"
                onerror="this.src='https://placehold.co/800x600?text=Dokumentasi+Wisata'"
              />

              <!-- Top Left: Category Badge -->
              <div class="absolute top-3 left-3 z-10 flex items-center gap-1.5">
                <span class="px-3 py-1 rounded-full text-[11px] font-extrabold bg-navy-950/80 backdrop-blur-md text-white border border-white/15 shadow-sm flex items-center gap-1">
                  <span>{getCategoryEmoji(img.category || 'Wisata')}</span>
                  <span>{img.category || 'Wisata'}</span>
                </span>
              </div>

              <!-- Top Right: Zoom Icon Badge on Hover -->
              <div class="absolute top-3 right-3 z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <span class="w-8 h-8 rounded-full bg-white/90 dark:bg-navy-900/90 backdrop-blur-md text-slate-800 dark:text-white flex items-center justify-center shadow-md">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                  </svg>
                </span>
              </div>

              <!-- Bottom Gradient Overlay with Title -->
              <div class="absolute inset-0 bg-gradient-to-t from-navy-950/90 via-navy-950/30 to-transparent opacity-90 group-hover:opacity-100 transition-opacity flex flex-col justify-end p-4 sm:p-5">
                <h3 class="card-caption text-white font-extrabold text-sm sm:text-base leading-snug drop-shadow-sm group-hover:text-primary-300 transition-colors line-clamp-2">
                  {img.title}
                </h3>
                <div class="card-extra flex items-center justify-between text-[11px] text-slate-300 mt-2 opacity-0 group-hover:opacity-100 transition-all duration-300 translate-y-2 group-hover:translate-y-0">
                  <span class="flex items-center gap-1 text-primary-300 font-semibold">
                    <span>Lihat Ukuran Penuh</span>
                    <span>↗</span>
                  </span>
                  <span class="text-white/60">Klik Foto</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- NO RESULTS PLACEHOLDER (Jika filter / search tidak cocok) -->
      <div id="no-results-box" class="hidden py-24 text-center">
        <div class="w-16 h-16 rounded-3xl bg-slate-100 dark:bg-navy-900 text-slate-400 flex items-center justify-center text-3xl mx-auto mb-3">
          🔍
        </div>
        <h3 class="text-base font-bold text-slate-800 dark:text-white">Tidak Ada Foto Ditemukan</h3>
        <p class="text-xs text-slate-400 mt-1 max-w-sm mx-auto">
          Coba pilih kategori lain atau gunakan kata kunci pencarian yang lebih umum.
        </p>
        <button
          type="button"
          id="btn-reset-filters"
          class="mt-4 px-4 py-2 rounded-xl bg-primary-600 hover:bg-primary-500 text-white text-xs font-bold transition cursor-pointer"
        >
          Tampilkan Semua Foto
        </button>
      </div>

      <!-- BOTTOM CTA BANNER: KONSULTASI TRIP DARI FOTO -->
      <div class="mt-20 p-8 sm:p-12 rounded-3xl bg-gradient-to-r from-navy-950 via-navy-900 to-slate-900 border border-white/10 text-center text-white relative overflow-hidden shadow-2xl" data-aos="fade-up">
        <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-primary-500/20 blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-72 h-72 rounded-full bg-emerald-500/15 blur-3xl pointer-events-none"></div>

        <div class="relative z-10 max-w-2xl mx-auto space-y-4">
          <span class="inline-block px-3.5 py-1 rounded-full text-xs font-extrabold bg-primary-500/20 text-primary-300 border border-primary-500/30">
            Liburan Seru Anti Ribet
          </span>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight">
            Ingin Mengabadikan Momen Seperti Ini di Jogja?
          </h2>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-light">
            Sewa mobil nyaman dengan driver ramah yang siap jadi fotografer dadakan dan mengantar Anda ke spot-spot terindah di Jogja.
          </p>
          <div class="pt-3">
            <a
              href={getWhatsAppUrl("Halo Beyond Jogja Tours! Saya melihat dokumentasi liburan di website dan ingin konsultasi trip wisata ke spot-spot ini.")}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 px-8 py-3.5 rounded-2xl bg-gradient-to-r from-primary-600 to-primary-500 hover:from-primary-500 hover:to-primary-400 text-white font-extrabold text-sm shadow-xl shadow-primary-600/30 transition-all hover:-translate-y-0.5 active:scale-95"
            >
              <span>Konsultasi Liburan via WhatsApp</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- FULLSCREEN LIGHTBOX VIEWER WITH SPOT INQUIRY WHATSAPP BUTTON -->
  <!-- ========================================================================= -->
  <div
    id="lightbox-modal"
    class="fixed inset-0 z-50 hidden bg-navy-950/95 backdrop-blur-md flex flex-col justify-between p-4 sm:p-6 transition-opacity duration-300 select-none"
  >
    <!-- Top Header Bar -->
    <div class="flex items-center justify-between text-white z-20 shrink-0">
      <div class="flex items-center gap-3 min-w-0 pr-4">
        <span id="lb-category" class="px-3 py-1 rounded-full text-xs font-extrabold bg-primary-600 text-white shrink-0">
          Wisata
        </span>
        <div class="truncate">
          <h3 id="lb-title" class="text-sm sm:text-base font-extrabold text-white truncate leading-snug"></h3>
          <p id="lb-counter" class="text-[11px] text-slate-400 font-mono mt-0.5">Foto 1 dari 10</p>
        </div>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <!-- Direct Lead WhatsApp Button for this specific photo -->
        <a
          id="lb-wa-btn"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold shadow-md transition active:scale-95"
          title="Tanyakan paket wisata atau sewa mobil ke spot ini"
        >
          <span>💬 Mau Trip ke Sini?</span>
        </a>

        <button
          type="button"
          id="lb-close"
          class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center text-lg font-bold transition cursor-pointer"
          aria-label="Tutup pratinjau"
        >
          ✕
        </button>
      </div>
    </div>

    <!-- Center Photo with Nav Arrows -->
    <div class="relative flex-1 flex items-center justify-center my-3 overflow-hidden">
      <button
        type="button"
        id="lb-prev"
        class="absolute left-2 sm:left-4 z-20 w-12 h-12 rounded-full bg-white/15 hover:bg-white/25 active:scale-90 text-white flex items-center justify-center text-2xl transition cursor-pointer backdrop-blur-xs"
        aria-label="Foto sebelumnya"
      >
        &#10094;
      </button>

      <img
        id="lb-img"
        src=""
        alt=""
        class="max-h-[75vh] max-w-[92vw] object-contain rounded-2xl shadow-2xl transition-transform duration-300 select-none"
      />

      <button
        type="button"
        id="lb-next"
        class="absolute right-2 sm:right-4 z-20 w-12 h-12 rounded-full bg-white/15 hover:bg-white/25 active:scale-90 text-white flex items-center justify-center text-2xl transition cursor-pointer backdrop-blur-xs"
        aria-label="Foto berikutnya"
      >
        &#10095;
      </button>
    </div>

    <!-- Bottom Action Bar & Navigation Hints -->
    <div class="text-center text-xs text-slate-400 pb-2 flex flex-col sm:flex-row items-center justify-between gap-3 shrink-0 px-2">
      <!-- Mobile WA button -->
      <a
        id="lb-wa-btn-mobile"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="sm:hidden w-full inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl bg-emerald-600 text-white text-xs font-bold"
      >
        <span>💬 Mau Trip ke Spot Ini? Chat via WA</span>
      </a>

      <div class="hidden sm:block text-slate-400 text-[11px]">
        Gunakan tombol panah keyboard <kbd class="px-1.5 py-0.5 bg-white/10 rounded font-mono">←</kbd> <kbd class="px-1.5 py-0.5 bg-white/10 rounded font-mono">→</kbd> atau swipe layar di HP. Tekan <kbd class="px-1.5 py-0.5 bg-white/10 rounded font-mono">ESC</kbd> untuk keluar.
      </div>

      <div class="text-slate-400 text-[11px]">
        Beyond Jogja Tours & Rental Official Gallery
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* GAYA KHUSUS MODE KOMPAK / KECIL */
  #gallery-grid.view-compact {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 0.875rem !important;
  }
  @media (min-width: 640px) {
    #gallery-grid.view-compact {
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
      gap: 1rem !important;
    }
  }
  @media (min-width: 768px) {
    #gallery-grid.view-compact {
      grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    }
  }
  @media (min-width: 1024px) {
    #gallery-grid.view-compact {
      grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
    }
  }

  #gallery-grid.view-compact .img-frame {
    aspect-ratio: 1 / 1 !important;
    border-radius: 1.25rem !important;
  }
  #gallery-grid.view-compact .gallery-item {
    border-radius: 1.25rem !important;
  }
  #gallery-grid.view-compact .card-caption {
    font-size: 0.8125rem !important;
    line-height: 1.2 !important;
    -webkit-line-clamp: 1 !important;
  }
  #gallery-grid.view-compact .card-extra {
    display: none !important;
  }
</style>

<script is:inline>
  (() => {
    const grid = document.getElementById('gallery-grid');
    const items = Array.from(document.querySelectorAll('.gallery-item'));
    const catBtns = document.querySelectorAll('.filter-cat-btn');
    const searchInput = document.getElementById('gallery-search-input');
    const btnClearSearch = document.getElementById('btn-clear-search');
    const noResultsBox = document.getElementById('no-results-box');
    const visibleCountText = document.getElementById('visible-count-text');
    const btnResetFilters = document.getElementById('btn-reset-filters');

    // Switcher buttons
    const btnComfortable = document.getElementById('view-btn-comfortable');
    const btnCompact = document.getElementById('view-btn-compact');

    let activeCategory = 'Semua';
    let searchQuery = '';

    // ==========================================
    // 1. OPSI TAMPILAN UKURAN (BESAR VS KECIL)
    // ==========================================
    const setViewMode = (mode) => {
      if (!grid) return;
      if (mode === 'compact') {
        grid.classList.remove('view-comfortable', 'grid-cols-1', 'sm:grid-cols-2', 'lg:grid-cols-3', 'gap-6');
        grid.classList.add('view-compact');
        btnCompact?.classList.add('bg-white', 'dark:bg-navy-900', 'text-primary-600', 'dark:text-primary-400', 'shadow-xs');
        btnCompact?.classList.remove('text-slate-600', 'dark:text-slate-400');
        btnComfortable?.classList.remove('bg-white', 'dark:bg-navy-900', 'text-primary-600', 'dark:text-primary-400', 'shadow-xs');
        btnComfortable?.classList.add('text-slate-600', 'dark:text-slate-400');
        localStorage.setItem('beyond-gallery-view', 'compact');
      } else {
        grid.classList.remove('view-compact');
        grid.classList.add('view-comfortable', 'grid-cols-1', 'sm:grid-cols-2', 'lg:grid-cols-3', 'gap-6');
        btnComfortable?.classList.add('bg-white', 'dark:bg-navy-900', 'text-primary-600', 'dark:text-primary-400', 'shadow-xs');
        btnComfortable?.classList.remove('text-slate-600', 'dark:text-slate-400');
        btnCompact?.classList.remove('bg-white', 'dark:bg-navy-900', 'text-primary-600', 'dark:text-primary-400', 'shadow-xs');
        btnCompact?.classList.add('text-slate-600', 'dark:text-slate-400');
        localStorage.setItem('beyond-gallery-view', 'comfortable');
      }
    };

    btnComfortable?.addEventListener('click', () => setViewMode('comfortable'));
    btnCompact?.addEventListener('click', () => setViewMode('compact'));

    // Muat preferensi ukuran dari localStorage
    const savedMode = localStorage.getItem('beyond-gallery-view') || 'comfortable';
    setViewMode(savedMode);

    // ==========================================
    // 2. FILTER KATEGORI & PENCARIAN REAL-TIME
    // ==========================================
    const applyFilters = () => {
      let visibleCount = 0;
      const q = searchQuery.toLowerCase().trim();

      items.forEach((item) => {
        const itemCat = item.getAttribute('data-category') || 'Wisata';
        const itemTitle = (item.getAttribute('data-title') || '').toLowerCase();

        const matchCat = activeCategory === 'Semua' || itemCat.toLowerCase() === activeCategory.toLowerCase();
        const matchSearch = !q || itemTitle.includes(q) || itemCat.toLowerCase().includes(q);

        if (matchCat && matchSearch) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (visibleCountText) visibleCountText.textContent = String(visibleCount);

      if (visibleCount === 0) {
        grid?.classList.add('hidden');
        noResultsBox?.classList.remove('hidden');
      } else {
        grid?.classList.remove('hidden');
        noResultsBox?.classList.add('hidden');
      }
    };

    // Category button clicks
    catBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category') || 'Semua';
        activeCategory = cat;

        catBtns.forEach((b) => {
          b.classList.remove('active', 'bg-primary-600', 'text-white', 'shadow-md', 'shadow-primary-600/20');
          b.classList.add('bg-slate-100', 'dark:bg-navy-800', 'text-slate-700', 'dark:text-slate-300');
          const badge = b.querySelector('span:last-child');
          if (badge) {
            badge.className = 'ml-1 px-1.5 py-0.2 rounded-full text-[10px] font-mono bg-white dark:bg-navy-900 text-slate-500 dark:text-slate-400';
          }
        });

        btn.classList.add('active', 'bg-primary-600', 'text-white', 'shadow-md', 'shadow-primary-600/20');
        btn.classList.remove('bg-slate-100', 'dark:bg-navy-800', 'text-slate-700', 'dark:text-slate-300');
        const activeBadge = btn.querySelector('span:last-child');
        if (activeBadge) {
          activeBadge.className = 'ml-1 px-1.5 py-0.2 rounded-full text-[10px] font-mono bg-white/25 text-white';
        }

        applyFilters();
      });
    });

    // Search input
    searchInput?.addEventListener('input', (e) => {
      searchQuery = e.target.value;
      if (btnClearSearch) {
        if (searchQuery) {
          btnClearSearch.classList.remove('hidden');
          btnClearSearch.classList.add('flex');
        } else {
          btnClearSearch.classList.add('hidden');
          btnClearSearch.classList.remove('flex');
        }
      }
      applyFilters();
    });

    btnClearSearch?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      btnClearSearch.classList.add('hidden');
      btnClearSearch.classList.remove('flex');
      applyFilters();
    });

    btnResetFilters?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      activeCategory = 'Semua';
      catBtns[0]?.click();
    });

    // Cek query parameter URL (misal: /galeri?kategori=Candi)
    const urlParams = new URLSearchParams(window.location.search);
    const catQuery = urlParams.get('kategori') || urlParams.get('category');
    if (catQuery) {
      catBtns.forEach((b) => {
        if (b.getAttribute('data-category')?.toLowerCase() === catQuery.toLowerCase()) {
          b.click();
        }
      });
    }

    // ==========================================
    // 3. FULLSCREEN LIGHTBOX & TOUCH SWIPE
    // ==========================================
    const modal = document.getElementById('lightbox-modal');
    const lbImg = document.getElementById('lb-img');
    const lbTitle = document.getElementById('lb-title');
    const lbCategory = document.getElementById('lb-category');
    const lbCounter = document.getElementById('lb-counter');
    const lbClose = document.getElementById('lb-close');
    const lbPrev = document.getElementById('lb-prev');
    const lbNext = document.getElementById('lb-next');
    const lbWaBtn = document.getElementById('lb-wa-btn');
    const lbWaBtnMobile = document.getElementById('lb-wa-btn-mobile');

    let currentIndex = 0;
    const getVisibleItems = () => items.filter((it) => it.style.display !== 'none');

    const updateLightboxPhoto = (idx) => {
      const vItems = getVisibleItems();
      if (vItems.length === 0) return;

      if (idx < 0) idx = vItems.length - 1;
      if (idx >= vItems.length) idx = 0;
      currentIndex = idx;

      const target = vItems[currentIndex];
      if (!target) return;

      const fullUrl = target.getAttribute('data-full') || '';
      const title = target.getAttribute('data-title') || 'Foto Wisata Jogja';
      const category = target.getAttribute('data-category') || 'Wisata';

      if (lbImg) lbImg.src = fullUrl;
      if (lbTitle) lbTitle.textContent = title;
      if (lbCategory) lbCategory.textContent = category;
      if (lbCounter) lbCounter.textContent = `Foto ${currentIndex + 1} dari ${vItems.length}`;

      const waMsg = encodeURIComponent(
        `Halo Beyond Jogja Tours, saya melihat foto "${title}" (${category}) di galeri website dan tertarik ingin trip/sewa mobil ke destinasi ini. Boleh minta info paketnya?`
      );
      const waUrl = `https://api.whatsapp.com/send?phone=6285213814714&text=${waMsg}`;
      if (lbWaBtn) lbWaBtn.href = waUrl;
      if (lbWaBtnMobile) lbWaBtnMobile.href = waUrl;
    };

    items.forEach((item) => {
      item.addEventListener('click', () => {
        const vItems = getVisibleItems();
        const idx = vItems.indexOf(item);
        if (idx !== -1) {
          updateLightboxPhoto(idx);
          modal?.classList.remove('hidden');
          modal?.classList.add('flex');
          document.body.style.overflow = 'hidden';
        }
      });
    });

    const closeLightbox = () => {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
      document.body.style.overflow = '';
    };

    lbClose?.addEventListener('click', closeLightbox);
    lbPrev?.addEventListener('click', (e) => {
      e.stopPropagation();
      updateLightboxPhoto(currentIndex - 1);
    });
    lbNext?.addEventListener('click', (e) => {
      e.stopPropagation();
      updateLightboxPhoto(currentIndex + 1);
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeLightbox();
    });

    // Keyboard navigation
    window.addEventListener('keydown', (e) => {
      if (!modal || modal.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') updateLightboxPhoto(currentIndex - 1);
      if (e.key === 'ArrowRight') updateLightboxPhoto(currentIndex + 1);
    });

    // Mobile touch swipe support
    let touchStartX = 0;
    let touchEndX = 0;

    modal?.addEventListener(
      'touchstart',
      (e) => {
        touchStartX = e.changedTouches[0].screenX;
      },
      { passive: true }
    );

    modal?.addEventListener(
      'touchend',
      (e) => {
        touchEndX = e.changedTouches[0].screenX;
        const diffX = touchEndX - touchStartX;
        if (Math.abs(diffX) > 50) {
          if (diffX > 0) {
            updateLightboxPhoto(currentIndex - 1); // Swipe kanan -> Prev
          } else {
            updateLightboxPhoto(currentIndex + 1); // Swipe kiri -> Next
          }
        }
      },
      { passive: true }
    );
  })();
</script>
