---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllCars } from '../lib/cars';
import { getSiteSettings, formatWhatsAppUrl } from '../lib/settings';

const cars = await getAllCars();
const settings = await getSiteSettings();
---

<BaseLayout 
  title="Katalog Rental Mobil Jogja - Beyond Jogja Tours" 
  description="Pilihan sewa mobil murah di Jogja lepas kunci atau dengan driver. Unit All New Avanza, Innova Reborn, Hiace, Fortuner terawat & siap antar-jemput."
  image="/rentalmobil.jpg"
>
  <!-- Hero Section ala GetYourGuide -->
  <section class="bg-navy-950 text-white pt-32 pb-16 md:pt-44 md:pb-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:60px_60px] z-0"></div>
    <div class="absolute top-1/4 -right-20 w-96 h-96 rounded-full bg-primary-500/10 blur-3xl z-0"></div>
    <div class="absolute bottom-0 left-10 w-72 h-72 rounded-full bg-primary-400/5 blur-3xl z-0"></div>

    <div class="container mx-auto px-4 relative z-10 text-center max-w-4xl" data-aos="fade-up">
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight mb-5 leading-tight">
        Sewa Mobil di Jogja <br class="hidden sm:inline" />
        <span class="text-primary-400">Nyaman, Bersih & Fleksibel</span>
      </h1>

      <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto font-light leading-relaxed">
        Pilihan armada terlengkap untuk liburan, dinas kerja, maupun rombongan keluarga. Siap lepas kunci atau lengkap dengan driver ramah berpengalaman.
      </p>

      <!-- Trust Badges Bar -->
      <div class="mt-8 pt-8 border-t border-white/10 flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-xs text-slate-300">
        <div class="flex items-center gap-2">
          <span class="text-primary-400 text-base">🧼</span>
          <span>100% Unit Bersih & Prima</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-primary-400 text-base">👨‍✈️</span>
          <span>Driver Ramah & Hafal Rute</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-primary-400 text-base">🔑</span>
          <span>Lepas Kunci / All-in Driver</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-primary-400 text-base">🚉</span>
          <span>Antar-Jemput Bandara & Stasiun</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Car Catalog Section -->
  <section class="py-16 md:py-24 bg-slate-50 dark:bg-navy-950 transition-colors duration-300 min-h-screen">
    <div class="container mx-auto px-4 max-w-7xl">
      <!-- Section Header with count -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 pb-6 border-b border-slate-200/80 dark:border-white/10">
        <div>
          <p class="text-xs uppercase tracking-widest font-semibold text-primary-600 dark:text-primary-400 mb-1">Armada Pilihan</p>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">Daftar Rental Mobil Jogja</h2>
        </div>
        <div class="text-sm text-slate-500 dark:text-slate-400">
          Menampilkan <strong class="text-slate-900 dark:text-white">{cars.length} unit</strong> kendaraan siap jalan
        </div>
      </div>

      <!-- Cars Grid ala GetYourGuide Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {cars.map((car, index) => {
          const waMessage = car.data.whatsappMessage || `Halo Beyond Jogja! Saya ingin sewa mobil ${car.data.title}`;
          const waUrl = formatWhatsAppUrl(settings.whatsapp_number, waMessage);

          return (
            <article
              data-aos="fade-up"
              data-aos-delay={index * 80}
              class="group bg-white dark:bg-navy-900 rounded-2xl overflow-hidden border border-slate-200/90 dark:border-white/10 hover:border-primary-400 dark:hover:border-primary-500/40 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col"
            >
              <!-- Card Image & Badges -->
              <div class="block h-56 sm:h-60 overflow-hidden relative shrink-0 bg-slate-100 dark:bg-navy-800">
                <img
                  src={car.data.thumbnail}
                  alt={car.data.title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                  onerror="this.src='https://placehold.co/600x400?text=Mobil+Rental'"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>

                <!-- Floating Top Badges -->
                <div class="absolute top-3.5 left-3.5 right-3.5 flex items-center justify-between pointer-events-none">
                  {car.data.badge && (
                    <span class="bg-primary-600/95 backdrop-blur-sm text-white text-[11px] font-bold px-3 py-1 rounded-full shadow-md uppercase tracking-wider">
                      {car.data.badge}
                    </span>
                  )}
                  <span class="bg-black/60 backdrop-blur-sm text-white text-[11px] font-medium px-2.5 py-1 rounded-full flex items-center gap-1 shadow-sm ml-auto">
                    ⚙️ {car.data.transmission || 'Manual/Matic'}
                  </span>
                </div>

                <!-- Floating Bottom Title Tag in Image for readability -->
                <div class="absolute bottom-3.5 left-4 right-4">
                  <span class="text-xs text-primary-300 font-semibold uppercase tracking-wider">Beyond Rental</span>
                  <h3 class="text-white text-lg font-bold leading-snug line-clamp-1 group-hover:text-primary-200 transition-colors">
                    {car.data.title}
                  </h3>
                </div>
              </div>

              <!-- Card Body -->
              <div class="p-6 flex flex-col flex-grow justify-between gap-5">
                <div>
                  <!-- Capacity & Transmission Row -->
                  <div class="flex items-center justify-between text-xs mb-3 pb-3 border-b border-slate-100 dark:border-white/5">
                    <div class="flex items-center gap-1.5 text-slate-700 dark:text-slate-200 font-semibold">
                      <span>👥 Kapasitas:</span>
                      <span>{car.data.capacity || '6-7 Orang'}</span>
                    </div>

                    <div class="flex items-center gap-1 text-emerald-600 dark:text-emerald-400 font-medium">
                      <span>●</span>
                      <span>Unit Siap Jalan</span>
                    </div>
                  </div>

                  <!-- Facilities / Features Chips -->
                  <div class="mb-3">
                    <p class="text-[11px] uppercase tracking-wider font-semibold text-slate-400 mb-2">Fasilitas Termasuk:</p>
                    <div class="flex flex-wrap gap-1.5">
                      {car.data.features && car.data.features.length > 0 ? (
                        car.data.features.map(f => (
                          <span class="bg-slate-100 dark:bg-navy-800 text-slate-600 dark:text-slate-300 text-[11px] font-medium px-2 py-0.5 rounded-md">
                            ✓ {f}
                          </span>
                        ))
                      ) : (
                        <span class="bg-slate-100 dark:bg-navy-800 text-slate-600 dark:text-slate-300 text-[11px] font-medium px-2 py-0.5 rounded-md">
                          ✓ AC Dingin & Audio
                        </span>
                      )}
                    </div>
                  </div>
                </div>

                <!-- Price Block & Action Buttons (GetYourGuide style) -->
                <div class="pt-4 border-t border-slate-100 dark:border-white/10 mt-auto">
                  <div class="flex items-baseline justify-between mb-3.5">
                    <div>
                      <span class="text-[11px] uppercase tracking-wider text-slate-400 block font-medium">Mulai dari</span>
                      <div class="flex items-baseline gap-1">
                        <span class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">
                          {car.data.price || 'Rp 400.000'}
                        </span>
                        <span class="text-xs text-slate-400 font-normal">
                          {car.data.priceUnit || '/ hari'}
                        </span>
                      </div>
                    </div>

                    <span class="text-xs font-semibold text-primary-600 dark:text-primary-400">
                      Bisa Lepas Kunci
                    </span>
                  </div>

                  <!-- Action Buttons -->
                  <div class="grid grid-cols-1 gap-2.5">
                    <a
                      href={waUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-center py-2.5 px-3 rounded-xl bg-primary-600 hover:bg-primary-700 text-white font-semibold text-xs transition shadow-sm hover:shadow flex items-center justify-center gap-2"
                    >
                      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
                      </svg>
                      Booking / Sewa via WhatsApp
                    </a>
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Bottom Helper / Custom Fleet Box -->
      <div class="mt-20 bg-white dark:bg-navy-900 rounded-3xl p-8 sm:p-12 border border-slate-200/80 dark:border-white/10 shadow-sm text-center max-w-3xl mx-auto" data-aos="fade-up">
        <span class="text-3xl mb-3 block">🚐</span>
        <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-3">Butuh Kendaraan Lain atau Rombongan Besar?</h3>
        <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-6">
          Kami juga melayani sewa <strong>Medium Bus (30-35 seat)</strong>, <strong>Big Bus Pariwisata (50 seat)</strong>, Alphard VIP, hingga sewa bulanan perusahaan. Konsultasikan kebutuhan transportasi kamu langsung dengan admin!
        </p>
        <a
          href={formatWhatsAppUrl(settings.whatsapp_number, 'Halo Beyond Jogja! Saya ingin tanya ketersediaan sewa kendaraan rombongan / tipe lainnya.')}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-primary-600 hover:bg-primary-700 text-white font-semibold px-7 py-3.5 rounded-xl transition shadow-md hover:-translate-y-0.5 text-sm"
        >
          Hubungi Admin Rental via WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
