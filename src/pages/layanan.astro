---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getWhatsAppUrl } from '../lib/constants';

const cars = await getCollection('cars');
---

<BaseLayout title="Layanan Rental Mobil" description="Daftar armada rental mobil terbaik dan termurah di Jogja.">
  <!-- Hero -->
  <div class="bg-navy-950 text-white pt-32 pb-20 md:pt-44 relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.015)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.015)_1px,transparent_1px)] bg-[size:60px_60px] z-0"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 rounded-full bg-primary-500/5 blur-3xl z-0"></div>
    <div class="container mx-auto px-4 text-center relative z-10" data-aos="fade-up">
      <div class="inline-flex items-center gap-2 bg-primary-500/10 border border-primary-500/20 rounded-full px-3 py-1.5 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-primary-400"></span>
        <span class="text-primary-300 text-xs font-medium tracking-wider">Armada Kami</span>
      </div>
      <h1 class="text-4xl md:text-[54px] font-bold tracking-display mb-4">Katalog <span class="text-primary-400">Rental Mobil</span></h1>
      <p class="text-slate-400 text-base max-w-xl mx-auto font-light leading-relaxed">Pilihan unit selalu bersih, terawat, dan siap antar jemput lokasi kamu.</p>
    </div>
  </div>

  <section class="py-24 bg-slate-50 dark:bg-navy-950 transition-colors duration-300 min-h-screen">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {cars.map((car, index) => (
          <div data-aos="fade-up" data-aos-delay={index * 80} class="tilt-card bg-white dark:bg-navy-900 rounded-2xl border border-slate-100 dark:border-white/8 hover:border-primary-200 dark:hover:border-primary-500/20 shadow-sm hover:shadow-lg transition-all duration-300 group overflow-hidden">
            <div class="bg-slate-50 dark:bg-navy-800/50 p-6 flex items-center justify-center h-56 overflow-hidden transition-colors">
              <img src={car.data.thumbnail} alt={car.data.title} class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="p-6">
              <div class="flex justify-between items-start mb-3">
                <h3 class="text-base font-semibold text-slate-900 dark:text-white transition-colors">{car.data.title}</h3>
                <span class="bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-medium px-2.5 py-1 rounded-full border border-emerald-100 dark:border-emerald-500/20 transition-colors">Tersedia</span>
              </div>
              <p class="text-xl font-bold text-primary-600 dark:text-primary-400 mb-1">{car.data.priceLabel}</p>
              <p class="text-xs text-slate-400 dark:text-slate-500 font-medium mb-5 transition-colors">per hari</p>
              <div class="mb-3">
                <p class="text-xs font-medium text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2 transition-colors">Fasilitas:</p>
                <div class="flex flex-wrap gap-1.5">
                  {car.data.features.map(f => (
                    <span class="bg-slate-100 dark:bg-navy-800 text-slate-500 dark:text-slate-300 text-xs font-medium px-2.5 py-1 rounded-lg transition-colors">{f}</span>
                  ))}
                </div>
              </div>
              <a
                href={getWhatsAppUrl(car.data.whatsappMessage)}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 block w-full text-center bg-primary-600 text-white py-2.5 rounded-xl text-sm font-semibold hover:bg-primary-700 transition-colors"
              >
                Booking Sekarang
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
