---
import { sql } from '../../lib/db';
import { createSessionToken, verifySessionToken } from '../../lib/auth';
import bcrypt from 'bcryptjs';

if (verifySessionToken(Astro.cookies.get('admin_session')?.value)) {
  return Astro.redirect('/admin');
}

let errorMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const username = formData.get('username')?.toString().trim() || '';
    const password = formData.get('password')?.toString() || '';

    if (!username || !password) {
      errorMessage = 'Username dan password wajib diisi.';
    } else {
      const rows = await sql`SELECT id, username, password_hash FROM admins WHERE username = ${username} LIMIT 1;`;

      if (rows.length > 0 && bcrypt.compareSync(password, rows[0].password_hash)) {
        Astro.cookies.set('admin_session', createSessionToken(rows[0].username), {
          path: '/',
          httpOnly: true,
          secure: import.meta.env.PROD,
          sameSite: 'lax',
          maxAge: 60 * 60 * 24 * 7,
        });
        return Astro.redirect('/admin');
      }
      errorMessage = 'Username atau password salah.';
    }
  } catch (err: any) {
    console.error('Login error:', err);
    errorMessage = 'Terjadi kesalahan pada server. Coba lagi.';
  }
}
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Login Admin | Beyond Jogja Tours</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline>
    const savedTheme = localStorage.getItem('admin-theme');
    if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    }
  </script>
</head>
<body class="font-sans antialiased min-h-screen bg-navy-950 relative overflow-hidden flex items-center justify-center p-4">
  <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-primary-500/20 blur-3xl"></div>
  <div class="absolute -bottom-32 -right-32 w-96 h-96 rounded-full bg-primary-400/10 blur-3xl"></div>

  <div class="relative w-full max-w-md">
    <div class="text-center mb-8">
      <img src="/logo.png" alt="Beyond Jogja Tours" class="w-16 h-16 mx-auto rounded-full object-contain shadow-xl ring-4 ring-primary-500/20 block" />
      <h1 class="mt-4 text-2xl font-bold text-white">Beyond Jogja Admin</h1>
      <p class="text-sm text-slate-400 mt-1">Masuk untuk mengelola website</p>
    </div>

    <div class="bg-white dark:bg-navy-900 rounded-3xl shadow-2xl p-8 border border-transparent dark:border-slate-800">
      {errorMessage && (
        <div class="mb-5 px-4 py-3 rounded-xl bg-red-50 dark:bg-red-950/50 border border-red-200 dark:border-red-900 text-red-600 dark:text-red-400 text-sm">{errorMessage}</div>
      )}

      <form method="POST" class="space-y-5">
        <div>
          <label for="username" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Username</label>
          <input id="username" name="username" type="text" required autofocus autocomplete="username"
            class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-navy-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-4 focus:ring-primary-500/10 focus:border-primary-500 transition" />
        </div>

        <div>
          <label for="password" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Password</label>
          <div class="relative">
            <input id="password" name="password" type="password" required autocomplete="current-password"
              class="w-full px-4 py-3 pr-16 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-navy-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-4 focus:ring-primary-500/10 focus:border-primary-500 transition" />
            <button type="button" id="toggle-pw" class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-white">Tampilkan</button>
          </div>
        </div>

        <button type="submit" class="w-full bg-primary-600 hover:bg-primary-700 text-white font-semibold py-3 rounded-xl transition shadow-sm">
          Masuk
        </button>
      </form>
    </div>

    <p class="text-center mt-6 text-sm"><a href="/" class="text-slate-400 hover:text-white transition">&larr; Kembali ke website</a></p>
  </div>

  <script is:inline>
    const pw = document.getElementById('password');
    const btn = document.getElementById('toggle-pw');
    btn.addEventListener('click', () => {
      const show = pw.type === 'password';
      pw.type = show ? 'text' : 'password';
      btn.textContent = show ? 'Sembunyikan' : 'Tampilkan';
    });
  </script>
</body>
</html>
