---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { sql } from '../../../lib/db';
import { verifySessionToken } from '../../../lib/auth';

const user = verifySessionToken(Astro.cookies.get('admin_session')?.value);
if (!user) {
  return Astro.redirect('/admin/login');
}

let flash: { type: 'success' | 'error'; text: string } | null = null;
const statusFilter = Astro.url.searchParams.get('status') || 'semua';

// Handle Actions (Update Status or Delete)
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action');
    const inquiryId = Number(formData.get('inquiry_id'));

    if (action === 'update_status' && inquiryId) {
      const newStatus = formData.get('status')?.toString() || 'baru';
      await sql`UPDATE inquiries SET status = ${newStatus} WHERE id = ${inquiryId};`;
      flash = { type: 'success', text: 'Status pesanan berhasil diperbarui.' };
    } else if (action === 'delete' && inquiryId) {
      await sql`DELETE FROM inquiries WHERE id = ${inquiryId};`;
      flash = { type: 'success', text: 'Pesan lead berhasil dihapus.' };
    }
  } catch (err: any) {
    console.error('Inquiries POST error:', err);
    flash = { type: 'error', text: 'Terjadi kesalahan: ' + err.message };
  }
}

let inquiries: any[] = [];
let counts = { semua: 0, baru: 0, dihubungi: 0, selesai: 0, batal: 0 };

try {
  const allRows = await sql`SELECT * FROM inquiries ORDER BY id DESC;`;
  counts.semua = allRows.length;
  allRows.forEach((r: any) => {
    if (r.status in counts) counts[r.status as keyof typeof counts]++;
  });

  if (statusFilter === 'semua') {
    inquiries = allRows;
  } else {
    inquiries = allRows.filter((r: any) => r.status === statusFilter);
  }
} catch (err: any) {
  console.error('Fetch inquiries error:', err);
  flash = { type: 'error', text: 'Gagal memuat data pesan dari database.' };
}

const statusBadge = (s: string) => {
  switch (s) {
    case 'baru':
      return 'bg-amber-100 text-amber-800 border-amber-200';
    case 'dihubungi':
      return 'bg-blue-100 text-blue-800 border-blue-200';
    case 'selesai':
      return 'bg-emerald-100 text-emerald-800 border-emerald-200';
    case 'batal':
      return 'bg-slate-100 text-slate-600 border-slate-200';
    default:
      return 'bg-slate-100 text-slate-800 border-slate-200';
  }
};

const fmtDate = (d: any) => d ? new Date(d).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
const fmtDateTime = (d: any) => d ? new Date(d).toLocaleString('id-ID', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '-';
---

<AdminLayout title="Pesan & Leads Masuk" active="inquiries">
  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Pesan & Leads Masuk</h1>
        <p class="text-sm text-slate-500 mt-1">Daftar calon pelanggan yang mengirim pesan booking lewat halaman Kontak.</p>
      </div>
    </div>

    {flash && (
      <div class:list={[
        'px-4 py-3 rounded-xl text-sm font-medium border',
        flash.type === 'success' ? 'bg-emerald-50 border-emerald-200 text-emerald-700' : 'bg-red-50 border-red-200 text-red-700',
      ]}>
        {flash.text}
      </div>
    )}

    <!-- Filter Tabs -->
    <div class="flex flex-wrap gap-2 border-b border-slate-200 pb-3">
      {[
        { key: 'semua', label: 'Semua', count: counts.semua },
        { key: 'baru', label: 'Belum Dihubungi', count: counts.baru },
        { key: 'dihubungi', label: 'Sudah Dihubungi', count: counts.dihubungi },
        { key: 'selesai', label: 'Deal / Selesai', count: counts.selesai },
        { key: 'batal', label: 'Batal', count: counts.batal },
      ].map((tab) => (
        <a
          href={`/admin/inquiries?status=${tab.key}`}
          class:list={[
            'inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-semibold transition',
            statusFilter === tab.key
              ? 'bg-primary-600 text-white shadow-sm'
              : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-50',
          ]}
        >
          {tab.label}
          <span class:list={[
            'px-1.5 py-0.2 rounded-full text-[10px]',
            statusFilter === tab.key ? 'bg-white/20 text-white' : 'bg-slate-100 text-slate-600',
          ]}>
            {tab.count}
          </span>
        </a>
      ))}
    </div>

    <!-- Leads List -->
    {inquiries.length === 0 ? (
      <div class="bg-white rounded-2xl border border-dashed border-slate-300 py-16 text-center">
        <p class="text-slate-500 text-sm">Belum ada pesan / leads dengan status "{statusFilter}".</p>
      </div>
    ) : (
      <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm border-collapse">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                <th class="py-3 px-5">Pemesan</th>
                <th class="py-3 px-5">Layanan Diminati</th>
                <th class="py-3 px-5">Tgl Rencana</th>
                <th class="py-3 px-5">Pesan / Catatan</th>
                <th class="py-3 px-5">Status</th>
                <th class="py-3 px-5 text-right">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {inquiries.map((inq) => {
                const cleanPhone = inq.phone.replace(/\D/g, '').replace(/^0/, '62');
                const waText = encodeURIComponent(`Halo Kak ${inq.name}, saya dari Beyond Jogja Tours menindaklanjuti pesan booking untuk layanan ${inq.service || 'wisata'}.`);
                const waUrl = `https://wa.me/${cleanPhone}?text=${waText}`;

                return (
                  <tr class="hover:bg-slate-50/60 transition">
                    <td class="py-4 px-5">
                      <div class="font-semibold text-slate-900">{inq.name}</div>
                      <a href={waUrl} target="_blank" class="text-xs text-primary-600 hover:underline font-mono inline-flex items-center gap-1 mt-0.5">
                        💬 {inq.phone}
                      </a>
                      <div class="text-[10px] text-slate-400 mt-1">Masuk: {fmtDateTime(inq.created_at)}</div>
                    </td>
                    <td class="py-4 px-5">
                      <span class="inline-block px-2.5 py-1 bg-slate-100 rounded-lg text-xs font-medium text-slate-700">
                        {inq.service || 'Belum dipilih'}
                      </span>
                    </td>
                    <td class="py-4 px-5 text-slate-600 text-xs">
                      {fmtDate(inq.trip_date)}
                    </td>
                    <td class="py-4 px-5 text-slate-600 max-w-xs text-xs">
                      <p class="line-clamp-2">{inq.message || '-'}</p>
                    </td>
                    <td class="py-4 px-5">
                      <form method="POST" class="inline-block">
                        <input type="hidden" name="_action" value="update_status" />
                        <input type="hidden" name="inquiry_id" value={inq.id} />
                        <select
                          name="status"
                          onchange="this.form.submit()"
                          class:list={[
                            'text-xs font-semibold px-2.5 py-1 rounded-lg border focus:outline-none cursor-pointer',
                            statusBadge(inq.status),
                          ]}
                        >
                          <option value="baru" selected={inq.status === 'baru'}>🟡 Baru</option>
                          <option value="dihubungi" selected={inq.status === 'dihubungi'}>🔵 Dihubungi</option>
                          <option value="selesai" selected={inq.status === 'selesai'}>🟢 Deal / Selesai</option>
                          <option value="batal" selected={inq.status === 'batal'}>⚪ Batal</option>
                        </select>
                      </form>
                    </td>
                    <td class="py-4 px-5 text-right">
                      <div class="flex items-center justify-end gap-2">
                        <a
                          href={waUrl}
                          target="_blank"
                          class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-medium transition inline-flex items-center gap-1"
                        >
                          WhatsApp
                        </a>
                        <form method="POST" onsubmit="return confirmDelete(this, 'Hapus Pesan Leads?', 'Riwayat pesan ini akan dihapus secara permanen dari daftar.');" class="inline">
                          <input type="hidden" name="_action" value="delete" />
                          <input type="hidden" name="inquiry_id" value={inq.id} />
                          <button type="submit" class="p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition cursor-pointer" title="Hapus">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </div>
</AdminLayout>

