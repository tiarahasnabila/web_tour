---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { sql } from '../../../lib/db';
import { verifySessionToken } from '../../../lib/auth';

const user = verifySessionToken(Astro.cookies.get('admin_session')?.value);
if (!user) {
  return Astro.redirect('/admin/login');
}

let flash: { type: 'success' | 'error'; text: string } | null = null;
const urlParam = Astro.url.searchParams;
const statusFilter = urlParam.get('status') || 'semua';

if (urlParam.get('updated') === '1') {
  flash = { type: 'success', text: 'Status pesanan lead berhasil diperbarui.' };
} else if (urlParam.get('deleted') === '1') {
  flash = { type: 'success', text: 'Pesan lead berhasil dihapus dari daftar.' };
}

// Handle Actions (Update Status or Delete)
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action');
    const inquiryId = Number(formData.get('inquiry_id'));

    if (action === 'update_status' && inquiryId) {
      const newStatus = formData.get('status')?.toString() || 'baru';
      await sql`UPDATE inquiries SET status = ${newStatus} WHERE id = ${inquiryId};`;
      return Astro.redirect(`/admin/inquiries?status=${statusFilter}&updated=1`);
    } else if (action === 'delete' && inquiryId) {
      await sql`DELETE FROM inquiries WHERE id = ${inquiryId};`;
      return Astro.redirect(`/admin/inquiries?status=${statusFilter}&deleted=1`);
    }
  } catch (err: any) {
    console.error('Inquiries POST error:', err);
    flash = { type: 'error', text: 'Terjadi kesalahan: ' + err.message };
  }
}

let inquiries: any[] = [];
let counts = { semua: 0, baru: 0, dihubungi: 0, selesai: 0, batal: 0 };

try {
  const allRows = await sql`SELECT * FROM inquiries ORDER BY id DESC;`;
  counts.semua = allRows.length;
  allRows.forEach((r: any) => {
    if (r.status in counts) counts[r.status as keyof typeof counts]++;
  });

  if (statusFilter === 'semua') {
    inquiries = allRows;
  } else {
    inquiries = allRows.filter((r: any) => r.status === statusFilter);
  }
} catch (err: any) {
  console.error('Fetch inquiries error:', err);
  flash = { type: 'error', text: 'Gagal memuat data pesan dari database.' };
}

const statusBadge = (s: string) => {
  switch (s) {
    case 'baru':
      return 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/25';
    case 'dihubungi':
      return 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/25';
    case 'selesai':
      return 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/25';
    case 'batal':
      return 'bg-slate-500/10 text-slate-600 dark:text-slate-400 border-slate-500/25';
    default:
      return 'bg-slate-500/10 text-slate-600 dark:text-slate-400 border-slate-500/25';
  }
};

const statusLabel = (s: string) => {
  switch (s) {
    case 'baru':
      return '🟡 Belum Dihubungi';
    case 'dihubungi':
      return '🔵 Sedang Dihubungi';
    case 'selesai':
      return '🟢 Deal / Selesai';
    case 'batal':
      return '⚪ Dibatalkan';
    default:
      return s;
  }
};

const fmtDate = (d: any) =>
  d
    ? new Date(d).toLocaleDateString('id-ID', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      })
    : '-';

const fmtDateTime = (d: any) =>
  d
    ? new Date(d).toLocaleString('id-ID', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      })
    : '-';

const fmtRelativeTime = (d: any) => {
  if (!d) return '-';
  const diff = Date.now() - new Date(d).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 1) return 'Baru saja';
  if (mins < 60) return `${mins} mnt lalu`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs} jam lalu`;
  const days = Math.floor(hrs / 24);
  if (days < 7) return `${days} hari lalu`;
  return fmtDate(d);
};
---

<AdminLayout title="Pesan & Leads Masuk" active="inquiries">
  <div class="space-y-6 max-w-7xl mx-auto pb-20">

    <!-- HERO HEADER BANNER -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-navy-950 via-navy-900 to-slate-900 text-white p-6 sm:p-8 shadow-xl border border-white/10">
      <div class="absolute -top-24 -right-24 w-80 h-80 rounded-full bg-primary-500/20 blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-16 w-64 h-64 rounded-full bg-emerald-500/15 blur-3xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="space-y-2 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-primary-300 text-xs font-semibold tracking-wide">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Kotak Masuk Calon Pelanggan</span>
            <span class="text-white/30">•</span>
            <span>{counts.baru} Perlu Tindak Lanjut</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
            Pesan & Leads Booking Masuk
          </h1>
          <p class="text-sm text-slate-300 leading-relaxed">
            Kelola calon tamu yang mengirim formulir pemesanan paket wisata atau sewa mobil. Klik pada pesan untuk membaca isi lengkap dan merespons via WhatsApp.
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0">
          <a
            href="/kontak"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/15 text-white text-sm font-semibold border border-white/15 transition backdrop-blur-xs"
          >
            <svg class="w-4 h-4 text-primary-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            <span>Buka Form Kontak</span>
          </a>
        </div>
      </div>
    </div>

    <!-- FLASH NOTIFICATION -->
    {flash && (
      <div class:list={[
        'px-5 py-4 rounded-2xl text-sm font-semibold border flex items-center justify-between gap-3 shadow-xs',
        flash.type === 'success'
          ? 'bg-emerald-50 dark:bg-emerald-950/40 border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300'
          : 'bg-rose-50 dark:bg-rose-950/40 border-rose-200 dark:border-rose-800 text-rose-800 dark:text-rose-300',
      ]}>
        <div class="flex items-center gap-3">
          <div class:list={[
            'w-8 h-8 rounded-xl flex items-center justify-center shrink-0',
            flash.type === 'success' ? 'bg-emerald-500 text-white' : 'bg-rose-500 text-white',
          ]}>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={flash.type === 'success' ? 'M5 13l4 4L19 7' : 'M6 18L18 6M6 6l12 12'} />
            </svg>
          </div>
          <span>{flash.text}</span>
        </div>
        <button
          type="button"
          onclick="this.parentElement.remove()"
          class="text-xs opacity-60 hover:opacity-100 px-2 py-1 rounded-lg hover:bg-black/5 dark:hover:bg-white/10 transition cursor-pointer"
        >
          Tutup ✕
        </button>
      </div>
    )}

    <!-- STATS SUMMARY CARDS -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-xs flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-primary-500/10 text-primary-600 flex items-center justify-center shrink-0 border border-primary-500/20">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
          </svg>
        </div>
        <div class="min-w-0">
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Pesan</p>
          <p class="text-2xl font-black text-slate-900 mt-0.5">{counts.semua}</p>
        </div>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-xs flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-600 flex items-center justify-center shrink-0 border border-amber-500/20">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-1.5">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Belum Dihubungi</p>
            {counts.baru > 0 && (
              <span class="w-2 h-2 rounded-full bg-amber-500 animate-ping"></span>
            )}
          </div>
          <p class="text-2xl font-black text-amber-600 mt-0.5">{counts.baru}</p>
        </div>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-xs flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-blue-500/10 text-blue-600 flex items-center justify-center shrink-0 border border-blue-500/20">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </div>
        <div class="min-w-0">
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Sedang Dihubungi</p>
          <p class="text-2xl font-black text-blue-600 mt-0.5">{counts.dihubungi}</p>
        </div>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-xs flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center shrink-0 border border-emerald-500/20">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="min-w-0">
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Deal / Sukses</p>
          <p class="text-2xl font-black text-emerald-600 mt-0.5">{counts.selesai}</p>
        </div>
      </div>
    </div>

    <!-- FILTER TABS & SEARCH BAR -->
    <div class="bg-white rounded-2xl border border-slate-200/80 p-3 sm:p-4 shadow-xs flex flex-col md:flex-row md:items-center md:justify-between gap-3">
      <!-- Tabs -->
      <div class="flex flex-wrap items-center gap-1.5">
        {[
          { key: 'semua', label: 'Semua', count: counts.semua },
          { key: 'baru', label: 'Belum Dihubungi', count: counts.baru },
          { key: 'dihubungi', label: 'Sudah Dihubungi', count: counts.dihubungi },
          { key: 'selesai', label: 'Deal / Selesai', count: counts.selesai },
          { key: 'batal', label: 'Batal', count: counts.batal },
        ].map((tab) => (
          <a
            href={`/admin/inquiries?status=${tab.key}`}
            class:list={[
              'inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-bold transition cursor-pointer',
              statusFilter === tab.key
                ? 'bg-primary-600 text-white shadow-xs'
                : 'text-slate-600 hover:bg-slate-100/80 dark:hover:bg-slate-800',
            ]}
          >
            <span>{tab.label}</span>
            <span class:list={[
              'px-1.5 py-0.5 rounded-full text-[10px] font-mono',
              statusFilter === tab.key
                ? 'bg-white/20 text-white'
                : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400',
            ]}>
              {tab.count}
            </span>
          </a>
        ))}
      </div>

      <!-- Quick Search Filter -->
      <div class="relative w-full md:w-72">
        <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          id="search-leads-input"
          type="text"
          placeholder="Cari nama, no HP, atau isi pesan..."
          class="w-full pl-9 pr-4 py-2 rounded-xl text-xs bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition"
        />
      </div>
    </div>

    <!-- LEADS TABLE LIST -->
    {inquiries.length === 0 ? (
      <div class="bg-white rounded-3xl border border-dashed border-slate-300 dark:border-slate-700 py-20 px-4 text-center">
        <div class="w-16 h-16 rounded-3xl bg-slate-100 dark:bg-slate-800 text-slate-400 flex items-center justify-center mx-auto text-2xl mb-3">
          📭
        </div>
        <h3 class="font-bold text-slate-800 dark:text-slate-200 text-base">Tidak Ada Pesan</h3>
        <p class="text-slate-500 text-xs mt-1 max-w-sm mx-auto">
          Belum ada pesan booking masuk dengan filter status "{statusFilter}".
        </p>
      </div>
    ) : (
      <div class="bg-white rounded-3xl border border-slate-200/80 overflow-hidden shadow-xs">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm border-collapse" id="leads-table">
            <thead>
              <tr class="bg-slate-50/80 border-b border-slate-200/80 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                <th class="py-3.5 px-5">Pemesan & Kontak</th>
                <th class="py-3.5 px-5">Layanan</th>
                <th class="py-3.5 px-5">Tgl Rencana</th>
                <th class="py-3.5 px-5 w-2/5">Isi Pesan / Kebutuhan</th>
                <th class="py-3.5 px-5">Status</th>
                <th class="py-3.5 px-5 text-right">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {inquiries.map((inq) => {
                const cleanPhone = (inq.phone || '').replace(/\D/g, '').replace(/^0/, '62');
                const waText = encodeURIComponent(
                  `Halo Kak ${inq.name}, saya dari Beyond Jogja Tours menindaklanjuti pesan Anda terkait ${inq.service || 'layanan wisata'}. Ada yang bisa kami bantu persiapkan?`
                );
                const waUrl = `https://wa.me/${cleanPhone}?text=${waText}`;
                const rawMsg = inq.message || '';
                const isLongMsg = rawMsg.length > 80;

                // Avatar initials palette
                const initials = (inq.name || 'T')
                  .split(' ')
                  .map((w: string) => w[0])
                  .slice(0, 2)
                  .join('')
                  .toUpperCase();

                return (
                  <tr
                    class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition group lead-row"
                    data-search={`${inq.name} ${inq.phone} ${inq.service} ${rawMsg}`.toLowerCase()}
                  >
                    <!-- Pemesan -->
                    <td class="py-4 px-5 align-top">
                      <div class="flex items-start gap-3">
                        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-primary-500/10 to-teal-500/15 text-primary-600 dark:text-primary-400 font-extrabold text-xs flex items-center justify-center shrink-0 border border-primary-500/20">
                          {initials}
                        </div>
                        <div class="min-w-0">
                          <button
                            type="button"
                            class="font-bold text-slate-900 dark:text-white hover:text-primary-600 transition text-left cursor-pointer btn-open-detail"
                            data-inquiry={JSON.stringify(inq)}
                          >
                            {inq.name}
                          </button>
                          <div class="flex items-center gap-2 mt-0.5">
                            <a
                              href={waUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="text-xs font-mono text-emerald-600 dark:text-emerald-400 hover:underline inline-flex items-center gap-1"
                              title="Kirim Pesan WhatsApp"
                            >
                              <span>💬 {inq.phone}</span>
                              <span class="text-[10px]">↗</span>
                            </a>
                          </div>
                          <div class="text-[11px] text-slate-400 mt-1 flex items-center gap-1.5">
                            <span>🕒 {fmtDateTime(inq.created_at)}</span>
                            <span class="text-slate-300">•</span>
                            <span class="text-slate-500 font-medium">{fmtRelativeTime(inq.created_at)}</span>
                          </div>
                        </div>
                      </div>
                    </td>

                    <!-- Layanan -->
                    <td class="py-4 px-5 align-top">
                      <span class="inline-block px-2.5 py-1 bg-slate-100 dark:bg-slate-800 rounded-lg text-xs font-semibold text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700 max-w-[180px] truncate" title={inq.service}>
                        {inq.service || 'Belum dipilih'}
                      </span>
                    </td>

                    <!-- Tgl Rencana -->
                    <td class="py-4 px-5 align-top text-xs font-medium text-slate-600 dark:text-slate-400 whitespace-nowrap">
                      {fmtDate(inq.trip_date)}
                    </td>

                    <!-- Isi Pesan (KUNCI PERBAIKAN: Jelas, Lengkap, dan Bisa Diklik / Dibuka Modal) -->
                    <td class="py-4 px-5 align-top">
                      {rawMsg ? (
                        <div class="space-y-1.5 max-w-md">
                          <div
                            class="p-3 rounded-xl bg-slate-50/80 dark:bg-slate-800/60 border border-slate-200/70 dark:border-slate-700/80 text-xs text-slate-700 dark:text-slate-300 leading-relaxed break-words hover:border-primary-400/50 transition cursor-pointer btn-open-detail"
                            data-inquiry={JSON.stringify(inq)}
                            title="Klik untuk membuka pesan lengkap"
                          >
                            <p class={isLongMsg ? 'line-clamp-3' : ''}>
                              {rawMsg}
                            </p>
                          </div>
                          <div class="flex items-center justify-between">
                            <button
                              type="button"
                              class="inline-flex items-center gap-1 text-[11px] font-bold text-primary-600 dark:text-primary-400 hover:underline cursor-pointer btn-open-detail"
                              data-inquiry={JSON.stringify(inq)}
                            >
                              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                              </svg>
                              <span>{isLongMsg ? 'Baca Pesan Lengkap →' : 'Lihat Detail'}</span>
                            </button>
                            <span class="text-[10px] text-slate-400 font-mono">
                              {rawMsg.length} karakter
                            </span>
                          </div>
                        </div>
                      ) : (
                        <span class="text-xs text-slate-400 italic">(Tidak ada pesan tertulis)</span>
                      )}
                    </td>

                    <!-- Status Dropdown -->
                    <td class="py-4 px-5 align-top whitespace-nowrap">
                      <form method="POST" class="inline-block">
                        <input type="hidden" name="_action" value="update_status" />
                        <input type="hidden" name="inquiry_id" value={inq.id} />
                        <select
                          name="status"
                          onchange="this.form.submit()"
                          class:list={[
                            'text-xs font-bold px-2.5 py-1.5 rounded-xl border focus:outline-none cursor-pointer transition shadow-2xs',
                            statusBadge(inq.status),
                          ]}
                        >
                          <option value="baru" selected={inq.status === 'baru'}>🟡 Baru</option>
                          <option value="dihubungi" selected={inq.status === 'dihubungi'}>🔵 Dihubungi</option>
                          <option value="selesai" selected={inq.status === 'selesai'}>🟢 Deal / Selesai</option>
                          <option value="batal" selected={inq.status === 'batal'}>⚪ Batal</option>
                        </select>
                      </form>
                    </td>

                    <!-- Aksi -->
                    <td class="py-4 px-5 align-top text-right whitespace-nowrap">
                      <div class="flex items-center justify-end gap-1.5">
                        <button
                          type="button"
                          class="p-2 text-slate-600 dark:text-slate-300 hover:text-primary-600 hover:bg-primary-50 dark:hover:bg-primary-950/40 rounded-xl transition cursor-pointer btn-open-detail"
                          data-inquiry={JSON.stringify(inq)}
                          title="Baca Pesan Lengkap"
                        >
                          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                          </svg>
                        </button>
                        <a
                          href={waUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition inline-flex items-center gap-1 shadow-xs active:scale-95"
                          title="Chat via WhatsApp"
                        >
                          <span>WA</span>
                          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                          </svg>
                        </a>
                        <form
                          method="POST"
                          onsubmit={`return confirmDelete(this, 'Hapus Pesan dari &ldquo;${(inq.name || '').replace(/'/g, "\\'")}&rdquo;?', 'Riwayat pesan leads ini akan dihapus permanen.');`}
                          class="inline"
                        >
                          <input type="hidden" name="_action" value="delete" />
                          <input type="hidden" name="inquiry_id" value={inq.id} />
                          <button
                            type="submit"
                            class="p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 rounded-xl transition cursor-pointer"
                            title="Hapus Pesan"
                          >
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    )}

  </div>

  <!-- POPUP MODAL: DETAIL PESAN LENGKAP -->
  <div
    id="detail-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-navy-950/70 backdrop-blur-sm animate-in fade-in duration-200"
  >
    <div class="relative w-full max-w-2xl bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
      
      <!-- Modal Header -->
      <div class="px-6 py-5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between bg-slate-50/70 dark:bg-slate-800/40 shrink-0">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-primary-500/10 text-primary-600 dark:text-primary-400 flex items-center justify-center font-bold text-lg border border-primary-500/20">
            ✉️
          </div>
          <div>
            <h3 class="font-extrabold text-slate-900 dark:text-white text-base">Detail Pesan Masuk</h3>
            <p id="modal-time-lead" class="text-xs text-slate-400 mt-0.5">Waktu masuk: -</p>
          </div>
        </div>
        <button
          type="button"
          id="btn-close-modal"
          class="w-8 h-8 rounded-xl flex items-center justify-center text-slate-400 hover:text-slate-700 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition cursor-pointer text-base"
        >
          ✕
        </button>
      </div>

      <!-- Modal Body (Scrollable) -->
      <div class="p-6 overflow-y-auto space-y-6">

        <!-- Info Pemesan & Layanan Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Card Pemesan -->
          <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/70 dark:border-slate-700 space-y-2">
            <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Nama Calon Tamu</p>
            <p id="modal-lead-name" class="text-base font-extrabold text-slate-900 dark:text-white">-</p>
            <div class="flex items-center gap-2 pt-1">
              <span class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400" id="modal-lead-phone">-</span>
              <button
                type="button"
                id="btn-copy-phone"
                class="px-2 py-0.5 rounded text-[10px] font-semibold bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 text-slate-600 dark:text-slate-200 hover:border-emerald-500 transition cursor-pointer"
              >
                📋 Salin
              </button>
            </div>
          </div>

          <!-- Card Layanan & Tanggal -->
          <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/70 dark:border-slate-700 space-y-2">
            <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Layanan & Tanggal</p>
            <p id="modal-lead-service" class="text-sm font-bold text-slate-900 dark:text-white">-</p>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              Rencana Trip: <strong id="modal-lead-date" class="text-slate-700 dark:text-slate-200">-</strong>
            </p>
          </div>
        </div>

        <!-- Box Isi Pesan Lengkap -->
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <label class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-2">
              <span>Isi Pesan Lengkap</span>
              <span id="modal-msg-badge" class="px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-primary-500/10 text-primary-600">
                0 karakter
              </span>
            </label>
            <button
              type="button"
              id="btn-copy-message"
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl text-xs font-bold bg-slate-100 dark:bg-slate-800 hover:bg-primary-50 hover:text-primary-600 text-slate-600 dark:text-slate-300 transition cursor-pointer"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
              </svg>
              <span>Salin Teks Pesan</span>
            </button>
          </div>

          <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700 relative">
            <div
              id="modal-lead-message"
              class="text-sm text-slate-800 dark:text-slate-200 leading-relaxed whitespace-pre-wrap font-sans select-text break-words max-h-72 overflow-y-auto"
            >
              -
            </div>
          </div>
        </div>

        <!-- Quick Status Update Form inside Modal -->
        <div class="p-4.5 rounded-2xl bg-primary-50/50 dark:bg-primary-950/20 border border-primary-200/60 dark:border-primary-800/40 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <p class="text-xs font-bold text-primary-900 dark:text-primary-300">Ubah Status Tindak Lanjut</p>
            <p class="text-[11px] text-primary-700 dark:text-primary-400 mt-0.5">Tandai progress komunikasi dengan calon tamu ini.</p>
          </div>
          <form method="POST" id="modal-status-form" class="flex items-center gap-2">
            <input type="hidden" name="_action" value="update_status" />
            <input type="hidden" name="inquiry_id" id="modal-inquiry-id" value="" />
            <select
              name="status"
              id="modal-status-select"
              class="text-xs font-bold px-3 py-2 rounded-xl border border-primary-300 dark:border-primary-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500 cursor-pointer shadow-xs"
            >
              <option value="baru">🟡 Belum Dihubungi</option>
              <option value="dihubungi">🔵 Sudah Dihubungi</option>
              <option value="selesai">🟢 Deal / Selesai</option>
              <option value="batal">⚪ Batal</option>
            </select>
            <button
              type="submit"
              class="px-3.5 py-2 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-xs font-bold transition shadow-xs cursor-pointer active:scale-95"
            >
              Simpan
            </button>
          </form>
        </div>

      </div>

      <!-- Modal Footer -->
      <div class="px-6 py-4 bg-slate-50 dark:bg-slate-800/40 border-t border-slate-100 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3 shrink-0">
        <form
          method="POST"
          id="modal-delete-form"
          onsubmit="return confirmDelete(this, 'Hapus Pesan Leads Ini?', 'Pesan ini akan dihapus permanen.');"
        >
          <input type="hidden" name="_action" value="delete" />
          <input type="hidden" name="inquiry_id" id="modal-delete-inquiry-id" value="" />
          <button
            type="submit"
            class="px-3.5 py-2 text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 rounded-xl text-xs font-bold transition cursor-pointer"
          >
            🗑️ Hapus Pesan
          </button>
        </form>

        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btn-modal-close-footer"
            class="px-4 py-2 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-200/60 dark:hover:bg-slate-700 transition cursor-pointer"
          >
            Tutup
          </button>
          <a
            id="modal-wa-btn"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition shadow-md shadow-emerald-600/20 active:scale-95"
          >
            <span>Buka Chat WhatsApp</span>
            <span>↗</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</AdminLayout>

<script is:inline>
  (() => {
    const modal = document.getElementById('detail-modal');
    const closeBtn = document.getElementById('btn-close-modal');
    const closeFooterBtn = document.getElementById('btn-modal-close-footer');
    const nameEl = document.getElementById('modal-lead-name');
    const phoneEl = document.getElementById('modal-lead-phone');
    const serviceEl = document.getElementById('modal-lead-service');
    const dateEl = document.getElementById('modal-lead-date');
    const timeEl = document.getElementById('modal-time-lead');
    const msgEl = document.getElementById('modal-lead-message');
    const msgBadge = document.getElementById('modal-msg-badge');
    const inqIdInput = document.getElementById('modal-inquiry-id');
    const delInqIdInput = document.getElementById('modal-delete-inquiry-id');
    const statusSelect = document.getElementById('modal-status-select');
    const waBtn = document.getElementById('modal-wa-btn');
    const copyPhoneBtn = document.getElementById('btn-copy-phone');
    const copyMsgBtn = document.getElementById('btn-copy-message');
    const searchInput = document.getElementById('search-leads-input');

    let currentInquiry = null;

    const openModal = (inq) => {
      currentInquiry = inq;
      if (!modal) return;

      if (nameEl) nameEl.textContent = inq.name || '-';
      if (phoneEl) phoneEl.textContent = inq.phone || '-';
      if (serviceEl) serviceEl.textContent = inq.service || 'Belum dipilih';
      
      const tripDate = inq.trip_date
        ? new Date(inq.trip_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
        : '-';
      if (dateEl) dateEl.textContent = tripDate;

      const createdDate = inq.created_at
        ? new Date(inq.created_at).toLocaleString('id-ID', {
            weekday: 'long',
            day: 'numeric',
            month: 'long',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
          })
        : '-';
      if (timeEl) timeEl.textContent = `Diterima pada: ${createdDate} WIB`;

      const rawMsg = inq.message || '(Tidak ada pesan tertulis)';
      if (msgEl) msgEl.textContent = rawMsg;
      if (msgBadge) msgBadge.textContent = `${rawMsg.length} karakter`;

      if (inqIdInput) inqIdInput.value = inq.id;
      if (delInqIdInput) delInqIdInput.value = inq.id;
      if (statusSelect) statusSelect.value = inq.status || 'baru';

      const cleanPhone = (inq.phone || '').replace(/\D/g, '').replace(/^0/, '62');
      const waText = encodeURIComponent(
        `Halo Kak ${inq.name}, saya dari Beyond Jogja Tours menindaklanjuti pesan Anda terkait ${inq.service || 'layanan wisata'}. Ada yang bisa kami bantu persiapkan?`
      );
      if (waBtn) waBtn.href = `https://wa.me/${cleanPhone}?text=${waText}`;

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };

    const closeModal = () => {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    };

    closeBtn?.addEventListener('click', closeModal);
    closeFooterBtn?.addEventListener('click', closeModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
        closeModal();
      }
    });

    // Handle Open Detail button clicks
    document.querySelectorAll('.btn-open-detail').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        try {
          const raw = btn.getAttribute('data-inquiry');
          if (raw) {
            const parsed = JSON.parse(raw);
            openModal(parsed);
          }
        } catch (err) {
          console.error('Error parsing inquiry data:', err);
        }
      });
    });

    // Copy Phone
    copyPhoneBtn?.addEventListener('click', async () => {
      if (!currentInquiry?.phone) return;
      try {
        await navigator.clipboard.writeText(currentInquiry.phone);
        const orig = copyPhoneBtn.textContent;
        copyPhoneBtn.textContent = '✓ Tersalin!';
        setTimeout(() => (copyPhoneBtn.textContent = orig), 1500);
      } catch {}
    });

    // Copy Full Message
    copyMsgBtn?.addEventListener('click', async () => {
      if (!currentInquiry?.message) return;
      try {
        await navigator.clipboard.writeText(currentInquiry.message);
        const orig = copyMsgBtn.innerHTML;
        copyMsgBtn.innerHTML = '<span>✓ Teks Tersalin!</span>';
        setTimeout(() => (copyMsgBtn.innerHTML = orig), 1800);
      } catch {}
    });

    // Realtime Search Filter
    searchInput?.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      const rows = document.querySelectorAll('.lead-row');
      rows.forEach((row) => {
        const text = row.getAttribute('data-search') || '';
        if (!q || text.includes(q)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    });
  })();
</script>
