---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { sql } from '../../../lib/db';
import { verifySessionToken } from '../../../lib/auth';
import bcrypt from 'bcryptjs';

const session = verifySessionToken(Astro.cookies.get('admin_session')?.value);
if (!session) {
  return Astro.redirect('/admin/login');
}

let flash: { type: 'success' | 'error'; text: string } | null = null;
let currentAdmin: any = null;

const saved = Astro.url.searchParams.get('saved');
if (saved) {
  flash = { type: 'success', text: 'Akun admin baru berhasil ditambahkan!' };
}

// Get current logged-in admin
const meRows = await sql`SELECT id, username FROM admins WHERE username = ${session.username} LIMIT 1;`;
currentAdmin = meRows[0];

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action');
    const get = (k: string) => formData.get(k)?.toString().trim() || '';

    if (action === 'create_admin') {
      const username = get('username').toLowerCase();
      const displayName = get('display_name');
      const password = formData.get('password')?.toString() || '';

      if (!/^[a-z0-9_.]{3,30}$/.test(username)) {
        flash = { type: 'error', text: 'Username harus 3-30 karakter (huruf kecil, angka, titik, atau underscore).' };
      } else if (password.length < 8) {
        flash = { type: 'error', text: 'Password admin baru minimal 8 karakter.' };
      } else {
        const taken = await sql`SELECT id FROM admins WHERE username = ${username} LIMIT 1;`;
        if (taken.length > 0) {
          flash = { type: 'error', text: `Username "${username}" sudah digunakan.` };
        } else {
          const hash = bcrypt.hashSync(password, 10);
          await sql`
            INSERT INTO admins (username, display_name, password_hash)
            VALUES (${username}, ${displayName || null}, ${hash});
          `;
          flash = { type: 'success', text: `Admin baru "@${username}" berhasil ditambahkan!` };
        }
      }
    } else if (action === 'delete_admin') {
      const targetId = Number(formData.get('target_id'));
      if (currentAdmin && targetId === currentAdmin.id) {
        flash = { type: 'error', text: 'Anda tidak dapat menghapus akun Anda sendiri yang sedang aktif.' };
      } else {
        await sql`DELETE FROM admins WHERE id = ${targetId};`;
        flash = { type: 'success', text: 'Akun admin berhasil dihapus.' };
      }
    } else if (action === 'reset_password') {
      const targetId = Number(formData.get('target_id'));
      const newPassword = formData.get('new_password')?.toString() || '';
      if (newPassword.length < 8) {
        flash = { type: 'error', text: 'Password baru minimal 8 karakter.' };
      } else {
        const hash = bcrypt.hashSync(newPassword, 10);
        await sql`UPDATE admins SET password_hash = ${hash}, updated_at = NOW() WHERE id = ${targetId};`;
        flash = { type: 'success', text: 'Password admin berhasil direset.' };
      }
    }
  } catch (err: any) {
    console.error('Admin users error:', err);
    flash = { type: 'error', text: 'Terjadi kesalahan: ' + err.message };
  }
}

let admins: any[] = [];
try {
  admins = await sql`SELECT id, username, display_name, created_at, updated_at FROM admins ORDER BY id ASC;`;
} catch (err: any) {
  console.error('Fetch admins error:', err);
}

const fmtDate = (d: any) => d ? new Date(d).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
---

<AdminLayout title="Manajemen Admin" active="users">
  <div class="space-y-6 max-w-5xl">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Manajemen Akun Admin</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Kelola staf atau admin yang memiliki hak akses login ke panel ini.</p>
      </div>
      <a
        href="/admin/users/tambah"
        class="inline-flex items-center justify-center gap-2 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm hover:shadow-md transition"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
        <span>+ Tambah Akun Admin</span>
      </a>
    </div>

    {flash && (
      <div class:list={[
        'px-4 py-3 rounded-xl text-sm font-medium border flex items-center gap-2.5',
        flash.type === 'success' ? 'bg-emerald-50 border-emerald-200 text-emerald-800' : 'bg-red-50 border-red-200 text-red-800',
      ]}>
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d={flash.type === 'success' ? "M5 13l4 4L19 7" : "M6 18L18 6M6 6l12 12"} />
        </svg>
        <span>{flash.text}</span>
      </div>
    )}

    <!-- Tabel Daftar Admin (Full Width) -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 overflow-hidden shadow-sm">
      <div class="px-6 py-4.5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
        <h2 class="font-bold text-slate-900 dark:text-white text-base">Daftar Admin Terdaftar ({admins.length})</h2>
        <span class="text-xs text-slate-400">Total: {admins.length} pengguna aktif</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm border-collapse">
          <thead>
            <tr class="bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-500 uppercase tracking-wider">
              <th class="py-3.5 px-6">Admin</th>
              <th class="py-3.5 px-6">Username</th>
              <th class="py-3.5 px-6">Dibuat Pada</th>
              <th class="py-3.5 px-6 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            {admins.map((adm) => {
              const isMe = currentAdmin && adm.id === currentAdmin.id;
              return (
                <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition">
                  <td class="py-4 px-6">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 rounded-full bg-primary-500/15 text-primary-700 dark:text-primary-300 flex items-center justify-center font-bold text-xs uppercase shrink-0 border border-primary-500/20">
                        {(adm.display_name || adm.username).slice(0, 2)}
                      </div>
                      <div>
                        <div class="font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                          <span>{adm.display_name || adm.username}</span>
                          {isMe && (
                            <span class="bg-primary-50 dark:bg-primary-950/60 text-primary-700 dark:text-primary-300 text-[10px] font-bold px-2 py-0.5 rounded-full border border-primary-200 dark:border-primary-800">
                              Akun Anda
                            </span>
                          )}
                        </div>
                      </div>
                    </div>
                  </td>
                  <td class="py-4 px-6 font-mono text-xs text-slate-600 dark:text-slate-400">
                    @{adm.username}
                  </td>
                  <td class="py-4 px-6 text-xs text-slate-500 dark:text-slate-400">
                    {fmtDate(adm.created_at)}
                  </td>
                  <td class="py-4 px-6 text-right">
                    {isMe ? (
                      <a href="/admin/profil" class="text-xs text-primary-600 dark:text-primary-400 hover:underline font-semibold">
                        Ubah di Profil &rarr;
                      </a>
                    ) : (
                      <form method="POST" onsubmit="return confirmDelete(this, 'Hapus Akun Admin?', 'Akun admin ini tidak akan dapat login lagi ke panel admin.');" class="inline">
                        <input type="hidden" name="_action" value="delete_admin" />
                        <input type="hidden" name="target_id" value={adm.id} />
                        <button type="submit" class="px-3 py-1.5 text-xs text-rose-600 bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/40 dark:hover:bg-rose-900/40 rounded-xl transition font-semibold cursor-pointer">
                          Hapus
                        </button>
                      </form>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </div>
  </div>
</AdminLayout>

