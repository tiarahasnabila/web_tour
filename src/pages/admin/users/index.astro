---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { sql } from '../../../lib/db';
import { verifySessionToken } from '../../../lib/auth';
import bcrypt from 'bcryptjs';

const session = verifySessionToken(Astro.cookies.get('admin_session')?.value);
if (!session) {
  return Astro.redirect('/admin/login');
}

let flash: { type: 'success' | 'error'; text: string } | null = null;
let currentAdmin: any = null;

const saved = Astro.url.searchParams.get('saved');
if (saved) {
  flash = { type: 'success', text: 'Akun admin baru berhasil ditambahkan dan siap digunakan!' };
}

// Get current logged-in admin
const meRows = await sql`SELECT id, username, display_name, avatar_url FROM admins WHERE username = ${session.username} LIMIT 1;`;
currentAdmin = meRows[0];

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action');
    const get = (k: string) => formData.get(k)?.toString().trim() || '';

    if (action === 'create_admin') {
      const username = get('username').toLowerCase();
      const displayName = get('display_name');
      const password = formData.get('password')?.toString() || '';

      if (!/^[a-z0-9_.]{3,30}$/.test(username)) {
        flash = { type: 'error', text: 'Username harus 3-30 karakter (huruf kecil, angka, titik, atau underscore).' };
      } else if (password.length < 8) {
        flash = { type: 'error', text: 'Password admin baru minimal 8 karakter.' };
      } else {
        const taken = await sql`SELECT id FROM admins WHERE username = ${username} LIMIT 1;`;
        if (taken.length > 0) {
          flash = { type: 'error', text: `Username "${username}" sudah digunakan.` };
        } else {
          const hash = bcrypt.hashSync(password, 10);
          await sql`
            INSERT INTO admins (username, display_name, password_hash)
            VALUES (${username}, ${displayName || null}, ${hash});
          `;
          flash = { type: 'success', text: `Admin baru "@${username}" berhasil ditambahkan!` };
        }
      }
    } else if (action === 'delete_admin') {
      const targetId = Number(formData.get('target_id'));
      if (currentAdmin && targetId === currentAdmin.id) {
        flash = { type: 'error', text: 'Anda tidak dapat menghapus akun Anda sendiri yang sedang aktif digunakan.' };
      } else {
        await sql`DELETE FROM admins WHERE id = ${targetId};`;
        flash = { type: 'success', text: 'Akun admin berhasil dihapus dari sistem.' };
      }
    } else if (action === 'reset_password') {
      const targetId = Number(formData.get('target_id'));
      const newPassword = formData.get('new_password')?.toString() || '';
      if (newPassword.length < 8) {
        flash = { type: 'error', text: 'Password baru minimal 8 karakter.' };
      } else {
        const hash = bcrypt.hashSync(newPassword, 10);
        await sql`UPDATE admins SET password_hash = ${hash}, updated_at = NOW() WHERE id = ${targetId};`;
        flash = { type: 'success', text: 'Password admin berhasil direset.' };
      }
    }
  } catch (err: any) {
    console.error('Admin users error:', err);
    flash = { type: 'error', text: 'Terjadi kesalahan: ' + err.message };
  }
}

let admins: any[] = [];
try {
  admins = await sql`SELECT id, username, display_name, avatar_url, created_at, updated_at FROM admins ORDER BY id ASC;`;
} catch (err: any) {
  console.error('Fetch admins error:', err);
}

const fmtDate = (d: any) =>
  d
    ? new Date(d).toLocaleDateString('id-ID', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      })
    : '-';

function getInitials(name: string, username: string) {
  const target = (name || username || '').trim();
  const parts = target.split(/\s+/).filter(Boolean);
  if (parts.length >= 2) {
    return (parts[0][0] + parts[1][0]).toUpperCase();
  }
  return target.slice(0, 2).toUpperCase();
}
---

<AdminLayout title="Manajemen Akun Admin" active="users">
  <div class="space-y-7 max-w-5xl">
    
    <!-- Top Header Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary-50 dark:bg-primary-950/50 border border-primary-200/60 dark:border-primary-500/20 text-primary-700 dark:text-primary-300 text-xs font-semibold mb-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Akses & Keamanan Panel</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">Manajemen Akun Admin</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 max-w-xl">
          Kelola daftar pengelola yang memiliki hak akses login penuh ke dashboard Beyond Jogja Tours.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin/users/tambah"
          class="inline-flex items-center justify-center gap-2 bg-primary-600 hover:bg-primary-700 dark:bg-primary-500 dark:hover:bg-primary-600 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-md hover:shadow-lg transition-all active:scale-95 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          <span>Tambah Akun Admin</span>
        </a>
      </div>
    </div>

    <!-- Flash Alert -->
    {flash && (
      <div class:list={[
        'px-4 py-3.5 rounded-2xl text-sm font-medium border flex items-center justify-between gap-3 shadow-xs',
        flash.type === 'success'
          ? 'bg-emerald-50 dark:bg-emerald-950/40 border-emerald-200 dark:border-emerald-800/80 text-emerald-800 dark:text-emerald-300'
          : 'bg-rose-50 dark:bg-rose-950/40 border-rose-200 dark:border-rose-800/80 text-rose-800 dark:text-rose-300',
      ]}>
        <div class="flex items-center gap-2.5">
          <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d={flash.type === 'success' ? "M5 13l4 4L19 7" : "M6 18L18 6M6 6l12 12"} />
          </svg>
          <span>{flash.text}</span>
        </div>
      </div>
    )}

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-4.5 shadow-xs flex items-center gap-3.5">
        <div class="w-11 h-11 rounded-xl bg-primary-50 dark:bg-primary-950/60 text-primary-600 dark:text-primary-400 flex items-center justify-center text-xl shrink-0 border border-primary-100 dark:border-primary-800/40">
          👥
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-500 dark:text-slate-400">Total Akun Terdaftar</p>
          <div class="flex items-baseline gap-2 mt-0.5">
            <h3 class="text-xl font-bold text-slate-900 dark:text-white">{admins.length}</h3>
            <span class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">Pengguna Aktif</span>
          </div>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-4.5 shadow-xs flex items-center gap-3.5">
        <div class="w-11 h-11 rounded-xl bg-sky-50 dark:bg-sky-950/60 text-sky-600 dark:text-sky-400 flex items-center justify-center text-xl shrink-0 border border-sky-100 dark:border-sky-800/40">
          🔑
        </div>
        <div class="min-w-0">
          <p class="text-xs font-semibold text-slate-500 dark:text-slate-400">Login Saat Ini</p>
          <div class="flex items-center gap-1.5 mt-0.5">
            <span class="text-sm font-bold text-slate-900 dark:text-white truncate">@{session.username}</span>
            <span class="text-[10px] font-bold px-1.5 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300">Online</span>
          </div>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-4.5 shadow-xs flex items-center gap-3.5">
        <div class="w-11 h-11 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xl shrink-0 border border-amber-100 dark:border-amber-800/40">
          🛡️
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-500 dark:text-slate-400">Proteksi Keamanan</p>
          <p class="text-sm font-bold text-slate-900 dark:text-white mt-0.5">Bcrypt & JWT Session</p>
        </div>
      </div>
    </div>

    <!-- Main Card & Table -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 overflow-hidden shadow-sm">
      
      <!-- Table Header & Search -->
      <div class="px-6 py-4.5 border-b border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-50/50 dark:bg-slate-800/30">
        <div>
          <h2 class="font-bold text-slate-900 dark:text-white text-base">Daftar Akun Admin</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Seluruh admin memiliki akses penuh untuk mengelola website.</p>
        </div>

        <!-- Pencarian Instan -->
        <div class="relative w-full sm:w-64">
          <input
            type="text"
            id="search-admin"
            placeholder="Cari nama atau username..."
            class="w-full pl-9 pr-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>

      <!-- Table -->
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm border-collapse" id="admin-table">
          <thead>
            <tr class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
              <th class="py-3.5 px-6">Pengguna Admin</th>
              <th class="py-3.5 px-6">Status & Akses</th>
              <th class="py-3.5 px-6">Bergabung Pada</th>
              <th class="py-3.5 px-6 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            {admins.map((adm) => {
              const isMe = currentAdmin && adm.id === currentAdmin.id;
              const initials = getInitials(adm.display_name, adm.username);
              const displayName = adm.display_name || adm.username;
              return (
                <tr class="admin-row hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition">
                  <!-- User Info Column -->
                  <td class="py-4 px-6">
                    <div class="flex items-center gap-3.5">
                      <!-- Avatar -->
                      <div class="relative shrink-0">
                        {adm.avatar_url ? (
                          <img
                            src={adm.avatar_url}
                            alt={displayName}
                            class="w-11 h-11 rounded-2xl object-cover ring-2 ring-primary-500/20 dark:ring-primary-500/30"
                          />
                        ) : (
                          <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-primary-500/20 to-teal-500/10 text-primary-700 dark:text-primary-300 border border-primary-500/30 flex items-center justify-center font-bold text-xs uppercase shadow-xs">
                            {initials}
                          </div>
                        )}
                        {isMe && (
                          <span
                            class="absolute -bottom-1 -right-1 w-3 h-3 bg-emerald-500 border-2 border-white dark:border-slate-900 rounded-full shadow-xs"
                            title="Akun Anda Sedang Aktif"
                          ></span>
                        )}
                      </div>

                      <!-- Names -->
                      <div class="min-w-0">
                        <div class="flex items-center gap-2">
                          <span class="font-bold text-slate-900 dark:text-white text-sm truncate">
                            {displayName}
                          </span>
                          {isMe && (
                            <span class="inline-flex items-center gap-1 bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 text-[10px] font-bold px-2 py-0.5 rounded-full border border-emerald-200 dark:border-emerald-800/80">
                              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                              Akun Anda
                            </span>
                          )}
                        </div>
                        <p class="text-xs font-mono text-slate-500 dark:text-slate-400 mt-0.5">
                          @{adm.username}
                        </p>
                      </div>
                    </div>
                  </td>

                  <!-- Status & Role Column -->
                  <td class="py-4 px-6">
                    <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-medium text-slate-700 dark:text-slate-300">
                      <span class="w-1.5 h-1.5 rounded-full bg-primary-500"></span>
                      <span>Administrator</span>
                    </div>
                  </td>

                  <!-- Date Column -->
                  <td class="py-4 px-6">
                    <div class="flex items-center gap-2 text-xs text-slate-600 dark:text-slate-400">
                      <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                      <span>{fmtDate(adm.created_at)}</span>
                    </div>
                  </td>

                  <!-- Action Column -->
                  <td class="py-4 px-6 text-right">
                    {isMe ? (
                      <a
                        href="/admin/profil"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-primary-600 dark:text-primary-400 bg-primary-50 hover:bg-primary-100 dark:bg-primary-950/40 dark:hover:bg-primary-900/50 border border-primary-200 dark:border-primary-800/80 transition shadow-xs"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                        </svg>
                        <span>Ubah di Profil</span>
                      </a>
                    ) : (
                      <form
                        method="POST"
                        onsubmit={`return confirmDelete(this, 'Hapus Akun @${adm.username}?', 'Akun admin ini akan dihapus permanen dan tidak dapat login lagi ke panel admin.');`}
                        class="inline-block"
                      >
                        <input type="hidden" name="_action" value="delete_admin" />
                        <input type="hidden" name="target_id" value={adm.id} />
                        <button
                          type="submit"
                          class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-rose-600 dark:text-rose-400 bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/40 dark:hover:bg-rose-900/50 border border-rose-200 dark:border-rose-800/80 rounded-xl transition cursor-pointer shadow-xs active:scale-95"
                          title="Hapus akun admin"
                        >
                          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                          <span>Hapus</span>
                        </button>
                      </form>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <!-- Empty State Filter -->
      <div id="no-search-results" class="hidden py-12 text-center text-slate-400 text-xs">
        <p class="text-base mb-1">🔍</p>
        <p>Tidak ada admin yang cocok dengan pencarian Anda.</p>
      </div>

    </div>

  </div>
</AdminLayout>

<script is:inline>
  // Filter pencarian instan nama & username admin
  const searchInput = document.getElementById('search-admin');
  const rows = document.querySelectorAll('.admin-row');
  const noResults = document.getElementById('no-search-results');

  searchInput?.addEventListener('input', (e) => {
    const q = e.target.value.toLowerCase().trim();
    let visibleCount = 0;

    rows.forEach((row) => {
      const text = row.textContent.toLowerCase();
      if (text.includes(q)) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });

    if (noResults) {
      noResults.classList.toggle('hidden', visibleCount > 0);
    }
  });
</script>

