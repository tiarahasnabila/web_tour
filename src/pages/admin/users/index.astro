---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { sql } from '../../../lib/db';
import { verifySessionToken } from '../../../lib/auth';
import bcrypt from 'bcryptjs';

const session = verifySessionToken(Astro.cookies.get('admin_session')?.value);
if (!session) {
  return Astro.redirect('/admin/login');
}

let flash: { type: 'success' | 'error'; text: string } | null = null;
let currentAdmin: any = null;

// Ambil data admin yang sedang login
const meRows = await sql`SELECT id, username, display_name, avatar_url, created_at FROM admins WHERE username = ${session.username} LIMIT 1;`;
currentAdmin = meRows[0];

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action');
    const get = (k: string) => formData.get(k)?.toString().trim() || '';

    if (action === 'create_admin') {
      const username = get('username').toLowerCase();
      const displayName = get('display_name');
      const password = formData.get('password')?.toString() || '';

      if (!/^[a-z0-9_.]{3,30}$/.test(username)) {
        flash = { type: 'error', text: 'Username harus 3-30 karakter (huruf kecil, angka, titik, atau underscore).' };
      } else if (password.length < 8) {
        flash = { type: 'error', text: 'Password admin baru minimal 8 karakter.' };
      } else {
        const taken = await sql`SELECT id FROM admins WHERE username = ${username} LIMIT 1;`;
        if (taken.length > 0) {
          flash = { type: 'error', text: `Username "@${username}" sudah digunakan oleh admin lain.` };
        } else {
          const hash = bcrypt.hashSync(password, 10);
          await sql`
            INSERT INTO admins (username, display_name, password_hash)
            VALUES (${username}, ${displayName || null}, ${hash});
          `;
          return Astro.redirect('/admin/users?saved=1');
        }
      }
    } else if (action === 'update_admin') {
      const targetId = Number(formData.get('target_id'));
      const displayName = get('display_name');
      const newPassword = formData.get('new_password')?.toString() || '';

      if (newPassword && newPassword.length < 8) {
        flash = { type: 'error', text: 'Password baru minimal 8 karakter.' };
      } else {
        if (newPassword) {
          const hash = bcrypt.hashSync(newPassword, 10);
          await sql`
            UPDATE admins
            SET display_name = ${displayName || null}, password_hash = ${hash}, updated_at = NOW()
            WHERE id = ${targetId};
          `;
        } else {
          await sql`
            UPDATE admins
            SET display_name = ${displayName || null}, updated_at = NOW()
            WHERE id = ${targetId};
          `;
        }
        return Astro.redirect('/admin/users?updated=1');
      }
    } else if (action === 'delete_admin') {
      const targetId = Number(formData.get('target_id'));
      if (currentAdmin && targetId === currentAdmin.id) {
        flash = { type: 'error', text: 'Anda tidak dapat menghapus akun Anda sendiri yang sedang aktif digunakan.' };
      } else {
        await sql`DELETE FROM admins WHERE id = ${targetId};`;
        return Astro.redirect('/admin/users?deleted=1');
      }
    }
  } catch (err: any) {
    console.error('Admin users error:', err);
    flash = { type: 'error', text: 'Terjadi kesalahan: ' + err.message };
  }
}

const savedParam = Astro.url.searchParams.get('saved');
const updatedParam = Astro.url.searchParams.get('updated');
const deletedParam = Astro.url.searchParams.get('deleted');

if (!flash) {
  if (savedParam) flash = { type: 'success', text: 'Akun admin baru berhasil ditambahkan dan siap digunakan!' };
  else if (updatedParam) flash = { type: 'success', text: 'Data akun admin berhasil diperbarui!' };
  else if (deletedParam) flash = { type: 'success', text: 'Akun admin berhasil dihapus secara permanen.' };
}

let admins: any[] = [];
try {
  admins = await sql`SELECT id, username, display_name, avatar_url, created_at, updated_at FROM admins ORDER BY id ASC;`;
} catch (err: any) {
  console.error('Fetch admins error:', err);
}

const fmtDate = (d: any) =>
  d
    ? new Date(d).toLocaleDateString('id-ID', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      })
    : '-';

function getInitials(name: string, username: string) {
  const target = (name || username || '').trim();
  const parts = target.split(/\s+/).filter(Boolean);
  if (parts.length >= 2) {
    return (parts[0][0] + parts[1][0]).toUpperCase();
  }
  return target.slice(0, 2).toUpperCase();
}

const avatarPalettes = [
  'from-teal-500 to-emerald-600 text-white shadow-teal-500/20',
  'from-sky-500 to-blue-600 text-white shadow-sky-500/20',
  'from-violet-500 to-indigo-600 text-white shadow-violet-500/20',
  'from-amber-500 to-orange-600 text-white shadow-amber-500/20',
  'from-rose-500 to-pink-600 text-white shadow-rose-500/20',
];
---

<AdminLayout title="Manajemen Akun Admin" active="users">
  <div class="space-y-6 max-w-6xl pb-10">
    
    <!-- Hero Banner Header -->
    <section class="relative overflow-hidden rounded-3xl bg-navy-950 text-white p-6 sm:p-8 shadow-lg border border-white/10">
      <div class="absolute -right-16 -top-16 w-72 h-72 rounded-full bg-primary-500/20 blur-3xl pointer-events-none"></div>
      <div class="absolute right-32 -bottom-24 w-56 h-56 rounded-full bg-sky-500/15 blur-3xl pointer-events-none"></div>
      
      <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
        <div class="space-y-2">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/15 text-primary-300 text-xs font-semibold backdrop-blur-xs">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Kontrol Akses & Otoritas Sistem</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">Manajemen Akun Admin</h1>
          <p class="text-sm text-slate-300 max-w-xl leading-relaxed">
            Kelola tim staf dan administrator yang memiliki wewenang untuk mengatur paket wisata, armada, galeri, dan konfigurasi website.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3 shrink-0">
          <a
            href="/admin/profil"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/15 border border-white/15 text-white text-xs sm:text-sm font-semibold transition backdrop-blur-xs"
          >
            <svg class="w-4 h-4 text-primary-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span>Profil Saya</span>
          </a>

          <button
            type="button"
            id="btn-open-create-modal"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-500 text-white text-xs sm:text-sm font-bold shadow-lg shadow-primary-600/25 hover:shadow-primary-500/40 transition-all hover:-translate-y-0.5 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            <span>Tambah Akun Admin</span>
          </button>
        </div>
      </div>
    </section>

    <!-- Flash Alert -->
    {flash && (
      <div class:list={[
        'px-5 py-4 rounded-2xl text-sm font-medium border flex items-center justify-between gap-3 shadow-xs transition-all',
        flash.type === 'success'
          ? 'bg-emerald-50 dark:bg-emerald-950/40 border-emerald-200 dark:border-emerald-800/70 text-emerald-800 dark:text-emerald-300'
          : 'bg-rose-50 dark:bg-rose-950/40 border-rose-200 dark:border-rose-800/70 text-rose-800 dark:text-rose-300',
      ]}>
        <div class="flex items-center gap-3">
          <span class:list={[
            'w-7 h-7 rounded-xl flex items-center justify-center text-xs font-bold shrink-0',
            flash.type === 'success' ? 'bg-emerald-500 text-white' : 'bg-rose-500 text-white'
          ]}>
            {flash.type === 'success' ? '✓' : '!'}
          </span>
          <span>{flash.text}</span>
        </div>
        <button type="button" onclick="this.parentElement.remove()" class="text-xs opacity-60 hover:opacity-100 px-2 py-1 cursor-pointer">✕</button>
      </div>
    )}

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <!-- Total Admin -->
      <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-5 shadow-xs flex items-center justify-between">
        <div class="space-y-1">
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Pengelola</p>
          <div class="flex items-baseline gap-2">
            <h3 class="text-2xl font-bold text-slate-900 dark:text-white">{admins.length}</h3>
            <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">Akun Aktif</span>
          </div>
          <p class="text-[11px] text-slate-400">Akses penuh ke panel admin</p>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-primary-50 dark:bg-primary-950/60 text-primary-600 dark:text-primary-400 flex items-center justify-center border border-primary-100 dark:border-primary-800/40 shrink-0">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
      </div>

      <!-- Sesi Login Saat Ini -->
      <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-5 shadow-xs flex items-center justify-between">
        <div class="min-w-0 space-y-1 pr-2">
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Sesi Anda Saat Ini</p>
          <div class="flex items-center gap-2">
            <span class="text-base font-bold text-slate-900 dark:text-white truncate">
              {currentAdmin?.display_name || session.username}
            </span>
            <span class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60 shrink-0">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              Online
            </span>
          </div>
          <p class="text-[11px] font-mono text-slate-400 truncate">@{session.username}</p>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-sky-50 dark:bg-sky-950/60 text-sky-600 dark:text-sky-400 flex items-center justify-center border border-sky-100 dark:border-sky-800/40 shrink-0">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
      </div>

      <!-- Keamanan -->
      <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-5 shadow-xs flex items-center justify-between">
        <div class="space-y-1">
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Standar Proteksi</p>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Bcrypt & Signed Token</h3>
          <p class="text-[11px] text-emerald-600 dark:text-emerald-400 font-medium">✓ Enkripsi Hash 10-Rounds Aktif</p>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center border border-amber-100 dark:border-amber-800/40 shrink-0">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Main Container -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 overflow-hidden shadow-xs">
      
      <!-- Toolbar: Title, Search & View Switcher -->
      <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="font-bold text-slate-900 dark:text-white text-base flex items-center gap-2">
            <span>Daftar Administrator</span>
            <span class="px-2 py-0.5 text-xs font-bold rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
              {admins.length}
            </span>
          </h2>
          <p class="text-xs text-slate-400 mt-0.5">Kelola informasi profil, reset password staf, atau cabut hak akses.</p>
        </div>

        <div class="flex items-center gap-3">
          <!-- Pencarian Instan -->
          <div class="relative flex-1 sm:w-64">
            <input
              type="text"
              id="search-admin"
              placeholder="Cari nama atau @username..."
              class="w-full pl-9 pr-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-xs text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition"
            />
            <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>

          <!-- View Switcher (Table / Cards) -->
          <div class="inline-flex items-center p-1 bg-slate-100 dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 shrink-0">
            <button
              type="button"
              id="view-btn-table"
              class="px-2.5 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer bg-white dark:bg-slate-900 text-slate-900 dark:text-white shadow-xs"
              title="Tampilan Tabel"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              <span class="hidden md:inline">Tabel</span>
            </button>
            <button
              type="button"
              id="view-btn-grid"
              class="px-2.5 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-white"
              title="Tampilan Kartu"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
              </svg>
              <span class="hidden md:inline">Kartu</span>
            </button>
          </div>
        </div>
      </div>

      <!-- 1. TABLE VIEW -->
      <div id="admin-view-table" class="overflow-x-auto">
        <table class="w-full text-left text-sm border-collapse">
          <thead>
            <tr class="bg-slate-50/70 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800 text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
              <th class="py-3.5 px-6">Profil Pengelola</th>
              <th class="py-3.5 px-6">Peran & Otoritas</th>
              <th class="py-3.5 px-6">Terdaftar</th>
              <th class="py-3.5 px-6 text-right">Tindakan</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            {admins.map((adm, idx) => {
              const isMe = currentAdmin && adm.id === currentAdmin.id;
              const initials = getInitials(adm.display_name, adm.username);
              const displayName = adm.display_name || adm.username;
              const palette = avatarPalettes[idx % avatarPalettes.length];
              return (
                <tr
                  class="admin-search-item hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition"
                  data-search={`${displayName} ${adm.username}`.toLowerCase()}
                >
                  <!-- User Info -->
                  <td class="py-4 px-6">
                    <div class="flex items-center gap-3.5">
                      <div class="relative shrink-0">
                        {adm.avatar_url ? (
                          <img
                            src={adm.avatar_url}
                            alt={displayName}
                            class="w-11 h-11 rounded-2xl object-cover ring-2 ring-primary-500/20 shadow-xs"
                          />
                        ) : (
                          <div class={`w-11 h-11 rounded-2xl bg-gradient-to-br ${palette} flex items-center justify-center font-bold text-xs uppercase shadow-sm`}>
                            {initials}
                          </div>
                        )}
                        {isMe && (
                          <span
                            class="absolute -bottom-1 -right-1 w-3.5 h-3.5 bg-emerald-500 border-2 border-white dark:border-slate-900 rounded-full"
                            title="Sedang digunakan"
                          ></span>
                        )}
                      </div>

                      <div class="min-w-0">
                        <div class="flex items-center gap-2">
                          <span class="font-bold text-slate-900 dark:text-white text-sm truncate">
                            {displayName}
                          </span>
                          {isMe && (
                            <span class="inline-flex items-center gap-1 bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 text-[10px] font-bold px-2 py-0.5 rounded-full border border-emerald-200 dark:border-emerald-800/80">
                              Akun Anda
                            </span>
                          )}
                        </div>
                        <p class="text-xs font-mono text-slate-400 mt-0.5">
                          @{adm.username}
                        </p>
                      </div>
                    </div>
                  </td>

                  <!-- Role & Badges -->
                  <td class="py-4 px-6">
                    <div class="flex flex-wrap items-center gap-1.5">
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-primary-50 dark:bg-primary-950/60 border border-primary-200/60 dark:border-primary-800/60 text-xs font-semibold text-primary-700 dark:text-primary-300">
                        <span class="w-1.5 h-1.5 rounded-full bg-primary-500"></span>
                        <span>Administrator</span>
                      </span>
                      <span class="text-[11px] px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">
                        Akses Penuh
                      </span>
                    </div>
                  </td>

                  <!-- Created Date -->
                  <td class="py-4 px-6">
                    <div class="text-xs text-slate-600 dark:text-slate-300 font-medium">
                      {fmtDate(adm.created_at)}
                    </div>
                    {adm.updated_at && (
                      <p class="text-[10px] text-slate-400 mt-0.5">
                        Diperbarui {fmtDate(adm.updated_at)}
                      </p>
                    )}
                  </td>

                  <!-- Actions -->
                  <td class="py-4 px-6 text-right">
                    {isMe ? (
                      <a
                        href="/admin/profil"
                        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold text-primary-700 dark:text-primary-300 bg-primary-50 hover:bg-primary-100 dark:bg-primary-950/50 dark:hover:bg-primary-900/60 border border-primary-200/80 dark:border-primary-800/70 transition shadow-2xs"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                        <span>Kelola Profil &rarr;</span>
                      </a>
                    ) : (
                      <div class="inline-flex items-center justify-end gap-2">
                        <button
                          type="button"
                          data-admin={JSON.stringify({ id: adm.id, username: adm.username, display_name: adm.display_name || '' })}
                          class="btn-edit-admin inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-300 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 border border-slate-200/80 dark:border-slate-700 transition cursor-pointer"
                          title="Edit nama atau reset password"
                        >
                          <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                          </svg>
                          <span>Edit / Reset Sandi</span>
                        </button>

                        <form
                          method="POST"
                          onsubmit={`return confirmDelete(this, 'Hapus Akun Admin?', 'Akun <strong>@${adm.username}</strong> (${displayName.replace(/'/g, "\\'")}) akan dihapus permanen dan tidak bisa login lagi.');`}
                          class="inline-block"
                        >
                          <input type="hidden" name="_action" value="delete_admin" />
                          <input type="hidden" name="target_id" value={adm.id} />
                          <button
                            type="submit"
                            class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-rose-600 dark:text-rose-400 bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/40 dark:hover:bg-rose-900/50 border border-rose-200 dark:border-rose-800/80 rounded-xl transition cursor-pointer"
                            title="Hapus akun admin"
                          >
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                            <span>Hapus</span>
                          </button>
                        </form>
                      </div>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <!-- 2. GRID / CARD VIEW -->
      <div id="admin-view-grid" class="hidden p-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {admins.map((adm, idx) => {
          const isMe = currentAdmin && adm.id === currentAdmin.id;
          const initials = getInitials(adm.display_name, adm.username);
          const displayName = adm.display_name || adm.username;
          const palette = avatarPalettes[idx % avatarPalettes.length];
          return (
            <div
              class="admin-search-item dashboard-card rounded-2xl bg-slate-50/70 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700 p-5 flex flex-col justify-between gap-5 hover:shadow-md transition"
              data-search={`${displayName} ${adm.username}`.toLowerCase()}
            >
              <div>
                <div class="flex items-start justify-between gap-3">
                  <div class="flex items-center gap-3.5">
                    <div class="relative shrink-0">
                      {adm.avatar_url ? (
                        <img
                          src={adm.avatar_url}
                          alt={displayName}
                          class="w-13 h-13 rounded-2xl object-cover ring-2 ring-primary-500/20"
                        />
                      ) : (
                        <div class={`w-13 h-13 rounded-2xl bg-gradient-to-br ${palette} flex items-center justify-center font-bold text-sm uppercase shadow-md`}>
                          {initials}
                        </div>
                      )}
                      {isMe && (
                        <span class="absolute -bottom-1 -right-1 w-3.5 h-3.5 bg-emerald-500 border-2 border-white dark:border-slate-900 rounded-full"></span>
                      )}
                    </div>

                    <div class="min-w-0">
                      <h3 class="font-bold text-slate-900 dark:text-white text-base truncate">{displayName}</h3>
                      <p class="text-xs font-mono text-slate-400 truncate">@{adm.username}</p>
                    </div>
                  </div>

                  {isMe ? (
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 shrink-0">
                      Akun Anda
                    </span>
                  ) : (
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-semibold bg-slate-200/70 dark:bg-slate-700 text-slate-600 dark:text-slate-300 shrink-0">
                      Admin
                    </span>
                  )}
                </div>

                <div class="mt-4 pt-4 border-t border-slate-200/60 dark:border-slate-700/70 grid grid-cols-2 gap-2 text-xs">
                  <div>
                    <span class="text-[10px] uppercase tracking-wider text-slate-400 block">Terdaftar</span>
                    <span class="font-semibold text-slate-700 dark:text-slate-200">{fmtDate(adm.created_at)}</span>
                  </div>
                  <div>
                    <span class="text-[10px] uppercase tracking-wider text-slate-400 block">Hak Akses</span>
                    <span class="font-semibold text-primary-600 dark:text-primary-400">Penuh (All Menu)</span>
                  </div>
                </div>
              </div>

              <div class="pt-3 border-t border-slate-200/60 dark:border-slate-700/70 flex items-center justify-between gap-2">
                {isMe ? (
                  <a
                    href="/admin/profil"
                    class="w-full py-2 px-3 rounded-xl text-xs font-bold text-center text-primary-700 dark:text-primary-300 bg-primary-50 hover:bg-primary-100 dark:bg-primary-950/60 border border-primary-200/70 dark:border-primary-800/70 transition"
                  >
                    Ubah Profil & Password &rarr;
                  </a>
                ) : (
                  <>
                    <button
                      type="button"
                      data-admin={JSON.stringify({ id: adm.id, username: adm.username, display_name: adm.display_name || '' })}
                      class="btn-edit-admin flex-1 py-2 px-3 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 transition cursor-pointer"
                    >
                      🔑 Edit / Sandi
                    </button>
                    <form
                      method="POST"
                      onsubmit={`return confirmDelete(this, 'Hapus Akun Admin?', 'Akun <strong>@${adm.username}</strong> (${displayName.replace(/'/g, "\\'")}) akan dihapus permanen dan tidak bisa login lagi.');`}
                    >
                      <input type="hidden" name="_action" value="delete_admin" />
                      <input type="hidden" name="target_id" value={adm.id} />
                      <button
                        type="submit"
                        class="py-2 px-3 rounded-xl text-xs font-semibold text-rose-600 dark:text-rose-400 bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/50 border border-rose-200 dark:border-rose-800/70 transition cursor-pointer"
                      >
                        Hapus
                      </button>
                    </form>
                  </>
                )}
              </div>
            </div>
          );
        })}
      </div>

      <!-- Empty Search State -->
      <div id="no-search-results" class="hidden py-14 text-center">
        <div class="w-12 h-12 rounded-2xl bg-slate-100 dark:bg-slate-800 text-slate-400 mx-auto flex items-center justify-center text-xl mb-3">
          🔍
        </div>
        <p class="text-sm font-bold text-slate-700 dark:text-slate-300">Admin tidak ditemukan</p>
        <p class="text-xs text-slate-400 mt-0.5">Tidak ada nama atau username yang cocok dengan kata kunci pencarian.</p>
      </div>
    </div>

    <!-- Bottom Info Banner -->
    <div class="rounded-2xl bg-slate-100/80 dark:bg-slate-900/90 border border-slate-200/70 dark:border-slate-800 p-4 sm:p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="flex items-start sm:items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-primary-500/10 text-primary-600 dark:text-primary-400 flex items-center justify-center shrink-0 text-lg">
          💡
        </div>
        <div>
          <h4 class="text-xs font-bold text-slate-800 dark:text-slate-200">Tips Keamanan Akses</h4>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Gunakan akun terpisah untuk setiap staf agar aktivitas pengelolaan terpantau. Jika staf sudah tidak bertugas, segera hapus akun atau reset kata sandinya.
          </p>
        </div>
      </div>
      <a
        href="/admin/users/tambah"
        class="text-xs font-bold text-primary-600 dark:text-primary-400 hover:underline shrink-0"
      >
        Buka Halaman Form Penuh &rarr;
      </a>
    </div>
  </div>

  <!-- MODAL 1: TAMBAH ADMIN BARU -->
  <div id="create-admin-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
    <div id="create-modal-backdrop" class="fixed inset-0 bg-navy-950/70 backdrop-blur-sm"></div>
    <div class="relative bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 w-full max-w-md p-6 sm:p-7 shadow-2xl z-10">
      <div class="flex items-center justify-between pb-4 mb-5 border-b border-slate-100 dark:border-slate-800">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-primary-50 dark:bg-primary-950/60 text-primary-600 dark:text-primary-400 flex items-center justify-center font-bold">
            👤+
          </div>
          <div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white">Tambah Akun Admin</h3>
            <p class="text-xs text-slate-400">Buat akses login baru untuk pengelola.</p>
          </div>
        </div>
        <button type="button" id="btn-close-create" class="w-8 h-8 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-500 hover:text-slate-800 dark:hover:text-white flex items-center justify-center text-sm cursor-pointer">
          ✕
        </button>
      </div>

      <form method="POST" class="space-y-4">
        <input type="hidden" name="_action" value="create_admin" />

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
            Nama Tampilan
          </label>
          <input
            type="text"
            name="display_name"
            placeholder="Contoh: Admin Salsa"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-xs focus:outline-none focus:ring-2 focus:ring-primary-500"
          />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
            Username Login <span class="text-rose-500">*</span>
          </label>
          <div class="flex rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden bg-white dark:bg-slate-800 focus-within:ring-2 focus-within:ring-primary-500">
            <span class="px-3 flex items-center bg-slate-50 dark:bg-slate-900 text-slate-400 text-xs font-mono border-r border-slate-200 dark:border-slate-700">@</span>
            <input
              type="text"
              name="username"
              required
              minlength="3"
              maxlength="30"
              pattern="[a-zA-Z0-9_.]+"
              placeholder="salsa_jogja"
              class="w-full px-3 py-2.5 text-xs bg-transparent text-slate-900 dark:text-white focus:outline-none"
            />
          </div>
          <p class="text-[11px] text-slate-400 mt-1">Huruf kecil, angka, titik, atau underscore (tanpa spasi).</p>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
              Password Awal <span class="text-rose-500">*</span>
            </label>
            <button type="button" id="btn-gen-pass" class="text-[11px] font-semibold text-primary-600 dark:text-primary-400 hover:underline cursor-pointer">
              ⚡ Buat Password Acak
            </button>
          </div>
          <div class="relative">
            <input
              type="password"
              name="password"
              id="create-password"
              required
              minlength="8"
              placeholder="Minimal 8 karakter"
              class="w-full px-3.5 py-2.5 pr-10 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-xs focus:outline-none focus:ring-2 focus:ring-primary-500"
            />
            <button
              type="button"
              id="toggle-create-pw"
              class="absolute inset-y-0 right-0 px-3 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 cursor-pointer"
            >
              👁️
            </button>
          </div>
        </div>

        <div class="pt-3 flex items-center justify-end gap-2.5 border-t border-slate-100 dark:border-slate-800">
          <button
            type="button"
            id="btn-cancel-create"
            class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition cursor-pointer"
          >
            Batal
          </button>
          <button
            type="submit"
            class="px-5 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-xs font-bold shadow-md transition cursor-pointer"
          >
            Simpan Akun Admin
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL 2: EDIT INFO / RESET PASSWORD ADMIN -->
  <div id="edit-admin-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
    <div id="edit-modal-backdrop" class="fixed inset-0 bg-navy-950/70 backdrop-blur-sm"></div>
    <div class="relative bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 w-full max-w-md p-6 sm:p-7 shadow-2xl z-10">
      <div class="flex items-center justify-between pb-4 mb-5 border-b border-slate-100 dark:border-slate-800">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold">
            🔑
          </div>
          <div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white">Edit / Reset Sandi Admin</h3>
            <p id="edit-modal-subtitle" class="text-xs font-mono text-slate-400">@username</p>
          </div>
        </div>
        <button type="button" id="btn-close-edit" class="w-8 h-8 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-500 hover:text-slate-800 dark:hover:text-white flex items-center justify-center text-sm cursor-pointer">
          ✕
        </button>
      </div>

      <form method="POST" class="space-y-4">
        <input type="hidden" name="_action" value="update_admin" />
        <input type="hidden" name="target_id" id="edit-target-id" value="" />

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
            Nama Tampilan
          </label>
          <input
            type="text"
            name="display_name"
            id="edit-display-name"
            placeholder="Nama tampilan admin"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-xs focus:outline-none focus:ring-2 focus:ring-primary-500"
          />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
            Reset Password Baru (Opsional)
          </label>
          <input
            type="password"
            name="new_password"
            id="edit-new-password"
            minlength="8"
            placeholder="Kosongkan jika tidak ingin mengubah sandi"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-xs focus:outline-none focus:ring-2 focus:ring-primary-500"
          />
          <p class="text-[11px] text-slate-400 mt-1">Isi minimal 8 karakter hanya jika staf lupa password.</p>
        </div>

        <div class="pt-3 flex items-center justify-end gap-2.5 border-t border-slate-100 dark:border-slate-800">
          <button
            type="button"
            id="btn-cancel-edit"
            class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition cursor-pointer"
          >
            Batal
          </button>
          <button
            type="submit"
            class="px-5 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-xs font-bold shadow-md transition cursor-pointer"
          >
            Simpan Perubahan
          </button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script is:inline>
  (function () {
    // 1. Live Search Filter
    const searchInput = document.getElementById('search-admin');
    const searchItems = document.querySelectorAll('.admin-search-item');
    const noResults = document.getElementById('no-search-results');

    searchInput?.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      let visibleCount = 0;

      searchItems.forEach((item) => {
        const text = item.getAttribute('data-search') || '';
        if (text.includes(q)) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }
    });

    // 2. View Switcher (Table vs Grid)
    const btnTable = document.getElementById('view-btn-table');
    const btnGrid = document.getElementById('view-btn-grid');
    const viewTable = document.getElementById('admin-view-table');
    const viewGrid = document.getElementById('admin-view-grid');

    function setViewMode(mode) {
      if (mode === 'grid') {
        viewTable?.classList.add('hidden');
        viewGrid?.classList.remove('hidden');
        btnGrid?.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-900', 'dark:text-white', 'shadow-xs');
        btnGrid?.classList.remove('text-slate-500', 'dark:text-slate-400');
        btnTable?.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-900', 'dark:text-white', 'shadow-xs');
        btnTable?.classList.add('text-slate-500', 'dark:text-slate-400');
      } else {
        viewGrid?.classList.add('hidden');
        viewTable?.classList.remove('hidden');
        btnTable?.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-900', 'dark:text-white', 'shadow-xs');
        btnTable?.classList.remove('text-slate-500', 'dark:text-slate-400');
        btnGrid?.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-900', 'dark:text-white', 'shadow-xs');
        btnGrid?.classList.add('text-slate-500', 'dark:text-slate-400');
      }
      localStorage.setItem('admin-users-view', mode);
    }

    btnTable?.addEventListener('click', () => setViewMode('table'));
    btnGrid?.addEventListener('click', () => setViewMode('grid'));

    const savedView = localStorage.getItem('admin-users-view');
    if (savedView === 'grid') setViewMode('grid');

    // 3. Create Admin Modal
    const createModal = document.getElementById('create-admin-modal');
    const openCreateBtn = document.getElementById('btn-open-create-modal');
    const closeCreateBtn = document.getElementById('btn-close-create');
    const cancelCreateBtn = document.getElementById('btn-cancel-create');
    const createBackdrop = document.getElementById('create-modal-backdrop');
    const createPwInput = document.getElementById('create-password');
    const toggleCreatePw = document.getElementById('toggle-create-pw');
    const genPassBtn = document.getElementById('btn-gen-pass');

    const closeCreate = () => createModal?.classList.add('hidden');
    openCreateBtn?.addEventListener('click', () => createModal?.classList.remove('hidden'));
    closeCreateBtn?.addEventListener('click', closeCreate);
    cancelCreateBtn?.addEventListener('click', closeCreate);
    createBackdrop?.addEventListener('click', closeCreate);

    toggleCreatePw?.addEventListener('click', () => {
      if (!createPwInput) return;
      createPwInput.type = createPwInput.type === 'password' ? 'text' : 'password';
    });

    genPassBtn?.addEventListener('click', () => {
      if (!createPwInput) return;
      const chars = 'abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789!@#';
      let pass = '';
      for (let i = 0; i < 10; i++) {
        pass += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      createPwInput.value = pass;
      createPwInput.type = 'text';
    });

    // 4. Edit / Reset Password Admin Modal
    const editModal = document.getElementById('edit-admin-modal');
    const closeEditBtn = document.getElementById('btn-close-edit');
    const cancelEditBtn = document.getElementById('btn-cancel-edit');
    const editBackdrop = document.getElementById('edit-modal-backdrop');
    const editTargetId = document.getElementById('edit-target-id');
    const editDisplayName = document.getElementById('edit-display-name');
    const editSubtitle = document.getElementById('edit-modal-subtitle');
    const editNewPw = document.getElementById('edit-new-password');

    const closeEdit = () => editModal?.classList.add('hidden');
    closeEditBtn?.addEventListener('click', closeEdit);
    cancelEditBtn?.addEventListener('click', closeEdit);
    editBackdrop?.addEventListener('click', closeEdit);

    document.querySelectorAll('.btn-edit-admin').forEach((btn) => {
      btn.addEventListener('click', () => {
        try {
          const data = JSON.parse(btn.getAttribute('data-admin') || '{}');
          if (editTargetId) editTargetId.value = data.id || '';
          if (editDisplayName) editDisplayName.value = data.display_name || '';
          if (editSubtitle) editSubtitle.textContent = '@' + (data.username || '');
          if (editNewPw) editNewPw.value = '';
          editModal?.classList.remove('hidden');
        } catch (err) {
          console.error(err);
        }
      });
    });
  })();
</script>
