---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { sql } from '../../../lib/db';
import { verifySessionToken } from '../../../lib/auth';
import { invalidateToursCache } from '../../../lib/tours';

// Wajib login
const user = verifySessionToken(Astro.cookies.get('admin_session')?.value);
if (!user) {
  return Astro.redirect('/admin/login');
}

let tours: any[] = [];
let flash: { type: 'success' | 'error'; text: string } | null = null;

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action');
    const tourId = formData.get('tour_id');

    if (action === 'delete' && tourId) {
      await sql`DELETE FROM tours WHERE id = ${Number(tourId)};`;
      invalidateToursCache();
      flash = { type: 'success', text: 'Paket wisata berhasil dihapus.' };
    } else if (action === 'toggle_status' && tourId) {
      await sql`UPDATE tours SET is_active = NOT COALESCE(is_active, true) WHERE id = ${Number(tourId)};`;
      invalidateToursCache();
      flash = { type: 'success', text: 'Status publikasi paket berhasil diperbarui.' };
    }
  } catch (err: any) {
    console.error('Delete error:', err);
    flash = { type: 'error', text: 'Gagal menghapus: ' + err.message };
  }
}

if (!flash && Astro.url.searchParams.get('saved')) {
  flash = { type: 'success', text: 'Paket wisata berhasil disimpan.' };
}

try {
  tours = await sql`SELECT * FROM tours ORDER BY id DESC;`;
} catch (err: any) {
  console.error('Fetch error:', err);
  flash = { type: 'error', text: 'Gagal memuat data dari database.' };
}
---

<AdminLayout title="Paket Wisata" active="tours">
  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Paket Wisata</h1>
        <p class="text-sm text-slate-500 mt-1">{tours.length} paket tampil di website.</p>
      </div>

      <div class="flex items-center gap-3">
        <!-- Switcher View: List & Icon -->
        <div class="inline-flex items-center p-1 bg-slate-100 dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
          <button
            type="button"
            id="view-btn-list"
            class="px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer"
            title="Tampilan List"
            aria-label="Tampilan List"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <span class="hidden sm:inline">List</span>
          </button>
          <button
            type="button"
            id="view-btn-grid"
            class="px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer"
            title="Tampilan Icon / Grid"
            aria-label="Tampilan Icon / Grid"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
            </svg>
            <span class="hidden sm:inline">Icon</span>
          </button>
        </div>

        <a href="/admin/tours/tambah" class="inline-flex items-center justify-center gap-2 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
          <span>Tambah Paket</span>
        </a>
      </div>
    </div>

    {flash && (
      <div class:list={[
        'px-4 py-3 rounded-xl text-sm font-medium border',
        flash.type === 'success' ? 'bg-emerald-50 border-emerald-200 text-emerald-700' : 'bg-red-50 border-red-200 text-red-700',
      ]}>
        {flash.text}
      </div>
    )}

    {tours.length === 0 ? (
      <div class="bg-white rounded-2xl border border-dashed border-slate-300 py-16 text-center">
        <p class="text-slate-500 text-sm">Belum ada paket wisata.</p>
        <a href="/admin/tours/tambah" class="inline-block mt-3 text-primary-600 font-semibold text-sm hover:underline">+ Tambah paket pertama</a>
      </div>
    ) : (
      <>
        <!-- 1. TAMPILAN LIST -->
        <div id="view-container-list" class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs">
          <ul class="divide-y divide-slate-100">
            {tours.map((tour) => (
              <li class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center gap-4 hover:bg-slate-50/60 transition">
                <img src={tour.thumbnail} alt={tour.title} loading="lazy"
                  class="w-full sm:w-28 h-32 sm:h-20 rounded-xl object-cover bg-slate-100 border border-slate-200 shrink-0" />
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2">
                    <h3 class="font-semibold text-slate-900 truncate">{tour.title}</h3>
                    {tour.is_active !== false ? (
                      <span class="text-[10px] bg-emerald-50 text-emerald-700 border border-emerald-200 font-bold px-2 py-0.5 rounded-full">
                        🟢 Aktif
                      </span>
                    ) : (
                      <span class="text-[10px] bg-amber-50 text-amber-700 border border-amber-200 font-bold px-2 py-0.5 rounded-full">
                        ⚪ Nonaktif
                      </span>
                    )}
                    {tour.badge && (
                      <span class="text-[10px] bg-primary-100 text-primary-700 font-bold px-2 py-0.5 rounded-full">
                        {tour.badge}
                      </span>
                    )}
                  </div>
                  <div class="flex items-center gap-2.5 text-xs text-slate-500 mt-1">
                    <span class="font-semibold text-slate-800">{tour.price || 'Rp 450.000'} {tour.price_unit || '/ mobil'}</span>
                    <span>•</span>
                    <span>⏱️ {tour.duration || '10-12 Jam'}</span>
                    <span>•</span>
                    <span>📍 {tour.location || 'Yogyakarta'}</span>
                  </div>
                  <p class="text-xs text-slate-500 line-clamp-1 mt-1">{tour.tagline || 'Tanpa tagline'}</p>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <form method="POST" class="inline">
                    <input type="hidden" name="_action" value="toggle_status" />
                    <input type="hidden" name="tour_id" value={tour.id} />
                    <button
                      type="submit"
                      class:list={[
                        "px-2.5 py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer border",
                        tour.is_active !== false
                          ? "bg-slate-100 hover:bg-slate-200 text-slate-700 border-slate-200"
                          : "bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border-emerald-200"
                      ]}
                      title={tour.is_active !== false ? "Klik untuk nonaktifkan" : "Klik untuk aktifkan"}
                    >
                      {tour.is_active !== false ? "Nonaktifkan" : "Aktifkan"}
                    </button>
                  </form>
                  <a href={`/tour-package/${tour.slug}`} target="_blank" class="px-3 py-2 rounded-lg text-xs font-medium text-slate-600 border border-slate-200 hover:bg-slate-100 transition">Lihat</a>
                  <a href={`/admin/tours/edit/${tour.id}`} class="px-3 py-2 rounded-lg text-xs font-medium text-primary-700 bg-primary-50 hover:bg-primary-100 transition">Edit</a>
                  <form method="POST" onsubmit="return confirmDelete(this, 'Hapus Paket Wisata?', 'Paket wisata ini akan dihapus secara permanen dari katalog website.');">
                    <input type="hidden" name="_action" value="delete" />
                    <input type="hidden" name="tour_id" value={tour.id} />
                    <button type="submit" class="px-3 py-2 rounded-lg text-xs font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 transition cursor-pointer">Hapus</button>
                  </form>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- 2. TAMPILAN ICON / GRID -->
        <div id="view-container-grid" class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
          {tours.map((tour) => (
            <div class="group bg-white rounded-3xl border border-slate-200/80 overflow-hidden shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between hover:-translate-y-1">
              <div>
                <!-- Thumbnail dengan Badge & Harga -->
                <div class="relative aspect-video w-full overflow-hidden bg-slate-100">
                  <img
                    src={tour.thumbnail}
                    alt={tour.title}
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                  {tour.badge && (
                    <span class="absolute top-3 left-3 text-[10px] bg-primary-600 text-white font-bold px-2.5 py-1 rounded-full shadow-md">
                      {tour.badge}
                    </span>
                  )}
                  <span class:list={[
                    "absolute top-3 right-3 text-[10px] font-bold px-2 py-0.5 rounded-full shadow-md backdrop-blur",
                    tour.is_active !== false
                      ? "bg-emerald-600/90 text-white"
                      : "bg-slate-900/90 text-amber-300 border border-amber-400/30"
                  ]}>
                    {tour.is_active !== false ? "🟢 Aktif" : "⚪ Nonaktif"}
                  </span>
                  <div class="absolute bottom-2.5 right-2.5 px-2.5 py-1 rounded-xl bg-slate-900/80 backdrop-blur text-white text-xs font-bold shadow-md">
                    {tour.price || 'Rp 450.000'} <span class="text-[10px] font-normal text-slate-300">{tour.price_unit || '/ mobil'}</span>
                  </div>
                </div>

                <!-- Konten Kartu -->
                <div class="p-5 space-y-2.5">
                  <h3 class="font-bold text-slate-900 text-base line-clamp-1 group-hover:text-primary-600 transition-colors" title={tour.title}>
                    {tour.title}
                  </h3>
                  <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                    {tour.tagline || 'Tanpa tagline deskripsi.'}
                  </p>

                  <div class="pt-2.5 flex flex-wrap items-center gap-1.5 text-xs text-slate-500 border-t border-slate-100">
                    <span class="inline-flex items-center gap-1 bg-slate-100 px-2 py-0.5 rounded-lg text-[11px] font-medium">
                      ⏱️ {tour.duration || '10-12 Jam'}
                    </span>
                    <span class="inline-flex items-center gap-1 bg-slate-100 px-2 py-0.5 rounded-lg text-[11px] font-medium truncate max-w-[130px]">
                      📍 {tour.location || 'Yogyakarta'}
                    </span>
                  </div>
                </div>
              </div>

              <!-- Tombol Aksi Bawah -->
              <div class="p-5 pt-0 flex items-center gap-2">
                <a
                  href={`/tour-package/${tour.slug}`}
                  target="_blank"
                  class="flex-1 py-2.5 text-center rounded-xl text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition"
                >
                  Lihat
                </a>
                <a
                  href={`/admin/tours/edit/${tour.id}`}
                  class="flex-1 py-2.5 text-center rounded-xl text-xs font-semibold text-primary-700 bg-primary-50 hover:bg-primary-100 transition"
                >
                  Edit
                </a>
                <form method="POST" class="shrink-0">
                  <input type="hidden" name="_action" value="toggle_status" />
                  <input type="hidden" name="tour_id" value={tour.id} />
                  <button
                    type="submit"
                    class:list={[
                      "p-2.5 rounded-xl border text-xs font-semibold transition cursor-pointer",
                      tour.is_active !== false
                        ? "bg-slate-50 hover:bg-slate-100 text-slate-600 border-slate-200"
                        : "bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border-emerald-200"
                    ]}
                    title={tour.is_active !== false ? "Nonaktifkan paket" : "Aktifkan paket"}
                  >
                    {tour.is_active !== false ? "Nonaktifkan" : "Aktifkan"}
                  </button>
                </form>
                <form
                  method="POST"
                  onsubmit="return confirmDelete(this, 'Hapus Paket Wisata?', 'Paket wisata ini akan dihapus secara permanen dari katalog website.');"
                  class="shrink-0"
                >
                  <input type="hidden" name="_action" value="delete" />
                  <input type="hidden" name="tour_id" value={tour.id} />
                  <button
                    type="submit"
                    class="p-2.5 rounded-xl text-rose-600 bg-rose-50 hover:bg-rose-100 transition cursor-pointer"
                    title="Hapus paket"
                    aria-label="Hapus"
                  >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                </form>
              </div>
            </div>
          ))}
        </div>
      </>
    )}
  </div>

  <!-- Script Switcher View List & Icon -->
  <script is:inline>
    (function () {
      const storageKey = 'admin-tours-view';
      const btnList = document.getElementById('view-btn-list');
      const btnGrid = document.getElementById('view-btn-grid');
      const containerList = document.getElementById('view-container-list');
      const containerGrid = document.getElementById('view-container-grid');

      const activeClasses = ['bg-white', 'dark:bg-slate-700', 'text-slate-900', 'dark:text-white', 'shadow-xs'];
      const inactiveClasses = ['text-slate-500', 'hover:text-slate-700', 'dark:hover:text-slate-200'];

      function setView(view) {
        if (view === 'grid') {
          containerList?.classList.add('hidden');
          containerGrid?.classList.remove('hidden');

          btnGrid?.classList.add(...activeClasses);
          btnGrid?.classList.remove(...inactiveClasses);

          btnList?.classList.remove(...activeClasses);
          btnList?.classList.add(...inactiveClasses);

          localStorage.setItem(storageKey, 'grid');
        } else {
          containerGrid?.classList.add('hidden');
          containerList?.classList.remove('hidden');

          btnList?.classList.add(...activeClasses);
          btnList?.classList.remove(...inactiveClasses);

          btnGrid?.classList.remove(...activeClasses);
          btnGrid?.classList.add(...inactiveClasses);

          localStorage.setItem(storageKey, 'list');
        }
      }

      // Restore saved view or default to list
      const savedView = localStorage.getItem(storageKey) || 'list';
      setView(savedView);

      btnList?.addEventListener('click', () => setView('list'));
      btnGrid?.addEventListener('click', () => setView('grid'));
    })();
  </script>
</AdminLayout>

