---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { sql } from '../../../lib/db';
import { verifySessionToken } from '../../../lib/auth';
import { getAllGallery, invalidateGalleryCache, type GalleryItem } from '../../../lib/gallery';
import { uploadToR2, ensureR2Url, isR2Configured } from '../../../lib/r2';

// Wajib login
const user = verifySessionToken(Astro.cookies.get('admin_session')?.value);
if (!user) {
  return Astro.redirect('/admin/login');
}

let flash: { type: 'success' | 'error'; text: string } | null = null;

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action');
    const id = formData.get('id');

    if (action === 'delete' && id) {
      await sql`DELETE FROM gallery WHERE id = ${Number(id)};`;
      invalidateGalleryCache();
      return Astro.redirect('/admin/gallery?deleted=1');
    } else if (action === 'toggle_featured' && id) {
      await sql`UPDATE gallery SET is_featured = NOT COALESCE(is_featured, true) WHERE id = ${Number(id)};`;
      invalidateGalleryCache();
      return Astro.redirect('/admin/gallery?toggled=1');
    } else if (action === 'rename_category') {
      // UBAH NAMA KATEGORI
      const oldCategory = formData.get('old_category')?.toString().trim();
      const newCategory = formData.get('new_category')?.toString().trim();
      if (oldCategory && newCategory && oldCategory !== newCategory) {
        await sql`
          UPDATE gallery
          SET category = ${newCategory}
          WHERE category = ${oldCategory};
        `;
        invalidateGalleryCache();
        return Astro.redirect(
          `/admin/gallery?cat_renamed=1&old=${encodeURIComponent(oldCategory)}&new=${encodeURIComponent(newCategory)}`
        );
      }
    } else if (action === 'delete_category') {
      // HAPUS KATEGORI (Foto dialihkan ke 'Wisata' atau dihapus)
      const targetCategory = formData.get('target_category')?.toString().trim();
      const deleteMode = formData.get('delete_mode')?.toString() || 'reassign'; // 'reassign' | 'delete_photos'
      if (targetCategory) {
        if (deleteMode === 'delete_photos') {
          await sql`DELETE FROM gallery WHERE category = ${targetCategory};`;
        } else {
          await sql`UPDATE gallery SET category = 'Wisata' WHERE category = ${targetCategory};`;
        }
        invalidateGalleryCache();
        return Astro.redirect(
          `/admin/gallery?cat_deleted=1&cat=${encodeURIComponent(targetCategory)}&mode=${deleteMode}`
        );
      }
    } else if (action === 'batch_save') {
      // UPLOAD BANYAK FOTO SEKALIGUS PER KATEGORI
      const batchJson = formData.get('batch_data')?.toString() || '[]';
      const batchItems = JSON.parse(batchJson);

      if (!Array.isArray(batchItems) || batchItems.length === 0) {
        flash = { type: 'error', text: 'Tidak ada foto yang dipilih untuk diunggah.' };
      } else {
        let insertedCount = 0;
        const categoryName = batchItems[0]?.category || 'Wisata';

        for (const it of batchItems) {
          const title = (it.title || 'Foto Wisata').trim();
          let imageUrl = (it.image_url || '').trim();
          const cat = (it.category || categoryName || 'Wisata').trim();
          const isFeatured = Boolean(it.is_featured);

          if (imageUrl && imageUrl.startsWith('data:image/')) {
            imageUrl = await ensureR2Url(imageUrl, `${title || 'gallery'}.jpg`, 'gallery');
          }

          if (title && imageUrl) {
            await sql`
              INSERT INTO gallery (title, image_url, category, is_featured)
              VALUES (${title}, ${imageUrl}, ${cat}, ${isFeatured});
            `;
            insertedCount++;
          }
        }

        invalidateGalleryCache();
        return Astro.redirect(`/admin/gallery?batch_saved=${insertedCount}&cat=${encodeURIComponent(categoryName)}`);
      }
    } else if (action === 'save') {
      // Edit atau Tambah 1 Foto
      const photoId = formData.get('photo_id');
      const title = formData.get('title')?.toString().trim();
      let imageUrl = formData.get('image_url')?.toString().trim();
      const category = formData.get('category')?.toString().trim() || 'Wisata';
      const isFeatured = formData.get('is_featured') === 'on' || formData.get('is_featured') === 'true';

      const imageFile = formData.get('image_file') as File | null;
      if (imageFile && imageFile.size > 0 && imageFile.name) {
        const buffer = Buffer.from(await imageFile.arrayBuffer());
        if (isR2Configured()) {
          imageUrl = await uploadToR2(buffer, imageFile.name, imageFile.type || 'image/jpeg', 'gallery');
        } else {
          imageUrl = `data:${imageFile.type || 'image/jpeg'};base64,${buffer.toString('base64')}`;
        }
      } else if (imageUrl && imageUrl.startsWith('data:image/')) {
        imageUrl = await ensureR2Url(imageUrl, `${title || 'photo'}.jpg`, 'gallery');
      }

      if (!title || !imageUrl) {
        flash = { type: 'error', text: 'Judul dan gambar foto wajib diisi.' };
      } else {
        if (photoId) {
          await sql`
            UPDATE gallery
            SET title = ${title}, image_url = ${imageUrl}, category = ${category}, is_featured = ${isFeatured}
            WHERE id = ${Number(photoId)};
          `;
        } else {
          await sql`
            INSERT INTO gallery (title, image_url, category, is_featured)
            VALUES (${title}, ${imageUrl}, ${category}, ${isFeatured});
          `;
        }
        invalidateGalleryCache();
        return Astro.redirect('/admin/gallery?saved=1');
      }
    }
  } catch (err: any) {
    console.error('Gallery action error:', err);
    flash = { type: 'error', text: 'Terjadi kesalahan: ' + (err?.message || 'Gagal menyimpan data') };
  }
}

const urlParam = Astro.url.searchParams;
const deletedParam = urlParam.get('deleted');
const savedParam = urlParam.get('saved');
const toggledParam = urlParam.get('toggled');
const batchSavedParam = urlParam.get('batch_saved');
const catParam = urlParam.get('cat');
const catRenamedParam = urlParam.get('cat_renamed');
const catDeletedParam = urlParam.get('cat_deleted');
const oldParam = urlParam.get('old');
const newParam = urlParam.get('new');
const deleteModeParam = urlParam.get('mode');

if (!flash) {
  if (catRenamedParam) {
    flash = {
      type: 'success',
      text: `✏️ Nama kategori "${oldParam}" berhasil diubah menjadi "${newParam}".`,
    };
  } else if (catDeletedParam) {
    flash = {
      type: 'success',
      text:
        deleteModeParam === 'delete_photos'
          ? `🗑️ Kategori "${catParam}" beserta seluruh fotonya berhasil dihapus permanen.`
          : `🗑️ Kategori "${catParam}" berhasil dihapus (seluruh foto telah dialihkan ke kategori "Wisata").`,
    };
  } else if (batchSavedParam) {
    flash = {
      type: 'success',
      text: `🎉 Berhasil mengunggah ${batchSavedParam} foto sekaligus ke kategori "${catParam || 'Wisata'}"!`,
    };
  } else if (deletedParam) {
    flash = { type: 'success', text: 'Foto galeri berhasil dihapus permanen.' };
  } else if (savedParam) {
    flash = { type: 'success', text: 'Perubahan foto galeri berhasil disimpan.' };
  } else if (toggledParam) {
    flash = { type: 'success', text: 'Status tampilan di slider Home berhasil diperbarui.' };
  }
}

const items: GalleryItem[] = await getAllGallery();
const featuredCount = items.filter((i) => i.is_featured).length;

// Ambil semua kategori dari database + kategori default agar selalu lengkap
const defaultCategories = ['Candi', 'Petualangan', 'Pantai', 'Budaya', 'Armada', 'Wisata'];
const dbCategories = Array.from(new Set(items.map((i) => (i.category || '').trim()).filter(Boolean)));
const allCategories = Array.from(new Set([...defaultCategories, ...dbCategories]));

// Hitung jumlah per kategori aktual
const categoryCounts: Record<string, number> = {};
items.forEach((i) => {
  const c = i.category || 'Wisata';
  categoryCounts[c] = (categoryCounts[c] || 0) + 1;
});
const categories = Object.keys(categoryCounts);

const getCatEmoji = (cat: string) => {
  const c = cat.toLowerCase();
  if (c.includes('candi') || c.includes('temple')) return '⛩️';
  if (c.includes('petualang') || c.includes('adventure') || c.includes('jeep')) return '🚙';
  if (c.includes('pantai') || c.includes('beach') || c.includes('laut')) return '🏖️';
  if (c.includes('budaya') || c.includes('culture') || c.includes('kraton') || c.includes('malioboro')) return '🏛️';
  if (c.includes('armada') || c.includes('mobil') || c.includes('car') || c.includes('driver')) return '🚐';
  if (c.includes('alam') || c.includes('nature') || c.includes('gunung')) return '🌄';
  if (c.includes('kuliner') || c.includes('food')) return '🍲';
  return '📸';
};
---

<AdminLayout title="Kelola Galeri" active="gallery">
  <div class="space-y-6 max-w-7xl mx-auto pb-20">

    <!-- HERO HEADER BANNER -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-navy-950 via-navy-900 to-slate-900 text-white p-6 sm:p-8 shadow-xl border border-white/10">
      <div class="absolute -top-24 -right-24 w-80 h-80 rounded-full bg-primary-500/20 blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-16 w-64 h-64 rounded-full bg-sky-500/15 blur-3xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="space-y-2 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-primary-300 text-xs font-semibold tracking-wide">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Dokumentasi Trip & Wisata Jogja</span>
            <span class="text-white/30">•</span>
            <span>Upload Massal Per Kategori</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
            Kelola Galeri Foto Wisata
          </h1>
          <p class="text-sm text-slate-300 leading-relaxed">
            Unggah banyak foto sekaligus per kategori (Candi, Jeep Merapi, Pantai, Budaya, dll) dengan kompresi otomatis berkecepatan tinggi agar tampilan slider beranda dan galeri publik selalu memikat wisatawan.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3 shrink-0">
          <a
            href="/galeri"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/15 text-white text-xs font-bold border border-white/15 transition backdrop-blur-xs"
          >
            <svg class="w-4 h-4 text-primary-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            <span>Lihat Galeri Web</span>
          </a>

          <button
            type="button"
            id="btn-open-batch"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-primary-500 to-primary-600 hover:from-primary-600 hover:to-primary-700 text-white text-xs font-extrabold shadow-lg shadow-primary-600/30 transition-all active:scale-95 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span>⚡ Upload Banyak Foto (Per Kategori)</span>
          </button>
        </div>
      </div>
    </div>

    <!-- FLASH NOTIFICATION -->
    {flash && (
      <div class:list={[
        'px-5 py-4 rounded-2xl text-sm font-semibold border flex items-center justify-between gap-3 shadow-xs',
        flash.type === 'success'
          ? 'bg-emerald-50 dark:bg-emerald-950/40 border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300'
          : 'bg-rose-50 dark:bg-rose-950/40 border-rose-200 dark:border-rose-800 text-rose-800 dark:text-rose-300',
      ]}>
        <div class="flex items-center gap-3">
          <div class:list={[
            'w-8 h-8 rounded-xl flex items-center justify-center shrink-0 text-white font-bold',
            flash.type === 'success' ? 'bg-emerald-500' : 'bg-rose-500',
          ]}>
            {flash.type === 'success' ? '✓' : '⚠️'}
          </div>
          <span>{flash.text}</span>
        </div>
        <button
          type="button"
          onclick="this.parentElement.remove()"
          class="text-xs opacity-60 hover:opacity-100 px-2 py-1 rounded-lg hover:bg-black/5 dark:hover:bg-white/10 transition cursor-pointer"
        >
          Tutup ✕
        </button>
      </div>
    )}

    <!-- STATS SUMMARY CARDS -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-primary-500/10 text-primary-600 dark:text-primary-400 flex items-center justify-center text-xl shrink-0 border border-primary-500/20">
          🖼️
        </div>
        <div class="min-w-0">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Koleksi Foto</p>
          <p class="text-2xl font-black text-slate-900 dark:text-white mt-0.5">{items.length} <span class="text-xs font-medium text-slate-400">foto</span></p>
        </div>
      </div>

      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-sky-500/10 text-sky-600 dark:text-sky-400 flex items-center justify-center text-xl shrink-0 border border-sky-500/20">
          🎠
        </div>
        <div class="min-w-0">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Slider Halaman Depan</p>
          <p class="text-2xl font-black text-slate-900 dark:text-white mt-0.5">
            {featuredCount} <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400 font-semibold">foto aktif</span>
          </p>
        </div>
      </div>

      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xl shrink-0 border border-amber-500/20">
          🏷️
        </div>
        <div class="min-w-0">
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Kategori Wisata</p>
          <p class="text-2xl font-black text-slate-900 dark:text-white mt-0.5">
            {categories.length} <span class="text-xs font-medium text-slate-400">kategori aktif</span>
          </p>
        </div>
      </div>
    </div>

    <!-- CATEGORY FILTER PILLS & TOOLBAR (DENGAN TOMBOL KELOLA KATEGORI) -->
    <div class="p-3 sm:p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs flex flex-col md:flex-row md:items-center md:justify-between gap-3">
      <!-- Filter Pills -->
      <div class="flex flex-wrap items-center gap-1.5" id="category-filter-bar">
        <button
          type="button"
          data-cat-filter="all"
          class="cat-filter-btn active px-3.5 py-1.5 rounded-xl text-xs font-bold transition cursor-pointer bg-primary-600 text-white shadow-xs"
        >
          <span>Semua Foto</span>
          <span class="ml-1.5 px-1.5 py-0.2 rounded-full text-[10px] bg-white/20">{items.length}</span>
        </button>

        {categories.map((cat) => (
          <button
            type="button"
            data-cat-filter={cat}
            class="cat-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold transition cursor-pointer text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200/80 dark:border-slate-700"
          >
            <span>{cat}</span>
            <span class="ml-1.5 px-1.5 py-0.2 rounded-full text-[10px] bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">
              {categoryCounts[cat]}
            </span>
          </button>
        ))}
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex items-center gap-2 shrink-0">
        <!-- TOMBOL KELOLA KATEGORI (EDIT NAMA / HAPUS) -->
        <button
          type="button"
          id="btn-manage-categories"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200/80 dark:border-slate-700 transition cursor-pointer"
          title="Ubah nama atau hapus kategori"
        >
          <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>Kelola Kategori</span>
        </button>

        <button
          type="button"
          id="btn-open-single"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200/80 dark:border-slate-700 transition cursor-pointer"
        >
          <span>+ Tambah 1 Foto Saja</span>
        </button>
      </div>
    </div>

    <!-- GALLERY PHOTO GRID -->
    {items.length === 0 ? (
      <div class="p-16 text-center rounded-3xl bg-white dark:bg-slate-900 border border-dashed border-slate-300 dark:border-slate-700">
        <span class="text-5xl block mb-3">📷</span>
        <h3 class="text-base font-bold text-slate-800 dark:text-white">Belum ada foto di galeri</h3>
        <p class="text-xs text-slate-400 mt-1 max-w-sm mx-auto">
          Mulai tambahkan dokumentasi liburan Jogja dengan memilih banyak foto sekaligus per kategori.
        </p>
        <button
          type="button"
          id="btn-empty-batch"
          class="mt-4 px-5 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-xs font-bold shadow-md transition cursor-pointer"
        >
          ⚡ Upload Banyak Foto Sekarang
        </button>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5" id="gallery-container">
        {items.map((item) => (
          <div
            class="gallery-card group rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 overflow-hidden shadow-xs hover:shadow-lg transition-all duration-300 flex flex-col justify-between"
            data-category={item.category || 'Wisata'}
          >
            <div>
              <!-- Photo Container -->
              <div class="relative aspect-[4/3] w-full overflow-hidden bg-slate-100 dark:bg-slate-800">
                <img
                  src={item.image_url}
                  alt={item.title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  onerror="this.src='https://placehold.co/600x400?text=Foto+Galeri'"
                />

                <!-- Category Badge -->
                <span class="absolute top-2.5 left-2.5 px-2.5 py-1 rounded-full text-[10px] font-bold bg-navy-950/80 backdrop-blur-md text-white border border-white/10 shadow-xs">
                  {item.category || 'Wisata'}
                </span>

                <!-- Home Slider Status Badge -->
                {item.is_featured ? (
                  <span class="absolute top-2.5 right-2.5 px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-600 text-white shadow-xs flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                    <span>Home Slider</span>
                  </span>
                ) : (
                  <span class="absolute top-2.5 right-2.5 px-2.5 py-1 rounded-full text-[10px] font-medium bg-slate-900/80 backdrop-blur text-slate-300 shadow-xs">
                    Galeri Saja
                  </span>
                )}
              </div>

              <!-- Title / Info -->
              <div class="p-4">
                <h3
                  class="font-bold text-slate-900 dark:text-white text-sm line-clamp-2 leading-snug group-hover:text-primary-600 dark:group-hover:text-primary-400 transition"
                  title={item.title}
                >
                  {item.title}
                </h3>
              </div>
            </div>

            <!-- Bottom Actions -->
            <div class="px-4 pb-4 pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between gap-2">
              <!-- Toggle Featured Form -->
              <form method="POST">
                <input type="hidden" name="_action" value="toggle_featured" />
                <input type="hidden" name="id" value={item.id} />
                <button
                  type="submit"
                  title={item.is_featured ? 'Klik untuk sembunyikan dari slider Home' : 'Klik untuk tampilkan di slider Home'}
                  class={`text-[11px] font-semibold px-2.5 py-1.5 rounded-lg transition cursor-pointer flex items-center gap-1 ${
                    item.is_featured
                      ? 'bg-primary-50 dark:bg-primary-950/60 text-primary-700 dark:text-primary-300 hover:bg-primary-100'
                      : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200'
                  }`}
                >
                  <span>{item.is_featured ? '⭐ Slider Aktif' : '☆ Slider Pasif'}</span>
                </button>
              </form>

              <div class="flex items-center gap-1.5">
                <button
                  type="button"
                  data-edit={JSON.stringify(item)}
                  class="btn-edit p-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition cursor-pointer"
                  title="Edit foto"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                  </svg>
                </button>

                <form
                  method="POST"
                  onsubmit={`return confirmDelete(this, 'Hapus Foto Galeri?', 'Foto &ldquo;<strong>${(item.title || '').replace(/'/g, "\\'")}</strong>&rdquo; akan dihapus secara permanen dari galeri dan slider beranda.');`}
                >
                  <input type="hidden" name="_action" value="delete" />
                  <input type="hidden" name="id" value={item.id} />
                  <button
                    type="submit"
                    class="p-1.5 rounded-lg text-rose-600 hover:text-rose-700 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition cursor-pointer"
                    title="Hapus foto"
                  >
