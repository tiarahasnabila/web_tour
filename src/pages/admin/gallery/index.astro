---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { sql } from '../../../lib/db';
import { verifySessionToken } from '../../../lib/auth';
import { getAllGallery, invalidateGalleryCache, type GalleryItem } from '../../../lib/gallery';

// Wajib login
const user = verifySessionToken(Astro.cookies.get('admin_session')?.value);
if (!user) {
  return Astro.redirect('/admin/login');
}

let flash: { type: 'success' | 'error'; text: string } | null = null;

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action');
    const id = formData.get('id');

    if (action === 'delete' && id) {
      await sql`DELETE FROM gallery WHERE id = ${Number(id)};`;
      invalidateGalleryCache();
      return Astro.redirect('/admin/gallery?deleted=1');
    } else if (action === 'toggle_featured' && id) {
      await sql`UPDATE gallery SET is_featured = NOT COALESCE(is_featured, true) WHERE id = ${Number(id)};`;
      invalidateGalleryCache();
      return Astro.redirect('/admin/gallery?toggled=1');
    } else if (action === 'save') {
      const photoId = formData.get('photo_id');
      const title = formData.get('title')?.toString().trim();
      let imageUrl = formData.get('image_url')?.toString().trim();
      const category = formData.get('category')?.toString().trim() || 'Wisata';
      const isFeatured = formData.get('is_featured') === 'on' || formData.get('is_featured') === 'true';

      // Cek apakah ada file image upload
      const imageFile = formData.get('image_file') as File | null;
      if (imageFile && imageFile.size > 0 && imageFile.name) {
        const buffer = await imageFile.arrayBuffer();
        const base64 = Buffer.from(buffer).toString('base64');
        imageUrl = `data:${imageFile.type || 'image/jpeg'};base64,${base64}`;
      }

      if (!title || !imageUrl) {
        flash = { type: 'error', text: 'Judul/keterangan dan gambar wajib diisi.' };
      } else {
        if (photoId) {
          // Edit
          await sql`
            UPDATE gallery
            SET title = ${title}, image_url = ${imageUrl}, category = ${category}, is_featured = ${isFeatured}
            WHERE id = ${Number(photoId)};
          `;
        } else {
          // Tambah baru
          await sql`
            INSERT INTO gallery (title, image_url, category, is_featured)
            VALUES (${title}, ${imageUrl}, ${category}, ${isFeatured});
          `;
        }
        invalidateGalleryCache();
        return Astro.redirect('/admin/gallery?saved=1');
      }
    }
  } catch (err: any) {
    console.error('Gallery action error:', err);
    flash = { type: 'error', text: 'Terjadi kesalahan: ' + (err?.message || 'Gagal menyimpan data') };
  }
}

const deletedParam = Astro.url.searchParams.get('deleted');
const savedParam = Astro.url.searchParams.get('saved');
const toggledParam = Astro.url.searchParams.get('toggled');

if (!flash) {
  if (deletedParam) flash = { type: 'success', text: 'Foto galeri berhasil dihapus permanen.' };
  else if (savedParam) flash = { type: 'success', text: 'Foto galeri berhasil disimpan.' };
  else if (toggledParam) flash = { type: 'success', text: 'Status tampilan di slider Home berhasil diperbarui.' };
}

const items: GalleryItem[] = await getAllGallery();
const featuredCount = items.filter((i) => i.is_featured).length;
const categories = Array.from(new Set(items.map((i) => i.category || 'Wisata')));
---

<AdminLayout title="Kelola Galeri" active="gallery">
  <div class="space-y-6">
    <!-- Top Header & Actions -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-primary-50 dark:bg-primary-950/50 text-primary-700 dark:text-primary-300 border border-primary-200/50 dark:border-primary-800/50 mb-2">
          <span>📸</span>
          <span>Dokumentasi Trip</span>
        </div>
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Galeri Foto Wisata</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
          Kelola dokumentasi foto perjalanan yang tampil di slider halaman depan dan halaman galeri publik.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/galeri"
          target="_blank"
          class="px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-semibold flex items-center gap-1.5 transition shadow-xs"
        >
          <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          <span>Lihat Galeri Web</span>
        </a>

        <button
          type="button"
          id="btn-open-add"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-xs font-bold shadow-sm transition hover:shadow-md cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          <span>Tambah Foto</span>
        </button>
      </div>
    </div>

    <!-- Flash Message -->
    {flash && (
      <div
        class={`p-4 rounded-2xl text-sm font-medium border flex items-center justify-between gap-3 ${
          flash.type === 'success'
            ? 'bg-emerald-50 dark:bg-emerald-950/40 border-emerald-200 dark:border-emerald-800/50 text-emerald-800 dark:text-emerald-300'
            : 'bg-rose-50 dark:bg-rose-950/40 border-rose-200 dark:border-rose-800/50 text-rose-800 dark:text-rose-300'
        }`}
      >
        <div class="flex items-center gap-2">
          <span>{flash.type === 'success' ? '✓' : '⚠️'}</span>
          <span>{flash.text}</span>
        </div>
        <button type="button" onclick="this.parentElement.remove()" class="text-xs opacity-60 hover:opacity-100">&times;</button>
      </div>
    )}

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-primary-500/10 text-primary-600 dark:text-primary-400 flex items-center justify-center text-xl font-bold">
          🖼️
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Foto</p>
          <p class="text-2xl font-bold text-slate-900 dark:text-white mt-0.5">{items.length}</p>
        </div>
      </div>

      <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 flex items-center justify-center text-xl font-bold">
          🎠
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Slider Home</p>
          <p class="text-2xl font-bold text-slate-900 dark:text-white mt-0.5">
            {featuredCount} <span class="text-xs font-normal text-slate-400">foto aktif</span>
          </p>
        </div>
      </div>

      <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xl font-bold">
          🏷️
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Kategori</p>
          <p class="text-2xl font-bold text-slate-900 dark:text-white mt-0.5">
            {categories.length} <span class="text-xs font-normal text-slate-400">label</span>
          </p>
        </div>
      </div>
    </div>

    <!-- Gallery Grid Items -->
    {items.length === 0 ? (
      <div class="p-12 text-center rounded-3xl bg-white dark:bg-slate-900 border border-dashed border-slate-300 dark:border-slate-800">
        <span class="text-4xl block mb-3">📷</span>
        <h3 class="text-base font-bold text-slate-800 dark:text-white">Belum ada foto di galeri</h3>
        <p class="text-xs text-slate-400 mt-1 max-w-sm mx-auto">
          Tambahkan foto dokumentasi liburan pertama Anda agar tampil di slider beranda dan galeri publik.
        </p>
        <button
          type="button"
          id="btn-empty-add"
          class="mt-4 px-4 py-2 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-xs font-bold transition cursor-pointer"
        >
          + Tambah Foto Sekarang
        </button>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
        {items.map((item) => (
          <div class="group rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 overflow-hidden shadow-xs hover:shadow-md transition-all flex flex-col justify-between">
            <div>
              <!-- Photo Container -->
              <div class="relative aspect-[4/3] w-full overflow-hidden bg-slate-100 dark:bg-slate-800">
                <img
                  src={item.image_url}
                  alt={item.title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  onerror="this.src='https://placehold.co/600x400?text=Foto+Galeri'"
                />
                
                <!-- Category Badge -->
                <span class="absolute top-2.5 left-2.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-black/60 backdrop-blur text-white shadow-xs">
                  {item.category || 'Wisata'}
                </span>

                <!-- Home Slider Status Badge -->
                {item.is_featured ? (
                  <span class="absolute top-2.5 right-2.5 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-600 text-white shadow-xs flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                    <span>Home Slider</span>
                  </span>
                ) : (
                  <span class="absolute top-2.5 right-2.5 px-2 py-0.5 rounded-full text-[10px] font-medium bg-slate-800/80 backdrop-blur text-slate-300 shadow-xs">
                    Galeri Saja
                  </span>
                )}
              </div>

              <!-- Info -->
              <div class="p-4">
                <h3 class="font-bold text-slate-900 dark:text-white text-sm line-clamp-2 leading-snug group-hover:text-primary-600 dark:group-hover:text-primary-400 transition" title={item.title}>
                  {item.title}
                </h3>
              </div>
            </div>

            <!-- Card Actions -->
            <div class="px-4 pb-4 pt-2 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between gap-2">
              <!-- Toggle Featured Form -->
              <form method="POST">
                <input type="hidden" name="_action" value="toggle_featured" />
                <input type="hidden" name="id" value={item.id} />
                <button
                  type="submit"
                  title={item.is_featured ? 'Klik untuk sembunyikan dari slider Home' : 'Klik untuk tampilkan di slider Home'}
                  class={`text-[11px] font-semibold px-2.5 py-1.5 rounded-lg transition cursor-pointer flex items-center gap-1 ${
                    item.is_featured
                      ? 'bg-primary-50 dark:bg-primary-950/60 text-primary-700 dark:text-primary-300 hover:bg-primary-100'
                      : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200'
                  }`}
                >
                  <span>{item.is_featured ? '⭐ Aktif di Home' : '☆ Pasif di Home'}</span>
                </button>
              </form>

              <div class="flex items-center gap-1.5">
                <button
                  type="button"
                  data-edit={JSON.stringify(item)}
                  class="btn-edit p-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition cursor-pointer"
                  title="Edit foto"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                  </svg>
                </button>

                <form
                  method="POST"
                  onsubmit={`return confirmDelete(this, 'Hapus Foto Galeri?', 'Foto &ldquo;<strong>${item.title.replace(/'/g, "\\'")}</strong>&rdquo; akan dihapus secara permanen dari galeri dan slider beranda.');`}
                >
                  <input type="hidden" name="_action" value="delete" />
                  <input type="hidden" name="id" value={item.id} />
                  <button
                    type="submit"
                    class="p-1.5 rounded-lg text-rose-600 hover:text-rose-700 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition cursor-pointer"
                    title="Hapus foto"
                  >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                </form>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>

  <!-- Modal Tambah / Edit Foto -->
  <div id="gallery-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 w-full max-w-lg p-6 shadow-2xl relative overflow-hidden">
      <!-- Modal Header -->
      <div class="flex items-center justify-between pb-4 mb-5 border-b border-slate-100 dark:border-slate-800">
        <div>
          <h2 id="modal-title" class="text-lg font-bold text-slate-900 dark:text-white">Tambah Foto Galeri</h2>
          <p class="text-xs text-slate-400 mt-0.5">Unggah foto dokumentasi atau masukkan tautan gambar.</p>
        </div>
        <button type="button" id="btn-close-modal" class="w-8 h-8 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-500 hover:text-slate-800 dark:hover:text-white flex items-center justify-center text-sm transition cursor-pointer">
          ✕
        </button>
      </div>

      <!-- Modal Form -->
      <form method="POST" enctype="multipart/form-data" class="space-y-4">
        <input type="hidden" name="_action" value="save" />
        <input type="hidden" name="photo_id" id="form-photo-id" value="" />

        <!-- Title -->
        <div>
          <label for="form-title" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
            Judul / Keterangan Foto *
          </label>
          <input
            type="text"
            name="title"
            id="form-title"
            required
            placeholder="Contoh: Momen Sunrise di Candi Borobudur"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-xs focus:ring-2 focus:ring-primary-500 focus:outline-hidden"
          />
        </div>

        <!-- Category -->
        <div>
          <label for="form-category" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
            Kategori
          </label>
          <select
            name="category"
            id="form-category"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-xs focus:ring-2 focus:ring-primary-500 focus:outline-hidden"
          >
            <option value="Candi">Candi (Borobudur, Prambanan, Ratu Boko)</option>
            <option value="Petualangan">Petualangan / Jeep Merapi</option>
            <option value="Pantai">Pantai & Laut Selatan</option>
            <option value="Budaya">Budaya & Kota (Malioboro, Kraton)</option>
            <option value="Armada">Armada & Pelayanan</option>
            <option value="Wisata">Wisata Lainnya</option>
          </select>
        </div>

        <!-- Image Input: Upload File or URL -->
        <div class="space-y-2">
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300">
            Gambar Foto *
          </label>
          
          <div class="grid grid-cols-1 gap-2">
            <div>
              <span class="text-[11px] text-slate-400 block mb-1">Opsi 1: Masukkan URL Gambar (Direct Link)</span>
              <input
                type="url"
                name="image_url"
                id="form-image-url"
                placeholder="https://images.unsplash.com/... atau tautan gambar"
                class="w-full px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-xs focus:ring-2 focus:ring-primary-500 focus:outline-hidden"
              />
            </div>

            <div>
              <span class="text-[11px] text-slate-400 block mb-1">Opsi 2: Atau Unggah File Foto dari Komputer / HP</span>
              <input
                type="file"
                name="image_file"
                id="form-image-file"
                accept="image/*"
                class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-primary-50 dark:file:bg-primary-950/60 file:text-primary-700 dark:file:text-primary-300 hover:file:bg-primary-100 cursor-pointer"
              />
            </div>
          </div>
        </div>

        <!-- Checkbox: Show on Home Slider -->
        <div class="pt-2">
          <label class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 cursor-pointer">
            <input
              type="checkbox"
              name="is_featured"
              id="form-is-featured"
              checked
              class="w-4 h-4 rounded text-primary-600 focus:ring-primary-500"
            />
            <div>
              <p class="text-xs font-bold text-slate-900 dark:text-white">Tampilkan di Slider Halaman Depan (Home)</p>
              <p class="text-[11px] text-slate-400">Foto akan otomatis muncul di korsel bergeser pada halaman utama.</p>
            </div>
          </label>
        </div>

        <!-- Submit Button -->
        <div class="pt-3 flex items-center justify-end gap-3 border-t border-slate-100 dark:border-slate-800">
          <button
            type="button"
            id="btn-cancel-modal"
            class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition cursor-pointer"
          >
            Batal
          </button>
          <button
            type="submit"
            class="px-5 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-xs font-bold shadow-sm transition cursor-pointer"
          >
            Simpan Foto
          </button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  function initGalleryAdmin() {
    const modal = document.getElementById('gallery-modal');
    const btnOpenAdd = document.getElementById('btn-open-add');
    const btnEmptyAdd = document.getElementById('btn-empty-add');
    const btnClose = document.getElementById('btn-close-modal');
    const btnCancel = document.getElementById('btn-cancel-modal');

    const modalTitle = document.getElementById('modal-title') as HTMLElement;
    const formPhotoId = document.getElementById('form-photo-id') as HTMLInputElement;
    const formTitle = document.getElementById('form-title') as HTMLInputElement;
    const formCategory = document.getElementById('form-category') as HTMLSelectElement;
    const formImageUrl = document.getElementById('form-image-url') as HTMLInputElement;
    const formIsFeatured = document.getElementById('form-is-featured') as HTMLInputElement;

    function openModalForAdd() {
      if (!modal) return;
      modalTitle.textContent = 'Tambah Foto Galeri';
      formPhotoId.value = '';
      formTitle.value = '';
      formCategory.value = 'Wisata';
      formImageUrl.value = '';
      formIsFeatured.checked = true;
      modal.classList.remove('hidden');
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
    }

    btnOpenAdd?.addEventListener('click', openModalForAdd);
    btnEmptyAdd?.addEventListener('click', openModalForAdd);
    btnClose?.addEventListener('click', closeModal);
    btnCancel?.addEventListener('click', closeModal);

    // Close on backdrop click
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Handle Edit Buttons
    document.querySelectorAll<HTMLButtonElement>('.btn-edit').forEach((btn) => {
      btn.addEventListener('click', () => {
        try {
          const item = JSON.parse(btn.dataset.edit || '{}');
          if (!modal) return;
          modalTitle.textContent = 'Edit Foto Galeri';
          formPhotoId.value = item.id || '';
          formTitle.value = item.title || '';
          formCategory.value = item.category || 'Wisata';
          formImageUrl.value = item.image_url || '';
          formIsFeatured.checked = item.is_featured !== false;
          modal.classList.remove('hidden');
        } catch (e) {
          console.error(e);
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGalleryAdmin);
  } else {
    initGalleryAdmin();
  }
</script>

