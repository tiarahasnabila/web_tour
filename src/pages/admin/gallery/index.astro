            <!-- Rendered by JS -->
          </div>
        </div>

        <!-- PROGRESS OVERLAY WHEN PROCESSING -->
        <div id="batch-progress-box" class="hidden p-4 rounded-2xl bg-primary-50 dark:bg-primary-950/40 border border-primary-200 dark:border-primary-800 text-center space-y-2">
          <div class="flex items-center justify-center gap-2 text-primary-700 dark:text-primary-300 text-xs font-bold">
            <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span id="batch-progress-text">Mengompresi dan menyiapkan foto...</span>
          </div>
          <div class="w-full bg-primary-200 dark:bg-primary-900 rounded-full h-1.5 overflow-hidden">
            <div id="batch-progress-bar" class="bg-primary-600 h-1.5 rounded-full transition-all duration-300" style="width: 0%"></div>
          </div>
        </div>

      </div>

      <!-- Hidden Form for submission -->
      <form id="batch-hidden-form" method="POST" class="hidden">
        <input type="hidden" name="_action" value="batch_save" />
        <input type="hidden" name="batch_data" id="batch-data-input" value="[]" />
      </form>

      <!-- Footer Modal -->
      <div class="px-6 py-4 bg-slate-50 dark:bg-slate-800/40 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between gap-3 shrink-0">
        <button
          type="button"
          id="btn-cancel-batch"
          class="px-4 py-2 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-slate-700 transition cursor-pointer"
        >
          Batal
        </button>

        <button
          type="button"
          id="btn-submit-batch"
          disabled
          class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-gradient-to-r from-primary-600 to-primary-500 hover:from-primary-700 hover:to-primary-600 disabled:opacity-40 disabled:cursor-not-allowed text-white text-xs font-extrabold shadow-md shadow-primary-600/25 transition-all cursor-pointer active:scale-95"
        >
          <span>🚀 Upload Semua Foto Sekarang</span>
          <span id="btn-batch-badge" class="px-1.5 py-0.2 rounded-full text-[10px] bg-white/20">0</span>
        </button>
      </div>

    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- MODAL 2: TAMBAH 1 FOTO / EDIT SATUAN -->
  <!-- ========================================================================= -->
  <div id="single-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-navy-950/70 backdrop-blur-xs">
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 w-full max-w-lg p-6 shadow-2xl relative overflow-hidden">
      <!-- Modal Header -->
      <div class="flex items-center justify-between pb-4 mb-5 border-b border-slate-100 dark:border-slate-800">
        <div>
          <h2 id="single-modal-title" class="text-base font-bold text-slate-900 dark:text-white">Edit Foto Galeri</h2>
          <p class="text-xs text-slate-400 mt-0.5">Ubah judul, kategori, atau status slider.</p>
        </div>
        <button type="button" id="btn-close-single" class="w-8 h-8 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-500 hover:text-slate-800 dark:hover:text-white flex items-center justify-center text-sm transition cursor-pointer">
          ✕
        </button>
      </div>

      <!-- Single Form -->
      <form method="POST" enctype="multipart/form-data" class="space-y-4">
        <input type="hidden" name="_action" value="save" />
        <input type="hidden" name="photo_id" id="form-single-photo-id" value="" />

        <div>
          <label for="form-single-title" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
            Judul / Keterangan Foto *
          </label>
          <input
            type="text"
            name="title"
            id="form-single-title"
            required
            placeholder="Contoh: Momen Sunrise di Candi Borobudur"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-xs focus:ring-2 focus:ring-primary-500 outline-none"
          />
        </div>

        <div>
          <label for="form-single-category" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
            Kategori
          </label>
          <input
            type="text"
            name="category"
            id="form-single-category"
            list="category-suggestions"
            placeholder="Pilih atau ketik kategori..."
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-xs focus:ring-2 focus:ring-primary-500 outline-none"
          />
          <datalist id="category-suggestions">
            <option value="Candi" />
            <option value="Petualangan" />
            <option value="Pantai" />
            <option value="Budaya" />
            <option value="Armada" />
            <option value="Wisata" />
          </datalist>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
            URL Gambar / File Foto
          </label>
          <input
            type="text"
            name="image_url"
            id="form-single-image-url"
            placeholder="https://... atau data:image/..."
            class="w-full px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-xs font-mono mb-2"
          />
          <input
            type="file"
            name="image_file"
            id="form-single-image-file"
            accept="image/*"
            class="w-full text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-primary-50 dark:file:bg-primary-950/60 file:text-primary-700 dark:file:text-primary-300 hover:file:bg-primary-100 cursor-pointer"
          />
        </div>

        <div class="pt-1">
          <label class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 cursor-pointer">
            <input
              type="checkbox"
              name="is_featured"
              id="form-single-is-featured"
              checked
              class="w-4 h-4 rounded text-primary-600 focus:ring-primary-500"
            />
            <div>
              <p class="text-xs font-bold text-slate-900 dark:text-white">Tampilkan di Slider Halaman Depan</p>
              <p class="text-[11px] text-slate-400">Muncul otomatis pada korsel foto di beranda.</p>
            </div>
          </label>
        </div>

        <div class="pt-3 flex items-center justify-end gap-3 border-t border-slate-100 dark:border-slate-800">
          <button
            type="button"
            id="btn-cancel-single"
            class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition cursor-pointer"
          >
            Batal
          </button>
          <button
            type="submit"
            class="px-5 py-2 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-xs font-bold shadow-sm transition cursor-pointer"
          >
            Simpan Foto
          </button>
        </div>
      </form>
    </div>
  </div>

</AdminLayout>

<script is:inline>
  (() => {
    // Canvas Client-side Compressor Helper
    function compressImage(file, maxDim = 1280, quality = 0.82) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            let w = img.width;
            let h = img.height;
            if (w > maxDim || h > maxDim) {
              if (w > h) {
                h = Math.round((h * maxDim) / w);
                w = maxDim;
              } else {
                w = Math.round((w * maxDim) / h);
                h = maxDim;
              }
            }
            const canvas = document.createElement('canvas');
            canvas.width = w;
            canvas.height = h;
            const ctx = canvas.getContext('2d');
            if (!ctx) {
              resolve({ dataUrl: e.target.result, size: file.size });
              return;
            }
            ctx.drawImage(img, 0, 0, w, h);
            const dataUrl = canvas.toDataURL('image/jpeg', quality);
            resolve({ dataUrl, size: Math.round(dataUrl.length * 0.75) });
          };
          img.onerror = () => reject(new Error('Gagal memuat gambar'));
          img.src = e.target.result;
        };
        reader.onerror = () => reject(new Error('Gagal membaca file gambar'));
        reader.readAsDataURL(file);
      });
    }

    // ==========================================
    // 1. FILTER KATEGORI DI HALAMAN ADMIN
    // ==========================================
    const catFilterBtns = document.querySelectorAll('.cat-filter-btn');
    const galleryCards = document.querySelectorAll('.gallery-card');

    catFilterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-cat-filter');
        catFilterBtns.forEach((b) => {
          b.classList.remove('bg-primary-600', 'text-white', 'shadow-xs');
          b.classList.add('text-slate-600', 'dark:text-slate-300');
        });
        btn.classList.add('bg-primary-600', 'text-white', 'shadow-xs');
        btn.classList.remove('text-slate-600', 'dark:text-slate-300');

        galleryCards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          if (target === 'all' || cardCat === target) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // ==========================================
    // 2. BATCH UPLOADER STATE & LOGIC
    // ==========================================
    const batchModal = document.getElementById('batch-modal');
    const btnOpenBatch = document.getElementById('btn-open-batch');
    const btnEmptyBatch = document.getElementById('btn-empty-batch');
    const btnCloseBatch = document.getElementById('btn-close-batch');
    const btnCancelBatch = document.getElementById('btn-cancel-batch');

    const fileInput = document.getElementById('batch-file-input');
    const dropzone = document.getElementById('batch-dropzone');
    const baseTitleInput = document.getElementById('batch-base-title');
    const namingPatternSelect = document.getElementById('batch-naming-pattern');
    const isFeaturedCheckbox = document.getElementById('batch-is-featured');
    const previewSection = document.getElementById('batch-preview-section');
    const previewGrid = document.getElementById('batch-preview-grid');
    const countDisplay = document.getElementById('batch-count-display');
    const btnSubmitBatch = document.getElementById('btn-submit-batch');
    const btnBatchBadge = document.getElementById('btn-batch-badge');
    const btnClearBatch = document.getElementById('btn-clear-batch');

    const progressBox = document.getElementById('batch-progress-box');
    const progressBar = document.getElementById('batch-progress-bar');
    const progressText = document.getElementById('batch-progress-text');
    const hiddenForm = document.getElementById('batch-hidden-form');
    const hiddenDataInput = document.getElementById('batch-data-input');

    const customCatBtn = document.getElementById('btn-custom-cat');
    const customCatBox = document.getElementById('custom-cat-box');
    const customCatInput = document.getElementById('batch-custom-cat-input');

    let selectedCategory = 'Candi';
    let batchQueue = []; // Array of { id, originalName, dataUrl, title, size }

    const openBatchModal = () => {
      batchModal?.classList.remove('hidden');
      batchModal?.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };

    const closeBatchModal = () => {
      batchModal?.classList.add('hidden');
      batchModal?.classList.remove('flex');
      document.body.style.overflow = '';
    };

    btnOpenBatch?.addEventListener('click', openBatchModal);
    btnEmptyBatch?.addEventListener('click', openBatchModal);
    btnCloseBatch?.addEventListener('click', closeBatchModal);
    btnCancelBatch?.addEventListener('click', closeBatchModal);

    batchModal?.addEventListener('click', (e) => {
      if (e.target === batchModal) closeBatchModal();
    });

    // Category chips selection
    const catChips = document.querySelectorAll('.chip-cat');
    catChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        catChips.forEach((c) => {
          c.classList.remove('bg-primary-600', 'text-white', 'border-primary-600', 'shadow-xs');
          c.classList.add('bg-slate-50', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300', 'border-slate-200', 'dark:border-slate-700');
        });
        chip.classList.add('bg-primary-600', 'text-white', 'border-primary-600', 'shadow-xs');
        chip.classList.remove('bg-slate-50', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300', 'border-slate-200', 'dark:border-slate-700');

        selectedCategory = chip.getAttribute('data-cat-value') || 'Wisata';
        customCatBox?.classList.add('hidden');

        // Beri saran judul default sesuai kategori
        if (baseTitleInput && (!baseTitleInput.value || baseTitleInput.value.includes('Tour'))) {
          if (selectedCategory === 'Candi') baseTitleInput.value = 'Borobudur Sunrise Tour';
          else if (selectedCategory === 'Petualangan') baseTitleInput.value = 'Merapi Lava Tour';
          else if (selectedCategory === 'Pantai') baseTitleInput.value = 'Eksotisme Pantai Selatan Jogja';
          else if (selectedCategory === 'Budaya') baseTitleInput.value = 'Jalan Santai Malioboro & Kraton';
          else if (selectedCategory === 'Armada') baseTitleInput.value = 'Armada Nyaman & Driver Ramah';
          applyNamingTitles();
        }
      });
    });

    customCatBtn?.addEventListener('click', () => {
      customCatBox?.classList.toggle('hidden');
      customCatInput?.focus();
    });

    customCatInput?.addEventListener('input', (e) => {
      const val = e.target.value.trim();
      if (val) selectedCategory = val;
    });

    // Auto naming application
    function applyNamingTitles() {
      const baseTitle = baseTitleInput?.value.trim() || 'Foto Wisata';
      const pattern = namingPatternSelect?.value || 'numbered';

      batchQueue.forEach((item, idx) => {
        if (pattern === 'numbered') {
          item.title = batchQueue.length > 1 ? `${baseTitle} #${idx + 1}` : baseTitle;
        } else if (pattern === 'filename') {
          const clean = (item.originalName || '')
            .replace(/\.[^/.]+$/, '')
            .replace(/[-_]/g, ' ')
            .replace(/\b\w/g, (l) => l.toUpperCase());
          item.title = clean || `${baseTitle} #${idx + 1}`;
        } else {
          item.title = baseTitle;
        }
      });
      renderPreviewGrid();
    }

    baseTitleInput?.addEventListener('input', applyNamingTitles);
    namingPatternSelect?.addEventListener('change', applyNamingTitles);

    // Render preview cards in modal
    function renderPreviewGrid() {
      if (!previewGrid || !previewSection) return;

      if (batchQueue.length === 0) {
        previewSection.classList.add('hidden');
        if (btnSubmitBatch) btnSubmitBatch.disabled = true;
        if (btnBatchBadge) btnBatchBadge.textContent = '0';
        return;
      }

      previewSection.classList.remove('hidden');
      if (countDisplay) countDisplay.textContent = String(batchQueue.length);
      if (btnSubmitBatch) btnSubmitBatch.disabled = false;
      if (btnBatchBadge) btnBatchBadge.textContent = String(batchQueue.length);

      previewGrid.innerHTML = '';

      batchQueue.forEach((item, idx) => {
        const card = document.createElement('div');
        card.className =
          'relative rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 overflow-hidden shadow-xs flex flex-col justify-between group';

        const sizeKb = Math.round(item.size / 1024);

        card.innerHTML = `
          <div class="relative aspect-video w-full bg-slate-100 dark:bg-slate-900 overflow-hidden">
            <img src="${item.dataUrl}" alt="Preview" class="w-full h-full object-cover" />
            <button
              type="button"
              data-remove-idx="${idx}"
              class="btn-remove-item absolute top-1.5 right-1.5 w-6 h-6 rounded-full bg-rose-600 text-white flex items-center justify-center text-xs font-bold hover:scale-110 shadow-sm cursor-pointer transition"
              title="Hapus foto ini dari antrian"
            >
              ✕
            </button>
            <span class="absolute bottom-1.5 left-1.5 px-1.5 py-0.5 rounded text-[9px] font-mono bg-black/70 text-white">
              ~${sizeKb} KB
            </span>
          </div>
          <div class="p-2">
            <input
              type="text"
              data-idx="${idx}"
              value="${item.title}"
              class="input-card-title w-full px-2 py-1 text-[11px] font-semibold text-slate-900 dark:text-white bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg outline-none focus:border-primary-500"
              title="Klik untuk ubah judul foto ini"
            />
          </div>
        `;

        previewGrid.appendChild(card);
      });

      // Hook Remove buttons
      previewGrid.querySelectorAll('.btn-remove-item').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const idx = Number(btn.getAttribute('data-remove-idx'));
          batchQueue.splice(idx, 1);
          applyNamingTitles();
        });
      });

      // Hook Title input edits
      previewGrid.querySelectorAll('.input-card-title').forEach((inp) => {
        inp.addEventListener('input', (e) => {
          const idx = Number(inp.getAttribute('data-idx'));
          if (batchQueue[idx]) {
            batchQueue[idx].title = e.target.value;
          }
        });
      });
    }

    btnClearBatch?.addEventListener('click', () => {
      batchQueue = [];
      renderPreviewGrid();
    });

    // Handle File Selection & Compression
    async function handleFilesSelected(files) {
      const validFiles = Array.from(files).filter((f) => f.type.startsWith('image/'));
      if (validFiles.length === 0) return;

      if (progressBox && progressBar && progressText) {
        progressBox.classList.remove('hidden');
        progressBar.style.width = '0%';
        progressText.textContent = `Mengompresi 1 dari ${validFiles.length} foto...`;
      }

      for (let i = 0; i < validFiles.length; i++) {
        const file = validFiles[i];
        if (progressText) progressText.textContent = `Mengompresi ${i + 1} dari ${validFiles.length} foto...`;
        if (progressBar) progressBar.style.width = `${Math.round(((i + 1) / validFiles.length) * 100)}%`;

        try {
          const { dataUrl, size } = await compressImage(file, 1280, 0.82);
          batchQueue.push({
            id: 'temp_' + Date.now() + '_' + i,
            originalName: file.name,
            dataUrl,
            size,
            title: '',
          });
        } catch (err) {
          console.error('Error compressing image:', err);
        }
      }

      if (progressBox) progressBox.classList.add('hidden');
      applyNamingTitles();
    }

    fileInput?.addEventListener('change', (e) => {
      handleFilesSelected(e.target.files);
      fileInput.value = ''; // Reset input agar bisa pilih file lagi
    });

    // Drag and Drop handling on dropzone
    dropzone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('border-primary-500', 'bg-primary-50/20');
    });

    dropzone?.addEventListener('dragleave', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-primary-500', 'bg-primary-50/20');
    });

    dropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-primary-500', 'bg-primary-50/20');
      if (e.dataTransfer?.files) {
        handleFilesSelected(e.dataTransfer.files);
      }
    });

    // Batch Submit
    btnSubmitBatch?.addEventListener('click', () => {
      if (batchQueue.length === 0) return;

      const isFeatured = isFeaturedCheckbox?.checked !== false;
      const finalCategory = customCatInput?.value.trim() || selectedCategory || 'Wisata';

      const payload = batchQueue.map((item) => ({
        title: item.title,
        image_url: item.dataUrl,
        category: finalCategory,
        is_featured: isFeatured,
      }));

      if (hiddenDataInput && hiddenForm) {
        btnSubmitBatch.disabled = true;
        btnSubmitBatch.innerHTML = `
          <svg class="w-4 h-4 animate-spin inline mr-1" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Menyimpan ${payload.length} foto ke server...</span>
        `;
        hiddenDataInput.value = JSON.stringify(payload);
        hiddenForm.submit();
      }
    });

    // ==========================================
    // 3. SINGLE MODAL (TAMBAH 1 FOTO / EDIT SATUAN)
    // ==========================================
    const singleModal = document.getElementById('single-modal');
    const btnOpenSingle = document.getElementById('btn-open-single');
    const btnCloseSingle = document.getElementById('btn-close-single');
    const btnCancelSingle = document.getElementById('btn-cancel-single');
    const singleTitle = document.getElementById('single-modal-title');
    const singlePhotoId = document.getElementById('form-single-photo-id');
    const singleTitleInput = document.getElementById('form-single-title');
    const singleCategoryInput = document.getElementById('form-single-category');
    const singleImageUrlInput = document.getElementById('form-single-image-url');
    const singleIsFeatured = document.getElementById('form-single-is-featured');

    const openSingleModal = (isEdit = false, item = null) => {
      if (!singleModal) return;
      if (isEdit && item) {
        if (singleTitle) singleTitle.textContent = 'Edit Foto Galeri';
        if (singlePhotoId) singlePhotoId.value = item.id || '';
        if (singleTitleInput) singleTitleInput.value = item.title || '';
        if (singleCategoryInput) singleCategoryInput.value = item.category || 'Wisata';
        if (singleImageUrlInput) singleImageUrlInput.value = item.image_url || '';
        if (singleIsFeatured) singleIsFeatured.checked = item.is_featured !== false;
      } else {
        if (singleTitle) singleTitle.textContent = 'Tambah 1 Foto Galeri';
        if (singlePhotoId) singlePhotoId.value = '';
        if (singleTitleInput) singleTitleInput.value = '';
        if (singleCategoryInput) singleCategoryInput.value = selectedCategory || 'Wisata';
        if (singleImageUrlInput) singleImageUrlInput.value = '';
        if (singleIsFeatured) singleIsFeatured.checked = true;
      }
      singleModal.classList.remove('hidden');
      singleModal.classList.add('flex');
    };

    const closeSingleModal = () => {
      singleModal?.classList.add('hidden');
      singleModal?.classList.remove('flex');
    };

    btnOpenSingle?.addEventListener('click', () => openSingleModal(false));
    btnCloseSingle?.addEventListener('click', closeSingleModal);
    btnCancelSingle?.addEventListener('click', closeSingleModal);

    singleModal?.addEventListener('click', (e) => {
      if (e.target === singleModal) closeSingleModal();
    });

    // Hook edit buttons on cards
    document.querySelectorAll('.btn-edit').forEach((btn) => {
      btn.addEventListener('click', () => {
        try {
          const raw = btn.getAttribute('data-edit');
          if (raw) {
            const parsed = JSON.parse(raw);
            openSingleModal(true, parsed);
          }
        } catch (e) {
          console.error(e);
        }
      });
    });

    // Escape key closes both modals
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeBatchModal();
        closeSingleModal();
      }
    });
  })();
</script>
