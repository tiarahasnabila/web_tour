                    <h4 class="font-bold text-slate-900 dark:text-white text-xs sm:text-sm truncate cat-name-display">{cat}</h4>
                    <p class="text-[11px] text-slate-400 font-medium">
                      {count > 0 ? `${count} foto menggunakan kategori ini` : 'Belum ada foto'}
                    </p>
                  </div>
                </div>

                <div class="flex items-center gap-1.5 shrink-0">
                  <!-- Tombol Rename -->
                  <button
                    type="button"
                    data-cat-name={cat}
                    class="btn-trigger-rename px-2.5 py-1.5 rounded-xl text-[11px] font-bold bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 text-slate-700 dark:text-slate-200 hover:border-primary-500 hover:text-primary-600 transition cursor-pointer flex items-center gap-1"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                    <span>Ubah</span>
                  </button>

                  <!-- Tombol Hapus -->
                  <button
                    type="button"
                    data-cat-name={cat}
                    data-cat-count={count}
                    class="btn-trigger-delete p-1.5 rounded-xl text-rose-500 hover:text-rose-700 hover:bg-rose-50 dark:hover:bg-rose-950/40 border border-transparent transition cursor-pointer"
                    title="Hapus kategori ini"
                  >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                </div>
              </div>

              <!-- Form Inline Rename (Hidden by default) -->
              <div class="cat-rename-form hidden pt-2 border-t border-slate-200/50 dark:border-slate-700/50">
                <form method="POST" class="flex items-center gap-2">
                  <input type="hidden" name="_action" value="rename_category" />
                  <input type="hidden" name="old_category" value={cat} />
                  <input
                    type="text"
                    name="new_category"
                    value={cat}
                    required
                    placeholder="Nama kategori baru..."
                    class="flex-1 px-3 py-1.5 rounded-xl border border-primary-300 dark:border-primary-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-xs font-semibold outline-none focus:ring-2 focus:ring-primary-500"
                  />
                  <button
                    type="submit"
                    class="px-3 py-1.5 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-xs font-bold transition cursor-pointer"
                  >
                    Simpan
                  </button>
                  <button
                    type="button"
                    class="btn-cancel-rename px-2.5 py-1.5 rounded-xl text-xs font-semibold text-slate-400 hover:text-slate-600 transition cursor-pointer"
                  >
                    Batal
                  </button>
                </form>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Footer -->
      <div class="px-6 py-3.5 bg-slate-50 dark:bg-slate-800/40 border-t border-slate-100 dark:border-slate-800 flex justify-end shrink-0">
        <button
          type="button"
          id="btn-done-manage-cats"
          class="px-5 py-2 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-xs font-bold transition cursor-pointer"
        >
          Selesai
        </button>
      </div>
    </div>
  </div>

  <!-- Form Hidden untuk Hapus Kategori -->
  <form id="cat-delete-form" method="POST" class="hidden">
    <input type="hidden" name="_action" value="delete_category" />
    <input type="hidden" name="target_category" id="cat-delete-target-input" value="" />
    <input type="hidden" name="delete_mode" id="cat-delete-mode-input" value="reassign" />
  </form>

</AdminLayout>

<script is:inline>
  (() => {
    // Emoji Helper untuk kategori
    function getEmoji(cat) {
      const c = (cat || '').toLowerCase();
      if (c.includes('candi') || c.includes('temple')) return '⛩️';
      if (c.includes('petualang') || c.includes('adventure') || c.includes('jeep')) return '🚙';
      if (c.includes('pantai') || c.includes('beach') || c.includes('laut')) return '🏖️';
      if (c.includes('budaya') || c.includes('culture') || c.includes('kraton') || c.includes('malioboro')) return '🏛️';
      if (c.includes('armada') || c.includes('mobil') || c.includes('car') || c.includes('driver')) return '🚐';
      if (c.includes('alam') || c.includes('nature') || c.includes('gunung')) return '🌄';
      if (c.includes('kuliner') || c.includes('food')) return '🍲';
      return '📸';
    }

    // Canvas Client-side Compressor Helper
    function compressImage(file, maxDim = 1280, quality = 0.82) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            let w = img.width;
            let h = img.height;
            if (w > maxDim || h > maxDim) {
              if (w > h) {
                h = Math.round((h * maxDim) / w);
                w = maxDim;
              } else {
                w = Math.round((w * maxDim) / h);
                h = maxDim;
              }
            }
            const canvas = document.createElement('canvas');
            canvas.width = w;
            canvas.height = h;
            const ctx = canvas.getContext('2d');
            if (!ctx) {
              resolve({ dataUrl: e.target.result, size: file.size });
              return;
            }
            ctx.drawImage(img, 0, 0, w, h);
            const dataUrl = canvas.toDataURL('image/jpeg', quality);
            resolve({ dataUrl, size: Math.round(dataUrl.length * 0.75) });
          };
          img.onerror = () => reject(new Error('Gagal memuat gambar'));
          img.src = e.target.result;
        };
        reader.onerror = () => reject(new Error('Gagal membaca file gambar'));
        reader.readAsDataURL(file);
      });
    }

    // ==========================================
    // SINKRONISASI KATEGORI SECARA OTOMATIS
    // ==========================================
    const batchCatChips = document.getElementById('batch-cat-chips');
    const btnCustomCat = document.getElementById('btn-custom-cat');
    const batchCatIndicator = document.getElementById('batch-cat-indicator');
    const singleCategorySelect = document.getElementById('form-single-category-select');
    const singleCategoryInput = document.getElementById('form-single-category');

    let currentKnownCategories = new Set();
    document.querySelectorAll('.chip-cat').forEach((c) => {
      const v = c.getAttribute('data-cat-value');
      if (v) currentKnownCategories.add(v);
    });

    // Fungsi untuk mendaftarkan kategori baru secara realtime di SEMUA form/dropdown
    function registerNewCategory(catName) {
      const name = (catName || '').trim();
      if (!name || name === '__custom__') return;

      // 1. Tambah ke Chip Batch jika belum ada
      if (!currentKnownCategories.has(name) && batchCatChips && btnCustomCat) {
        currentKnownCategories.add(name);

        const newBtn = document.createElement('button');
        newBtn.type = 'button';
        newBtn.setAttribute('data-cat-value', name);
        newBtn.className =
          'chip-cat inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap shrink-0 transition cursor-pointer border bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:border-primary-400 hover:bg-slate-100';
        newBtn.innerHTML = `<span class="shrink-0">${getEmoji(name)}</span><span class="chip-label shrink-0">${name}</span>`;

        newBtn.addEventListener('click', () => selectBatchCategory(name));
        batchCatChips.insertBefore(newBtn, btnCustomCat);
      }

      // 2. Tambah ke Dropdown Single Select jika belum ada
      if (singleCategorySelect) {
        let exists = false;
        for (let i = 0; i < singleCategorySelect.options.length; i++) {
          if (singleCategorySelect.options[i].value.toLowerCase() === name.toLowerCase()) {
            exists = true;
            break;
          }
        }
        if (!exists) {
          const opt = document.createElement('option');
          opt.value = name;
          opt.textContent = `${getEmoji(name)} ${name}`;
          const customOpt = singleCategorySelect.querySelector('option[value="__custom__"]');
          if (customOpt) {
            singleCategorySelect.insertBefore(opt, customOpt);
          } else {
            singleCategorySelect.appendChild(opt);
          }
        }
      }
    }

    // ==========================================
    // 1. FILTER KATEGORI DI HALAMAN ADMIN
    // ==========================================
    const catFilterBtns = document.querySelectorAll('.cat-filter-btn');
    const galleryCards = document.querySelectorAll('.gallery-card');

    catFilterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-cat-filter');
        catFilterBtns.forEach((b) => {
          b.classList.remove('bg-primary-600', 'text-white', 'shadow-xs');
          b.classList.add('text-slate-600', 'dark:text-slate-300');
        });
        btn.classList.add('bg-primary-600', 'text-white', 'shadow-xs');
        btn.classList.remove('text-slate-600', 'dark:text-slate-300');

        galleryCards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          if (target === 'all' || cardCat === target) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // ==========================================
    // 2. BATCH UPLOADER STATE & LOGIC
    // ==========================================
    const batchModal = document.getElementById('batch-modal');
    const btnOpenBatch = document.getElementById('btn-open-batch');
    const btnEmptyBatch = document.getElementById('btn-empty-batch');
    const btnCloseBatch = document.getElementById('btn-close-batch');
    const btnCancelBatch = document.getElementById('btn-cancel-batch');

    const fileInput = document.getElementById('batch-file-input');
    const dropzone = document.getElementById('batch-dropzone');
    const baseTitleInput = document.getElementById('batch-base-title');
    const namingPatternSelect = document.getElementById('batch-naming-pattern');
    const isFeaturedCheckbox = document.getElementById('batch-is-featured');
    const previewSection = document.getElementById('batch-preview-section');
    const previewGrid = document.getElementById('batch-preview-grid');
    const countDisplay = document.getElementById('batch-count-display');
    const btnSubmitBatch = document.getElementById('btn-submit-batch');
    const btnBatchBadge = document.getElementById('btn-batch-badge');
    const btnClearBatch = document.getElementById('btn-clear-batch');

    const progressBox = document.getElementById('batch-progress-box');
    const progressBar = document.getElementById('batch-progress-bar');
    const progressText = document.getElementById('batch-progress-text');
    const hiddenForm = document.getElementById('batch-hidden-form');
    const hiddenDataInput = document.getElementById('batch-data-input');

    const customCatBox = document.getElementById('custom-cat-box');
    const customCatInput = document.getElementById('batch-custom-cat-input');
    const btnAddBatchCat = document.getElementById('btn-add-batch-cat');

    let selectedCategory = 'Candi';
    let batchQueue = [];

    const openBatchModal = () => {
      batchModal?.classList.remove('hidden');
      batchModal?.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };

    const closeBatchModal = () => {
      batchModal?.classList.add('hidden');
      batchModal?.classList.remove('flex');
      document.body.style.overflow = '';
    };

    btnOpenBatch?.addEventListener('click', openBatchModal);
    btnEmptyBatch?.addEventListener('click', openBatchModal);
    btnCloseBatch?.addEventListener('click', closeBatchModal);
    btnCancelBatch?.addEventListener('click', closeBatchModal);

    batchModal?.addEventListener('click', (e) => {
      if (e.target === batchModal) closeBatchModal();
    });

    // Fungsi Pilih Chip Kategori Batch
    function selectBatchCategory(catName) {
      selectedCategory = catName;

      if (batchCatIndicator) {
        batchCatIndicator.innerHTML = `Kategori aktif: <strong>${catName}</strong>`;
      }

      document.querySelectorAll('.chip-cat').forEach((c) => {
        const val = c.getAttribute('data-cat-value');
        if (val === catName) {
          c.classList.add('active', 'bg-primary-600', 'text-white', 'border-primary-600', 'shadow-xs');
          c.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300', 'border-slate-200', 'dark:border-slate-700');
        } else {
          c.classList.remove('active', 'bg-primary-600', 'text-white', 'border-primary-600', 'shadow-xs');
          c.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300', 'border-slate-200', 'dark:border-slate-700');
        }
      });

      customCatBox?.classList.add('hidden');

      if (baseTitleInput && (!baseTitleInput.value || baseTitleInput.value.includes('Tour'))) {
        if (selectedCategory.includes('Candi')) baseTitleInput.value = 'Borobudur Sunrise Tour';
        else if (selectedCategory.includes('Petualang')) baseTitleInput.value = 'Merapi Lava Tour';
        else if (selectedCategory.includes('Pantai')) baseTitleInput.value = 'Eksotisme Pantai Selatan Jogja';
        else if (selectedCategory.includes('Budaya')) baseTitleInput.value = 'Jalan Santai Malioboro & Kraton';
        else if (selectedCategory.includes('Armada')) baseTitleInput.value = 'Armada Nyaman & Driver Ramah';
        else baseTitleInput.value = `${selectedCategory} Jogja Trip`;
        applyNamingTitles();
      }
    }

    document.querySelectorAll('.chip-cat').forEach((chip) => {
      chip.addEventListener('click', () => {
        const val = chip.getAttribute('data-cat-value') || 'Wisata';
        selectBatchCategory(val);
      });
    });

    btnCustomCat?.addEventListener('click', () => {
      customCatBox?.classList.toggle('hidden');
      customCatInput?.focus();
    });

    function handleAddNewBatchCategory() {
      const val = customCatInput?.value?.trim();
      if (!val) return;
      registerNewCategory(val);
      selectBatchCategory(val);
      customCatBox?.classList.add('hidden');
      if (customCatInput) customCatInput.value = '';
    }

    btnAddBatchCat?.addEventListener('click', handleAddNewBatchCategory);
    customCatInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        handleAddNewBatchCategory();
      }
    });

    function applyNamingTitles() {
      const baseTitle = baseTitleInput?.value.trim() || 'Foto Wisata';
      const pattern = namingPatternSelect?.value || 'numbered';

      batchQueue.forEach((item, idx) => {
        if (pattern === 'numbered') {
          item.title = batchQueue.length > 1 ? `${baseTitle} #${idx + 1}` : baseTitle;
        } else if (pattern === 'filename') {
          const clean = (item.originalName || '')
            .replace(/\.[^/.]+$/, '')
            .replace(/[-_]/g, ' ')
            .replace(/\b\w/g, (l) => l.toUpperCase());
          item.title = clean || `${baseTitle} #${idx + 1}`;
        } else {
          item.title = baseTitle;
        }
      });
      renderPreviewGrid();
    }

    baseTitleInput?.addEventListener('input', applyNamingTitles);
    namingPatternSelect?.addEventListener('change', applyNamingTitles);

    function renderPreviewGrid() {
      if (!previewGrid || !previewSection) return;

      if (batchQueue.length === 0) {
        previewSection.classList.add('hidden');
        if (btnSubmitBatch) btnSubmitBatch.disabled = true;
        if (btnBatchBadge) btnBatchBadge.textContent = '0';
        return;
      }

      previewSection.classList.remove('hidden');
      if (countDisplay) countDisplay.textContent = String(batchQueue.length);
      if (btnSubmitBatch) btnSubmitBatch.disabled = false;
      if (btnBatchBadge) btnBatchBadge.textContent = String(batchQueue.length);

      previewGrid.innerHTML = '';

      batchQueue.forEach((item, idx) => {
        const card = document.createElement('div');
        card.className =
          'relative rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 overflow-hidden shadow-xs flex flex-col justify-between group';

        const sizeKb = Math.round(item.size / 1024);

        card.innerHTML = `
          <div class="relative aspect-video w-full bg-slate-100 dark:bg-slate-900 overflow-hidden">
            <img src="${item.dataUrl}" alt="Preview" class="w-full h-full object-cover" />
            <button
              type="button"
              data-remove-idx="${idx}"
              class="btn-remove-item absolute top-1.5 right-1.5 w-6 h-6 rounded-full bg-rose-600 text-white flex items-center justify-center text-xs font-bold hover:scale-110 shadow-sm cursor-pointer transition"
              title="Hapus foto ini dari antrian"
            >
              ✕
            </button>
            <span class="absolute bottom-1.5 left-1.5 px-1.5 py-0.5 rounded text-[9px] font-mono bg-black/70 text-white">
              ~${sizeKb} KB
            </span>
          </div>
          <div class="p-2">
            <input
              type="text"
              data-idx="${idx}"
              value="${item.title}"
              class="input-card-title w-full px-2 py-1 text-[11px] font-semibold text-slate-900 dark:text-white bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg outline-none focus:border-primary-500"
              title="Klik untuk ubah judul foto ini"
            />
          </div>
        `;

        previewGrid.appendChild(card);
      });

      previewGrid.querySelectorAll('.btn-remove-item').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const idx = Number(btn.getAttribute('data-remove-idx'));
          batchQueue.splice(idx, 1);
          applyNamingTitles();
        });
      });

      previewGrid.querySelectorAll('.input-card-title').forEach((inp) => {
        inp.addEventListener('input', (e) => {
          const idx = Number(inp.getAttribute('data-idx'));
          if (batchQueue[idx]) {
            batchQueue[idx].title = e.target.value;
          }
        });
      });
    }

    btnClearBatch?.addEventListener('click', () => {
      batchQueue = [];
      renderPreviewGrid();
    });

    async function handleFilesSelected(files) {
      const validFiles = Array.from(files).filter((f) => f.type.startsWith('image/'));
      if (validFiles.length === 0) return;

      if (progressBox && progressBar && progressText) {
        progressBox.classList.remove('hidden');
        progressBar.style.width = '0%';
        progressText.textContent = `Mengompresi 1 dari ${validFiles.length} foto...`;
      }

      for (let i = 0; i < validFiles.length; i++) {
        const file = validFiles[i];
        if (progressText) progressText.textContent = `Mengompresi ${i + 1} dari ${validFiles.length} foto...`;
        if (progressBar) progressBar.style.width = `${Math.round(((i + 1) / validFiles.length) * 100)}%`;

        try {
          const { dataUrl, size } = await compressImage(file, 1280, 0.82);
          batchQueue.push({
            id: 'temp_' + Date.now() + '_' + i,
            originalName: file.name,
            dataUrl,
            size,
            title: '',
          });
        } catch (err) {
          console.error('Error compressing image:', err);
        }
      }

      if (progressBox) progressBox.classList.add('hidden');
      applyNamingTitles();
    }

    fileInput?.addEventListener('change', (e) => {
      handleFilesSelected(e.target.files);
      fileInput.value = '';
    });

    dropzone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('border-primary-500', 'bg-primary-50/20');
    });

    dropzone?.addEventListener('dragleave', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-primary-500', 'bg-primary-50/20');
    });

    dropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-primary-500', 'bg-primary-50/20');
      if (e.dataTransfer?.files) {
        handleFilesSelected(e.dataTransfer.files);
      }
    });

    btnSubmitBatch?.addEventListener('click', () => {
      if (batchQueue.length === 0) return;

      const isFeatured = isFeaturedCheckbox?.checked !== false;
      const finalCategory = selectedCategory || 'Wisata';

      const payload = batchQueue.map((item) => ({
        title: item.title,
        image_url: item.dataUrl,
        category: finalCategory,
        is_featured: isFeatured,
      }));

      if (hiddenDataInput && hiddenForm) {
        btnSubmitBatch.disabled = true;
        btnSubmitBatch.innerHTML = `
          <svg class="w-4 h-4 animate-spin inline mr-1" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Menyimpan ${payload.length} foto ke server...</span>
        `;
        hiddenDataInput.value = JSON.stringify(payload);
        hiddenForm.submit();
      }
    });

    // ==========================================
    // 3. SINGLE MODAL (TAMBAH 1 FOTO / EDIT SATUAN)
    // ==========================================
    const singleModal = document.getElementById('single-modal');
    const btnOpenSingle = document.getElementById('btn-open-single');
    const btnCloseSingle = document.getElementById('btn-close-single');
    const btnCancelSingle = document.getElementById('btn-cancel-single');
    const singleTitle = document.getElementById('single-modal-title');
    const singlePhotoId = document.getElementById('form-single-photo-id');
    const singleTitleInput = document.getElementById('form-single-title');
    const singleImageUrlInput = document.getElementById('form-single-image-url');
    const singleIsFeatured = document.getElementById('form-single-is-featured');

    const singleCustomCatBox = document.getElementById('single-custom-cat-box');
    const singleCustomCatInput = document.getElementById('single-custom-cat-input');
    const btnApplySingleCat = document.getElementById('btn-apply-single-cat');

    const openSingleModal = (isEdit = false, item = null) => {
      if (!singleModal) return;

      const itemCategory = (item?.category || selectedCategory || 'Candi').trim();

      registerNewCategory(itemCategory);

      if (singleCategorySelect) singleCategorySelect.value = itemCategory;
      if (singleCategoryInput) singleCategoryInput.value = itemCategory;
      singleCustomCatBox?.classList.add('hidden');

      if (isEdit && item) {
        if (singleTitle) singleTitle.textContent = 'Edit Foto Galeri';
        if (singlePhotoId) singlePhotoId.value = item.id || '';
        if (singleTitleInput) singleTitleInput.value = item.title || '';
        if (singleImageUrlInput) singleImageUrlInput.value = item.image_url || '';
        if (singleIsFeatured) singleIsFeatured.checked = item.is_featured !== false;
      } else {
        if (singleTitle) singleTitle.textContent = 'Tambah 1 Foto Galeri';
        if (singlePhotoId) singlePhotoId.value = '';
        if (singleTitleInput) singleTitleInput.value = '';
        if (singleImageUrlInput) singleImageUrlInput.value = '';
        if (singleIsFeatured) singleIsFeatured.checked = true;
      }

      singleModal.classList.remove('hidden');
      singleModal.classList.add('flex');
    };

    const closeSingleModal = () => {
      singleModal?.classList.add('hidden');
      singleModal?.classList.remove('flex');
    };

    btnOpenSingle?.addEventListener('click', () => openSingleModal(false));
    btnCloseSingle?.addEventListener('click', closeSingleModal);
    btnCancelSingle?.addEventListener('click', closeSingleModal);

    singleModal?.addEventListener('click', (e) => {
      if (e.target === singleModal) closeSingleModal();
    });

    singleCategorySelect?.addEventListener('change', () => {
      const val = singleCategorySelect.value;
      if (val === '__custom__') {
        singleCustomCatBox?.classList.remove('hidden');
        singleCustomCatInput?.focus();
      } else {
        singleCustomCatBox?.classList.add('hidden');
        if (singleCategoryInput) singleCategoryInput.value = val;
      }
    });

    function handleApplySingleCustomCategory() {
      const val = singleCustomCatInput?.value?.trim();
      if (!val) return;
      registerNewCategory(val);
      if (singleCategorySelect) singleCategorySelect.value = val;
      if (singleCategoryInput) singleCategoryInput.value = val;
      singleCustomCatBox?.classList.add('hidden');
      if (singleCustomCatInput) singleCustomCatInput.value = '';
    }

    btnApplySingleCat?.addEventListener('click', handleApplySingleCustomCategory);
    singleCustomCatInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        handleApplySingleCustomCategory();
      }
    });

    document.querySelectorAll('.btn-edit').forEach((btn) => {
      btn.addEventListener('click', () => {
        try {
          const raw = btn.getAttribute('data-edit');
          if (raw) {
            const parsed = JSON.parse(raw);
            openSingleModal(true, parsed);
          }
        } catch (e) {
          console.error(e);
        }
      });
    });

    // ==========================================
    // 4. MODAL KELOLA KATEGORI (RENAME & DELETE)
    // ==========================================
    const manageCatsModal = document.getElementById('manage-cats-modal');
    const btnManageCats = document.getElementById('btn-manage-categories');
    const btnCloseManageCats = document.getElementById('btn-close-manage-cats');
    const btnDoneManageCats = document.getElementById('btn-done-manage-cats');

    const catDeleteForm = document.getElementById('cat-delete-form');
    const catDeleteTargetInput = document.getElementById('cat-delete-target-input');
    const catDeleteModeInput = document.getElementById('cat-delete-mode-input');

    const openManageCats = () => {
      manageCatsModal?.classList.remove('hidden');
      manageCatsModal?.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };

    const closeManageCats = () => {
      manageCatsModal?.classList.add('hidden');
      manageCatsModal?.classList.remove('flex');
      document.body.style.overflow = '';
    };

    btnManageCats?.addEventListener('click', openManageCats);
    btnCloseManageCats?.addEventListener('click', closeManageCats);
    btnDoneManageCats?.addEventListener('click', closeManageCats);

    manageCatsModal?.addEventListener('click', (e) => {
      if (e.target === manageCatsModal) closeManageCats();
    });

    // Toggle Form Rename Inline
    document.querySelectorAll('.btn-trigger-rename').forEach((btn) => {
      btn.addEventListener('click', () => {
        const row = btn.closest('.cat-row');
        const renameForm = row?.querySelector('.cat-rename-form');
        const input = renameForm?.querySelector('input[name="new_category"]');
        renameForm?.classList.toggle('hidden');
        if (!renameForm?.classList.contains('hidden')) {
          input?.focus();
          input?.select();
        }
      });
    });

    document.querySelectorAll('.btn-cancel-rename').forEach((btn) => {
      btn.addEventListener('click', () => {
        const form = btn.closest('.cat-rename-form');
        form?.classList.add('hidden');
      });
    });

    // Trigger Hapus Kategori
    document.querySelectorAll('.btn-trigger-delete').forEach((btn) => {
      btn.addEventListener('click', () => {
        const catName = btn.getAttribute('data-cat-name') || '';
        const count = Number(btn.getAttribute('data-cat-count') || '0');

        if (!catName) return;

        let confirmMsg = `Hapus kategori "${catName}"?`;
        if (count > 0) {
          confirmMsg = `Kategori "${catName}" saat ini digunakan oleh ${count} foto.\n\nFoto-foto tersebut akan otomatis dialihkan ke kategori "Wisata" agar tidak terhapus.\n\nLanjutkan menghapus kategori ini?`;
        }

        if (confirm(confirmMsg)) {
          if (catDeleteTargetInput && catDeleteModeInput && catDeleteForm) {
            catDeleteTargetInput.value = catName;
            catDeleteModeInput.value = 'reassign'; // foto dialihkan ke 'Wisata' agar aman
            catDeleteForm.submit();
          }
        }
      });
    });

    // Escape key closes all modals
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeBatchModal();
        closeSingleModal();
        closeManageCats();
      }
    });
  })();
</script>
