---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { sql } from '../../../lib/db';
import { verifySessionToken } from '../../../lib/auth';
import { invalidateTestimonialsCache } from '../../../lib/testimonials';

const user = verifySessionToken(Astro.cookies.get('admin_session')?.value);
if (!user) {
  return Astro.redirect('/admin/login');
}

let errorMessage = '';
let name = '', origin = '', rating = '5', trip_package = '', comment = '', avatar = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const get = (k: string) => formData.get(k)?.toString().trim() || '';

    name = get('name');
    origin = get('origin');
    rating = get('rating') || '5';
    trip_package = get('trip_package');
    comment = get('comment');
    avatar = get('avatar');

    if (!name || !comment) {
      errorMessage = 'Nama tamu dan isi testimoni wajib diisi.';
    } else {
      await sql`
        INSERT INTO testimonials (name, origin, rating, trip_package, comment, avatar)
        VALUES (${name}, ${origin}, ${Number(rating)}, ${trip_package}, ${comment}, ${avatar});
      `;
      invalidateTestimonialsCache();
      return Astro.redirect('/admin/testimonials?saved=1');
    }
  } catch (err: any) {
    console.error('Insert testimonial error:', err);
    errorMessage = 'Terjadi kesalahan: ' + err.message;
  }
}

const input = 'w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-sm focus:outline-none focus:ring-4 focus:ring-primary-500/10 focus:border-primary-500 transition shadow-sm placeholder:text-slate-400';
const label = 'block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5';
---

<AdminLayout title="Tambah Testimoni" active="testimonials">
  <div class="space-y-6 max-w-3xl mx-auto pb-12">
    <div>
      <a href="/admin/testimonials" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-primary-600 transition mb-1">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        Kembali ke daftar testimoni
      </a>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Tambah Ulasan Testimoni Tamu</h1>
    </div>

    {errorMessage && (
      <div class="px-4 py-3.5 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-sm font-medium flex items-center gap-2">
        <svg class="w-5 h-5 shrink-0 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
        <span>{errorMessage}</span>
      </div>
    )}

    <form method="POST" class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-8 shadow-sm space-y-6">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <h3 class="font-bold text-slate-900 flex items-center gap-2 text-base">
          <span class="text-amber-500">⭐</span> Formulir Testimoni Tamu
        </h3>
        <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-600">Sosial Proof</span>
      </div>

      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <label for="name" class={label}>Nama Tamu / Pelanggan <span class="text-rose-500">*</span></label>
          <input id="name" name="name" type="text" required placeholder="Contoh: Budi Pratama / Sarah Jenkins" value={name} class={input} />
        </div>
        <div>
          <label for="origin" class={label}>Asal Kota / Negara</label>
          <input id="origin" name="origin" type="text" placeholder="Contoh: Jakarta / Melbourne, Australia" value={origin} class={input} />
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <label for="trip_package" class={label}>Paket / Layanan yang Dipakai</label>
          <input id="trip_package" name="trip_package" type="text" placeholder="Contoh: Sunrise Borobudur & Merapi Lava Tour" value={trip_package} class={input} />
        </div>
        <div>
          <label for="rating" class={label}>Rating Bintang</label>
          <select id="rating" name="rating" class={input}>
            <option value="5" selected={rating === '5'}>⭐⭐⭐⭐⭐ (5 Bintang - Sempurna)</option>
            <option value="4" selected={rating === '4'}>⭐⭐⭐⭐ (4 Bintang - Sangat Baik)</option>
            <option value="3" selected={rating === '3'}>⭐⭐⭐ (3 Bintang - Cukup)</option>
          </select>
        </div>
      </div>

      <div>
        <label for="avatar" class={label}>URL Foto Profil Tamu (Opsional)</label>
        <input id="avatar" name="avatar" type="url" placeholder="https://images.unsplash.com/... (opsional)" value={avatar} class={input} />
        <p class="text-[11px] text-slate-400 mt-1">Kosongkan jika ingin memakai avatar inisial otomatis.</p>
      </div>

      <div>
        <label for="comment" class={label}>Isi Ulasan / Testimoni <span class="text-rose-500">*</span></label>
        <textarea id="comment" name="comment" rows="4" required placeholder="Ceritakan pengalaman kepuasan tamu terhadap driver, kebersihan armada, atau fleksibilitas rute tour..." class={`${input} leading-relaxed`}>{comment}</textarea>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
        <a href="/admin/testimonials" class="px-5 py-2.5 rounded-xl border border-slate-200 text-sm font-semibold text-slate-600 hover:bg-slate-50 transition shadow-sm">
          Batal
        </a>
        <button
          type="submit"
          class="bg-primary-600 hover:bg-primary-700 text-white font-semibold px-6 py-2.5 rounded-xl transition shadow-md shadow-primary-600/20 text-sm cursor-pointer"
        >
          Simpan Testimoni
        </button>
      </div>
    </form>
  </div>
</AdminLayout>
