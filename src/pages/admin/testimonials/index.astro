---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { sql } from '../../../lib/db';
import { verifySessionToken } from '../../../lib/auth';

const user = verifySessionToken(Astro.cookies.get('admin_session')?.value);
if (!user) {
  return Astro.redirect('/admin/login');
}

let flash: { type: 'success' | 'error'; text: string } | null = null;
let testimonials: any[] = [];

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action');
    const testId = Number(formData.get('test_id'));

    if (action === 'delete' && testId) {
      await sql`DELETE FROM testimonials WHERE id = ${testId};`;
      flash = { type: 'success', text: 'Testimoni berhasil dihapus.' };
    }
  } catch (err: any) {
    console.error('Delete testimonial error:', err);
    flash = { type: 'error', text: 'Gagal menghapus: ' + err.message };
  }
}

if (!flash && Astro.url.searchParams.get('saved')) {
  flash = { type: 'success', text: 'Testimoni berhasil disimpan.' };
}

try {
  testimonials = await sql`SELECT * FROM testimonials ORDER BY id DESC;`;
} catch (err: any) {
  console.error('Fetch testimonials error:', err);
  flash = { type: 'error', text: 'Gagal memuat testimoni dari database.' };
}
---

<AdminLayout title="Kelola Testimoni" active="testimonials">
  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Testimoni Pelanggan</h1>
        <p class="text-sm text-slate-500 mt-1">Ulasan kepuasan pelanggan yang tampil di halaman beranda.</p>
      </div>
      <a href="/admin/testimonials/tambah" class="inline-flex items-center justify-center gap-2 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
        Tambah Testimoni
      </a>
    </div>

    {flash && (
      <div class:list={[
        'px-4 py-3 rounded-xl text-sm font-medium border',
        flash.type === 'success' ? 'bg-emerald-50 border-emerald-200 text-emerald-700' : 'bg-red-50 border-red-200 text-red-700',
      ]}>
        {flash.text}
      </div>
    )}

    {testimonials.length === 0 ? (
      <div class="bg-white rounded-2xl border border-dashed border-slate-300 py-16 text-center">
        <p class="text-slate-500 text-sm">Belum ada testimoni.</p>
        <a href="/admin/testimonials/tambah" class="inline-block mt-3 text-primary-600 font-semibold text-sm hover:underline">+ Tambah ulasan pertama</a>
      </div>
    ) : (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {testimonials.map((t) => (
          <div class="bg-white rounded-2xl border border-slate-200 p-6 flex flex-col justify-between shadow-sm hover:shadow-md transition">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-3">
                  <img
                    src={t.avatar || `https://ui-avatars.com/api/?name=${encodeURIComponent(t.name)}&background=0d9488&color=fff`}
                    alt={t.name}
                    class="w-12 h-12 rounded-full object-cover border border-slate-100"
                    onerror="this.src='https://placehold.co/100x100?text=User'"
                  />
                  <div>
                    <h3 class="font-semibold text-slate-900 text-sm">{t.name}</h3>
                    <p class="text-xs text-slate-400">{t.origin || 'Wisatawan'}</p>
                  </div>
                </div>
                <div class="flex text-amber-400 text-xs">
                  {'★'.repeat(Number(t.rating) || 5)}
                </div>
              </div>

              {t.trip_package && (
                <div class="mb-3">
                  <span class="inline-block bg-primary-50 text-primary-700 text-[11px] font-medium px-2 py-0.5 rounded-md">
                    {t.trip_package}
                  </span>
                </div>
              )}

              <p class="text-slate-600 text-sm italic leading-relaxed">
                "{t.comment}"
              </p>
            </div>

            <div class="flex items-center justify-end gap-2 pt-4 mt-4 border-t border-slate-100">
              <a href={`/admin/testimonials/edit/${t.id}`} class="px-3 py-1.5 rounded-lg text-xs font-medium text-primary-700 bg-primary-50 hover:bg-primary-100 transition">
                Edit
              </a>
              <form method="POST" onsubmit="return confirmDelete(this, 'Hapus Ulasan Testimoni?', 'Ulasan tamu ini akan dihapus secara permanen dari website.');" class="inline">
                <input type="hidden" name="_action" value="delete" />
                <input type="hidden" name="test_id" value={t.id} />
                <button type="submit" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 transition cursor-pointer">
                  Hapus
                </button>
              </form>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</AdminLayout>

