---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
// Sort by date descending
posts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout title="Blog & Artikel" description="Baca artikel terbaru seputar tips wisata dan rental mobil di Jogja.">
  <div class="bg-gray-900 text-white pt-32 pb-16 md:pt-40">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl font-bold mb-4">Blog & Artikel</h1>
      <p class="text-xl max-w-2xl mx-auto text-gray-300">Tips, panduan, dan informasi terbaru seputar wisata dan rental mobil di Yogyakarta.</p>
    </div>
  </div>

  <section class="py-16 bg-white min-h-screen">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {posts.map(post => (
          <article class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden group">
            <a href={`/blog/${post.slug}`} class="block h-64 overflow-hidden bg-gray-100 relative">
              <img src={post.data.thumbnail} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            </a>
            <div class="p-6">
              <time class="text-sm text-gray-500 mb-2 block">
                {post.data.publishDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <h2 class="text-2xl font-bold text-gray-900 mb-3 hover:text-primary-600 transition-colors">
                <a href={`/blog/${post.slug}`}>{post.data.title}</a>
              </h2>
              <p class="text-gray-600 mb-4 line-clamp-3">
                {post.data.excerpt}
              </p>
              <a href={`/blog/${post.slug}`} class="inline-block text-primary-600 font-medium hover:text-primary-700">Baca selengkapnya &rarr;</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
